{
  "$comment": "Only an actual runtime ACTION_RESULT_COMMITTED event after independent read/comparison can discharge a normal conclusive intent. EXECUTION requires null resolution_ref. RECOVERY requires an exact committed resolution_ref and RECONCILIATION_COMMITTED event, preserving original attempt_fact while reporting the new effective outcome; never send it to the original run normal result entry. Original UNKNOWN files remain unchanged. This static file is not commit evidence. Optional design_only metadata annotates hand-authored P1 resources. P1-R1 DESIGN_ONLY revision; NOT IMPLEMENTED. UNATTEMPTED_ABSENCE uses only commit_unattempted_absence / UNATTEMPTED_ABSENCE_COMMITTED: INTERRUPTED plan, no intent/obligation/resolution, independently fresh sufficient ABSENT and complete uncalled event prefix; never dispatch or clear other pending.",
  "$defs": {
    "ActionResult": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "after_evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "title": "After Evidence Refs",
          "type": "array"
        },
        "attempt_evidence_refs": {
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "minItems": 0,
          "type": "array"
        },
        "attempt_fact": {
          "enum": [
            "NOT_ATTEMPTED",
            "MAY_HAVE_BEEN_ATTEMPTED",
            "ATTEMPTED",
            "LEGACY_UNRECORDED"
          ],
          "type": "string"
        },
        "before_evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Before Evidence Refs",
          "type": "array"
        },
        "effect_match": {
          "enum": [
            "MATCH",
            "ABSENT",
            "INDETERMINATE"
          ],
          "title": "Effect Match",
          "type": "string"
        },
        "intent_ref": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "artifact_id": {
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
                  "title": "Artifact Id",
                  "type": "string"
                },
                "content_hash": {
                  "pattern": "^[0-9a-f]{64}$",
                  "title": "Content Hash",
                  "type": "string"
                },
                "kind": {
                  "const": "WriteIntent",
                  "type": "string"
                },
                "revision": {
                  "exclusiveMinimum": 0,
                  "title": "Revision",
                  "type": "integer"
                }
              },
              "required": [
                "artifact_id",
                "revision",
                "kind",
                "content_hash"
              ],
              "title": "ArtifactRef",
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_step": {
          "enum": [
            "POSTCHECK",
            "RECHECK_TARGET",
            "RECONCILE"
          ],
          "title": "Next Step",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "APPLIED",
            "NOT_APPLIED",
            "UNKNOWN"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "platform_ids": {
          "items": {
            "type": "string"
          },
          "title": "Platform Ids",
          "type": "array"
        },
        "readback": {
          "anyOf": [
            {
              "$ref": "#/$defs/Resource"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "replay_allowed": {
          "const": false,
          "title": "Replay Allowed",
          "type": "boolean"
        }
