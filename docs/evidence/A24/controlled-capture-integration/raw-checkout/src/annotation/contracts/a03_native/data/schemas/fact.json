      "additionalProperties": false,
      "properties": {
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/x-portable-graymap",
            "text/plain",
            "application/json"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "origin": {
          "enum": [
            "SYNTHETIC",
            "ORIGINAL",
            "OBSERVED"
          ],
          "type": "string"
