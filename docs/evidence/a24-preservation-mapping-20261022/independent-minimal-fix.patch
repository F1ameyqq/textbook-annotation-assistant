+    def test_float_numbers_reject_instead_of_rounding_or_overflowing(self):
+        for raw in (b'{"value":0.123456789012345678901234567890}', b'{"value":1e309}'):
+            with self.subTest(raw=raw):
+                path, _ = self.synthetic(raw)
+                with self.assertRaises(PilotError) as caught:
+                    load_historical_original(path, sha(raw), len(raw))
+                self.assertEqual(caught.exception.code, "HISTORICAL_JSON_NUMBER")
+
+    def test_record_value_is_reparsed_from_preserved_bytes(self):
+        raw = b'{"question":"original"}'
+        path, _ = self.synthetic(raw)
+        archive = load_historical_original(path, sha(raw), len(raw))
+        self.assertFalse(hasattr(archive.records[0], "_value"))
+        value = archive.records[0].value()
+        value["question"] = "mutated"
+        self.assertEqual(archive.full_records(), [{"question": "original"}])
