    "section_path": [
      "第一章 勾股定理",
      "2 一定是直角三角形吗"
    ],
    "question_asset": "viewer-15",
    "answer_asset": "viewer-173",
    "task_maps": [
      {
        "task": "q16-task1",
        "slices": [
          {
            "fragment": "content-fragment-6a6525201c66dee02745ab1d",
            "span": [
