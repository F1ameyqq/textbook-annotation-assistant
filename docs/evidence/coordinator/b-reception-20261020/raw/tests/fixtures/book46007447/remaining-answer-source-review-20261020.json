      "cells": [],
      "runs": [
        {
          "format": "plain",
          "text": "【例】解：∵在△ABC中，AB=8，BC=6，AC=10，∴"
        },
        {
          "format": "latex",
          "text": "AB^2+BC^2=AC^2"
        },
        {
          "format": "plain",
          "text": "。∴∠B=90°。∵D为BC的中点，∴BD=CD=3。由折叠的性质可知，AN=DN。设BN=x，则AN=DN=8-x。在Rt△BDN中，由勾股定理，得"
        },
        {
          "format": "latex",
          "text": "DN^2=BN^2+BD^2"
        },
        {
          "format": "plain",
          "text": "，即"
        },
        {
          "format": "latex",
          "text": "(8-x)^2=x^2+3^2"
        },
        {
          "format": "plain",
          "text": "，解得"
        },
        {
          "format": "latex",
          "text": "x=\\frac{55}{16}"
        },
        {
          "format": "plain",
          "text": "。故BN的长为"
        },
        {
          "format": "latex",
          "text": "\\frac{55}{16}"
        },
        {
          "format": "plain",
          "text": "。"
        }
      ],
