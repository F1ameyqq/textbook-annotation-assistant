"""Referential and safety invariants; no planner, executor or recognition code."""
import copy
import struct
from pathlib import Path

from pydantic import BaseModel, ValidationError

from .integrity import artifact_ref, as_data, content_digest, file_digest, policy_ref, read_json
from .models import (ArtifactRef, ExchangeBundle, ImageBinding, PolicyRef, Resource)


class ContractError(ValueError):
    def __init__(self, issues):
        self.issues = issues
        super().__init__("\n".join("{path}: [{code}] {message}".format(**item) for item in issues))


def fail(path, code, message):
    raise ContractError([{"path": path, "code": code, "message": message}])


def walk(value, path):
    yield path, value
    if isinstance(value, BaseModel):
        for name in type(value).model_fields:
            yield from walk(getattr(value, name), path + "." + name)
    elif isinstance(value, list):
        for i, item in enumerate(value):
            yield from walk(item, path + "[" + str(i) + "]")
    elif isinstance(value, dict):
        for name, item in value.items():
            yield from walk(item, path + "." + name)


def distinct(items, path):
    if len(items) != len(set(items)):
        fail(path, "DUPLICATE_ID", "identifiers must be unique in this collection")


def subset(items, allowed, path):
    for i, item in enumerate(items):
        if item not in allowed:
            fail(path + "[" + str(i) + "]", "MISSING_REFERENCE", "unknown reference " + str(item))


def image_size(path, media_type):
    """Read only image headers; support PNG, JPEG and portable graymap fixtures."""
    with path.open("rb") as handle:
        if media_type == "image/png":
            head = handle.read(24)
            if head[:8] != b"\x89PNG\r\n\x1a\n" or head[12:16] != b"IHDR" or len(head) < 24:
                raise ValueError("invalid PNG header")
            return struct.unpack(">II", head[16:24])
        if media_type == "image/x-portable-graymap":
            tokens = []
            while len(tokens) < 4:
                line = handle.readline(4096)
                if not line:
                    raise ValueError("incomplete PGM header")
                tokens.extend(line.split(b"#", 1)[0].split())
            if tokens[0] not in (b"P2", b"P5"):
                raise ValueError("invalid PGM header")
            return int(tokens[1]), int(tokens[2])
        if media_type == "image/jpeg":
            if handle.read(2) != b"\xff\xd8":
                raise ValueError("invalid JPEG header")
            while True:
                prefix = handle.read(1)
                if not prefix:
                    raise ValueError("JPEG size not found")
                if prefix != b"\xff":
                    continue
                marker = handle.read(1)
                while marker == b"\xff":
                    marker = handle.read(1)
                if not marker or marker[0] in (0xD9, 0xDA):
                    raise ValueError("JPEG size not found")
                if marker[0] in (0x00, 0x01, *range(0xD0, 0xD9)):
                    continue
                raw_length = handle.read(2)
                if len(raw_length) != 2:
                    raise ValueError("truncated JPEG")
                length = struct.unpack(">H", raw_length)[0]
                if length < 2:
                    raise ValueError("invalid JPEG segment")
                if marker[0] in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF):
                    size = handle.read(5)
                    if len(size) != 5:
                        raise ValueError("truncated JPEG size")
                    height, width = struct.unpack(">HH", size[1:5])
                    return width, height
                handle.seek(length - 2, 1)
    raise ValueError("asset media_type must be an image")


class _Context:
    def __init__(self, bundle):
        self.bundle = bundle
        self.artifacts = {}
        self.paths = {}
        self.policies = {}
        self.evidence = {e.evidence_id: e for e in bundle.evidence}
        distinct([e.evidence_id for e in bundle.evidence], "$.evidence")
        for i, policy in enumerate(bundle.policies):
            key = (policy.policy_id, policy.revision)
            if key in self.policies:
                fail("$.policies[{}]".format(i), "DUPLICATE_ID", "duplicate policy revision")
            if policy.content_hash != content_digest(policy):
                fail("$.policies[{}].content_hash".format(i), "HASH_MISMATCH", "policy digest differs")
            if set(policy.role_mapping) != {"stem", "option", "answer", "explanation", "shared_material"}:
                fail("$.policies[{}].role_mapping".format(i), "POLICY_MAPPING", "all generic roles require mapping")
            if policy.applicability == "SYNTHETIC_ONLY" and policy.confirmation_status != "SYNTHETIC_ASSUMPTION":
                fail("$.policies[{}]".format(i), "POLICY_STATUS", "synthetic policy must be an explicit assumption")
            if policy.applicability == "JOINT_CONFIRMED" and policy.confirmation_status != "JOINT_CONFIRMED":
                fail("$.policies[{}]".format(i), "POLICY_STATUS", "joint applicability requires joint confirmation")
            self.policies[key] = policy
        identities = {}
        for i, artifact in enumerate(bundle.artifacts):
            path = "$.artifacts[{}]".format(i)
            key = (artifact.artifact_id, artifact.revision)
            if key in self.artifacts:
                fail(path, "DUPLICATE_ID", "duplicate immutable artifact revision")
            identity = (artifact.kind, artifact.book_id, artifact.scope_id)
            if artifact.artifact_id in identities and identities[artifact.artifact_id] != identity:
                fail(path, "IDENTITY_CONFLICT", "artifact identity changed kind/book/scope")
            identities[artifact.artifact_id] = identity
            if artifact.content_hash != content_digest(artifact):
                fail(path + ".content_hash", "HASH_MISMATCH", "artifact digest differs from normalized content")
            self.artifacts[key], self.paths[key] = artifact, path

    def resolve(self, ref, path, kind=None):
        artifact = self.artifacts.get((ref.artifact_id, ref.revision))
        if artifact is None:
            fail(path, "MISSING_REFERENCE", "missing artifact revision")
        if artifact_ref(artifact) != as_data(ref):
            fail(path, "REFERENCE_CONFLICT", "kind/revision/hash does not match referenced artifact")
        if kind and artifact.kind != kind:
            fail(path, "KIND_CONFLICT", "expected " + kind)
        return artifact

    def policy(self, ref, path):
        policy = self.policies.get((ref.policy_id, ref.revision))
        if policy is None or policy_ref(policy) != as_data(ref):
            fail(path, "POLICY_CONFLICT", "missing policy or revision/hash mismatch")
        return policy

    def source(self, artifact, path):
        if artifact.kind == "SourceBundle":
            return artifact
        if hasattr(artifact.payload, "source"):
            return self.resolve(artifact.payload.source, path + ".source", "SourceBundle")
        if hasattr(artifact.payload, "graph"):
            graph = self.resolve(artifact.payload.graph, path + ".graph", "QuestionGraph")
            return self.source(graph, path)
        if artifact.kind == "ExecutionReceipt":
            return self.source(self.resolve(artifact.payload.plan, path + ".plan", "ApplyPlan"), path)
        if artifact.kind == "ReviewPatch":
            return self.source(self.resolve(artifact.payload.baseline, path + ".baseline", "QuestionGraph"), path)
        # Snapshots may list frames; their exact image source must be an explicit input.
        sources = [self.resolve(r, path + ".input_refs") for r in artifact.input_refs if r.kind == "SourceBundle"]
        if len(sources) != 1:
            fail(path, "SOURCE_BINDING", "exactly one source dependency required for image bindings")
        return sources[0]

    def evrefs(self, refs, path, extra=()):
        subset(refs, set(self.evidence) | set(extra), path)


def _relationships(ctx):
    for key, artifact in ctx.artifacts.items():
        path = ctx.paths[key]
        declared = [tuple(as_data(r).values()) for r in artifact.input_refs]
        distinct(declared, path + ".input_refs")
        for location, value in walk(artifact, path):
            if isinstance(value, ArtifactRef):
                dependency = ctx.resolve(value, location)
                if (dependency.book_id, dependency.scope_id) != (artifact.book_id, artifact.scope_id):
                    fail(location, "SCOPE_CONFLICT", "dependency belongs to a different book or scope")
                if artifact.producer.evidence_mode == "OBSERVED" and dependency.producer.evidence_mode == "SYNTHETIC":
                    fail(location, "SYNTHETIC_EVIDENCE", "observed artifact cannot depend on a synthetic artifact")
                if ".input_refs[" not in location and tuple(as_data(value).values()) not in declared:
                    fail(location, "UNDECLARED_INPUT", "payload dependency must also appear in input_refs")
            elif isinstance(value, PolicyRef):
                ctx.policy(value, location)
                if ".producer.policy_versions[" not in location and value not in artifact.producer.policy_versions:
                    fail(location, "UNDECLARED_POLICY", "policy must also appear in producer.policy_versions")
        if artifact.kind == "SourceBundle" and artifact.input_refs:
            fail(path + ".input_refs", "SOURCE_MUTATION", "source imports are immutable roots in C01")
    visited, active = set(), set()

    def visit(key):
        if key in active:
            fail(ctx.paths[key] + ".input_refs", "DEPENDENCY_CYCLE", "artifact dependency cycle")
        if key not in visited:
            active.add(key)
            for ref in ctx.artifacts[key].input_refs:
                visit((ref.artifact_id, ref.revision))
            active.remove(key)
            visited.add(key)
    for key in ctx.artifacts:
        visit(key)


def _resources(ctx, asset_root):
    for path, value in walk(ctx.bundle, "$"):
        if isinstance(value, Resource) and asset_root is not None:
            root = Path(asset_root).resolve()
            resolved = (root / value.path).resolve()
            try:
                resolved.relative_to(root)
            except ValueError:
                fail(path + ".path", "PATH_ESCAPE", "resolved resource leaves bundle directory")
            if not resolved.is_file():
                fail(path + ".path", "RESOURCE_MISSING", "resource does not exist")
            if file_digest(resolved) != value.sha256:
                fail(path + ".sha256", "RESOURCE_HASH", "resource bytes differ")
            if hasattr(value, "asset_id"):
                try:
                    size = image_size(resolved, value.media_type)
                except (ValueError, OSError) as error:
                    fail(path, "IMAGE_HEADER", str(error))
                if size != (value.width, value.height):
                    fail(path, "IMAGE_DIMENSIONS", "image header differs from declared width/height")
    for key, artifact in ctx.artifacts.items():
        for path, value in walk(artifact.payload, ctx.paths[key] + ".payload"):
            if isinstance(value, ImageBinding):
                source = ctx.source(artifact, path)
                assets = {asset.asset_id: asset for asset in source.payload.assets}
                asset = assets.get(value.asset_id)
                if asset is None:
                    fail(path + ".asset_id", "MISSING_ASSET", "asset absent from bound SourceBundle")
                if (value.width, value.height, value.sha256) != (asset.width, asset.height, asset.sha256):
                    fail(path, "IMAGE_BINDING", "original dimensions/digest conflict with asset")


def _source(ctx, a, path):
    p = a.payload
    assets = {x.asset_id for x in p.assets}
    dirs = {x.directory_id for x in p.directories}
    distinct([x.asset_id for x in p.assets], path + ".assets")
    distinct([x.directory_id for x in p.directories], path + ".directories")
    for name in ("pages_expected", "pages_acquired", "scope_manifest"):
        distinct(getattr(p, name), path + "." + name)
    if set(p.pages_acquired) != assets:
        fail(path + ".pages_acquired", "SOURCE_PAGES", "acquired pages must equal actual asset inventory")
    subset(p.pages_acquired, p.pages_expected, path + ".pages_acquired")
    parents = {d.directory_id: d.parent_id for d in p.directories}
    for i, directory in enumerate(p.directories):
        if directory.parent_id is not None:
            subset([directory.parent_id], dirs, path + ".directories[{}].parent_id".format(i))
        seen, current = set(), directory.directory_id
        while current is not None:
            if current in seen:
                fail(path + ".directories", "DIRECTORY_CYCLE", "directory tree contains a cycle")
            seen.add(current)
            current = parents[current]
    mappings = []
    for i, mapping in enumerate(p.external_page_mappings):
        loc = path + ".external_page_mappings[{}]".format(i)
        subset([mapping.asset_id], assets, loc + ".asset_id")
        subset([mapping.directory_id], dirs, loc + ".directory_id")
        ctx.evrefs(mapping.evidence_refs, loc + ".evidence_refs")
        mappings.append(mapping.asset_id)
    distinct(mappings, path + ".external_page_mappings")
    if set(mappings) != assets:
        fail(path + ".external_page_mappings", "PAGE_MAPPING", "every acquired original needs an external-page mapping")


def _evidence(ctx, a, path):
    p = a.payload
    regions = {r.region_id for r in p.regions}
    distinct([r.region_id for r in p.regions], path + ".regions")
    distinct([c.clue_id for c in p.coverage_clues], path + ".coverage_clues")
    for i, region in enumerate(p.regions):
        ctx.evrefs(region.evidence_refs, path + ".regions[{}].evidence_refs".format(i))
    for i, clue in enumerate(p.coverage_clues):
        loc = path + ".coverage_clues[{}]".format(i)
        subset(clue.region_ids, regions, loc + ".region_ids")
        ctx.evrefs(clue.evidence_refs, loc + ".evidence_refs")
        if clue.disposition == "ASSIGNED" and not clue.region_ids:
            fail(loc, "COVERAGE_ASSIGNMENT", "assigned clue must identify regions")
        if clue.disposition in ("EXCLUDED", "UNASSIGNED") and clue.region_ids:
            fail(loc, "COVERAGE_ASSIGNMENT", "excluded/unassigned clue cannot claim assigned regions")


def _graph(ctx, a, path):
    p = a.payload
    source = ctx.resolve(p.source, path + ".source", "SourceBundle")
    evidence = ctx.resolve(p.evidence, path + ".evidence", "EvidenceBundle")
    if evidence.payload.source != p.source:
        fail(path + ".source", "VERSION_CONFLICT", "graph/evidence source versions differ")
    regions = {r.region_id: r for r in evidence.payload.regions}
    fragments = {f.fragment_id: f for f in p.fragments}
    questions = {q.question_id: q for q in p.questions}
    for name, ids in (("questions", [q.question_id for q in p.questions]),
                      ("fragments", [f.fragment_id for f in p.fragments]),
                      ("answer_relations", [r.relation_id for r in p.answer_relations])):
        distinct(ids, path + "." + name)
    # IDs identify distinct entity namespaces; numbers can repeat in external_refs.
    all_ids = list(regions) + list(fragments) + list(questions)
    distinct(all_ids, path)
    subset(list(questions), source.payload.scope_manifest, path + ".questions")
    dirs = {d.directory_id for d in source.payload.directories}
    for i, fragment in enumerate(p.fragments):
        loc = path + ".fragments[{}]".format(i)
        subset(fragment.region_ids, regions, loc + ".region_ids")
        distinct(fragment.region_ids, loc + ".region_ids")
        if any(regions[r].content_type != fragment.content_type for r in fragment.region_ids):
            fail(loc + ".content_type", "CONTENT_TYPE", "fragment and region content types differ")
    for i, question in enumerate(p.questions):
        loc = path + ".questions[{}]".format(i)
        subset([question.directory_id], dirs, loc + ".directory_id")
        subset(question.fragment_ids + question.shared_fragment_ids, fragments, loc + ".fragment_ids")
        distinct(question.fragment_ids, loc + ".fragment_ids")
        if question.parent_question_id is not None:
            subset([question.parent_question_id], questions, loc + ".parent_question_id")
        seen, current = set(), question.question_id
        while current is not None:
            if current in seen:
                fail(loc, "QUESTION_CYCLE", "question parent cycle")
            seen.add(current)
            current = questions[current].parent_question_id
        if any(fragments[f].role != "shared_material" for f in question.shared_fragment_ids):
            fail(loc + ".shared_fragment_ids", "SHARED_ROLE", "shared material requires generic shared_material role")
        pages = {regions[r].box.image.asset_id for f in question.fragment_ids + question.shared_fragment_ids
                 for r in fragments[f].region_ids if fragments[f].role not in ("answer", "explanation")}
        if question.cross_page != (len(pages) > 1):
            fail(loc + ".cross_page", "CROSS_PAGE", "cross_page must match question content original pages")
        orders = [fragments[f].reading_order for f in question.fragment_ids]
        distinct(orders, loc + ".fragment_ids")
    for i, relation in enumerate(p.answer_relations):
        loc = path + ".answer_relations[{}]".format(i)
        subset([relation.question_id], questions, loc + ".question_id")
        subset(relation.candidate_fragment_ids, fragments, loc + ".candidate_fragment_ids")
        subset(relation.selected_fragment_ids, relation.candidate_fragment_ids, loc + ".selected_fragment_ids")
        if any(fragments[f].role not in ("answer", "explanation") for f in relation.candidate_fragment_ids):
            fail(loc, "ANSWER_ROLE", "answer candidates must have answer/explanation roles")
        if (relation.status == "SELECTED") != bool(relation.selected_fragment_ids):
            fail(loc, "ANSWER_SELECTION", "selected status must have selected candidates; unresolved cannot select")
        ctx.evrefs(relation.evidence_refs, loc + ".evidence_refs", regions)
    # A graph that claims a patch derivation must actually be that patch result.
    patches = [ctx.resolve(ref, path + ".input_refs", "ReviewPatch")
               for ref in a.input_refs if ref.kind == "ReviewPatch"]
    if patches:
        if len(patches) != 1:
            fail(path, "PATCH_DERIVATION", "one explicit patch per derived graph revision is required")
        patch = patches[0].payload
        baseline = ctx.resolve(patch.baseline, path + ".patch.baseline", "QuestionGraph")
        if baseline.artifact_id != a.artifact_id or patch.result_revision != a.revision:
            fail(path, "PATCH_DERIVATION", "patch result identity/revision differs from derived graph")
        if patch.baseline not in a.input_refs:
            fail(path, "PATCH_DERIVATION", "derived graph must declare the immutable baseline input")
        expected = copy.deepcopy(baseline.payload.model_dump(mode="json"))
        for change in patch.changes:
            if change.field == "role":
                collection, id_field = expected["fragments"], "fragment_id"
            elif change.field == "printed_number":
                collection, id_field = expected["questions"], "question_id"
            else:
                collection, id_field = expected["answer_relations"], "relation_id"
            entity = next((e for e in collection if e[id_field] == change.entity_id), None)
            if entity is None:
                fail(path, "PATCH_DERIVATION", "patch entity missing from baseline")
            if change.field == "printed_number":
                entity["external_refs"]["printed_number"] = change.after
            else:
                entity[change.field] = change.after
        if expected != p.model_dump(mode="json"):
            fail(path, "PATCH_DERIVATION", "derived graph differs from exact baseline plus declared patch; re-recognition needs explicit conflict handling")


def _coverage(ctx, coverage, graph, path, passing=False):
    source = ctx.source(graph, path)
    evidence = ctx.resolve(graph.payload.evidence, path + ".evidence", "EvidenceBundle")
    if coverage.scope_id != graph.scope_id or set(coverage.pages_expected) != set(source.payload.pages_expected):
        fail(path, "COVERAGE_SCOPE", "coverage must bind complete original source scope")
    for name in ("pages_expected", "pages_checked", "clue_ids", "unassigned_region_ids"):
        distinct(getattr(coverage, name), path + "." + name)
    subset(coverage.pages_checked, source.payload.pages_acquired, path + ".pages_checked")
    clues = {c.clue_id: c for c in evidence.payload.coverage_clues}
    subset(coverage.clue_ids, clues, path + ".clue_ids")
    subset(coverage.unassigned_region_ids, {r.region_id for r in evidence.payload.regions}, path + ".unassigned_region_ids")
    # Every independently observed clue on a checked page must be accounted for.
    required = {c.clue_id for c in clues.values() if c.box.image.asset_id in coverage.pages_checked}
    if not required.issubset(coverage.clue_ids):
        fail(path + ".clue_ids", "COVERAGE_OMISSION", "checked page omitted whole-page coverage clues")
    if passing:
        if {q.question_id for q in graph.payload.questions} != set(source.payload.scope_manifest):
            fail(path, "SCOPE_QUESTION_MISSING", "PASS cannot omit an independently scoped question")
        owned = {f for q in graph.payload.questions for f in q.fragment_ids + q.shared_fragment_ids}
        owned.update(f for relation in graph.payload.answer_relations for f in relation.selected_fragment_ids)
        assigned = {r for f in graph.payload.fragments if f.fragment_id in owned for r in f.region_ids}
        if set(coverage.pages_checked) != set(coverage.pages_expected) or coverage.unassigned_region_ids:
            fail(path, "COVERAGE_INCOMPLETE", "PASS requires complete pages and no unassigned regions")
        for clue_id in coverage.clue_ids:
            clue = clues[clue_id]
            if clue.disposition == "UNASSIGNED" or (clue.disposition == "ASSIGNED" and not set(clue.region_ids).issubset(assigned)):
                fail(path + ".clue_ids", "UNASSIGNED_CONTENT", "whole-page clue lacks graph ownership")


def _check(ctx, a, path):
    p = a.payload
    graph = ctx.resolve(p.graph, path + ".graph", "QuestionGraph")
    policy = ctx.policy(p.policy, path + ".policy")
    if p.snapshot is not None:
        ctx.resolve(p.snapshot, path + ".snapshot", "PlatformSnapshot")
    if p.stage != "POST_APPLY" and p.receipt is not None:
        fail(path + ".receipt", "CHECK_STAGE", "receipt binding is reserved for POST_APPLY")
    expected_subject = {"PRE_APPLY": p.graph, "TARGET": p.snapshot, "POST_APPLY": p.receipt}[p.stage]
    if p.subject != expected_subject:
        fail(path + ".subject", "CHECK_SUBJECT", "stage subject must match graph/snapshot/receipt respectively")
    if p.decision == "PASS" and p.stage in ("PRE_APPLY", "TARGET"):
        if any(q.question_type in ("ordinary_choice", "seven_choice") for q in graph.payload.questions):
            if policy.option_grouping == "UNRESOLVED" or policy.confirmation_status == "UNRESOLVED":
                fail(path + ".policy", "POLICY_UNRESOLVED", "affected option rule must be resolved before PASS")
    _coverage(ctx, p.coverage, graph, path + ".coverage", p.decision == "PASS")
    source = ctx.source(graph, path)
    evidence = ctx.resolve(graph.payload.evidence, path + ".evidence", "EvidenceBundle")
    entities = {q.question_id for q in graph.payload.questions} | set(source.payload.scope_manifest)
    fragments = {f.fragment_id for f in graph.payload.fragments}
    regions = {r.region_id for r in evidence.payload.regions}
    extra = entities | fragments | regions | {c.clue_id for c in evidence.payload.coverage_clues}
    distinct([i.issue_id for i in p.issues], path + ".issues")
    for i, check in enumerate(p.checks):
        ctx.evrefs(check.evidence_refs, path + ".checks[{}].evidence_refs".format(i), extra)
    for i, issue in enumerate(p.issues):
        loc = path + ".issues[{}]".format(i)
        ctx.evrefs(issue.evidence_refs, loc + ".evidence_refs", extra)
        allowed = {"book": {a.book_id}, "scope": {a.scope_id}, "page": set(source.payload.pages_expected),
                   "question": entities, "fragment": fragments, "region": regions,
                   "action": {x.action_id for item in ctx.bundle.artifacts if item.kind == "ApplyPlan"
                              for x in item.payload.actions}}[issue.scope_type]
        subset([issue.scope_id], allowed, loc + ".scope_id")
    if p.stage == "POST_APPLY":
        receipt = ctx.resolve(p.receipt, path + ".receipt", "ExecutionReceipt")
        plan = ctx.resolve(receipt.payload.plan, path + ".receipt.plan", "ApplyPlan")
        if plan.payload.graph != p.graph or plan.payload.policy != p.policy:
            fail(path, "POSTCHECK_BINDING", "postcheck graph/policy must match executed plan")
        if p.decision == "PASS" and (not receipt.payload.results or any(r.outcome != "APPLIED" for r in receipt.payload.results)):
            fail(path + ".decision", "UNPROVEN_APPLY", "POST_APPLY PASS requires all actions APPLIED")


def _plan(ctx, a, path, current_snapshot=None):
    p = a.payload
    graph = ctx.resolve(p.graph, path + ".graph", "QuestionGraph")
    pre = ctx.resolve(p.precheck, path + ".precheck", "CheckReport").payload
    target = ctx.resolve(p.targetcheck, path + ".targetcheck", "CheckReport").payload
    snapshot = ctx.resolve(p.snapshot, path + ".snapshot", "PlatformSnapshot")
    policy = ctx.policy(p.policy, path + ".policy")
    previous = None
    if p.previous_receipt is not None:
        previous = ctx.resolve(p.previous_receipt, path + ".previous_receipt", "ExecutionReceipt")
        previous_plan = ctx.resolve(previous.payload.plan, path + ".previous_receipt.plan", "ApplyPlan")
        if (previous_plan.payload.graph.artifact_id != p.graph.artifact_id
                or previous_plan.payload.graph.revision >= p.graph.revision):
            fail(path + ".previous_receipt", "DELTA_BASELINE", "old receipt must belong to a prior revision of this graph")
    if pre.stage != "PRE_APPLY" or target.stage != "TARGET":
        fail(path, "TWO_CHECK_STAGES", "plan needs distinct PRE_APPLY and TARGET reports")
    for name, report in (("precheck", pre), ("targetcheck", target)):
        if report.graph != p.graph or report.policy != p.policy:
            fail(path + "." + name, "VERSION_CONFLICT", "check graph/policy version differs from plan")
        if report.snapshot is not None and report.snapshot != p.snapshot:
            fail(path + "." + name + ".snapshot", "TARGET_CHANGED", "check snapshot version differs from plan")
    if current_snapshot is not None and artifact_ref(snapshot) != as_data(current_snapshot):
        fail(path + ".snapshot", "TARGET_CHANGED", "current snapshot differs; recheck and replan")
    if snapshot.payload.authorized_scope_id != a.scope_id:
        fail(path + ".snapshot", "AUTHORIZED_SCOPE", "snapshot authorization scope differs")
    if p.readiness == "BLOCKED":
        issue_ids = {i.issue_id for report in (pre, target) for i in report.issues}
        subset(p.blocked_issue_ids, issue_ids, path + ".blocked_issue_ids")
        if pre.decision == target.decision == "PASS":
            fail(path, "BLOCKED_BASIS", "blocked plan needs a failed/held check")
        return
    if pre.decision != "PASS" or target.decision != "PASS":
        fail(path, "TWO_PASS_REQUIRED", "READY plan requires both content and target PASS")
    if any(q.question_type in ("ordinary_choice", "seven_choice") for q in graph.payload.questions):
        if policy.option_grouping == "UNRESOLVED" or policy.confirmation_status == "UNRESOLVED":
            fail(path + ".policy", "POLICY_UNRESOLVED", "affected option grouping cannot silently pass")
    if policy.applicability == "SYNTHETIC_ONLY" and (p.execution_mode != "SIMULATED" or a.producer.evidence_mode != "SYNTHETIC"):
        fail(path + ".policy", "SYNTHETIC_ONLY", "demo assumption cannot authorize platform execution")
    if p.execution_mode == "PLATFORM" and (policy.applicability != "JOINT_CONFIRMED" or a.producer.evidence_mode != "OBSERVED"):
        fail(path, "POLICY_UNCONFIRMED", "platform eligibility requires confirmed policy and observed evidence")
    caps = {c.name: c for c in snapshot.payload.capabilities}
    required = set(p.required_capabilities) | {"frame_readback"}
    required.add("persistent_draft" if p.session_mode == "PERSISTENT" else "same_session_handoff")
    if any(action.operation == "UPDATE_FRAMES" for action in p.actions):
        required.add("frame_update")
    for cap in required:
        if cap not in caps or caps[cap].status != "VERIFIED":
            fail(path + ".required_capabilities", "CAPABILITY_UNVERIFIED", "required capability not verified: " + cap)
        if caps[cap].platform_version != snapshot.payload.platform_version:
            fail(path + ".required_capabilities", "CAPABILITY_VERSION", "capability was tested against a different platform version: " + cap)
    distinct([x.action_id for x in p.actions], path + ".actions")
    questions = {q.question_id: q for q in graph.payload.questions}
    platform_questions = {q.platform_question_id: q for q in snapshot.payload.questions}
    graph_path = ctx.paths[(graph.artifact_id, graph.revision)] + ".payload"
    for i, question in enumerate(graph.payload.questions):
        external = question.external_refs
        if external.platform_question_id is None:
            continue
        loc = graph_path + ".questions[{}].external_refs".format(i)
        if external.platform_question_id not in platform_questions:
            fail(loc + ".platform_question_id", "MISSING_REFERENCE", "existing question mapping is absent from the plan snapshot")
        existing = platform_questions[external.platform_question_id]
        if external.platform_order is not None and external.platform_order != existing.platform_order:
            fail(loc + ".platform_order", "PLATFORM_MAPPING_CONFLICT", "mapped question order differs from the plan snapshot")
    entities = set(questions) | {f.fragment_id for f in graph.payload.fragments}
    seen = set()
    for i, action in enumerate(p.actions):
        loc = path + ".actions[{}]".format(i)
        subset(action.depends_on, seen, loc + ".depends_on")
        subset([action.target.question_id], questions, loc + ".target.question_id")
        subset(action.source_entity_ids, entities, loc + ".source_entity_ids")
        question = questions[action.target.question_id]
        owned = {question.question_id} | set(question.fragment_ids) | set(question.shared_fragment_ids)
        owned.update(f for relation in graph.payload.answer_relations if relation.question_id == question.question_id
                     for f in relation.selected_fragment_ids)
        if not set(action.source_entity_ids).issubset(owned):
            fail(loc + ".source_entity_ids", "ACTION_OWNERSHIP", "action sources must belong to its target question")
        if action.target.target_id != snapshot.payload.target_id:
            fail(loc + ".target.target_id", "TARGET_CONFLICT", "action target differs from snapshot")
        platform_id = action.target.platform_question_id
        mapped_id = question.external_refs.platform_question_id
        target_path = loc + ".target.platform_question_id"
        if platform_id is not None:
            if platform_id not in platform_questions:
                fail(target_path, "MISSING_REFERENCE", "action platform question is absent from the plan snapshot")
            if mapped_id is None:
                fail(target_path, "PLATFORM_MAPPING_REQUIRED", "existing action target requires an explicit mapping on its internal question")
            if platform_id != mapped_id:
                fail(target_path, "PLATFORM_MAPPING_CONFLICT", "action target differs from its internal question's existing platform mapping")
        elif mapped_id is not None:
            fail(target_path, "PLATFORM_MAPPING_CONFLICT", "null target cannot replace an existing platform question mapping")
        if action.operation == "UPDATE_FRAMES" and p.previous_receipt is None:
            fail(loc, "DELTA_BASELINE", "updates must reference old receipt; actual delta support is out of C01")
        if action.operation == "UPDATE_FRAMES":
            previous_targets = {old.action_id: old.target.question_id for old in previous_plan.payload.actions}
            applied_questions = {previous_targets[r.action_id] for r in previous.payload.results if r.outcome == "APPLIED"}
            if action.target.question_id not in applied_questions:
                fail(loc, "DELTA_BASELINE", "update target has no APPLIED baseline action")
        seen.add(action.action_id)


def _receipt(ctx, a, path):
    p = a.payload
    plan = ctx.resolve(p.plan, path + ".plan", "ApplyPlan").payload
    distinct([r.action_id for r in p.results], path + ".results")
    if plan.readiness == "BLOCKED":
        if p.results or p.execution_mode != "NOT_EXECUTED" or p.write_disposition != "NOT_EXECUTED":
            fail(path, "BLOCKED_EXECUTION", "blocked plan must not have executed actions")
    else:
        if {r.action_id for r in p.results} != {a.action_id for a in plan.actions}:
            fail(path + ".results", "ACTION_COVERAGE", "every planned action requires exactly one result")
        if p.execution_mode != {"SIMULATED": "SIMULATED", "PLATFORM": "PLATFORM_OBSERVED"}[plan.execution_mode]:
            fail(path + ".execution_mode", "EVIDENCE_MODE", "receipt execution mode differs from plan")
        outcomes = {r.outcome for r in p.results}
        expected = "PAUSE_RECONCILE" if "UNKNOWN" in outcomes else "RECHECK_TARGET" if "NOT_APPLIED" in outcomes else "POSTCHECK"
        if p.write_disposition != expected:
            fail(path + ".write_disposition", "UNKNOWN_GUARD", "receipt disposition must follow worst unresolved action")
        if "UNKNOWN" in outcomes and not p.unresolved_issue_ids:
            fail(path + ".unresolved_issue_ids", "UNKNOWN_GUARD", "UNKNOWN requires unresolved issue")
    for i, result in enumerate(p.results):
        ctx.evrefs(result.before_evidence_refs, path + ".results[{}].before_evidence_refs".format(i))
        ctx.evrefs(result.after_evidence_refs, path + ".results[{}].after_evidence_refs".format(i))


def _patch(ctx, a, path):
    p = a.payload
    graph = ctx.resolve(p.baseline, path + ".baseline", "QuestionGraph")
    if p.result_revision != graph.revision + 1:
        fail(path + ".result_revision", "PATCH_REVISION", "patch must propose next immutable revision")
    fragments = {f.fragment_id: f for f in graph.payload.fragments}
    questions = {q.question_id: q for q in graph.payload.questions}
    relations = {r.relation_id: r for r in graph.payload.answer_relations}
    distinct([(c.entity_id, c.field) for c in p.changes], path + ".changes")
    for i, change in enumerate(p.changes):
        loc = path + ".changes[{}]".format(i)
        if change.field == "role":
            entity = fragments.get(change.entity_id)
            if change.after not in ("stem", "option", "answer", "explanation", "shared_material"):
                fail(loc + ".after", "PATCH_VALUE", "invalid generic role")
            before = entity.role if entity else None
        elif change.field == "printed_number":
            entity = questions.get(change.entity_id)
            if change.after is not None and not isinstance(change.after, str):
                fail(loc + ".after", "PATCH_VALUE", "printed number must be string or null")
            before = entity.external_refs.printed_number if entity else None
        else:
            entity = relations.get(change.entity_id)
            if not isinstance(change.after, list):
                fail(loc + ".after", "PATCH_VALUE", "answer selection must be a list")
            subset(change.after, entity.candidate_fragment_ids if entity else (), loc + ".after")
            before = entity.selected_fragment_ids if entity else None
        if entity is None:
            fail(loc + ".entity_id", "MISSING_ENTITY", "patch entity absent from exact baseline")
        if change.before != before:
            fail(loc + ".before", "PATCH_BASELINE", "expected old field does not match baseline")


def _batch(ctx, a, path):
    p = a.payload
    source = ctx.resolve(p.source, path + ".source", "SourceBundle")
    graph = ctx.resolve(p.graph, path + ".graph", "QuestionGraph")
    receipt = ctx.resolve(p.receipt, path + ".receipt", "ExecutionReceipt")
    post = ctx.resolve(p.postcheck, path + ".postcheck", "CheckReport").payload
    if p.scope_manifest != source.payload.scope_manifest:
        fail(path + ".scope_manifest", "DENOMINATOR_CHANGED", "batch must retain independent source scope manifest")
    if graph.payload.source != p.source or post.graph != p.graph or post.receipt != p.receipt or post.stage != "POST_APPLY":
        fail(path, "BATCH_BINDING", "batch source/graph/postcheck/receipt versions differ")
    _coverage(ctx, p.coverage, graph, path + ".coverage", p.state in ("COMPLETED", "READY_FOR_SUBMISSION"))
    checks = {c.check_id: c.outcome for c in post.checks}
    expected_frames = {"PASS": "PASS", "FAIL": "FAIL", "UNAVAILABLE": "UNAVAILABLE"}[checks["frame_structure"]]
    if p.frame_check_status != expected_frames:
        fail(path + ".frame_check_status", "FRAME_EVIDENCE", "frame result differs from postcheck")
    if p.content_check_status == "VERIFIED" and checks["final_content"] != "PASS":
        fail(path + ".content_check_status", "CONTENT_EVIDENCE", "verified content requires final-content PASS")
    if p.content_check_status == "MISMATCH" and checks["final_content"] != "FAIL":
        fail(path + ".content_check_status", "CONTENT_EVIDENCE", "mismatch requires final-content failure")
    if p.state in ("COMPLETED", "READY_FOR_SUBMISSION") and post.decision != "PASS":
        fail(path + ".state", "COMPLETION_GUARD", "completion/readiness requires POST_APPLY PASS")
    if any(r.outcome == "UNKNOWN" for r in receipt.payload.results):
        if p.state != "NEEDS_RECONCILIATION" or not p.unresolved_issue_ids or not any(q.state == "UNKNOWN" for q in p.questions):
            fail(path + ".state", "UNKNOWN_GUARD", "unknown write must pause batch for reconciliation")
        if p.content_check_status == "VERIFIED":
            fail(path + ".content_check_status", "UNKNOWN_GUARD", "unresolved write cannot have verified final content")
    plan = ctx.resolve(receipt.payload.plan, path + ".receipt.plan", "ApplyPlan")
    targets = {action.action_id: action.target.question_id for action in plan.payload.actions}
    statuses = {q.question_id: q.state for q in p.questions}
    for result in receipt.payload.results:
        if result.outcome == "UNKNOWN" and statuses.get(targets[result.action_id]) != "UNKNOWN":
            fail(path + ".questions", "UNKNOWN_QUESTION", "each unresolved action target must remain UNKNOWN")
        if result.outcome == "NOT_APPLIED" and statuses.get(targets[result.action_id]) == "VERIFIED":
            fail(path + ".questions", "UNAPPLIED_QUESTION", "unapplied action target cannot be VERIFIED")
    for i, question in enumerate(p.questions):
        if question.question_id not in {q.question_id for q in graph.payload.questions} and question.state == "VERIFIED":
            fail(path + ".questions[{}]".format(i), "UNRECOGNIZED_QUESTION", "missing graph question cannot be verified")
    ctx.evrefs(p.submission_evidence_refs, path + ".submission_evidence_refs")


def validate_bundle(bundle, asset_root=None):
    """Validate schema, exact dependencies, geometry, policy and state invariants.

    asset_root=None deliberately skips file-byte validation; load_bundle defaults to it on.
    Re-parse even model instances to catch mutations of nested Python lists/dicts.
    """
    try:
        bundle = ExchangeBundle.model_validate(as_data(bundle))
    except ValidationError as error:
        raise ContractError([{"path": "$" + "".join("[{}]".format(x) if isinstance(x, int) else "." + x for x in e["loc"]),
                              "code": "SCHEMA", "message": e["msg"]} for e in error.errors(include_url=False)]) from error
    ctx = _Context(bundle)
    _relationships(ctx)
    _resources(ctx, asset_root)
    handlers = {"SourceBundle": _source, "EvidenceBundle": _evidence, "QuestionGraph": _graph,
                "CheckReport": _check, "ApplyPlan": _plan, "ExecutionReceipt": _receipt,
                "ReviewPatch": _patch, "BatchReport": _batch}
    all_issues = {issue.issue_id for a in bundle.artifacts if a.kind == "CheckReport" for issue in a.payload.issues}
    for key, artifact in ctx.artifacts.items():
        path = ctx.paths[key] + ".payload"
        if artifact.kind in handlers:
            handlers[artifact.kind](ctx, artifact, path)
        if artifact.kind == "PlatformSnapshot":
            p = artifact.payload
            distinct(p.directories, path + ".directories")
            distinct([c.name for c in p.capabilities], path + ".capabilities")
            distinct([q.platform_question_id for q in p.questions], path + ".questions")
            distinct([f.platform_frame_id for f in p.frames], path + ".frames")
            for i, question in enumerate(p.questions):
                if question.directory_id not in p.directories:
                    fail(path + ".questions[{}].directory_id".format(i), "MISSING_REFERENCE", "platform question directory is absent from this snapshot")
            for i, cap in enumerate(p.capabilities):
                ctx.evrefs(cap.evidence_refs, path + ".capabilities[{}].evidence_refs".format(i))
            ctx.evrefs(p.evidence_refs, path + ".evidence_refs")
            for i, frame in enumerate(p.frames):
                subset([frame.platform_question_id], {q.platform_question_id for q in p.questions}, path + ".frames[{}]".format(i))
        for name in ("unresolved_issue_ids", "related_issue_ids"):
            if hasattr(artifact.payload, name):
                subset(getattr(artifact.payload, name), all_issues, path + "." + name)
        if artifact.producer.evidence_mode == "OBSERVED":
            # A synthetic evidence file cannot be relabeled into an observation chain.
            for location, value in walk(artifact, ctx.paths[key]):
                if isinstance(value, list) and location.endswith("evidence_refs"):
                    for evidence_id in value:
                        if evidence_id in ctx.evidence and ctx.evidence[evidence_id].mode == "SYNTHETIC":
                            fail(location, "SYNTHETIC_EVIDENCE", "observed artifact references synthetic evidence")
    return bundle


def load_bundle(path, verify_assets=True):
    path = Path(path)
    try:
        data = read_json(path)
    except (OSError, ValueError) as error:
        fail("$", "JSON_INPUT", str(error))
    return validate_bundle(data, path.parent if verify_assets else None)


def assert_plan_ready(bundle, plan_ref, current_snapshot_ref):
    """Check eligibility against an explicit current snapshot; performs no I/O or action."""
    bundle = validate_bundle(bundle)
    ctx = _Context(bundle)
    try:
        plan_ref = ArtifactRef.model_validate(as_data(plan_ref))
        current_snapshot_ref = ArtifactRef.model_validate(as_data(current_snapshot_ref))
    except ValidationError as error:
        fail("$.eligibility", "SCHEMA", str(error))
    plan = ctx.resolve(plan_ref, "$.plan", "ApplyPlan")
    ctx.resolve(current_snapshot_ref, "$.current_snapshot", "PlatformSnapshot")
    if plan.payload.readiness != "READY":
        fail("$.plan.readiness", "PLAN_BLOCKED", "diagnostic plan is not eligible")
    _plan(ctx, plan, "$.plan.payload", current_snapshot_ref)
    # A fresh plan ID cannot bypass an unresolved write elsewhere in this book.
    for artifact in bundle.artifacts:
        if artifact.kind == "ExecutionReceipt" and artifact.book_id == plan.book_id:
            if any(r.outcome == "UNKNOWN" for r in artifact.payload.results):
                fail("$.plan", "BOOK_WRITE_PAUSED", "UNKNOWN receipt requires reconciliation before any book write")
    return plan


def assert_patch_base(bundle, patch_ref, baseline_ref):
    bundle = validate_bundle(bundle)
    ctx = _Context(bundle)
    try:
        patch_ref = ArtifactRef.model_validate(as_data(patch_ref))
        baseline_ref = ArtifactRef.model_validate(as_data(baseline_ref))
    except ValidationError as error:
        fail("$.patch", "SCHEMA", str(error))
    patch = ctx.resolve(patch_ref, "$.patch", "ReviewPatch")
    ctx.resolve(baseline_ref, "$.baseline", "QuestionGraph")
    if patch.payload.baseline != baseline_ref:
        fail("$.patch.payload.baseline", "PATCH_BASELINE", "patch may only apply to its exact baseline version")
    return patch

7693fa93113a021f280c0810f90cbf151a2ecb48 blob 21039
"""A02 in-memory synthetic target and executor with independent readback.

No platform, browser, network, content recognition, persistence or reconciliation.
Keep the SAME instance alive for the whole simulation; a new process is A03's gap.
"""
import copy
import hashlib
import json
from pathlib import Path

from annotation.contracts import (
    artifact_ref, assert_plan_ready, content_digest, seal_artifact, validate_bundle,
)
from annotation.delivery.planner import encoded, frame_facts, verify_generated_plan
from annotation.quality.targetcheck import (
    append_artifacts, coverage_for, make_artifact, reject, resolve_artifact,
)

FAULTS = {"applied", "not_applied", "lost_response", "response_lost_readable",
          "readback_failure", "contradictory", "partial"}


class MockSession:
    """One serial writer; defensive-copy reads, append-only in-session history.

    UNKNOWN locks are keyed by book, independent of run/scope/question/action IDs.
    No unlock/reset/history-removal API is provided. This is not a crash-safe store.
    """

    def __init__(self):
        self._targets = {}
        self._log = []
        self._history = {}
        self._pending = set()
        self._used_plans = set()
        self._used_actions = set()
        self._serial = 0

    @property
    def action_log(self):
        return tuple(copy.deepcopy(self._log))

    def receipt_history(self, book_id):
        """Full immutable-by-copy bundles, including unresolved receipts and evidence refs."""
        return tuple(copy.deepcopy(self._history.get(book_id, [])))

    def is_paused(self, book_id):
        return book_id in self._pending or any(
            a["kind"] == "ExecutionReceipt" and a["book_id"] == book_id
            and any(r["outcome"] == "UNKNOWN" for r in a["payload"]["results"])
            for b in self._history.get(book_id, []) for a in b["artifacts"])

    def register_target(self, bundle, snapshot_ref, *, asset_root, source_ref=None):
        bundle = validate_bundle(bundle, asset_root=asset_root)
        snapshot = resolve_artifact(bundle, snapshot_ref, "PlatformSnapshot")
        if snapshot.producer.evidence_mode != "SYNTHETIC":
            reject("SYNTHETIC_ONLY", "mock target requires SYNTHETIC snapshot")
        if snapshot.book_id in self._targets:
            reject("TARGET_ALREADY_REGISTERED", "cannot replace target state or clear book history")
        if source_ref is None:
            sources = [a for a in bundle.artifacts if a.kind == "SourceBundle" and
                       a.book_id == snapshot.book_id and a.scope_id == snapshot.scope_id]
            if len(sources) != 1:
                reject("SOURCE_BINDING", "mock snapshot needs an explicit unambiguous image SourceBundle")
            source_ref = artifact_ref(sources[0])
        else:
            source_ref = artifact_ref(resolve_artifact(bundle, source_ref, "SourceBundle"))
        self._targets[snapshot.book_id] = {"base": snapshot.model_dump(mode="json"),
                                           "payload": snapshot.payload.model_dump(mode="json"),
                                           "source_ref": source_ref, "epoch": 0, "bindings": {}, "projections": {}}

    def _target(self, book_id):
        if book_id not in self._targets:
            reject("TARGET_NOT_REGISTERED", "register this synthetic book's snapshot first")
        return self._targets[book_id]

    def read_target(self, book_id):
        """Read target facts independently of execute() responses and planned expectations."""
        target = self._target(book_id)
        return copy.deepcopy({"provenance": "SYNTHETIC", "execution_mode": "SIMULATED",
                              "book_id": book_id, "epoch": target["epoch"],
                              "target": target["payload"], "internal_bindings": target["bindings"],
                              "frame_projections": target["projections"]})

    def read_snapshot(self, book_id):
        target = self._target(book_id)
        data = copy.deepcopy(target["base"])
        if not target["epoch"]:
            return data
        data["revision"] += target["epoch"]
        data["payload"] = copy.deepcopy(target["payload"])
        data["payload"]["observed_hash"] = content_digest(self.read_target(book_id))
        data["payload"]["observed_version"] = "a02-mock-epoch-" + str(target["epoch"])
        data["producer"].update(module="a02-mock", implementation_version="a02-1")
        data["input_refs"] = [r for r in data["input_refs"] if r["kind"] != "SourceBundle"] + [target["source_ref"]]
        return seal_artifact(data)

    def inject_external_change(self, book_id, *, platform_version=None):
        """Explicit synthetic outside-actor fault; never used to resolve a paused book."""
        target = self._target(book_id)
        if platform_version is not None:
            target["payload"]["platform_version"] = platform_version
        target["epoch"] += 1
        self._log.append({"event": "external_change", "book_id": book_id, "epoch": target["epoch"]})

    def _facts(self, action, view):
        before = action.expected_before
        directory = before["directory_id"]
        pid = action.target.platform_question_id
        if pid is None:
            pid = view["internal_bindings"].get(action.target.question_id)
        question = next((q for q in view["target"]["questions"] if q["platform_question_id"] == pid), None)
        frames = [f for f in view["target"]["frames"] if f["platform_question_id"] == pid] if question else []
        facts = {"question_exists": question is not None, "platform_question_id": pid,
                 "directory_id": question["directory_id"] if question else directory,
                 "frame_count": len(frames), "frames_hash": frame_facts(frames)}
        if "platform_order" in before:
            facts["platform_order"] = question["platform_order"] if question else None
        if "next_order" in before:
            facts["next_order"] = max([q["platform_order"] for q in view["target"]["questions"]
                                       if q["directory_id"] == directory] + [0]) + 1
        return facts

    def _write(self, book_id, action, partial=False):
        target = self._target(book_id)
        payload = target["payload"]
        pid = action.target.platform_question_id
        if pid is None:
            number = len(payload["questions"]) + 1
            existing = {q["platform_question_id"] for q in payload["questions"]}
            while "mock-question-" + str(number) in existing:
                number += 1
            pid = "mock-question-" + str(number)
            directory = action.expected_before["directory_id"]
            order = max([q["platform_order"] for q in payload["questions"] if q["directory_id"] == directory] + [0]) + 1
            payload["questions"].append({"platform_question_id": pid, "directory_id": directory, "platform_order": order})
        target["bindings"][action.target.question_id] = pid
        projected = json.loads(action.expected_after["frames"])
        if partial:
            projected = projected[:-1]
        for frame in projected:
            number = len(payload["frames"]) + 1
            existing = {f["platform_frame_id"] for f in payload["frames"]}
            while "mock-frame-" + str(number) in existing:
                number += 1
            fid = "mock-frame-" + str(number)
            payload["frames"].append({"platform_frame_id": fid, "platform_question_id": pid,
                                      "box": frame["box"], "platform_role": frame["platform_role"]})
            target["projections"][fid] = copy.deepcopy(frame)
        target["epoch"] += 1
        return {"status": "OK", "platform_question_id": pid}

    def _compare(self, action, before, readback):
        """Only evidence comparisons determine outcomes; response status is not an input."""
        if readback.get("read_status") != "OK":
            return "UNKNOWN", [], "readback unavailable or contradictory"
        after = readback["view"]
        pid = action.target.platform_question_id or after["internal_bindings"].get(action.target.question_id)
        question = next((q for q in after["target"]["questions"] if q["platform_question_id"] == pid), None)
        frames = [f for f in after["target"]["frames"] if f["platform_question_id"] == pid] if question else []
        projected = [after["frame_projections"].get(f["platform_frame_id"]) for f in frames]
        expected = action.expected_after
        if (question and question["directory_id"] == expected["directory_id"] and
                question["platform_order"] == expected["platform_order"] and
                encoded(projected) == expected["frames"] and frames and
                all(f["box"] == p["box"] and f["platform_role"] == p["platform_role"]
                    for f, p in zip(frames, projected))):
            return "APPLIED", [pid] + [f["platform_frame_id"] for f in frames], "independent target readback matches all projected frames"
        # A conclusive absence needs BOTH a known pre-state and an unchanged relevant target.
        facts_before, facts_after = self._facts(action, before), self._facts(action, after)
        if (facts_after == facts_before and
                facts_after["frame_count"] == 0):
            return "NOT_APPLIED", [], "explicit readback proves projected frames ABSENT and relevant target unchanged"
        return "UNKNOWN", [], "effect is partial, changed, or lacks a provable ABSENT baseline"

    def execute(self, bundle, plan_ref, config, *, asset_root, receipt_id, created_at, faults=None):
        """Execute once and return a validated bundle with a calculated receipt.

        lost_response = mutation plus unavailable readback (UNKNOWN).
        response_lost_readable = mutation plus lost response, complete readback (APPLIED).
        Remaining actions after a non-APPLIED result are read but never dispatched.
        """
        bundle = validate_bundle(bundle, asset_root=asset_root)
        plan = resolve_artifact(bundle, plan_ref, "ApplyPlan")
        book = plan.book_id
        if self.is_paused(book):
            reject("BOOK_WRITE_PAUSED", "same-book UNKNOWN/pending intent retained; A03 reconciliation interface required")
        plan_key = (book, plan.artifact_id, plan.revision)
        if plan_key in self._used_plans:
            reject("REPLAY_FORBIDDEN", "old plan was already attempted; recheck target and generate a new plan")
        faults = dict(faults or {})
        action_ids = {a.action_id for a in plan.payload.actions}
        if set(faults) - action_ids or any(f not in FAULTS for f in faults.values()):
            reject("INVALID_FAULT", "unknown action ID or unsupported synthetic fault")
        if any((book, a.action_id) in self._used_actions for a in plan.payload.actions):
            reject("REPLAY_FORBIDDEN", "an action ID in this book was already attempted")
        if any(a.artifact_id == receipt_id for a in bundle.artifacts):
            reject("DUPLICATE_ID", "receipt identity already exists")
        if plan.payload.readiness == "BLOCKED":
            receipt = make_artifact("ExecutionReceipt", receipt_id, plan,
                                    {"plan": artifact_ref(plan), "execution_mode": "NOT_EXECUTED", "results": [],
                                     "unresolved_issue_ids": plan.payload.blocked_issue_ids, "write_disposition": "NOT_EXECUTED"},
                                    [plan], config.version, "a02-mock", created_at)
            output = append_artifacts(bundle, receipt, asset_root=asset_root)
            self._history.setdefault(book, []).append(output.model_dump(mode="json"))
            self._used_plans.add(plan_key)
            return output
        current = self.read_snapshot(book)
        if not any(artifact_ref(a) == artifact_ref(current) for a in bundle.artifacts):
            bundle = append_artifacts(bundle, current, asset_root=asset_root)
        assert_plan_ready(bundle, artifact_ref(plan), artifact_ref(current))
        verify_generated_plan(bundle, plan, artifact_ref(current), config)
        self._used_plans.add(plan_key)
        self._used_actions.update((book, a.action_id) for a in plan.payload.actions)
        self._pending.add(book)  # Any exception after this point closes the in-session write gate.
        self._serial += 1
        serial = self._serial
        root = Path(asset_root)
        results, new_records, generated_issues = [], [], []
        stopped = False

        def record(label, value):
            # Immutable content-addressed bytes: same names may be safely referenced, never overwritten.
            raw = (json.dumps(value, ensure_ascii=False, sort_keys=True, indent=2, allow_nan=False) + "\n").encode("utf-8")
            digest = hashlib.sha256(raw).hexdigest()
            relative = "assets/a02-" + digest + ".json"
            path = root / relative
            try:
                path.resolve().relative_to(root.resolve())
            except ValueError:
                reject("EVIDENCE_PATH", "evidence path resolves outside exchange root")
            path.parent.mkdir(parents=True, exist_ok=True)
            try:
                with path.open("xb") as handle:
                    handle.write(raw)
            except FileExistsError:
                if path.read_bytes() != raw:
                    reject("EVIDENCE_CONFLICT", "immutable evidence resource differs")
            identity = "proof-a02-" + str(serial) + "-" + label
            if any(e.evidence_id == identity for e in bundle.evidence):
                reject("DUPLICATE_ID", "evidence ID already exists; use one serial MockSession")
            resource = {"path": relative, "sha256": digest, "media_type": "application/json"}
            new_records.append({"evidence_id": identity, "resource": resource,
                                "description": "SYNTHETIC / SIMULATED independently captured " + label, "mode": "SYNTHETIC"})
            return identity, resource

        for index, action in enumerate(plan.payload.actions):
            before = self.read_target(book)
            before_id, _ = record(str(index) + "-before", before)
            fault = faults.get(action.action_id, "applied")
            precondition = self._facts(action, before) == action.expected_before
            dispatched = not stopped and precondition
            response = {"status": "NOT_DISPATCHED", "reason": "earlier action requires recheck/reconciliation" if stopped else "precondition mismatch"}
            if dispatched:
                self._used_actions.add((book, action.action_id))
                self._log.append({"event": "intent", "book_id": book, "plan": artifact_ref(plan),
                                  "action": action.model_dump(mode="json"), "before_evidence": before_id})
                response = {"status": "REJECTED"} if fault == "not_applied" else self._write(book, action, fault == "partial")
                if fault in ("lost_response", "response_lost_readable"):
                    response = {"status": "TIMEOUT"}
                self._log.append({"event": "response", "book_id": book, "action_id": action.action_id, "response": response})
            actual = self.read_target(book)
            readback = {"provenance": "SYNTHETIC", "execution_mode": "SIMULATED", "read_status": "OK", "view": actual}
            if dispatched and fault in ("lost_response", "readback_failure"):
                readback = {"provenance": "SYNTHETIC", "execution_mode": "SIMULATED", "read_status": "UNAVAILABLE"}
            elif dispatched and fault == "contradictory":
                alternate = copy.deepcopy(actual)
                alternate["target"]["frames"] = alternate["target"]["frames"][:-1]
                readback.update(read_status="CONTRADICTORY", second_view=alternate)
            after_id, resource = record(str(index) + "-readback", readback)
            outcome, ids, reason = self._compare(action, before, readback)
            # Precondition/dependency failures never gain APPLIED from unrelated state.
            if not dispatched and outcome == "APPLIED":
                outcome, ids, reason = "UNKNOWN", [], "not dispatched but effect already present; reconcile ownership"
            self._log.append({"event": "readback", "book_id": book, "action_id": action.action_id,
                              "dispatched": dispatched, "readback_evidence": after_id, "outcome": outcome})
            stopped = stopped or outcome != "APPLIED"
            if outcome == "UNKNOWN":
                generated_issues.append({"issue_id": "issue-a02-save-" + receipt_id + "-" + str(index),
                                         "code": "SAVE_UNKNOWN", "scope_type": "action", "scope_id": action.action_id,
                                         "evidence_refs": [before_id, after_id], "severity": "blocking", "blocks": ["APPLY", "COMPLETE"],
                                         "suggested_strategy": {"strategy_id": "RECONCILE", "max_attempts": 0, "max_cost": 0.0},
                                         "reason": reason + "; no ReconciliationResult in C01/A02; book remains paused"})
            results.append({"action_id": action.action_id, "outcome": outcome, "platform_ids": ids,
                            "before_evidence_refs": [before_id], "after_evidence_refs": [after_id], "readback": resource,
                            "effect_match": {"APPLIED": "MATCH", "NOT_APPLIED": "ABSENT", "UNKNOWN": "INDETERMINATE"}[outcome],
                            "next_step": {"APPLIED": "POSTCHECK", "NOT_APPLIED": "RECHECK_TARGET", "UNKNOWN": "RECONCILE"}[outcome],
                            "replay_allowed": False, "reason": reason})
        data = bundle.model_dump(mode="json")
        data["evidence"].extend(new_records)
        dependencies = [plan]
        # C01 stores Issue objects in CheckReport. This comparison report does NOT certify final content.
        if generated_issues:
            graph = resolve_artifact(bundle, plan.payload.graph, "QuestionGraph")
            coverage, _ = coverage_for(bundle, graph)
            comparison = make_artifact("CheckReport", "comparison-" + receipt_id, plan,
                                       {"stage": "POST_APPLY", "subject": {"artifact_id": receipt_id, "revision": 1,
                                        "kind": "ExecutionReceipt", "content_hash": "0" * 64},
                                        "graph": artifact_ref(graph), "policy": plan.payload.policy.model_dump(mode="json"),
                                        "snapshot": None, "receipt": {"artifact_id": receipt_id, "revision": 1,
                                        "kind": "ExecutionReceipt", "content_hash": "0" * 64},
                                        "coverage": coverage, "checks": [
                                            {"check_id": "frame_structure", "outcome": "UNAVAILABLE", "evidence_refs": [new_records[-1]["evidence_id"]],
                                             "reason": "SYNTHETIC readback cannot confirm every planned effect"},
                                            {"check_id": "final_content", "outcome": "UNAVAILABLE", "evidence_refs": [new_records[-1]["evidence_id"]],
                                             "reason": "A02 has no OCR/final-content checker"}],
                                        "issues": generated_issues, "decision": "HOLD", "reason": "SIMULATED unknown-effect comparison; no quality acceptance"},
                                       [plan, graph], config.version, "a02-mock-comparison", created_at)
        outcomes = {r["outcome"] for r in results}
        disposition = "PAUSE_RECONCILE" if "UNKNOWN" in outcomes else "RECHECK_TARGET" if "NOT_APPLIED" in outcomes else "POSTCHECK"
        receipt = make_artifact("ExecutionReceipt", receipt_id, plan,
                                {"plan": artifact_ref(plan), "execution_mode": "SIMULATED", "results": results,
                                 "unresolved_issue_ids": [i["issue_id"] for i in generated_issues], "write_disposition": disposition},
                                dependencies, config.version, "a02-mock", created_at)
        data["artifacts"].append(receipt)
        if generated_issues:
            # Build the report AFTER the receipt, avoiding an artificial cyclic dependency.
            comparison["payload"]["subject"] = artifact_ref(receipt)
            comparison["payload"]["receipt"] = artifact_ref(receipt)
            comparison["input_refs"].append(artifact_ref(receipt))
            data["artifacts"].append(seal_artifact(comparison))
        output = validate_bundle(data, asset_root=asset_root)
        self._history.setdefault(book, []).append(output.model_dump(mode="json"))
        self._log.append({"event": "receipt", "book_id": book, "receipt": artifact_ref(receipt),
                          "write_disposition": disposition})
        if disposition != "PAUSE_RECONCILE":
            self._pending.discard(book)
        return output

59c106548f4a276b4d6f3d60bd1c7ad12d32bc39 blob 7879
"""A02 pure planner. No filesystem, session mutation, browser or model access."""
import json

from annotation.contracts import (
    artifact_ref, assert_plan_ready, content_digest, policy_ref, validate_bundle,
)
from annotation.quality.targetcheck import (
    analyze_target, append_artifacts, make_artifact, projection_frames, reject,
    resolve_artifact, resolve_policy,
)


def encoded(value):
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)


def frame_facts(frames):
    return content_digest({"frames": frames})


def create_plan(bundle, graph_ref, precheck_ref, targetcheck_ref, snapshot_ref,
                current_snapshot_ref, policy_reference, config, *, artifact_id,
                created_at, run_id=None, operation="CREATE_FRAMES", previous_receipt=None):
    """Return a new validated bundle. Invalid/missing bindings raise ContractError.

    A valid failed-check chain yields a BLOCKED diagnostic plan with no actions.
    UPDATE is explicitly unsupported, including when a C01 baseline is provided.
    """
    bundle = validate_bundle(bundle)
    graph = resolve_artifact(bundle, graph_ref, "QuestionGraph")
    pre = resolve_artifact(bundle, precheck_ref, "CheckReport")
    target = resolve_artifact(bundle, targetcheck_ref, "CheckReport")
    snapshot = resolve_artifact(bundle, snapshot_ref, "PlatformSnapshot")
    current = resolve_artifact(bundle, current_snapshot_ref, "PlatformSnapshot")
    policy = resolve_policy(bundle, policy_reference)
    if operation != "CREATE_FRAMES" or previous_receipt is not None:
        reject("UPDATE_UNSUPPORTED", "A02 supports no delta shape; need old APPLIED receipt, frame_update and future implementation")
    if pre.payload.stage != "PRE_APPLY" or target.payload.stage != "TARGET":
        reject("TWO_CHECK_STAGES", "distinct PRE_APPLY and TARGET required")
    for report in (pre, target):
        if artifact_ref(graph) != report.payload.graph.model_dump(mode="json") or policy_ref(policy) != report.payload.policy.model_dump(mode="json"):
            reject("VERSION_CONFLICT", "report graph/policy differs from requested plan")
        if report.payload.snapshot is not None and report.payload.snapshot.model_dump(mode="json") != artifact_ref(snapshot):
            reject("TARGET_CHANGED", "report binds a different snapshot")
    if artifact_ref(snapshot) != artifact_ref(current):
        reject("TARGET_CHANGED", "explicit current snapshot changed; recheck target")
    if snapshot.payload.authorized_scope_id != graph.scope_id:
        reject("AUTHORIZED_SCOPE", "snapshot authorization differs; diagnostic plan not representable in C01")
    computed = analyze_target(bundle, graph_ref, snapshot_ref, current_snapshot_ref, policy_reference, config)
    if (target.producer.module != "a02-targetcheck" or target.producer.config_version != config.version or
            target.payload.model_dump(mode="json") != computed):
        reject("TARGET_CHECK_STALE", "target report does not equal recomputed conditions/current authorization")
    ready = pre.payload.decision == target.payload.decision == "PASS"
    actions = []
    required = ["frame_readback", "persistent_draft" if config.session_mode == "PERSISTENT" else "same_session_handoff"]
    if ready:
        platform = {q.platform_question_id: q for q in snapshot.payload.questions}
        next_orders = {d: max([q.platform_order for q in snapshot.payload.questions if q.directory_id == d] + [0]) + 1
                       for d in snapshot.payload.directories}
        for question in graph.payload.questions:
            qid = question.question_id
            pid = question.external_refs.platform_question_id
            directory = config.directory_map[question.directory_id]
            existing = platform.get(pid)
            order = existing.platform_order if existing else next_orders[directory]
            frames = [f.model_dump(mode="json") for f in snapshot.payload.frames if f.platform_question_id == pid] if existing else []
            before = {"question_exists": existing is not None, "platform_question_id": pid,
                      "directory_id": directory, "frame_count": len(frames), "frames_hash": frame_facts(frames)}
            if existing:
                before["platform_order"] = order
            else:
                before["next_order"] = order
                next_orders[directory] += 1
            projected = projection_frames(bundle, graph, question, policy)
            if not projected:
                reject("EMPTY_PROJECTION", "question has no frame projection: " + qid)
            action_id = "action-a02-" + content_digest({"plan_id": artifact_id, "question_id": qid,
                                                        "graph": artifact_ref(graph), "snapshot": artifact_ref(snapshot)})[:32]
            actions.append({"action_id": action_id,
                            "target": {"target_id": snapshot.payload.target_id, "question_id": qid, "platform_question_id": pid},
                            "source_entity_ids": [qid] + list(dict.fromkeys(f["fragment_id"] for f in projected)),
                            "expected_before": before, "operation": "CREATE_FRAMES",
                            "expected_after": {"question_exists": True, "directory_id": directory,
                                               "platform_order": order, "frames": encoded(projected)},
                            "depends_on": [actions[-1]["action_id"]] if actions else []})
    issues = [i.issue_id for report in (pre, target) for i in report.payload.issues if i.blocks]
    payload = {"graph": artifact_ref(graph), "precheck": artifact_ref(pre), "targetcheck": artifact_ref(target),
               "snapshot": artifact_ref(snapshot), "policy": policy_ref(policy),
               "readiness": "READY" if ready else "BLOCKED", "execution_mode": "SIMULATED",
               "session_mode": config.session_mode, "required_capabilities": required, "actions": actions,
               "blocked_issue_ids": list(dict.fromkeys(issues)), "previous_receipt": None, "final_submission": "HUMAN_ONLY"}
    plan = make_artifact("ApplyPlan", artifact_id, graph, payload, [graph, pre, target, snapshot],
                         config.version, "a02-planner", created_at, run_id)
    output = append_artifacts(bundle, plan)
    if ready:
        assert_plan_ready(output, artifact_ref(plan), artifact_ref(current))
    return output


def verify_generated_plan(bundle, plan, current_ref, config):
    """Recompute supported projection/facts before mock dispatch; refuse edited actions."""
    payload = plan.payload
    if plan.producer.config_version != config.version:
        reject("AUTHORIZATION_CHANGED", "current authorization/config differs from planned version")
    # Rebuild without this plan or its descendants; retain upstream history so UNKNOWN stays visible.
    data = bundle.model_dump(mode="json")
    remove = {(plan.artifact_id, plan.revision)}
    while True:
        previous_count = len(remove)
        for item in data["artifacts"]:
            if any((r["artifact_id"], r["revision"]) in remove for r in item["input_refs"]):
                remove.add((item["artifact_id"], item["revision"]))
        if len(remove) == previous_count:
            break
    data["artifacts"] = [a for a in data["artifacts"] if (a["artifact_id"], a["revision"]) not in remove]
    upstream = validate_bundle(data)
    generated = create_plan(upstream, payload.graph, payload.precheck, payload.targetcheck,
                            payload.snapshot, current_ref, payload.policy, config,
                            artifact_id=plan.artifact_id, created_at=plan.created_at, run_id=plan.run_id)
    rebuilt = generated.artifacts[-1]
    if rebuilt != plan:
        reject("PLAN_CHANGED", "plan does not equal generated supported projection")

8d22ce9d9777731793d056cd2b3503aafc1a1cad blob 10792
"""A-internal a01-geometry-1; continuous pixel boundaries, no browser semantics."""
import math
from dataclasses import dataclass
from fractions import Fraction
from typing import Optional, Tuple

from annotation.contracts import OriginalBox
from annotation.contracts.models import ImageBinding

SPEC_VERSION = "a01-geometry-1"
IMPLEMENTATION_VERSION = "a01-geometry-1-r1"
MAX_PIXEL_INTEGER = 2**53


class GeometryError(ValueError):
    def __init__(self, code, location, detail):
        self.code, self.location = code, location
        super().__init__("{}: [{}] {}".format(location, code, detail))


def _fail(code, location, detail):
    raise GeometryError(code, location, detail)


def _numbers(values, count, location):
    if not isinstance(values, (tuple, list)) or len(values) != count:
        _fail("SHAPE", location, "expected {} numbers".format(count))
    if any(isinstance(v, bool) or not isinstance(v, (int, float)) for v in values):
        _fail("NUMBER", location, "expected real numbers")
    if any(isinstance(v,int) and abs(v) > MAX_PIXEL_INTEGER for v in values):
        _fail("REPRESENTATION", location, "integer exceeds the exact pixel range 2**53")
    try:
        result = tuple(float(v) for v in values)
    except (ValueError, OverflowError):
        _fail("NONFINITE", location, "numbers must be finite")
    if not all(math.isfinite(v) for v in result):
        _fail("NONFINITE", location, "numbers must be finite")
    return result


def _binding(value):
    try:
        data = value.model_dump() if isinstance(value, ImageBinding) else value
        return ImageBinding.model_validate(data)
    except ValueError as error:
        _fail("IMAGE_BINDING", "image", str(error))


def _same(actual, expected):
    if _binding(actual) != expected:
        _fail("IMAGE_BINDING", "image", "asset_id, dimensions or digest differs")


def invert_affine(matrix):
    """Invert six affine coefficients (a,b,c,d,e,f); reject singular/nonfinite values.

    This is a math helper, not a declaration of support for arbitrary transforms.
    x'=a*x+b*y+c; y'=d*x+e*y+f.
    """
    a, b, c, d, e, f = _numbers(matrix, 6, "matrix")
    determinant = a * e - b * d
    if not math.isfinite(determinant) or determinant == 0:
        _fail("NONINVERTIBLE", "matrix", "finite nonzero determinant required")
    inverse = (e / determinant, -b / determinant, (b*f-e*c) / determinant,
               -d / determinant, a / determinant, (d*c-a*f) / determinant)
    if not all(math.isfinite(v) for v in inverse):
        _fail("NONINVERTIBLE", "matrix", "inverse cannot be represented finitely")
    return inverse


def _apply(matrix, point):
    a, b, c, d, e, f = matrix
    x, y = point
    return _numbers((a*x+b*y+c, d*x+e*y+f), 2, "result")


def _point(point, domain, location):
    x, y = _numbers(point, 2, location)
    left, top, right, bottom = domain
    if not (left <= x <= right and top <= y <= bottom):
        _fail("BOUNDS", location, "point outside declared content domain")
    return x, y


def _box(box, binding, domain):
    try:
        value = OriginalBox.model_validate(box.model_dump() if isinstance(box, OriginalBox) else box)
    except ValueError as error:
        _fail("BOX", "bbox", str(error))
    _same(value.image, binding)
    x1, y1, x2, y2 = value.bbox
    return [_point(p, domain, "bbox") for p in ((x1,y1),(x2,y1),(x2,y2),(x1,y2))]


@dataclass(frozen=True)
class Transform:
    image: ImageBinding
    crop: Optional[Tuple[float, float, float, float]] = None
    scale: Tuple[float, float] = (1.0, 1.0)
    padding: Tuple[int, int, int, int] = (0, 0, 0, 0)
    rotation_degrees: int = 0
    spec_version: str = SPEC_VERSION

    def __post_init__(self):
        image = _binding(self.image)
        if max(image.width,image.height) > MAX_PIXEL_INTEGER:
            _fail("REPRESENTATION", "image", "image dimensions exceed 2**53")
        object.__setattr__(self, "image", image)
        if self.spec_version != SPEC_VERSION:
            _fail("SPEC_VERSION", "spec_version", "explicit a01-geometry-1 required")
        crop = _numbers(self.crop if self.crop is not None else (0,0,image.width,image.height), 4, "crop")
        x1, y1, x2, y2 = crop
        if not (0 <= x1 < x2 <= image.width and 0 <= y1 < y2 <= image.height):
            _fail("BOUNDS", "crop", "positive area within original required")
        scale = _numbers(self.scale, 2, "scale")
        if min(scale) <= 0:
            _fail("UNSUPPORTED_SCALE", "scale", "positive x/y scales required; no reflection")
        padding = _numbers(self.padding, 4, "padding")
        if any(p < 0 or not p.is_integer() for p in padding):
            _fail("PADDING", "padding", "nonnegative integer processing pixels required")
        if any(p > MAX_PIXEL_INTEGER for p in padding):
            _fail("REPRESENTATION", "padding", "padding exceeds the exact pixel range 2**53")
        degrees = self.rotation_degrees
        if isinstance(degrees, bool) or not isinstance(degrees, int) or degrees % 90:
            _fail("UNSUPPORTED_ROTATION", "rotation_degrees", "integer multiples of 90 required")
        object.__setattr__(self, "crop", crop)
        object.__setattr__(self, "scale", scale)
        object.__setattr__(self, "padding", tuple(int(p) for p in padding))
        object.__setattr__(self, "rotation_degrees", degrees % 360)
        # Validate dimensions and numerical invertibility before accepting the transform.
        self.output_size
        invert_affine(self.matrix)

    @classmethod
    def from_contract_crop_transform(cls, *args, **kwargs):
        _fail("AMBIGUOUS_SPEC", "crop_transform", "C01 fields do not name offset/rotation/order semantics; use explicit Transform")

    @property
    def padded_size(self):
        x1, y1, x2, y2 = self.crop
        sx, sy = self.scale
        sizes = _numbers(((x2-x1)*sx, (y2-y1)*sy), 2, "scaled_size")
        if any(v <= 0 or not v.is_integer() for v in sizes):
            _fail("DIMENSIONS", "scaled_size", "positive integer pixel dimensions required")
        left, top, right, bottom = self.padding
        width, height = int(sizes[0])+left+right, int(sizes[1])+top+bottom
        if max(width,height) > MAX_PIXEL_INTEGER:
            _fail("REPRESENTATION", "padded_size", "canvas dimensions exceed 2**53")
        _numbers((width,height), 2, "padded_size")
        return width, height

    @property
    def content_bounds(self):
        """Exact integer processing domain, checked BEFORE any inverse arithmetic."""
        left,top,right,bottom = self.padding
        width,height = self.padded_size
        right,bottom = width-right,height-bottom
        if self.rotation_degrees == 90:
            return height-bottom,left,height-top,right
        if self.rotation_degrees == 180:
            return width-right,height-bottom,width-left,height-top
        if self.rotation_degrees == 270:
            return top,width-right,bottom,width-left
        return left,top,right,bottom

    def _rotate(self, point, inverse=False):
        x,y = point
        width,height = self.padded_size
        if self.rotation_degrees == 90:
            return (y,height-x) if inverse else (height-y,x)
        if self.rotation_degrees == 180:
            return width-x,height-y
        if self.rotation_degrees == 270:
            return (width-y,x) if inverse else (y,width-x)
        return x,y

    @property
    def output_size(self):
        width, height = self.padded_size
        return (height,width) if self.rotation_degrees in (90,270) else (width,height)

    @property
    def matrix(self):
        x1, y1, _, _ = self.crop
        sx, sy = self.scale
        left, top, _, _ = self.padding
        c, f = left-sx*x1, top-sy*y1
        width, height = self.padded_size
        if self.rotation_degrees == 0:
            matrix = (sx,0,c,0,sy,f)
        elif self.rotation_degrees == 90:
            matrix = (0,-sy,height-f,sx,0,c)
        elif self.rotation_degrees == 180:
            matrix = (-sx,0,width-c,0,-sy,height-f)
        else:
            matrix = (0,sy,f,-sx,0,width-c)
        return _numbers(matrix, 6, "matrix")

    def processed_binding(self, asset_id, sha256):
        width, height = self.output_size
        return _binding(dict(asset_id=asset_id, width=width, height=height, sha256=sha256))

    def _processed(self, binding):
        value = _binding(binding)
        if (value.width,value.height) != self.output_size:
            _fail("IMAGE_BINDING", "processed_image", "processed dimensions differ")
        return value

    def forward_point(self, point, image):
        _same(image, self.image)
        x,y = _point(point,self.crop,"point")
        left,top,_,_ = self.crop
        sx,sy = self.scale
        pad_left,pad_top,_,_ = self.padding
        # Execute the declared order. Expanding sx*x - sx*left loses endpoints.
        scaled = ((x-left)*sx+pad_left,(y-top)*sy+pad_top)
        return _point(self._rotate(scaled),self.content_bounds,"processed_point")

    def inverse_point(self, point, processed_image, expected_processed_image):
        binding = self._processed(expected_processed_image)
        _same(processed_image, binding)
        point = _point(point,self.content_bounds,"processed_point")
        x,y = self._rotate(point,inverse=True)
        left,top,right,bottom = self.padding
        width,height = self.padded_size
        x1,y1,x2,y2 = self.crop
        def unscale(value,pad,extent,start,end):
            # Equivalent affine interval interpolation using the already
            # validated pixel extents. Exact rational operations keep endpoints
            # and their interior ordered; one final float conversion, no clamp.
            ratio = (Fraction(value)-pad)/(extent-pad)
            return float(Fraction(start)*(1-ratio)+Fraction(end)*ratio)
        original = (unscale(x,left,width-right,x1,x2),unscale(y,top,height-bottom,y1,y2))
        return _point(original,self.crop,"original_point")

    def forward_box(self, box, processed_image):
        binding = self._processed(processed_image)
        corners = _box(box, self.image, self.crop)
        return self._envelope([self.forward_point(p,self.image) for p in corners], binding)

    def inverse_box(self, box, expected_processed_image):
        binding = self._processed(expected_processed_image)
        corners = _box(box, binding, self.content_bounds)
        return self._envelope([self.inverse_point(p,binding,binding) for p in corners], self.image)

    @staticmethod
    def _envelope(corners, image):
        xs, ys = zip(*corners)
        return OriginalBox(image=image, bbox=[min(xs),min(ys),max(xs),max(ys)])


__all__ = ["Transform", "GeometryError", "ImageBinding", "OriginalBox", "invert_affine", "SPEC_VERSION", "IMPLEMENTATION_VERSION"]

a281f845ceb324459a142a62280114b2837742c8 blob 14211
"""A02 target checks. Pure, synthetic-only; no target mutation or I/O."""
from dataclasses import asdict, dataclass
from typing import Dict, Tuple

from annotation.contracts import (
    ContractError, artifact_ref, content_digest, policy_ref, seal_artifact,
    validate_bundle,
)

VERSION = "a02-1"


@dataclass(frozen=True)
class SimulationConfig:
    """Local simulation authorization, not an extension of the C01 contract.

    Directory namespaces are connected explicitly here, never by string equality.
    The entire configuration is bound by CheckReport/ApplyPlan producer.config_version.
    """
    book_id: str
    target_id: str
    scope_id: str
    directory_map: Dict[str, str]
    session_mode: str = "SAME_SESSION_HANDOFF"
    allowed_operations: Tuple[str, ...] = ("CREATE_FRAMES",)

    @property
    def version(self):
        return "a02-config-" + content_digest(asdict(self))


def reject(code, message, path="$.a02"):
    raise ContractError([{"path": path, "code": code, "message": message}])


def resolve_artifact(bundle, reference, kind=None):
    ref = reference.model_dump(mode="json") if hasattr(reference, "model_dump") else reference
    for item in bundle.artifacts:
        if artifact_ref(item) == ref and (kind is None or item.kind == kind):
            return item
    reject("MISSING_REFERENCE", "exact artifact reference not found: " + str(ref))


def resolve_policy(bundle, reference):
    ref = reference.model_dump(mode="json") if hasattr(reference, "model_dump") else reference
    for item in bundle.policies:
        if policy_ref(item) == ref:
            return item
    reject("POLICY_CONFLICT", "exact policy reference not found")


def make_artifact(kind, identity, anchor, payload, dependencies, config_version,
                  module, created_at, run_id=None):
    """Seal using C01's single structural authority; no local contract definitions."""
    refs = [artifact_ref(item) for item in dependencies]
    refs = list({(r["artifact_id"], r["revision"]): r for r in refs}.values())
    policies = [payload["policy"]] if "policy" in payload else [
        p.model_dump(mode="json") for p in anchor.producer.policy_versions]
    return seal_artifact({
        "schema_version": anchor.schema_version, "artifact_id": identity,
        "revision": 1, "kind": kind, "run_id": run_id or anchor.run_id,
        "book_id": anchor.book_id, "scope_id": anchor.scope_id, "input_refs": refs,
        "producer": {"module": module, "implementation_version": VERSION,
                     "config_version": config_version, "policy_versions": policies,
                     "model_version": None, "prompt_version": None,
                     "evidence_mode": "SYNTHETIC"},
        "created_at": created_at, "payload": payload,
    })


def append_artifacts(bundle, *artifacts, asset_root=None):
    data = bundle.model_dump(mode="json")
    data["artifacts"].extend(artifacts)
    return validate_bundle(data, asset_root=asset_root)


def coverage_for(bundle, graph):
    source = resolve_artifact(bundle, graph.payload.source, "SourceBundle")
    evidence = resolve_artifact(bundle, graph.payload.evidence, "EvidenceBundle")
    owned = {f for q in graph.payload.questions for f in q.fragment_ids + q.shared_fragment_ids}
    owned.update(f for r in graph.payload.answer_relations for f in r.selected_fragment_ids)
    assigned = {r for f in graph.payload.fragments if f.fragment_id in owned for r in f.region_ids}
    unassigned = {r for c in evidence.payload.coverage_clues if c.disposition == "UNASSIGNED"
                  for r in c.region_ids}
    unassigned.update(r.region_id for r in evidence.payload.regions if r.region_id not in assigned)
    coverage = {"scope_id": graph.scope_id, "pages_expected": source.payload.pages_expected,
                "pages_checked": source.payload.pages_acquired,
                "clue_ids": [c.clue_id for c in evidence.payload.coverage_clues],
                "unassigned_region_ids": sorted(unassigned)}
    complete = (set(source.payload.scope_manifest) == {q.question_id for q in graph.payload.questions}
                and set(source.payload.pages_expected) == set(source.payload.pages_acquired)
                and not unassigned
                and all(c.disposition != "UNASSIGNED" for c in evidence.payload.coverage_clues))
    return coverage, complete


def projection_frames(bundle, graph, question, policy):
    """Project owned/selected original regions; never select candidate answers by label."""
    evidence = resolve_artifact(bundle, graph.payload.evidence, "EvidenceBundle")
    regions = {r.region_id: r for r in evidence.payload.regions}
    selected = {f for rel in graph.payload.answer_relations if rel.question_id == question.question_id
                for f in rel.selected_fragment_ids}
    direct = set(question.fragment_ids + question.shared_fragment_ids)
    fragments = [f for f in graph.payload.fragments
                 if (f.fragment_id in selected or
                     (f.fragment_id in direct and f.role not in ("answer", "explanation")))]
    frames = []
    for fragment in sorted(fragments, key=lambda f: (f.reading_order, f.fragment_id)):
        for region_id in fragment.region_ids:
            region = regions[region_id]
            frames.append({"fragment_id": fragment.fragment_id, "region_id": region_id,
                           "box": region.box.model_dump(mode="json"),
                           "platform_role": policy.role_mapping[fragment.role],
                           "platform_type": "text" if fragment.content_type == "formula" else fragment.content_type})
    return frames


def analyze_target(bundle, graph_ref, snapshot_ref, current_snapshot_ref, policy_reference, config):
    """Compute TARGET payload from facts, independent of any input CheckReport decision."""
    bundle = validate_bundle(bundle)
    graph = resolve_artifact(bundle, graph_ref, "QuestionGraph")
    snapshot = resolve_artifact(bundle, snapshot_ref, "PlatformSnapshot")
    current = resolve_artifact(bundle, current_snapshot_ref, "PlatformSnapshot")
    policy = resolve_policy(bundle, policy_reference)
    source = resolve_artifact(bundle, graph.payload.source, "SourceBundle")
    evidence = resolve_artifact(bundle, graph.payload.evidence, "EvidenceBundle")
    proof = list(snapshot.payload.evidence_refs)
    coverage, complete = coverage_for(bundle, graph)
    checks, issues = [], []
    token = content_digest({"graph": artifact_ref(graph), "snapshot": artifact_ref(snapshot),
                            "current": artifact_ref(current), "config": config.version,
                            "policy": policy_ref(policy)})[:20]

    def check(name, problems, code, strategy="HUMAN_REVIEW"):
        checks.append({"check_id": name, "outcome": "FAIL" if problems else "PASS",
                       "evidence_refs": proof, "reason": "; ".join(problems) if problems else
                       "SYNTHETIC facts checked by A02: " + name})
        if problems:
            issues.append({"issue_id": "issue-a02-" + token + "-" + name,
                           "code": code, "scope_type": "scope", "scope_id": graph.scope_id,
                           "evidence_refs": proof, "severity": "blocking", "blocks": ["PLAN", "APPLY"],
                           "suggested_strategy": {"strategy_id": strategy, "max_attempts": 0, "max_cost": 0.0},
                           "reason": "; ".join(problems)})

    target_problems = []
    if artifact_ref(snapshot) != artifact_ref(current):
        target_problems.append("current snapshot revision/hash differs from checked snapshot")
    platform = {q.platform_question_id: q for q in snapshot.payload.questions}
    mapped = []
    for q in graph.payload.questions:
        ext = q.external_refs
        if ext.platform_question_id is not None:
            existing = platform.get(ext.platform_question_id)
            mapped.append(ext.platform_question_id)
            if not ext.platform_question_id or existing is None:
                target_problems.append(q.question_id + ": mapped platform question ID absent/empty")
            elif ext.platform_order is not None and ext.platform_order != existing.platform_order:
                target_problems.append(q.question_id + ": mapped platform order differs")
            elif config.directory_map.get(q.directory_id) != existing.directory_id:
                target_problems.append(q.question_id + ": explicit directory mapping differs")
        elif ext.platform_order is not None:
            target_problems.append(q.question_id + ": unmapped new question cannot claim an existing order")
    if len(set(mapped)) != len(mapped):
        target_problems.append("multiple internal questions share one platform ID; projection unsupported")
    if any(a.kind == "ExecutionReceipt" and a.book_id == graph.book_id and
           any(r.outcome == "UNKNOWN" for r in a.payload.results) for a in bundle.artifacts):
        target_problems.append("same book has unresolved UNKNOWN history; reconciliation interface missing")
    check("target_version", target_problems, "TARGET_CHANGED", "RECHECK_TARGET")

    auth_problems = []
    if (config.book_id != graph.book_id or config.book_id != snapshot.book_id or
            config.target_id != snapshot.payload.target_id or config.scope_id != graph.scope_id or
            config.scope_id != snapshot.scope_id or config.scope_id != snapshot.payload.authorized_scope_id):
        auth_problems.append("authorization book/target/scope differs from graph or snapshot")
    if "CREATE_FRAMES" not in config.allowed_operations:
        auth_problems.append("CREATE_FRAMES is not authorized")
    for q in graph.payload.questions:
        if config.directory_map.get(q.directory_id) not in snapshot.payload.directories:
            auth_problems.append(q.question_id + ": explicit platform directory not authorized/present")
    check("authorized_scope", auth_problems, "TARGET_CHANGED")

    cap_problems = []
    if config.session_mode not in ("PERSISTENT", "SAME_SESSION_HANDOFF"):
        cap_problems.append("unsupported session_mode")
    required = ["frame_readback", "persistent_draft" if config.session_mode == "PERSISTENT" else "same_session_handoff"]
    caps = {c.name: c for c in snapshot.payload.capabilities}
    for name in required:
        cap = caps.get(name)
        if cap is None or cap.status != "VERIFIED" or not cap.evidence_refs:
            cap_problems.append(name + ": capability not VERIFIED with evidence")
        elif cap.platform_version != snapshot.payload.platform_version:
            cap_problems.append(name + ": capability applies to a different platform version")
    check("capabilities", cap_problems, "TARGET_CHANGED")

    policy_problems = []
    if policy.confirmation_status == "UNRESOLVED":
        policy_problems.append("policy confirmation is UNRESOLVED")
    if any(a.producer.evidence_mode != "SYNTHETIC" for a in (graph, snapshot, source, evidence)):
        policy_problems.append("A02 only supports SYNTHETIC inputs")
    for q in graph.payload.questions:
        if q.question_type not in ("free_response", "ordinary_choice") or q.parent_question_id is not None:
            policy_problems.append(q.question_id + ": unsupported combination/seven-choice/parent-child projection")
        if q.question_type == "ordinary_choice" and not (
                policy.confirmation_status == "SYNTHETIC_ASSUMPTION" and
                policy.applicability == "SYNTHETIC_ONLY" and policy.option_grouping == "SEPARATE"):
            policy_problems.append(q.question_id + ": choice needs explicit synthetic SEPARATE assumption")
        if q.question_type == "free_response" and any(f.role == "option" for f in graph.payload.fragments
                                                       if f.fragment_id in q.fragment_ids):
            policy_problems.append(q.question_id + ": free-response option projection unsupported")
        relations = [r for r in graph.payload.answer_relations if r.question_id == q.question_id]
        if not relations or any(r.status != "SELECTED" or not r.selected_fragment_ids for r in relations):
            policy_problems.append(q.question_id + ": selected answer closure required")
        if q.external_refs.platform_question_id is not None and any(
                f.platform_question_id == q.external_refs.platform_question_id for f in snapshot.payload.frames):
            policy_problems.append(q.question_id + ": existing frames need UPDATE_FRAMES; A02 delta unsupported")
    unresolved_policy = policy.confirmation_status == "UNRESOLVED" or (
        policy.option_grouping == "UNRESOLVED" and
        any(q.question_type == "ordinary_choice" for q in graph.payload.questions))
    check("policy", policy_problems, "POLICY_UNRESOLVED" if unresolved_policy else "UNSUPPORTED_LAYOUT")
    check("coverage", [] if complete else ["independent scope/pages/clues are incomplete"], "UNASSIGNED_CONTENT")
    decision = "PASS" if not issues else "EXCEPTION" if policy_problems or not complete else "HOLD"
    return {"stage": "TARGET", "subject": artifact_ref(snapshot), "graph": artifact_ref(graph),
            "policy": policy_ref(policy), "snapshot": artifact_ref(snapshot), "receipt": None,
            "coverage": coverage, "checks": checks, "issues": issues, "decision": decision,
            "reason": "SYNTHETIC target conditions computed by A02; no algorithm or platform acceptance"}


def check_target(bundle, graph_ref, snapshot_ref, current_snapshot_ref, policy_reference, config,
                 *, artifact_id, created_at, run_id=None):
    bundle = validate_bundle(bundle)
    graph = resolve_artifact(bundle, graph_ref, "QuestionGraph")
    snapshot = resolve_artifact(bundle, snapshot_ref, "PlatformSnapshot")
    current = resolve_artifact(bundle, current_snapshot_ref, "PlatformSnapshot")
    payload = analyze_target(bundle, graph_ref, snapshot_ref, current_snapshot_ref, policy_reference, config)
    report = make_artifact("CheckReport", artifact_id, graph, payload, [graph, snapshot, current],
                           config.version, "a02-targetcheck", created_at, run_id)
    return append_artifacts(bundle, report)

