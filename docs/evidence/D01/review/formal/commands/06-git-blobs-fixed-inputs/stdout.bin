"""Record the synchronous D01 runner's own exit independently of its ledger."""
import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import sys
import time


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--receipt", required=True, type=Path)
    parser.add_argument("runner_args", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    assert not args.receipt.exists(), "preserve the previous collector receipt"
    args.receipt.mkdir(parents=True)
    runner_args = args.runner_args[1:] if args.runner_args[:1] == ["--"] else args.runner_args
    argv = [sys.executable, "-I", str(Path(__file__).with_name("run.py")), *runner_args]
    start = time.time()
    with (args.receipt / "stdout.txt").open("wb") as out, (args.receipt / "stderr.txt").open("wb") as err:
        child = subprocess.Popen(argv, cwd=str(Path.cwd()), stdout=out, stderr=err)
        code = child.wait()
    record = {"argv": argv, "cwd": str(Path.cwd()), "pid": child.pid,
              "started_unix": start, "finished_unix": time.time(), "exit_code": code,
              "synchronous_return": True, "background_children_started": 0}
    for name in ("stdout.txt", "stderr.txt"):
        record[name + "_sha256"] = hashlib.sha256((args.receipt / name).read_bytes()).hexdigest()
    (args.receipt / "command.json").write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(record, indent=2), flush=True)
    print((args.receipt / "stdout.txt").read_text(encoding="utf-8"), flush=True)
    if code:
        print((args.receipt / "stderr.txt").read_text(encoding="utf-8"), file=sys.stderr, flush=True)
    raise SystemExit(code)


if __name__ == "__main__":
    main()

cef36851d0ea51861a1e1db0b905061dbaca61d9 blob 8471
"""One-time D01 static closeout and SHA inventory. Does not run product tests."""
import ast
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess

BASE = "c6bebdf43eb93f7a6ae21e96ec07ed155686777d"
WORKFLOW = "f15f7bc03fac8994ade1642fa7547cbd823c6d43"
SOURCE = "9a7b9d7e374ee7a3ee124c9ff20e0b4003e57464"


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def main():
    root = Path(__file__).resolve().parents[2]
    evidence = root / "docs/evidence/D01/execution"
    run = evidence / "run03"
    stage = root / ".local/d01/run03"
    manifest = evidence / "SHA256SUMS.json"
    assert not manifest.exists(), "preserve the frozen manifest"
    git_calls = []

    def git(*args):
        argv = ["git", "-C", str(root), *args]
        result = subprocess.run(argv, capture_output=True)
        git_calls.append({"argv": argv, "cwd": str(root), "exit_code": result.returncode,
                          "stdout_sha256": sha(result.stdout), "stderr_sha256": sha(result.stderr),
                          "synchronous_return": True})
        assert result.returncode == 0, result.stderr
        return result.stdout

    def read(path):
        return json.loads(path.read_text(encoding="utf-8"))

    def save(name, value):
        path = evidence / name
        # Match the exact write_text newline serialization used by the initial
        # Windows attempt, without rewriting or normalizing any archived file.
        raw = (json.dumps(value, ensure_ascii=False, indent=2) + "\n").replace("\n", os.linesep).encode("utf-8")
        if path.exists():
            assert path.read_bytes() == raw, "preserve previous closeout output: " + name
            return
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(raw)

    supplement = []
    for name in ("docs/tasks/A01-integration-R2-review-report.md", "docs/tasks/A01-review-R2-handoff.md",
                 "docs/tasks/S01-eligibility-preparation.md"):
        raw = git("show", WORKFLOW + ":" + name)
        path = evidence / "workflow-links" / name
        path.parent.mkdir(parents=True, exist_ok=True)
        if path.exists():
            assert path.read_bytes() == raw
        else:
            path.write_bytes(raw)
        supplement.append({"path": name, "commit": WORKFLOW, "sha256": sha(raw), "bytes": len(raw),
                           "git_blob_oid": git("rev-parse", WORKFLOW + ":" + name).decode().strip()})
    save("workflow-links-index.json", supplement)
    assert git("diff", "--name-only", BASE, SOURCE).decode().splitlines() == ["pyproject.toml"]
    assert not git("diff", "--name-only", "HEAD").decode().splitlines(), "unexpected existing tracked changes"
    source_index = read(run / "source-index.json")["files"]
    for entry in source_index:
        assert sha((stage / "fixed source" / entry["path"]).read_bytes()) == entry["sha256"]
        assert sha(git("show", SOURCE + ":" + entry["path"])) == entry["sha256"]
    sample_index = read(run / "sample-index.json")["files"]
    for entry in sample_index:
        assert sha(git("show", BASE + ":" + entry["path"])) == entry["sha256"]
        for parent in (stage / "frozen inputs", stage / "relocated packages with spaces"):
            assert sha((parent / entry["path"]).read_bytes()) == entry["sha256"]
    # A complete per-file inventory of the controlled bad copies, including absences.
    negatives = []
    for case in read(run / "consumption-summary.json")["negative"]:
        book, mutation = case["book"], case["mutation"]
        prefix = "examples/a01/R3/bundles/" + book + "/"
        folder = stage / "controlled bad copies" / (book + "-" + mutation)
        entries = []
        for entry in sample_index:
            if entry["path"].startswith(prefix):
                relative = entry["path"][len(prefix):]
                path = folder / relative
                entries.append({"path": relative, "original_git_path": entry["path"],
                    "original_sha256": entry["sha256"], "exists": path.exists(),
                    "bytes": path.stat().st_size if path.exists() else None,
                    "sha256": sha(path.read_bytes()) if path.exists() else None})
        differences = [e for e in entries if e["original_sha256"] != e["sha256"]]
        assert len(differences) == 1 and differences[0]["path"] == case["resource_path"]
        negatives.append({"book": book, "mutation": mutation, "files": entries})
    save("negative-input-index.json", negatives)
    parsed = []
    for path in sorted((root / "examples/d01").glob("*.py")):
        ast.parse(path.read_text(encoding="utf-8"), filename=str(path), feature_version=9)
        parsed.append(path.relative_to(root).as_posix())
    for name in ("run.py", "probe.py", "collect.py"):
        assert (root / "examples/d01" / name).read_bytes() == (evidence / "collector-run03" / name).read_bytes()
    links = []
    generated_later = {evidence / "closeout-audit.json", manifest}
    for path in (root / "examples/d01/README.md", root / "docs/tasks/D01-execution-report.md"):
        for target in re.findall(r"\[[^\]]*\]\(([^)]+)\)", path.read_text(encoding="utf-8")):
            assert not target.startswith(("http:", "https:")), "D01 report uses local evidence links only"
            resolved = (path.parent / target.split("#", 1)[0]).resolve()
            assert resolved.exists() or resolved in generated_later, str(resolved)
            links.append({"document": path.relative_to(root).as_posix(), "target": target})
    commands = read(run / "commands.json")
    assert len(commands) == 18 and all(c["synchronous_return"] and not c["timed_out"] for c in commands)
    assert all(c["exit_code"] == c["expected_exit_code"] for c in commands)
    for c in commands:
        folder = run / "commands" / c["label"]
        for stream in ("stdout", "stderr"):
            assert sha((folder / (stream + ".txt")).read_bytes()) == c[stream + "_sha256"]
    for attempt, expected in (("01", 1), ("02", 1), ("03", 0)):
        folder = evidence / ("collector-run" + attempt)
        receipt = read(folder / "command.json")
        assert receipt["exit_code"] == expected and receipt["synchronous_return"]
        for name in ("stdout.txt", "stderr.txt"):
            assert sha((folder / name).read_bytes()) == receipt[name + "_sha256"]
    assert read(run / "contract-regression.json")["tests"] == {
        "ran": 70, "failures": 0, "errors": 0, "skips": []}
    assert read(run / "outside-cwd.json")["outside_worktree"]
    assert read(evidence / "process-observation-final.json")["observed_remaining"] == []
    save("closeout-audit.json", {"state": "REVIEW", "base_commit": BASE, "workflow_commit": WORKFLOW,
        "implementation_commit": SOURCE, "source_tree": read(run / "source-index.json")["source_tree"],
        "source_files_unchanged_after_build": len(source_index), "sample_files_fixed_and_preserved": len(sample_index),
        "controlled_negative_copies": len(negatives), "contract_tests": 70, "functional_commands": len(commands),
        "ast_parsed_on_cpython39": parsed, "checked_links": links,
        "runner_and_probe_bytes_match_executed_snapshot": True,
        "git_queries": git_calls, "scope": "Static closeout; no acceptance, integration, or test replay"})
    paths = {root / "pyproject.toml", root / "docs/tasks/D01-execution-report.md"}
    for prefix in ("examples/d01", "docs/evidence/D01/execution"):
        paths.update(p for p in (root / prefix).rglob("*") if p.is_file() and "__pycache__" not in p.parts)
    entries = [{"path": p.relative_to(root).as_posix(), "bytes": p.stat().st_size,
                "sha256": sha(p.read_bytes())} for p in sorted(paths)]
    save("SHA256SUMS.json", {"format": "d01-execution-sha256-1", "base_commit": BASE,
        "implementation_commit": SOURCE, "source_and_external_fixed_inputs": [
            "run03/source-index.json", "run03/sample-index.json", "run03/regression-input-index.json",
            "run03/public-dependencies.json", "negative-input-index.json", "run03/workflow-index.json",
            "workflow-links-index.json"],
        "excluded_self": ["docs/evidence/D01/execution/SHA256SUMS.json"], "files": entries})
    for link in links:
        assert (root / link["document"]).parent.joinpath(link["target"]).resolve().exists()
    print(json.dumps({"files": len(entries), "manifest_sha256": sha(manifest.read_bytes())}, indent=2))


if __name__ == "__main__":
    main()

84afab51b8648c0ca9b76459ae5bcb4447e922cf blob 2082
param([Parameter(Mandatory = $true)][string]$OutputPath)
$ErrorActionPreference = 'Stop'
$taskRoot = (Resolve-Path -LiteralPath (Join-Path $PSScriptRoot '../..')).Path
$taskEvidence = Join-Path $taskRoot 'docs/evidence/D01/execution'
$taskOutput = [IO.Path]::GetFullPath($OutputPath)
if (Test-Path -LiteralPath $taskOutput) { throw 'Preserve the previous process observation.' }
$taskLedgers = Get-ChildItem -LiteralPath $taskEvidence -Filter process-ledger.json -Recurse | ForEach-Object {
    Get-Content -LiteralPath $_.FullName -Raw | ConvertFrom-Json
}
$taskReceipts = Get-ChildItem -LiteralPath $taskEvidence -Filter command.json -Recurse |
    Where-Object { $_.Directory.Name -like 'collector-*' } | ForEach-Object {
        Get-Content -LiteralPath $_.FullName -Raw | ConvertFrom-Json
    }
$taskKnownPids = @($taskLedgers | ForEach-Object {
    $_.collector_pid
    $_.children | ForEach-Object { $_.pid }
}) + @($taskReceipts | ForEach-Object { $_.pid })
$taskObserved = @(Get-CimInstance Win32_Process | Where-Object {
    ($taskKnownPids -contains $_.ProcessId) -or
    ($_.CommandLine -and (
        $_.CommandLine.Contains((Join-Path $taskRoot '.local\d01\')) -or
        $_.CommandLine.Contains((Join-Path $taskRoot 'examples\d01\run.py')) -or
        $_.CommandLine.Contains((Join-Path $taskRoot 'examples\d01\collect.py'))
    ))
} | Select-Object ProcessId, ParentProcessId, Name, CreationDate)
$taskResult = [ordered]@{
    observed_at_utc = [DateTime]::UtcNow.ToString('o')
    script = $PSCommandPath
    cwd = (Get-Location).Path
    known_pids = @($taskKnownPids | Sort-Object -Unique)
    observed_remaining = $taskObserved
    command_lines_exported = $false
    scope = 'Known synchronous child/runner PIDs plus exact task runtime/runner paths; point-in-time observation'
}
$taskJson = $taskResult | ConvertTo-Json -Depth 7
[IO.File]::WriteAllText($taskOutput, $taskJson + [Environment]::NewLine, [Text.UTF8Encoding]::new($false))
$taskJson
if ($taskObserved.Count -ne 0) { throw 'A known PID or task path remains; inspect PID reuse before concluding.' }

2cc4f0d07b0a688e8b0e6bc008c160cf19e95a65 blob 6894
"""D01 installed-package probes. Run with the new environment's python -I.

Only the regression mode adds the frozen *test* directory, which contains no
src/ tree. The public A01 consumer is executed unchanged using runpy.
"""
import argparse
import hashlib
import importlib
import importlib.metadata as metadata
import json
from pathlib import Path
import runpy
import sys
import unittest


def digest(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def provenance():
    imports = {}
    prefix = Path(sys.prefix).resolve()
    for name in ("annotation.contracts", "annotation.source.static", "annotation.geometry", "PIL"):
        importlib.import_module(name)
    for name, module in sorted(sys.modules.items()):
        if name == "PIL" or name.startswith(("PIL.", "annotation.")):
            filename = getattr(module, "__file__", None)
            if filename:
                path = Path(filename).resolve()
                if prefix not in path.parents:
                    raise AssertionError("import outside new environment: " + str(path))
                imports[name] = {"file": str(path), "sha256": digest(path)}
    return {"executable": sys.executable, "version": sys.version,
            "prefix": sys.prefix, "base_prefix": sys.base_prefix,
            "isolated": sys.flags.isolated, "no_user_site": sys.flags.no_user_site,
            "ignore_environment": sys.flags.ignore_environment,
            "sys_path": list(sys.path), "imports": imports}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=("metadata", "consumer", "regression", "source"))
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--wheel", type=Path)
    parser.add_argument("--consumer", type=Path)
    parser.add_argument("--exchange", type=Path)
    parser.add_argument("--book-id")
    parser.add_argument("--tests", type=Path)
    args = parser.parse_args()
    result = {"mode": args.mode, "cwd": str(Path.cwd()), "argv": list(sys.argv)}
    try:
        result["before"] = provenance()
        assert sys.flags.isolated == 1 and sys.version_info[:2] == (3, 9)
        if args.mode == "metadata":
            dist = metadata.distribution("annotation-contracts")
            result["distribution"] = {
                "name": dist.metadata["Name"], "version": dist.version,
                "requires_python": dist.metadata["Requires-Python"],
                "requires_dist": dist.requires,
                "dist_info": str(dist._path),
                "direct_url": json.loads(dist.read_text("direct_url.json")),
                "distributions": sorted(
                    [{"name": d.metadata["Name"], "version": d.version,
                      "location": str(d.locate_file(""))} for d in metadata.distributions()],
                    key=lambda d: d["name"].lower())}
            assert "Pillow==11.3.0" in dist.requires
            assert result["distribution"]["requires_python"] == ">=3.9"
            assert result["distribution"]["direct_url"]["archive_info"]["hashes"]["sha256"] == digest(args.wheel)
            assert not result["distribution"]["direct_url"].get("dir_info", {}).get("editable", False)
            # Match every product .py byte to the actually installed wheel.
            import zipfile
            with zipfile.ZipFile(args.wheel) as archive:
                result["wheel_files"] = []
                for name in archive.namelist():
                    if name.startswith("annotation/") and name.endswith(".py"):
                        installed = Path(dist.locate_file(name))
                        expected = hashlib.sha256(archive.read(name)).hexdigest()
                        assert digest(installed) == expected
                        result["wheel_files"].append({"path": name, "sha256": expected,
                                                       "installed": str(installed)})
            result["metadata_text"] = dist.read_text("METADATA")
            result["record_text"] = dist.read_text("RECORD")
        elif args.mode == "consumer":
            sys.argv = [str(args.consumer), str(args.exchange), "--book-id", args.book_id]
            runpy.run_path(str(args.consumer), run_name="__main__")
        elif args.mode == "regression":
            assert not (args.tests.parent / "src").exists()
            sys.path.insert(0, str(args.tests))
            suites = [unittest.defaultTestLoader.discover(str(args.tests), pattern=pattern)
                      for pattern in ("test_contracts.py", "test_contracts_platform_refs.py")]
            checks = unittest.TextTestRunner(verbosity=2).run(unittest.TestSuite(suites))
            result["tests"] = {"ran": checks.testsRun, "failures": len(checks.failures),
                               "errors": len(checks.errors), "skips": checks.skipped}
            assert checks.wasSuccessful() and checks.testsRun == 70 and not checks.skipped
        elif args.mode == "source":
            from annotation.source.static.importer import StaticSourceError, url_index, decode_image
            result["url_cases"] = []
            for book, index in (("46006966", 7), ("46007447", 13)):
                url = "https://archive.example.invalid/upload_images/{0}/{0}_page_{1}.jpg".format(book, index)
                assert url_index(url, book, "d01.image") == index
                result["url_cases"].append({"book": book, "url": url, "index": index})
            for tail in ("?", "#", "?token=opaque", "#view", "?echo=/upload_images/46006966/46006966_page_1.jpg"):
                url = "https://archive.example.invalid/upload_images/46007447/46007447_page_13.jpg" + tail
                try:
                    url_index(url, "46007447", "d01.image")
                    raise AssertionError("unsupported URL accepted")
                except StaticSourceError as error:
                    assert error.code == "SOURCE_URL_COMPONENT" and error.location == "d01.image"
                    result["url_cases"].append({"url": url, "code": error.code, "location": error.location})
            broken = args.output.parent / "invalid-image.jpg"
            broken.write_bytes(b"D01 controlled non-JPEG bytes\n")
            try:
                decode_image(broken)
                raise AssertionError("invalid image decoded")
            except StaticSourceError as error:
                assert error.code == "IMAGE_DECODE" and error.location == broken.name
                result["decode_rejection"] = {"path": str(broken), "sha256": digest(broken),
                                              "code": error.code, "location": error.location}
        result["completed"] = True
    finally:
        result["after"] = provenance()
        args.output.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


if __name__ == "__main__":
    main()

3b9ece19930ac5e79e29175c17e43ddd7eca125e blob 17021
"""Reproduce the bounded D01 clean installation; never reuse an existing run.

Use --stage under this worktree's ignored .local/ and a new --evidence directory.
All child commands are synchronous. Logs preserve stdout/stderr after URL-userinfo
redaction. No global configuration, browser, platform, or model operations.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time
import uuid
import zipfile

BASE = "c6bebdf43eb93f7a6ae21e96ec07ed155686777d"
WORKFLOW = "f15f7bc03fac8994ade1642fa7547cbd823c6d43"
SOURCE = "9a7b9d7e374ee7a3ee124c9ff20e0b4003e57464"


def sha(data):
    return hashlib.sha256(data).hexdigest()


def save(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def sanitize(data):
    # Explicit public indexes are used; this is a defensive logging boundary.
    return re.sub(rb"(https?://)[^\s/@]+:[^\s/@]+@", rb"\1[REDACTED]@", data)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--stage", type=Path, required=True)
    parser.add_argument("--evidence", type=Path, required=True)
    parser.add_argument("--python39", type=Path, required=True)
    parser.add_argument("--source-commit", default=SOURCE)
    args = parser.parse_args()
    repo = Path(__file__).resolve().parents[2]
    # CPython 3.9 on Windows may leave a nonexistent relative path unresolved.
    stage, evidence = args.stage.absolute().resolve(), args.evidence.absolute().resolve()
    assert not stage.exists() and not evidence.exists(), "preserve old attempts; choose new paths"
    assert (repo / ".local").resolve() in stage.parents, "stage must be task-local and ignored"
    assert (repo / "docs/evidence/D01/execution").resolve() in evidence.parents
    stage.mkdir(parents=True)
    evidence.mkdir(parents=True)
    env = {k: v for k, v in os.environ.items()
           if not k.upper().startswith(("PYTHON", "PIP_"))}
    temp = stage / "temp"
    temp.mkdir()
    env.update(TMP=str(temp), TEMP=str(temp), TMPDIR=str(temp))
    commands = []

    def command(label, argv, cwd, expected=0, timeout=180):
        folder = evidence / "commands" / label
        folder.mkdir(parents=True)
        start = time.time()
        child = subprocess.Popen([str(a) for a in argv], cwd=str(cwd), env=env,
                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        timed_out = False
        try:
            stdout, stderr = child.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            timed_out = True
            child.kill()
            stdout, stderr = child.communicate()
        stdout, stderr = sanitize(stdout), sanitize(stderr)
        (folder / "stdout.txt").write_bytes(stdout)
        (folder / "stderr.txt").write_bytes(stderr)
        record = {"label": label, "argv": [str(a) for a in argv], "cwd": str(cwd),
                  "pid": child.pid, "started_unix": start, "finished_unix": time.time(),
                  "exit_code": child.returncode, "expected_exit_code": expected,
                  "timed_out": timed_out, "synchronous_return": True,
                  "stdout_sha256": sha(stdout), "stderr_sha256": sha(stderr),
                  "environment": {k: env[k] for k in ("TMP", "TEMP", "TMPDIR", "SOURCE_DATE_EPOCH") if k in env},
                  "python_and_pip_environment_removed": True}
        save(folder / "command.json", record)
        commands.append(record)
        save(evidence / "commands.json", commands)
        print(label + ": exit " + str(child.returncode), flush=True)
        if child.returncode != expected or timed_out:
            raise RuntimeError(label + " failed; preserve this attempt, see " + str(folder))
        return stdout

    def git(*argv):
        return subprocess.check_output(["git", "-C", str(repo), *argv])

    def export(commit, paths, target):
        names = git("ls-tree", "-r", "--name-only", commit, "--", *paths).decode("utf-8").splitlines()
        assert names
        entries = []
        for name in names:
            raw = git("show", commit + ":" + name)
            oid = git("rev-parse", commit + ":" + name).decode().strip()
            assert hashlib.sha1(b"blob " + str(len(raw)).encode() + b"\0" + raw).hexdigest() == oid
            path = target / name
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(raw)
            assert path.read_bytes() == raw
            entries.append({"path": name, "commit": commit, "git_blob_oid": oid,
                            "bytes": len(raw), "sha256": sha(raw), "export_sha256": sha(path.read_bytes())})
        return entries

    try:
        diff = git("diff", "--name-only", BASE, args.source_commit).decode().splitlines()
        assert diff == ["pyproject.toml"], diff
        epoch = git("show", "-s", "--format=%ct", args.source_commit).decode().strip()
        env["SOURCE_DATE_EPOCH"] = epoch
        source = stage / "fixed source"
        source_index = export(args.source_commit, ["pyproject.toml", "src"], source)
        save(evidence / "source-index.json", {"base_commit": BASE, "workflow_commit": WORKFLOW,
             "source_commit": args.source_commit,
             "source_tree": git("rev-parse", args.source_commit + "^{tree}").decode().strip(),
             "export_scope": ["pyproject.toml", "src/**"], "files": source_index})
        workflow_files = ["AGENTS.md", "docs/coordination.md", "docs/architecture.md", "docs/contracts-v1.md",
                          "docs/tasks/D01-dependency-implementation.md", "docs/tasks/D01-independent-review.md",
                          "docs/tasks/D01-dependency-preparation.md", "docs/tasks/A01-integration-R2-coordinator-acceptance.md"]
        save(evidence / "workflow-index.json", export(WORKFLOW, workflow_files, evidence / "workflow"))
        save(evidence / "receipt.json", {"task": "D01", "state": "RUNNING", "reasoning_effort": "xhigh",
             "worktree": str(repo), "branch": git("branch", "--show-current").decode().strip(),
             "base_commit": BASE, "workflow_commit": WORKFLOW, "implementation_commit": args.source_commit,
             "only_product_change": "pyproject.toml: Pillow==11.3.0", "initial_blockers": []})
        outside = Path(tempfile.gettempdir()).absolute().resolve() / ("1800 D01 outside cwd " + uuid.uuid4().hex)
        assert repo not in outside.parents and not outside.exists()
        outside.mkdir()
        save(evidence / "outside-cwd.json", {"cwd": str(outside), "worktree": str(repo),
             "outside_worktree": repo not in outside.parents,
             "outside_build_source": source not in outside.parents})
        venv = stage / "clean cp39"
        command("01-create-venv", [args.python39, "-I", "-m", "venv", venv], outside)
        py = venv / "Scripts/python.exe"
        (evidence / "pyvenv.cfg").write_bytes((venv / "pyvenv.cfg").read_bytes())
        assert "include-system-site-packages = false" in (venv / "pyvenv.cfg").read_text()
        command("02-new-environment", [py, "-I", "-c",
            "import json,sys,site;print(json.dumps(dict(executable=sys.executable,version=sys.version,prefix=sys.prefix,base_prefix=sys.base_prefix,sys_path=sys.path,user_site=site.ENABLE_USER_SITE)));assert sys.version_info[:2]==(3,9);assert sys.prefix!=sys.base_prefix;assert not site.ENABLE_USER_SITE"], outside)
        pip = [py, "-I", "-m", "pip", "--isolated", "--disable-pip-version-check", "--no-input"]
        downloads = stage / "bootstrap wheels"
        downloads.mkdir()
        command("03-download-pip", pip + ["download", "--index-url", "https://pypi.org/simple", "--no-deps",
                "--only-binary=:all:", "--dest", downloads, "--retries", "0", "--timeout", "30", "-v", "pip==25.3"], outside)
        pip_wheel, = downloads.glob("pip-25.3-*.whl")
        command("04-bootstrap-pip", pip + ["install", "--no-index", "--no-deps", "--upgrade", pip_wheel], outside)
        command("05-build-tools", pip + ["install", "--index-url", "https://pypi.org/simple", "--report",
                evidence / "build-tools-install-report.json", "--only-binary=:all:", "--retries", "0", "--timeout", "30",
                "setuptools==80.9.0", "wheel==0.45.1"], outside)
        dist = stage / "dist"
        dist.mkdir()
        command("06-build-wheel", pip + ["wheel", "--no-deps", "--no-build-isolation", "--no-index",
                "--wheel-dir", dist, source], outside)
        built, = dist.glob("annotation_contracts-*.whl")
        wheel = evidence / "artifacts" / built.name
        wheel.parent.mkdir()
        shutil.copyfile(built, wheel)
        assert built.read_bytes() == wheel.read_bytes()
        with zipfile.ZipFile(wheel) as archive:
            matches = []
            for entry in source_index:
                if entry["path"].startswith("src/"):
                    member = entry["path"][4:]
                    assert sha(archive.read(member)) == entry["sha256"]
                    matches.append({"git_path": entry["path"], "wheel_path": member,
                                    "sha256": entry["sha256"]})
        save(evidence / "wheel-binding.json", {"implementation_commit": args.source_commit,
             "wheel": str(wheel), "sha256": sha(wheel.read_bytes()), "bytes": wheel.stat().st_size,
             "source_date_epoch": epoch, "source_matches": matches})
        command("07-install-wheel", pip + ["install", "--index-url", "https://pypi.org/simple", "--report",
                evidence / "install-report.json", "--only-binary=:all:", "--retries", "0", "--timeout", "30", wheel], outside)
        command("08-pip-check", pip + ["check"], outside)
        probe = stage / "installed_probe.py"
        probe.write_bytes((Path(__file__).parent / "probe.py").read_bytes())
        command("09-installed-provenance", [py, "-I", probe, "metadata", "--output",
                evidence / "installed-provenance.json", "--wheel", wheel], outside)
        # The bootstrap download is independently tied to public PyPI's release metadata.
        bootstrap_code = (
            "import hashlib,json,pathlib,urllib.request;"
            "p=pathlib.Path(" + repr(str(pip_wheel)) + ");"
            "d=json.load(urllib.request.urlopen('https://pypi.org/pypi/pip/25.3/json',timeout=30));"
            "r=next(x for x in d['urls'] if x['filename']==p.name);"
            "assert hashlib.sha256(p.read_bytes()).hexdigest()==r['digests']['sha256'];"
            "print(json.dumps(dict(name='pip',version='25.3',url=r['url'],sha256=r['digests']['sha256'],bytes=p.stat().st_size)))")
        bootstrap = command("10-pip-public-hash", [py, "-I", "-c", bootstrap_code], outside)
        public = [json.loads(bootstrap)]
        for name in ("build-tools-install-report.json", "install-report.json"):
            report = json.loads((evidence / name).read_text(encoding="utf-8"))
            for entry in report["install"]:
                info = entry["download_info"]
                if not info["url"].startswith("https://"):
                    continue
                assert info["url"].startswith("https://files.pythonhosted.org/")
                public.append({"name": entry["metadata"]["name"], "version": entry["metadata"]["version"],
                               "url": info["url"], "sha256": info["archive_info"]["hashes"]["sha256"], "report": name})
        save(evidence / "public-dependencies.json", public)
        # Freeze the exact accepted R3 packages and public consumer from BASE.
        original = stage / "frozen inputs"
        frozen_paths = ["examples/a01/consume.py", "examples/a01/R3/bundles/46006966", "examples/a01/R3/bundles/46007447"]
        inputs = export(BASE, frozen_paths, original)
        moved = stage / "relocated packages with spaces"
        shutil.copytree(original, moved)
        for entry in inputs:
            entry["relocated_sha256"] = sha((moved / entry["path"]).read_bytes())
            assert entry["relocated_sha256"] == entry["sha256"]
        save(evidence / "sample-index.json", {"base_commit": BASE, "files": inputs})
        consumer = moved / "examples/a01/consume.py"
        positives, negatives = [], []
        for book, count in (("46006966", 6), ("46007447", 2)):
            package = moved / "examples/a01/R3/bundles" / book
            output = evidence / ("consumer-" + book + ".json")
            raw = command("11-consume-" + book, [py, "-I", probe, "consumer", "--output", output,
                          "--consumer", consumer, "--exchange", package / "exchange.json", "--book-id", book], outside)
            result = json.loads(raw)
            assert result["asset_count"] == count and result["coverage_eligible"] is False
            limitations = json.loads((package / "limitations.json").read_text(encoding="utf-8"))
            assert limitations["scope_manifest_status"] == "REFERENCE_ONLY"
            assert limitations["independent_denominator_status"] == "UNKNOWN"
            positives.append(result)
            for mutation, code in (("missing", "RESOURCE_MISSING"), ("corrupt", "RESOURCE_HASH")):
                damaged = stage / "controlled bad copies" / (book + "-" + mutation)
                shutil.copytree(package, damaged)
                value = json.loads((damaged / "exchange.json").read_text(encoding="utf-8"))
                asset = value["artifacts"][0]["payload"]["assets"][0]
                victim = damaged / asset["path"]
                before = sha(victim.read_bytes())
                if mutation == "missing":
                    victim.unlink()  # One explicitly scoped generated file; no recursive deletion.
                else:
                    victim.write_bytes(b"D01 controlled corrupt resource\n")
                label = "12-" + book + "-" + mutation
                command(label, [py, "-I", probe, "consumer", "--output", evidence / (label + ".json"),
                        "--consumer", consumer, "--exchange", damaged / "exchange.json", "--book-id", book], outside, expected=1)
                error = (evidence / "commands" / label / "stderr.txt").read_text(encoding="utf-8")
                assert "[" + code + "]" in error and "$.artifacts[0].payload.assets[0]" in error
                negatives.append({"book": book, "mutation": mutation, "resource_path": asset["path"],
                                  "original_sha256": before, "actual_sha256": sha(victim.read_bytes()) if victim.exists() else None,
                                  "code": code, "exit_code": 1, "command": label})
        save(evidence / "consumption-summary.json", {"positive": positives, "negative": negatives})
        command("13-source-regression", [py, "-I", probe, "source", "--output", evidence / "source-regression.json"], outside)
        regression = stage / "regression fixtures only"
        regression_index = export(BASE, ["tests/test_contracts.py", "tests/test_contracts_platform_refs.py",
             "tests/fixtures/contracts", "examples/contracts/consume.py", "examples/contracts/build_fixtures.py"], regression)
        save(evidence / "regression-input-index.json", regression_index)
        command("14-contract-regression", [py, "-I", probe, "regression", "--tests", regression / "tests",
                "--output", evidence / "contract-regression.json"], outside)
        unchanged = []
        for folder, entries in ((original, inputs), (moved, inputs), (regression, regression_index)):
            for entry in entries:
                actual = sha((folder / entry["path"]).read_bytes())
                assert actual == entry["sha256"]
                unchanged.append({"file": str(folder / entry["path"]), "sha256": actual})
        save(evidence / "post-run-input-integrity.json", unchanged)
        save(evidence / "run-result.json", {"state": "REVIEW", "execution_completed": True,
             "implementation_commit": args.source_commit, "command_count": len(commands),
             "positive_consumers": 2, "expected_resource_rejections": 4,
             "all_synchronous_commands_returned": all(c["synchronous_return"] for c in commands),
             "not_acceptance_or_integration": True, "platform_calls": 0, "model_calls": 0, "browser_downloads": 0})
    except BaseException as error:
        save(evidence / "attempt-failure.json", {"type": type(error).__name__, "message": str(error),
             "completed_command_count": len(commands), "synchronous_commands_returned": True})
        raise
    finally:
        save(evidence / "process-ledger.json", {"collector_pid": os.getpid(),
             "collector_completion": "finally reached; outer command receipt proves collector exit",
             "children": [{k: c[k] for k in ("label", "pid", "exit_code", "synchronous_return", "timed_out")} for c in commands],
             "background_children_started": 0})


if __name__ == "__main__":
    main()

61a09e0caa4c31549590cd222974d3a09c6fa4a2 blob 3809
"""Seal D01 with Git bytes and explicitly enumerated checkout representations.

One-time correction after the first inventory/index comparison. The original
inventory and changed helper/report bytes are retained in index-byte-first-attempt.
This does not alter original evidence or A01 representation policies.
"""
import ast
import hashlib
import json
from pathlib import Path
import subprocess


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def main():
    root = Path(__file__).resolve().parents[2]
    evidence = root / "docs/evidence/D01/execution"
    manifest = evidence / "SHA256SUMS.json"
    first = evidence / "index-byte-first-attempt/SHA256SUMS.json"
    assert sha(first.read_bytes()) == "6f1a0451900e6b8f9607782d98cbf43e3b153de32b3bb501deb25c13729055ba"
    assert manifest.read_bytes() == first.read_bytes(), "do not overwrite a later seal"
    data = json.loads(first.read_text(encoding="utf-8"))
    allowed = {"pyproject.toml"} | {
        p.relative_to(root).as_posix() for p in (root / "examples/d01").iterdir()
        if p.suffix in (".py", ".ps1")}
    audit = {"first_manifest_sha256": sha(first.read_bytes()),
             "first_index_comparison": {"files": 182, "git_matches": 181, "mismatches": ["pyproject.toml"],
                  "tool_session": 45917, "exit_code": 1, "terminal": "AssertionError: ['pyproject.toml']"},
             "scope": "Only pyproject.toml and enumerated D01 Python/PowerShell helper text; no raw evidence or A01 policy changes",
             "files": []}
    paths = {root / "pyproject.toml", root / "docs/tasks/D01-execution-report.md"}
    for prefix in ("examples/d01", "docs/evidence/D01/execution"):
        paths.update(p for p in (root / prefix).rglob("*") if p.is_file() and "__pycache__" not in p.parts)
    paths.discard(manifest)
    primary = {}
    for relative in sorted(allowed):
        raw = subprocess.check_output(["git", "-C", str(root), "show", ":" + relative])
        assert b"\r" not in raw, "fixed Git text must use LF"
        disk = (root / relative).read_bytes()
        crlf = raw.replace(b"\n", b"\r\n")
        assert disk in (raw, crlf), relative
        ast.parse(raw.decode("utf-8"), filename=relative, feature_version=9) if relative.endswith(".py") else None
        primary[relative] = raw
        audit["files"].append({"path": relative, "git_bytes": len(raw), "git_sha256": sha(raw),
            "checkout_bytes": len(disk), "checkout_sha256": sha(disk),
            "exact_crlf_bytes": len(crlf), "exact_crlf_sha256": sha(crlf)})
    audit_path = evidence / "checkout-byte-audit.json"
    assert not audit_path.exists()
    audit_path.write_text(json.dumps(audit, indent=2) + "\n", encoding="utf-8")
    paths.add(audit_path)
    entries = []
    for path in sorted(paths):
        relative = path.relative_to(root).as_posix()
        raw = primary[relative] if relative in primary else path.read_bytes()
        entry = {"path": relative, "bytes": len(raw), "sha256": sha(raw)}
        if relative in allowed:
            other = raw.replace(b"\n", b"\r\n")
            entry["representations"] = [{"kind": "EXACT_LF_TO_CRLF_FOR_THIS_FILE",
                                          "bytes": len(other), "sha256": sha(other)}]
        entries.append(entry)
    data.update(format="d01-execution-sha256-2", files=entries,
        byte_policy="Primary is exact Git bytes; only explicitly enumerated pyproject/D01 helper entries have one fixed CRLF hash. Raw evidence has no alternatives.")
    manifest.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(json.dumps({"files": len(entries), "explicit_checkout_alternatives": len(allowed),
                      "manifest_sha256": sha(manifest.read_bytes())}, indent=2))


if __name__ == "__main__":
    main()

78de5c9ed054a24d665c4a09658aabbeea495f2a blob 1799
"""Read-only D01 SHA closure check; no installation, Git, or source injection."""
import argparse
import hashlib
import json
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[2])
    args = parser.parse_args()
    root = args.root.absolute().resolve()
    manifest = root / "docs/evidence/D01/execution/SHA256SUMS.json"
    data = json.loads(manifest.read_text(encoding="utf-8"))
    failures = []
    for entry in data["files"]:
        path = root / entry["path"]
        if not path.is_file():
            failures.append(entry["path"] + ": missing")
            continue
        raw = path.read_bytes()
        candidates = [entry] + entry.get("representations", [])
        actual_bytes, actual_sha = len(raw), hashlib.sha256(raw).hexdigest()
        if not any(actual_bytes == c["bytes"] and actual_sha == c["sha256"] for c in candidates):
            failures.append(entry["path"] + ": byte mismatch")
    expected = {entry["path"] for entry in data["files"]}
    actual = {"pyproject.toml", "docs/tasks/D01-execution-report.md"}
    for prefix in ("examples/d01", "docs/evidence/D01/execution"):
        actual.update(p.relative_to(root).as_posix() for p in (root / prefix).rglob("*")
                      if p.is_file() and "__pycache__" not in p.parts)
    actual -= set(data["excluded_self"])
    if expected != actual:
        failures.append("closure mismatch: " + repr(sorted(expected ^ actual)))
    print(json.dumps({"files": len(data["files"]), "failures": failures,
                      "manifest_sha256": hashlib.sha256(manifest.read_bytes()).hexdigest()}, indent=2))
    raise SystemExit(bool(failures))


if __name__ == "__main__":
    main()

