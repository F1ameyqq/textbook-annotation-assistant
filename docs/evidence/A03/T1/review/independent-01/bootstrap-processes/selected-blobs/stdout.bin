                ],
                "title": "ArtifactRef",
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "receipt_ref": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "artifact_id": {
                    "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
                    "title": "Artifact Id",
                    "type": "string"
                  },
                  "revision": {
                    "exclusiveMinimum": 0,
                    "title": "Revision",
                    "type": "integer"
                  },
                  "kind": {
                    "const": "ExecutionReceipt",
                    "type": "string"
                  },
                  "content_hash": {
                    "pattern": "^[0-9a-f]{64}$",
                    "title": "Content Hash",
                    "type": "string"
                  }
                },
                "required": [
                  "artifact_id",
                  "revision",
                  "kind",
                  "content_hash"
                ],
                "title": "ArtifactRef",
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "LEGACY_UNRECORDED"
            ]
          }
        },
        "required": [
          "event_id",
          "obligation_id",
          "run_id",
          "scope_id",
          "plan_ref",
          "intent_ref",
          "receipt_ref",
          "classification"
        ]
      },
      "minItems": 0
    },
    "artifact_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 0
    },
    "pending_action_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0
    },
    "external_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "platform_question_id": {
            "type": "string",
            "minLength": 1
          },
          "platform_frame_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "question_id",
          "platform_question_id",
          "platform_frame_ids"
        ]
      },
      "minItems": 0
    },
    "pause": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paused": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "minItems": 0
        }
      },
      "required": [
        "paused",
        "reason_codes",
        "event_ids"
      ]
    },
    "state_directory_identity": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "target_store_identity": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "diagnostic_only": {
      "const": true
    }
  },
  "required": [
    "format_version",
    "ledger_id",
    "db_version",
    "book_key",
    "owner_id",
    "generation",
    "event_head_sequence",
    "event_head_hash",
    "scopes",
    "unresolved",
    "artifact_history",
    "pending_action_ids",
    "external_ids",
    "pause",
    "state_directory_identity",
    "target_store_identity",
    "diagnostic_only"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ledger-export.schema.json",
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ActionTarget"
        },
        "source_entity_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Entity Ids",
          "type": "array"
        },
        "expected_before": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "minProperties": 1,
          "title": "Expected Before",
          "type": "object"
        },
        "operation": {
          "enum": [
            "CREATE_FRAMES",
            "UPDATE_FRAMES"
          ],
          "title": "Operation",
          "type": "string"
        },
        "expected_after": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "minProperties": 1,
          "title": "Expected After",
          "type": "object"
        },
        "depends_on": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        }
      },
      "required": [
        "action_id",
        "target",
        "source_entity_ids",
        "expected_before",
        "operation",
        "expected_after",
        "depends_on"
      ],
      "title": "Action",
      "type": "object"
    },
    "ActionResult": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Action Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "APPLIED",
            "NOT_APPLIED",
            "UNKNOWN"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "platform_ids": {
          "items": {
            "type": "string"
          },
          "title": "Platform Ids",
          "type": "array"
        },
        "before_evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Before Evidence Refs",
          "type": "array"
        },
        "after_evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "title": "After Evidence Refs",
          "type": "array"
        },
        "readback": {
          "anyOf": [
            {
              "$ref": "#/$defs/Resource"
            },
            {
              "type": "null"
            }
          ]
        },
        "effect_match": {
          "enum": [
            "MATCH",
            "ABSENT",
            "INDETERMINATE"
          ],
          "title": "Effect Match",
          "type": "string"
        },
        "next_step": {
          "enum": [
            "POSTCHECK",
            "RECHECK_TARGET",
            "RECONCILE"
          ],
          "title": "Next Step",
          "type": "string"
        },
        "replay_allowed": {
          "const": false,
          "title": "Replay Allowed",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "attempt_fact": {
          "type": "string",
          "enum": [
            "NOT_ATTEMPTED",
            "MAY_HAVE_BEEN_ATTEMPTED",
            "ATTEMPTED",
            "LEGACY_UNRECORDED"
          ]
        },
        "attempt_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "minItems": 0
        },
        "intent_ref": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "artifact_id": {
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
                  "title": "Artifact Id",
                  "type": "string"
                },
                "revision": {
                  "exclusiveMinimum": 0,
                  "title": "Revision",
                  "type": "integer"
                },
                "kind": {
                  "const": "WriteIntent",
                  "type": "string"
                },
                "content_hash": {
                  "pattern": "^[0-9a-f]{64}$",
                  "title": "Content Hash",
                  "type": "string"
                }
              },
              "required": [
                "artifact_id",
                "revision",
                "kind",
                "content_hash"
              ],
              "title": "ArtifactRef",
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "action_id",
        "outcome",
        "platform_ids",
        "before_evidence_refs",
        "after_evidence_refs",
        "readback",
        "effect_match",
        "next_step",
        "replay_allowed",
        "reason",
        "attempt_fact",
        "attempt_evidence_refs",
        "intent_ref"
      ],
      "title": "ActionResult",
      "type": "object"
    },
    "ActionTarget": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "question_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Question Id",
          "type": "string"
        },
        "platform_question_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Platform Question Id"
        }
      },
      "required": [
        "target_id",
        "question_id",
        "platform_question_id"
      ],
      "title": "ActionTarget",
      "type": "object"
    },
    "AnswerRelation": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Relation Id",
          "type": "string"
        },
        "question_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Question Id",
          "type": "string"
        },
        "candidate_fragment_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "title": "Candidate Fragment Ids",
          "type": "array"
        },
        "selected_fragment_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "title": "Selected Fragment Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "SELECTED",
            "AMBIGUOUS",
            "UNRESOLVED"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "relation_id",
        "question_id",
        "candidate_fragment_ids",
        "selected_fragment_ids",
        "status",
        "evidence_refs"
      ],
      "title": "AnswerRelation",
      "type": "object"
    },
    "ApplyPlan": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.1.0-a-recovery-proposal",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "kind": {
          "const": "ApplyPlan",
          "title": "Kind",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "book_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Book Id",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Scope Id",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/PlanPayload"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "revision",
        "kind",
        "run_id",
        "book_id",
        "scope_id",
        "input_refs",
        "producer",
        "content_hash",
        "created_at",
        "payload"
      ],
      "title": "ApplyPlan",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "SourceBundle",
            "EvidenceBundle",
            "QuestionGraph",
            "PlatformSnapshot",
            "CheckReport",
            "ApplyPlan",
            "ExecutionReceipt",
            "ReviewPatch",
            "BatchReport",
            "WriteIntent",
            "ExecutionProgress",
            "ReconciliationResult"
          ],
          "title": "Kind",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "revision",
        "kind",
        "content_hash"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/x-portable-graymap",
            "text/plain",
            "application/json"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "asset_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Asset Id",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "source_label": {
          "minLength": 1,
          "title": "Source Label",
          "type": "string"
        },
        "provenance": {
          "enum": [
            "SYNTHETIC",
            "ORIGINAL"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "origin": {
          "type": "string",
          "enum": [
            "SYNTHETIC",
            "ORIGINAL",
            "OBSERVED"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type",
        "asset_id",
        "width",
        "height",
        "source_label",
        "provenance",
        "origin"
      ],
      "title": "Asset",
      "type": "object"
    },
    "BatchPayload": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "graph": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "receipt": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "postcheck": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "scope_manifest": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Scope Manifest",
          "type": "array"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/QuestionStatus"
          },
          "minItems": 1,
          "title": "Questions",
          "type": "array"
        },
        "total_expected": {
          "exclusiveMinimum": 0,
          "title": "Total Expected",
          "type": "integer"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "cost": {
          "$ref": "#/$defs/Cost"
        },
        "unresolved_issue_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "title": "Unresolved Issue Ids",
          "type": "array"
        },
        "submission_status": {
          "enum": [
            "NOT_SUBMITTED",
            "CONFIRMED",
            "UNKNOWN"
          ],
          "title": "Submission Status",
          "type": "string"
        },
        "submission_evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "title": "Submission Evidence Refs",
          "type": "array"
        },
        "content_check_status": {
          "enum": [
            "PENDING",
            "VERIFIED",
            "MISMATCH",
            "UNAVAILABLE"
          ],
          "title": "Content Check Status",
          "type": "string"
        },
        "frame_check_status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNAVAILABLE"
          ],
          "title": "Frame Check Status",
          "type": "string"
        },
        "state": {
          "enum": [
            "NEEDS_REVIEW",
            "NEEDS_RECONCILIATION",
            "CONTENT_PENDING",
            "AWAITING_HUMAN_SUBMIT_FOR_OCR",
            "READY_FOR_SUBMISSION",
            "COMPLETED"
          ],
          "title": "State",
          "type": "string"
        },
        "recovery_refs": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "properties": {
              "artifact_id": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
                "title": "Artifact Id",
                "type": "string"
              },
              "revision": {
                "exclusiveMinimum": 0,
                "title": "Revision",
                "type": "integer"
              },
              "kind": {
                "const": "ReconciliationResult",
                "type": "string"
              },
              "content_hash": {
                "pattern": "^[0-9a-f]{64}$",
                "title": "Content Hash",
                "type": "string"
              }
            },
            "required": [
              "artifact_id",
              "revision",
              "kind",
              "content_hash"
            ],
            "title": "ArtifactRef",
            "type": "object"
          },
          "minItems": 0
        },
        "progress_refs": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "properties": {
              "artifact_id": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
                "title": "Artifact Id",
                "type": "string"
              },
              "revision": {
                "exclusiveMinimum": 0,
                "title": "Revision",
                "type": "integer"
              },
              "kind": {
                "const": "ExecutionProgress",
                "type": "string"
              },
              "content_hash": {
                "pattern": "^[0-9a-f]{64}$",
                "title": "Content Hash",
                "type": "string"
              }
            },
            "required": [
              "artifact_id",
              "revision",
              "kind",
              "content_hash"
            ],
            "title": "ArtifactRef",
            "type": "object"
          },
          "minItems": 0
        }
      },
      "required": [
        "source",
        "graph",
        "receipt",
        "postcheck",
        "scope_manifest",
        "questions",
        "total_expected",
        "coverage",
        "cost",
        "unresolved_issue_ids",
        "submission_status",
        "submission_evidence_refs",
        "content_check_status",
        "frame_check_status",
        "state",
        "recovery_refs",
        "progress_refs"
      ],
      "title": "BatchPayload",
      "type": "object"
    },
    "BatchReport": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.1.0-a-recovery-proposal",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "kind": {
          "const": "BatchReport",
          "title": "Kind",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "book_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Book Id",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Scope Id",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
