            "PAGE_MAPPING_UNCERTAIN",
            "UNASSIGNED_CONTENT",
            "CROSS_PAGE_OPEN",
            "OPTION_INCOMPLETE",
            "ANSWER_AMBIGUOUS",
            "POLICY_UNRESOLVED",
            "UNSUPPORTED_LAYOUT",
            "TARGET_CHANGED",
            "CONTENT_MISMATCH",
            "SAVE_UNKNOWN",
            "LOGIN_REQUIRED",
            "BUDGET_LIMIT"
          ],
          "title": "Code",
          "type": "string"
        },
        "scope_type": {
          "enum": [
            "book",
            "scope",
            "page",
            "question",
            "fragment",
            "region",
            "action"
          ],
