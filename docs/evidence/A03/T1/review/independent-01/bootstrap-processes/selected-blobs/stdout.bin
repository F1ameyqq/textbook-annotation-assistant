          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "minItems": 0
        },
        "readback": {
          "anyOf": [
            {
              "$ref": "#/$defs/Resource"
            },
            {
              "type": "null"
            }
          ]
        },
        "comparator_version": {
          "const": "a02-facts-1"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "replay_allowed": {
          "const": false
        }
      },
      "required": [
        "plan_ref",
        "intent_ref",
        "obligation_id",
        "action_id",
        "action_digest",
        "original_receipt_ref",
        "previous_resolution_ref",
        "observed_snapshot_ref",
        "observation_id",
        "recovery_call_id",
        "attempt_index",
        "observed_at",
