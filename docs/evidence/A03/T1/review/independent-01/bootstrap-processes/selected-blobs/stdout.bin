{
  "imports": {
    "annotation": {
      "path": "D:\\1800-worktrees\\a03-t1\\examples\\a03\\T1-capture\\runtime-view\\src\\annotation\\__init__.py",
      "sha256": "a11279a7897a17523423f81c888a410edfb53c74d36435f7ab7c7cfacc67ca2d"
