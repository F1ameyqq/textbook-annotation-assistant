"""Current target drift holds, separate from immutable resolution histories.

This mixin uses RuntimeStore's controlled files, book gate and transactions.
Observations are verified again by the independent target's persisted registry;
neither caller hashes nor a serialized completeness flag grant clearance.
"""
import hashlib
import json
from datetime import datetime
from pathlib import Path
import sqlite3
import time

from .common import Handle, canonical, digest, fail, plain, reference, unique


def _time(value):
    try:
        result = datetime.fromisoformat(value.replace('Z', '+00:00'))
        if result.tzinfo is None:
            raise ValueError('timezone required')
        return result
    except (ValueError, AttributeError):
        fail('HOLD_EVIDENCE_INVALID', 'invalid evidence timestamp')


class HoldSupport:
    def _hold_registration(self, target_key):
        key = self.book_id(plain(target_key))
        with self.connect() as connection:
            rows = connection.execute('SELECT * FROM registrations WHERE book=?', (key,)).fetchall()
        if len(rows) != 1:
            fail('REGISTRATION_BINDING_MISMATCH', 'one fixed target registration is required')
        return dict(rows[0])

    def _hold_observer(self, reg, observer=None):
        from annotation.delivery.mock.persistent import PersistentMockSession
        key = self.target_key(reg['id'])
        observer = observer or self._observers.get(reg['book'])
        if observer is None:
            observer = PersistentMockSession.open(reg['target_dir'], expected_store_id=self.target_store_id,
                expected_target_session_id=reg['session'], expected_target_key=key,
                expected_scope_id=reg['scope'], expected_source_ref=json.loads(reg['source']))
        if not isinstance(observer, PersistentMockSession):
            fail('HOLD_EVIDENCE_INVALID', 'only the registered controlled target observer is supported')
        descriptor = plain(observer.descriptor)
        expected = {'store_id': self.target_store_id, 'target_session_id': reg['session'],
                    'target_key': key, 'fixed_scope_id': reg['scope'],
                    'fixed_source_ref': json.loads(reg['source'])}
        if (any(descriptor.get(k) != v for k, v in expected.items()) or
                Path(observer.directory).resolve() != Path(reg['target_dir']).resolve() or
                Path(observer.asset_root).resolve() != Path(reg['package_root']).resolve()):
            fail('HOLD_EVIDENCE_INVALID', 'observer store/session/source/scope/root differs from registration')
        return observer

    def _hold_fence(self, observer, target_key, owner_id, generation):
        context = plain(observer.export_book_context(target_key))
        if (context.get('fence_generation') != generation or context.get('fence_owner_id') != owner_id or
                context.get('target_store_id') != self.target_store_id or context.get('target_key') != target_key):
            fail('OWNER_GENERATION_STALE', 'current independent target fence differs', 4)
        return context

    def _hold_artifact(self, connection, ref, reg, kind=None):
        from annotation.contracts import content_digest
        ref = plain(ref)
        if not isinstance(ref, dict) or set(ref) != {'artifact_id', 'revision', 'kind', 'content_hash'}:
            fail('HOLD_EVIDENCE_INVALID', 'exact four-field artifact reference required')
        rows = connection.execute('SELECT path FROM artifacts WHERE ref=? AND book=? AND scope=?',
            (canonical(ref).decode(), self.target_key(reg['id'])['book_id'], reg['scope'])).fetchall()
        if len(rows) != 1:
            fail('HOLD_EVIDENCE_INVALID', 'artifact is not indexed in the exact registered book/scope')
        artifact = json.loads(Path(rows[0]['path']).read_bytes())
        if reference(artifact) != ref or content_digest(artifact) != ref['content_hash'] or (kind and artifact['kind'] != kind):
            fail('HOLD_EVIDENCE_INVALID', 'indexed artifact identity or bytes differ')
        return artifact

    def _hold_native(self, reg, observer, resource, snapshot_ref=None):
        """Revalidate an old observation against target.sqlite3, across processes."""
        body = self.read_resource(plain(resource), reg['id'])
        if (body.get('format_version') != 'a03-target-observation-1' or
                body.get('target_key') != self.target_key(reg['id']) or
                body.get('target_session_id') != reg['session'] or
                body.get('source_ref') != json.loads(reg['source']) or body.get('scope_id') != reg['scope'] or
                body.get('store_id') != self.target_store_id or body.get('scope_complete') is not True):
            fail('HOLD_EVIDENCE_INVALID', 'native observation bindings are incomplete or foreign')
        # Runtime capture normalizes nested Resource paths and removes asset_root.
        # Verify the original target evidence first, then reproduce that portable
        # projection without writing files or trusting normalized caller fields.
        target = sqlite3.connect(observer.path.as_uri() + '?mode=ro', uri=True, timeout=1)
        try:
            row = target.execute('SELECT body FROM observations WHERE observation_id=?',
                                 (body.get('observation_id'),)).fetchone()
        finally:
            target.close()
        if row is None:
            fail('HOLD_EVIDENCE_INVALID', 'native persisted observation is missing')
        original = json.loads(row[0])
        raw = (json.dumps(original, sort_keys=True, ensure_ascii=False, indent=2, allow_nan=False) + '\n').encode('utf-8')
        original_resource = {'path': 'assets/a03-target/' + hashlib.sha256(raw).hexdigest() + '.json',
                             'sha256': hashlib.sha256(raw).hexdigest(), 'media_type': 'application/json', 'origin': 'SYNTHETIC'}
        root = Path(observer.asset_root).resolve()
        visiting = set()
        normalized_resources = {}

        def normalize_resource(ref):
            key = canonical(ref)
            if key in normalized_resources:
                return normalized_resources[key]
            path = (root / ref['path']).resolve()
            if root not in path.parents or path.is_symlink() or not path.is_file() or path in visiting:
                fail('HOLD_EVIDENCE_INVALID', 'native resource is missing, unsafe or cyclic')
            raw = path.read_bytes()
            if hashlib.sha256(raw).hexdigest() != ref['sha256'] or ref.get('media_type') != 'application/json':
                fail('HOLD_EVIDENCE_INVALID', 'native JSON resource digest or type differs')
            visiting.add(path)
            normalized = normalize(json.loads(raw))
            visiting.remove(path)
            sha = hashlib.sha256(canonical(normalized)).hexdigest()
            result = ({'path': 'assets/runtime/' + sha + '.json', 'sha256': sha,
                       'media_type': 'application/json', 'origin': 'SYNTHETIC'}, normalized)
            normalized_resources[key] = result
            return result

        def normalize(value):
            if isinstance(value, dict):
                if {'path', 'sha256', 'media_type'} <= set(value):
                    return normalize_resource(value)[0]
                return {name: normalize(member) for name, member in value.items() if name != 'asset_root'}
            if isinstance(value, list):
                return [normalize(member) for member in value]
            return value

        # This public target method reads its independent persisted observation
        # registry and verifies exact resource bytes before deriving the snapshot.
        snapshot = plain(observer.snapshot_from_observation(dict(original, resource=original_resource, readback=original_resource)))
        expected_resource, expected_body = normalize_resource(original_resource)
        if plain(resource) != expected_resource or body != expected_body:
            fail('HOLD_EVIDENCE_INVALID', 'runtime observation differs from the exact normalized native read')
        if snapshot_ref is not None and reference(snapshot) != plain(snapshot_ref):
            fail('HOLD_EVIDENCE_INVALID', 'snapshot is not derived from the exact persisted native observation')
        return original, snapshot

    def _hold_native_for_snapshot(self, connection, reg, observer, snapshot_ref):
        root = Path(reg['package_root']).resolve()
        snapshot = self._hold_artifact(connection, snapshot_ref, reg, 'PlatformSnapshot')
        for row in connection.execute('SELECT path,sha FROM files ORDER BY path'):
            path = (self.directory / row['path']).resolve()
            if root not in path.parents or path.suffix.lower() != '.json':
                continue
            try:
                value = json.loads(path.read_bytes())
            except (OSError, ValueError):
                fail('HOLD_EVIDENCE_INVALID', 'indexed JSON evidence is unreadable')
            if (not isinstance(value, dict) or value.get('format_version') != 'a03-target-observation-1' or
                    value.get('observed_at') != snapshot['payload']['observed_at']):
                continue
            resource = {'path': path.relative_to(root).as_posix(), 'sha256': row['sha'],
                        'media_type': 'application/json', 'origin': 'SYNTHETIC'}
            body, actual = self._hold_native(reg, observer, resource)
            if reference(actual) == plain(snapshot_ref):
                return body, actual, resource
        fail('HOLD_EVIDENCE_INVALID', 'snapshot has no persisted runtime/target native observation binding')

    def _hold_baseline(self, connection, reg, observer):
        terminal_seen, expected = False, None
        for row in connection.execute('SELECT body FROM events WHERE book=? ORDER BY sequence', (reg['book'],)):
            event = json.loads(row['body'])
            payload = event['payload']
            resource, snapshot_ref, ref = None, None, None
            if event['event'] == 'RECONCILIATION_COMMITTED' and payload.get('resolution') in ('RESOLVED_APPLIED', 'RESOLVED_NOT_APPLIED'):
                resolution = self._hold_artifact(connection, payload['resolution_ref'], reg, 'ReconciliationResult')
                rp = resolution['payload']
                if rp['resolution'] != payload['resolution']:
                    fail('HOLD_EVIDENCE_INVALID', 'terminal event differs from immutable resolution')
                terminal_seen = True
                resource, snapshot_ref, ref = rp['readback'], rp['observed_snapshot_ref'], reference(resolution)
            elif terminal_seen and event['event'] == 'ACTION_RESULT_COMMITTED' and payload.get('outcome') == 'APPLIED':
                fact = self.read_resource(payload['fact'], reg['id'])
                if (fact['action_id'] != payload['action_id'] or fact['action_digest'] != payload['action_digest'] or
                        fact['result']['outcome'] != 'APPLIED' or fact['journal_sequence'] != event['sequence'] or
                        fact['predecessor_hash'] != event['previous_hash']):
                    fail('HOLD_EVIDENCE_INVALID', 'applied event differs from immutable fact')
                resource, snapshot_ref, ref = fact['readback'], fact['observed_snapshot_ref'], payload['fact']
            elif terminal_seen and event['event'] == 'HOLD_CLEARED':
                resource, snapshot_ref, ref = payload['verification_observation'], payload['verification_snapshot_ref'], payload['candidate_plan_ref']
            if resource is not None:
                expected = {'event_sequence': event['sequence'], 'event_hash': event['event_hash'],
                    'event': event['event'], 'binding': ref, 'plan_ref': payload.get('plan_ref'),
                    '_resource': resource, '_snapshot_ref': snapshot_ref}
        if expected is not None:
            body, _ = self._hold_native(reg, observer, expected.pop('_resource'), expected.pop('_snapshot_ref'))
            expected.update(target_state_hash=body['target_state_hash'], target_state_version=body['target_state_version'],
                            read_sequence=body['read_sequence'], observed_at=body['observed_at'])
        return expected if terminal_seen else None

    def _hold_read(self, reg, observer, deadline, *, capture=True):
        from annotation.runtime.recovery.observation import observe_bounded
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            fail('RECOVERY_DEADLINE_EXCEEDED', 'hold operation deadline exhausted', 6)
        result = observe_bounded(observer, timeout=min(2, remaining))
        if not result.get('ok') or not result.get('process_reaped') or result['read_elapsed_seconds'] > 2:
            fail(result.get('code', 'TARGET_READ_TIMEOUT'), 'hold observation failed within its bounded process', 6)
        original = result['observation']
        if not capture:
            snapshot = plain(observer.snapshot_from_observation(original))
            if (original.get('target_key') != self.target_key(reg['id']) or
                    original.get('target_session_id') != reg['session'] or original.get('scope_id') != reg['scope'] or
                    original.get('source_ref') != json.loads(reg['source']) or original.get('store_id') != self.target_store_id):
                fail('HOLD_EVIDENCE_INVALID', 'current native observation differs from registration')
            return original, snapshot, original
        captured, snapshot = self.capture_observation(original, observer, reg['id'])
        if snapshot is None:
            fail('HOLD_EVIDENCE_INVALID', 'hold requires a complete fresh native observation')
        body, actual = self._hold_native(reg, observer, captured['resource'], reference(snapshot))
        return captured, actual, body

    def _hold_assert_head(self, book, expected):
        if (book['head_sequence'], book['head_hash']) != expected:
            fail('EVENT_HEAD_CAS_MISMATCH', 'book event head changed during hold operation', 4)

    def _hold_current(self, observer, target_key, owner_id, generation, actual):
        from annotation.contracts import target_state_digest
        current = self._hold_fence(observer, target_key, owner_id, generation)
        live = plain(observer.read_target(target_key['book_id']))
        if (current['target_state_hash'] != actual['target_state_hash'] or
                (target_state_digest(live), 'a03-target-epoch-' + str(live['epoch'])) !=
                (actual['target_state_hash'], actual['target_state_version'])):
            fail('TARGET_CHANGED', 'target changed during final hold transaction', 3)

    def detect_target_drift(self, target_key, *, owner_id, generation, observer=None):
        target_key = plain(target_key)
        reg = self._hold_registration(target_key)
        observer = self._hold_observer(reg, observer)
        deadline = time.monotonic() + 60
        with self.effect_gate(target_key).acquire():
            self.verify_integrity()
            with self.connect() as connection:
                book = self._lease(connection, reg['book'], owner_id, generation, pending_ok=True)
                if book['hold']:
                    return Handle(status='TARGET_DRIFT_HOLD', hold_id=book['hold'], created=False)
                expected_head = (book['head_sequence'], book['head_hash'])
                baseline = self._hold_baseline(connection, reg, observer)
            if baseline is None:
                return Handle(status='NO_TERMINAL_BASELINE', hold_id=None, created=False)
            self._hold_fence(observer, target_key, owner_id, generation)
            captured, snapshot, actual = self._hold_read(reg, observer, deadline, capture=False)
            matches = (actual['target_state_hash'], actual['target_state_version']) == (baseline['target_state_hash'], baseline['target_state_version'])
            if not matches:
                captured, snapshot = self.capture_observation(captured, observer, reg['id'])
                if snapshot is None:
                    fail('HOLD_EVIDENCE_INVALID', 'hold requires a complete valid native snapshot')
                actual, snapshot = self._hold_native(reg, observer, captured['resource'], reference(snapshot))
            with self.transaction() as connection:
                book = self._lease(connection, reg['book'], owner_id, generation, pending_ok=True)
                self._hold_assert_head(book, expected_head)
                self._hold_current(observer, target_key, owner_id, generation, actual)
                if time.monotonic() >= deadline:
                    fail('RECOVERY_DEADLINE_EXCEEDED', 'hold operation deadline exhausted', 6)
                if matches:
                    return Handle(status='NO_DRIFT', hold_id=None, created=False,
                                  target_state_hash=actual['target_state_hash'], target_state_version=actual['target_state_version'],
                                  read_sequence=actual['read_sequence'])
                self._append(connection, reg['id'], snapshot)
                hold_id = unique('target-drift-hold')
                prior_prechecks = []
                bundle = self.bundle(reg['id'])
                for artifact in bundle['artifacts']:
                    if artifact['kind'] == 'ApplyPlan':
                        ref = artifact['payload']['precheck']
                        if ref not in prior_prechecks:
                            prior_prechecks.append(ref)
                payload = {'hold_id': hold_id, 'registration_id': reg['id'], 'plan_ref': baseline['plan_ref'],
                    'baseline': baseline, 'observation': captured['resource'], 'snapshot_ref': reference(snapshot),
                    'observation_id': actual['observation_id'], 'observed_at': actual['observed_at'],
                    'read_sequence': actual['read_sequence'], 'target_state_hash': actual['target_state_hash'],
                    'target_state_version': actual['target_state_version'], 'target_store_id': self.target_store_id,
                    'target_session_id': reg['session'], 'source_ref': json.loads(reg['source']), 'scope_id': reg['scope'],
                    'prior_precheck_refs': prior_prechecks}
                event = self._event(connection, reg['book'], 'TARGET_DRIFT_HOLD', payload)
                connection.execute('UPDATE books SET hold=? WHERE key=?', (hold_id, reg['book']))
            return Handle(status='TARGET_DRIFT_HOLD', hold_id=hold_id, created=True, event=event,
                          snapshot_ref=reference(snapshot), observation=captured['resource'])

    def clear_target_drift_hold(self, hold_id, snapshot_ref, precheck_ref, targetcheck_ref,
                               candidate_plan_ref, *, owner_id, generation):
        from annotation.contracts import (ContractError, assert_recovery_plan_ready, validate_recovery_bundle)
        from annotation.delivery.planner import verify_generated_plan
        from annotation.runtime.recovery import configuration
        deadline = time.monotonic() + 60
        with self.connect() as connection:
            rows = connection.execute('SELECT key FROM books WHERE hold=?', (hold_id,)).fetchall()
            if len(rows) != 1:
                fail('HOLD_EVIDENCE_INVALID', 'exact active hold does not exist')
            target_key = json.loads(connection.execute('SELECT target_key FROM books WHERE key=?', (rows[0]['key'],)).fetchone()[0])
        reg = self._hold_registration(target_key)
        observer = self._hold_observer(reg)
        with self.effect_gate(target_key).acquire():
            self.verify_integrity()
            with self.connect() as connection:
                book = self._lease(connection, reg['book'], owner_id, generation, pending_ok=True)
                if book['hold'] != hold_id:
                    fail('HOLD_EVIDENCE_INVALID', 'active hold changed')
                if self._pending(connection, reg['book']):
                    fail('BOOK_WRITE_PAUSED', 'all book scopes must have no unresolved save obligation', 3)
                expected_head = (book['head_sequence'], book['head_hash'])
                hold = None
                for row in connection.execute('SELECT body FROM events WHERE book=? ORDER BY sequence DESC', (reg['book'],)):
                    event = json.loads(row['body'])
                    if event['event'] == 'TARGET_DRIFT_HOLD' and event['payload'].get('hold_id') == hold_id:
                        hold = event
                        break
                if hold is None:
                    fail('HOLD_EVIDENCE_INVALID', 'active hold lacks its immutable event')
                refs = [(snapshot_ref, 'PlatformSnapshot'), (precheck_ref, 'CheckReport'),
                        (targetcheck_ref, 'CheckReport'), (candidate_plan_ref, 'ApplyPlan')]
                snapshot, precheck, targetcheck, plan = [self._hold_artifact(connection, ref, reg, kind) for ref, kind in refs]
                native, _, native_resource = self._hold_native_for_snapshot(connection, reg, observer, snapshot_ref)
            self._hold_fence(observer, target_key, owner_id, generation)
            hp = hold['payload']
            if (_time(native['observed_at']) <= max(_time(hp['observed_at']), _time(hold['recorded_at'])) or
                    native['read_sequence'] <= hp['read_sequence']):
                fail('OBSERVATION_NOT_FRESH', 'candidate snapshot must be a new actual observation after the hold')
            if (plain(precheck_ref) in hp['prior_precheck_refs'] or _time(precheck['created_at']) <= _time(hold['recorded_at']) or
                    precheck['payload']['stage'] != 'PRE_APPLY' or precheck['payload']['decision'] != 'PASS'):
                fail('HOLD_EVIDENCE_INVALID', 'a genuinely new post-hold PRE_APPLY is required; old PRE cannot be relabeled by this runtime')
            pp = plan['payload']
            if (pp['snapshot'] != plain(snapshot_ref) or pp['precheck'] != plain(precheck_ref) or
                    pp['targetcheck'] != plain(targetcheck_ref) or targetcheck['payload']['stage'] != 'TARGET' or
                    targetcheck['payload']['snapshot'] != plain(snapshot_ref) or targetcheck['payload']['subject'] != plain(snapshot_ref) or
                    targetcheck['payload']['decision'] != 'PASS' or _time(targetcheck['created_at']) < _time(native['observed_at']) or
                    _time(plan['created_at']) < max(_time(native['observed_at']), _time(precheck['created_at']), _time(targetcheck['created_at']))):
                fail('HOLD_EVIDENCE_INVALID', 'candidate plan/new PRE/new TARGET/current snapshot bindings differ')
            try:
                bundle = self._validate(self.bundle(reg['id']), asset_root=reg['package_root'])
                selected = assert_recovery_plan_ready(bundle, candidate_plan_ref, snapshot_ref, bridge_context=getattr(bundle, "bridge_context", None))
                verify_generated_plan(bundle, selected, snapshot_ref, configuration(json.loads(reg['config'])), bridge_context=getattr(bundle, "bridge_context", None))
            except ContractError as error:
                code = error.issues[0]['code'] if error.issues else 'HOLD_EVIDENCE_INVALID'
                fail(code if code in ('TARGET_CHANGED', 'OBSERVATION_NOT_FRESH', 'BOOK_WRITE_PAUSED') else 'HOLD_EVIDENCE_INVALID', str(error))
            # Retain the same book gate while the independent target is read.
            # No dispatch permit is issued or consumed by this route.
            self.renew(target_key, owner_id=owner_id, generation=generation)
            captured, verified_snapshot, actual = self._hold_read(reg, observer, deadline)
            if (actual['target_state_hash'], actual['target_state_version']) != (native['target_state_hash'], native['target_state_version']):
                fail('TARGET_CHANGED', 'target changed after candidate planning; hold remains', 3)
            self.fault('BEFORE_HOLD_CLEAR_COMMIT')
            with self.transaction() as connection:
                book = self._lease(connection, reg['book'], owner_id, generation, pending_ok=True)
                self._hold_assert_head(book, expected_head)
                if book['hold'] != hold_id or self._pending(connection, reg['book']):
                    fail('BOOK_WRITE_PAUSED', 'hold or full-book unresolved set changed', 3)
                self._hold_current(observer, target_key, owner_id, generation, actual)
                if time.monotonic() >= deadline:
                    fail('RECOVERY_DEADLINE_EXCEEDED', 'hold clearance deadline exhausted', 6)
                self._append(connection, reg['id'], verified_snapshot)
                payload = {'hold_id': hold_id, 'hold_event_hash': hold['event_hash'], 'registration_id': reg['id'],
                    'plan_ref': plain(candidate_plan_ref), 'candidate_plan_ref': plain(candidate_plan_ref),
                    'snapshot_ref': plain(snapshot_ref), 'precheck_ref': plain(precheck_ref), 'targetcheck_ref': plain(targetcheck_ref),
                    'candidate_observation': native_resource, 'verification_observation': captured['resource'],
                    'verification_snapshot_ref': reference(verified_snapshot), 'target_state_hash': actual['target_state_hash'],
                    'target_state_version': actual['target_state_version'], 'read_sequence': actual['read_sequence']}
                event = self._event(connection, reg['book'], 'HOLD_CLEARED', payload)
                connection.execute('UPDATE books SET hold=NULL WHERE key=? AND hold=?', (reg['book'], hold_id))
            return Handle(cleared=True, hold_id=hold_id, event_head={'sequence': event['sequence'], 'hash': event['event_hash']},
                          event=event, target_effects=0)

2fec8b724631e47498df9a0ac0a10ba17a55b22d blob 29948
"""Fresh native runtime store and process-private actual PRE registry.

All persistent writes, owner/currentness checks and proof issuance live here.
The ordinary intent, fence, permit and effect implementations remain in base.
"""
import hashlib
import json
from pathlib import Path
import sqlite3
import time

from annotation.contracts import artifact_ref, content_digest
from annotation.contracts.a03_native import (EXCHANGE, _attach_registry, _issue_context,
    require_context, select_native_codec, validate_native_bundle)
from . import RuntimeStore, SQL, CURRENT, exclusive_bytes
from .common import Handle, canonical, digest, fail, now, plain, reference, unique

NATIVE_SQL = '''
CREATE TABLE native_pre_runs(id TEXT PRIMARY KEY, registration TEXT NOT NULL,
    binding TEXT NOT NULL, head_sequence INTEGER NOT NULL, head_hash TEXT NOT NULL,
    created REAL NOT NULL, reads INTEGER NOT NULL, status TEXT NOT NULL,
    snapshot TEXT, observation TEXT, input_sha TEXT, input_manifest TEXT,
    pre_ref TEXT, run_sha TEXT, accepted_plan TEXT,
    UNIQUE(registration,head_sequence,head_hash));
CREATE TABLE native_creation_anchors(plan_artifact_id TEXT PRIMARY KEY,
    input_path TEXT NOT NULL,input_sha TEXT NOT NULL,manifest TEXT NOT NULL,
    config TEXT NOT NULL,created_at TEXT NOT NULL,run_id TEXT NOT NULL);
CREATE TABLE native_report_reads(plan_id TEXT PRIMARY KEY,created REAL NOT NULL,reads INTEGER NOT NULL);
'''


class RegisteredRunHandle:
    __slots__ = ('run_id', '_registry', '_pid')

    def __init__(self, run_id, registry):
        import os
        self.run_id, self._registry, self._pid = run_id, registry, os.getpid()


class AdmittedPreRun:
    __slots__ = ('run_id', 'pre_ref', 'input_sha256', 'snapshot_ref', '_registry', '_token')

    def __init__(self, run, registry, token):
        self.run_id, self.pre_ref = run['id'], json.loads(run['pre_ref'])
        self.input_sha256, self.snapshot_ref = run['input_sha'], json.loads(run['snapshot'])
        self._registry, self._token = registry, token


class NativeRegistry:
    def __init__(self, store):
        self.store, self.registry_id = store, unique('native-registry')
        self.handles, self.admitted, self.roots = {}, {}, set()
        self._callback = self._dispatch
        _attach_registry(self, self._callback)

    def context(self, bundle, root, *, binding='', historical=False):
        root = Path(root).resolve(strict=True)
        self.roots.add(root)
        return _issue_context(self, bundle, root, binding=binding, historical=historical)

    def _handle(self, handle):
        import os
        if (type(handle) is not RegisteredRunHandle or self.handles.get(id(handle)) is not handle
                or handle._registry is not self or handle._pid != os.getpid()):
            fail('NATIVE_RUN_HANDLE_REQUIRED', 'serialized or foreign PRE run handle rejected')
        with self.store.connect() as connection:
            row = connection.execute('SELECT * FROM native_pre_runs WHERE id=?', (handle.run_id,)).fetchone()
        if row is None:
            fail('NATIVE_RUN_MISSING')
        return dict(row)

    def _current(self, row, *, accepted=False):
        reg = self.store.registration(row['registration'])
        binding = json.loads(row['binding'])
        with self.store.connect() as connection:
            context = binding['context']
            head = (row['head_sequence'], row['head_hash']) if not accepted or context['kind'] == 'POST_HOLD' else None
            book = self.store._pre_lease(connection, reg, binding['owner_id'], binding['generation'],
                kind=context['kind'], context=context, expected_head=head, accepted=accepted)
            if not accepted and (book['head_sequence'], book['head_hash']) != (row['head_sequence'], row['head_hash']):
                fail('NATIVE_RUN_STALE_HEAD', 'whole-book head progressed after actual PRE')
            expected = binding['context']['hold_id']
            if book['hold'] != expected or (not accepted and self.store._pending(connection, reg['book'])):
                fail('NATIVE_RUN_CURRENTNESS', 'current hold/pending differs from actual run')
        if time.time() > row['created'] + 60:
            fail('NATIVE_PRE_DEADLINE_EXCEEDED', 'durable PRE window expired; reopen does not refresh it')
        observer = self.store._observers.get(reg['book'])
        if observer is None:
            fail('NATIVE_PRE_OBSERVER_REQUIRED')
        self.store._hold_fence(observer, self.store.target_key(reg['id']), binding['owner_id'], binding['generation'])
        if row['observation']:
            body = json.loads(row['observation'])
            self.store._hold_native(reg, observer, body['resource'], json.loads(row['snapshot']))
        return reg, binding

    def _dispatch(self, operation, context, **kwargs):
        if context._registry is not self:
            fail('NATIVE_CONTEXT_FOREIGN')
        if operation == 'derive_context':
            root = Path(kwargs['asset_root']).resolve(strict=True)
            if root not in self.roots:
                fail('NATIVE_CONTEXT_ROOT_FOREIGN')
            return self.context(kwargs['bundle'], root, binding=context._binding, historical=context._historical)
        if operation == 'producer_binding':
            row = self._handle(kwargs['handle'])
            reg, binding = self._current(row)
            if (json.loads(row['snapshot']) != plain(kwargs['snapshot_ref'])
                    or json.loads(row['observation']) != plain(kwargs['observation'])):
                fail('NATIVE_PRE_OBSERVATION_FOREIGN')
            return {'run_id': row['id'], 'context': binding['context'],
                'input_manifest': self.store.resource_manifest(kwargs.get('bundle') or self.store.bundle(reg['id']), reg['package_root']),
                'native_binding': {key: binding[key] for key in
                    ('registry_id', 'registration_id', 'owner_id', 'generation', 'target_store_id', 'target_session_id')}}
        if operation == 'admit_pre':
            row = self._handle(kwargs['handle'])
            reg, binding = self._current(row)
            bundle = kwargs['bundle']
            pre = next((a for a in bundle.artifacts if artifact_ref(a) == plain(kwargs['pre_ref'])), None)
            if pre is None or pre.kind != 'CheckReport' or pre.payload.stage != 'PRE_APPLY' or pre.payload.decision != 'PASS':
                fail('NATIVE_PRE_FAILED')
            run = self.store.read_resource(plain(pre.payload.synthetic_run_ref), reg['id'])
            expected_binding = {key: binding[key] for key in
                ('registry_id', 'registration_id', 'owner_id', 'generation', 'target_store_id', 'target_session_id')}
            if (run['run_id'] != row['id'] or run['native_binding'] != expected_binding
                    or run['context'] != binding['context'] or run['snapshot_ref'] != json.loads(row['snapshot'])
                    or run['snapshot_ref'] != plain(kwargs['snapshot_ref'])
                    or run['actual_observation'] != json.loads(row['observation'])['resource']
                    or run['input_raw_sha256'] != row['input_sha'] or run['input_manifest'] != json.loads(row['input_manifest'])):
                fail('NATIVE_PRE_BINDING_MISMATCH')
            from annotation.quality.synthetic_precheck import compare_synthetic_inputs, CHECKS
            checks = compare_synthetic_inputs(bundle, run['source_ref'], run['evidence_ref'], run['graph_ref'], run['policy_ref'], asset_root=reg['package_root'])
            if checks != run['checks'] or set(checks) != set(CHECKS) or any(v != 'PASS' for v in checks.values()):
                fail('NATIVE_PRE_FAILED', 'actual comparison does not support self-reported PASS')
            original = self.store.bundle(reg['id'])
            incoming = plain(bundle)
            if incoming['artifacts'] != original['artifacts'] + [plain(pre)] or incoming['evidence'][:-1] != original['evidence']:
                fail('NATIVE_PRE_INPUT_EXTENSION', 'admission only appends the produced PRE and its actual run evidence')
            with self.store.transaction() as connection:
                # Recheck the row and head under the committing transaction.
                book = self.store._pre_lease(connection, reg, binding['owner_id'], binding['generation'],
                    kind=binding['context']['kind'], context=binding['context'],
                    expected_head=(row['head_sequence'], row['head_hash']))
                if (book['head_sequence'], book['head_hash']) != (row['head_sequence'], row['head_hash']):
                    fail('NATIVE_RUN_STALE_HEAD')
                if connection.execute('SELECT status FROM native_pre_runs WHERE id=?', (row['id'],)).fetchone()[0] != 'OBSERVED':
                    fail('NATIVE_PRE_REPLAY')
                connection.execute('UPDATE native_pre_runs SET status=?,pre_ref=?,run_sha=? WHERE id=?',
                    ('ADMITTED', canonical(kwargs['pre_ref']).decode(), pre.payload.synthetic_run_ref.sha256, row['id']))
                for resource in self.store.resource_manifest(incoming, reg['package_root']):
                    path = Path(reg['package_root']) / resource['path']
                    self.store._file(path, path.read_bytes(), connection)
                self.store._artifact(connection, plain(pre))
                self.store._save_bundle(connection, reg['id'], incoming)
            with self.store.connect() as connection:
                actual = dict(connection.execute('SELECT * FROM native_pre_runs WHERE id=?', (row['id'],)).fetchone())
            token = object()
            proof = AdmittedPreRun(actual, self, token)
            self.admitted[digest(kwargs['pre_ref'])] = (proof, token)
            return proof
        if operation == 'assert_pre':
            entry = self.admitted.get(digest(kwargs['pre_ref']))
            if not entry or type(entry[0]) is not AdmittedPreRun or entry[0]._token is not entry[1]:
                fail('NATIVE_ADMITTED_RUN_REQUIRED', 'PASS bytes or reopened registry cannot recreate process-private proof')
            with self.store.connect() as connection:
                row = dict(connection.execute('SELECT * FROM native_pre_runs WHERE id=?', (entry[0].run_id,)).fetchone())
            if json.loads(row['pre_ref']) != plain(kwargs['pre_ref']) or json.loads(row['snapshot']) != plain(kwargs['snapshot_ref']):
                fail('NATIVE_PRE_BINDING_MISMATCH')
            self._current(row, accepted=bool(row['accepted_plan']))
            if row['accepted_plan']:
                with self.store.connect() as connection:
                    plan = connection.execute('SELECT * FROM plans WHERE id=?', (row['accepted_plan'],)).fetchone()
                    if not plan or plan['status'] != 'RUNNING':
                        fail('NATIVE_ACCEPTED_PLAN_NOT_CURRENT')
            return entry[0]
        if operation == 'creation_anchor':
            if context._historical:
                return None
            raw = canonical(plain(kwargs['bundle']))
            path = self.store.object(plain(kwargs['bundle']))
            values = (kwargs['artifact_id'], str(path), hashlib.sha256(raw).hexdigest(),
                canonical(self.store.resource_manifest(kwargs['bundle'], context.asset_root)).decode(),
                canonical(vars(kwargs['config'])).decode(), kwargs['created_at'], kwargs['run_id'])
            with self.store.transaction() as connection:
                if connection.execute('SELECT 1 FROM native_creation_anchors WHERE plan_artifact_id=?', (kwargs['artifact_id'],)).fetchone():
                    fail('NATIVE_CREATION_ANCHOR_EXISTS')
                connection.execute('INSERT INTO native_creation_anchors VALUES(?,?,?,?,?,?,?)', values)
            return None
        if operation == 'verify_creation_anchor':
            from annotation.delivery.planner import create_plan
            from annotation.runtime.recovery import configuration
            plan = kwargs['plan']
            with self.store.connect() as connection:
                row = connection.execute('SELECT * FROM native_creation_anchors WHERE plan_artifact_id=?', (plan.artifact_id,)).fetchone()
            if not row:
                fail('NATIVE_CREATION_ANCHOR_MISSING')
            raw = Path(row['input_path']).read_bytes()
            if hashlib.sha256(raw).hexdigest() != row['input_sha']:
                fail('NATIVE_CREATION_ANCHOR_HASH')
            original = json.loads(raw)
            if self.store.resource_manifest(original, context.asset_root) != json.loads(row['manifest']):
                fail('NATIVE_CREATION_MANIFEST_CHANGED')
            if canonical(vars(kwargs['config'])).decode() != row['config']:
                fail('NATIVE_CREATION_CONFIG_CHANGED')
            historical = self.context(original, context.asset_root, binding=context._binding, historical=True)
            payload = plan.payload
            generated = create_plan(original, payload.graph, payload.precheck, payload.targetcheck,
                payload.snapshot, payload.snapshot, payload.policy, kwargs['config'], artifact_id=plan.artifact_id,
                created_at=plan.created_at, run_id=plan.run_id, bridge_context=historical)
            if generated.artifacts[-1] != plan:
                fail('PLAN_CHANGED')
            binding = kwargs.get('observation_binding')
            if binding is not None and (plain(binding).get('plan_ref') != artifact_ref(plan)
                    or plain(binding).get('observed_snapshot_ref') != plain(kwargs['current_ref'])):
                fail('OBSERVATION_BINDING_MISMATCH')
            return None
        fail('NATIVE_REGISTRY_OPERATION_UNSUPPORTED', operation)


class NativeRuntimeStore(RuntimeStore):
    _db_version = 'a03-native-runtime-db-1'
    _application_id = 0x41303452
    _user_version = 4

    def _project_unknown_diagnostic_post(self):
        # Native reports require their own fresh observation and explicit publisher.
        return False

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.native_registry = NativeRegistry(self)

    def _expected_meta(self):
        result = super()._expected_meta()
        selection = select_native_codec()
        result.update(profile=selection.profile_id, profile_sha256=selection.profile_sha256,
            adoption_sha256=selection.adoption_sha256, initialization='COMPLETE', migration='NOT_IMPLEMENTED_BLOCKED')
        return result

    def bridge_for(self, bundle, root=None):
        return self.native_registry.context(bundle, root or getattr(bundle, 'asset_root', None))

    def _post_hold_event(self, connection, reg, book):
        """Read the immutable hold for this fixed registration, not writer authority."""
        for row in connection.execute('SELECT body FROM events WHERE book=? ORDER BY sequence DESC', (reg['book'],)):
            event = json.loads(row['body'])
            if event['event'] != 'TARGET_DRIFT_HOLD' or event['payload'].get('hold_id') != book['hold']:
                continue
            payload = event['payload']
            if (event['target_key'] != json.loads(book['target_key'])
                    or payload.get('registration_id') != reg['id'] or payload.get('scope_id') != reg['scope']
                    or payload.get('source_ref') != json.loads(reg['source'])
                    or payload.get('target_store_id') != self.target_store_id
                    or payload.get('target_session_id') != reg['session']):
                fail('HOLD_EVIDENCE_INVALID', 'active hold differs from exact registered source/target/session')
            return event
        fail('HOLD_EVIDENCE_INVALID', 'active hold lacks its exact immutable event')

    def _pre_lease(self, connection, reg, owner_id, generation, *, kind, context=None,
                   expected_head=None, accepted=False):
        """POST_HOLD read-only PRE exception with explicit pending/hold/head checks.

        Shared _lease still proves ACTIVE owner/generation/PID/instance. Its
        ordinary and INITIAL hold prohibition is unchanged. This helper neither
        clears a hold nor grants a plan/intent/permit or target effect.
        """
        if kind not in ('INITIAL', 'POST_HOLD'):
            fail('NATIVE_PRE_CONTEXT_INVALID')
        post_hold = kind == 'POST_HOLD'
        book = self._lease(connection, reg['book'], owner_id, generation, pending_ok=accepted or post_hold)
        if post_hold:
            if self._pending(connection, reg['book']):
                fail('BOOK_WRITE_PAUSED', 'POST_HOLD PRE cannot bypass unresolved book obligations', 3)
            if not book['hold']:
                fail('NATIVE_RUN_CURRENTNESS' if context else 'NATIVE_PRE_CONTEXT_INVALID', 'POST_HOLD needs the actual current hold')
            event = self._post_hold_event(connection, reg, book)
            if context is not None:
                if context['hold_id'] != book['hold']:
                    fail('NATIVE_RUN_CURRENTNESS', 'POST_HOLD run belongs to another hold')
                if (expected_head is None or context['hold_head'] != {'sequence': expected_head[0], 'hash': expected_head[1]}):
                    fail('NATIVE_RUN_STALE_HEAD', 'POST_HOLD context does not bind its registered head')
                if self.read_resource(context['hold_ref'], reg['id']) != event:
                    fail('NATIVE_RUN_CURRENTNESS', 'POST_HOLD resource is not the exact current hold event')
        if expected_head is not None and (book['head_sequence'], book['head_hash']) != expected_head:
            fail('NATIVE_RUN_STALE_HEAD', 'whole-book head progressed after actual PRE')
        return book

    def verify_integrity(self):
        super().verify_integrity()
        with self.connect() as connection:
            names = {row[0] for row in connection.execute("SELECT name FROM sqlite_master WHERE type='table'")}
            if not {'native_pre_runs', 'native_creation_anchors', 'native_report_reads'} <= names:
                fail('NATIVE_INITIALIZATION_INCOMPLETE', 'native tables missing; no automatic completion', 5)
        return True

    def _append(self, connection, registration_id, *artifacts):
        row = connection.execute('SELECT * FROM registrations WHERE id=?', (registration_id,)).fetchone()
        bundle = json.loads(Path(row['bundle_path']).read_bytes())
        for artifact in artifacts:
            if not any(reference(a) == reference(artifact) for a in bundle['artifacts']):
                bundle['artifacts'].append(plain(artifact))
        self._validate(bundle, asset_root=row['package_root'])
        return super()._append(connection, registration_id, *artifacts)

    def commit_reconciliation(self, result, *, owner_id, generation):
        committed = super().commit_reconciliation(result, owner_id=owner_id, generation=generation)
        payload = plain(result)['payload']
        if payload['resolution'] == 'STILL_UNKNOWN':
            return committed
        # A late material fact belongs to the existing intent and terminal head.
        # Keep the original intent/progress/UNKNOWN and null original receipt.
        registration_id = self._observations[payload['observation_id']][2]
        target_key = self.target_key(registration_id)
        with self.effect_gate(target_key).acquire(), self.transaction() as connection:
            intent = connection.execute('SELECT * FROM intents WHERE ref=?', (canonical(payload['intent_ref']).decode(),)).fetchone()
            plan_row = connection.execute('SELECT * FROM plans WHERE id=?', (intent['plan'],)).fetchone()
            reg = self.registration(plan_row['registration'])
            self._lease(connection, reg['book'], owner_id, generation, pending_ok=True)
            plan = self._plan(reg['id'], intent['plan'])
            stored = json.loads(Path(intent['prepared']).read_bytes())
            outcome = 'APPLIED' if payload['resolution'] == 'RESOLVED_APPLIED' else 'NOT_APPLIED'
            before_id = self._evidence(connection, reg['id'], stored['intent']['payload']['prepared_before'])
            after_id = self._evidence(connection, reg['id'], payload['readback'])
            result_value = {'action_id': intent['action'], 'outcome': outcome, 'platform_ids': payload['platform_ids'],
                'before_evidence_refs': [before_id], 'after_evidence_refs': [after_id], 'readback': payload['readback'],
                'effect_match': payload['observation'], 'next_step': 'POSTCHECK' if outcome == 'APPLIED' else 'RECHECK_TARGET',
                'replay_allowed': False, 'reason': 'Late fact from exact committed read-only terminal head',
                'attempt_fact': 'MAY_HAVE_BEEN_ATTEMPTED', 'attempt_evidence_refs': [payload['readback']], 'intent_ref': payload['intent_ref']}
            book = connection.execute('SELECT * FROM books WHERE key=?', (reg['book'],)).fetchone()
            fact = {'format_version': 'a03-action-fact-3', 'design_only': False, 'origin_phase': 'RECOVERY',
                'resolution_ref': reference(result), 'plan_ref': reference(plan), 'intent_ref': payload['intent_ref'],
                'obligation_id': payload['obligation_id'], 'action_id': intent['action'], 'action_digest': payload['action_digest'],
                'prepared_before': stored['intent']['payload']['prepared_before'],
                'observed_snapshot_ref': payload['observed_snapshot_ref'], 'readback': payload['readback'],
                'comparator_version': 'a02-facts-1', 'result': result_value, 'journal_sequence': book['head_sequence'],
                'predecessor_hash': payload.get('journal_head_hash', book['head_hash']), 'unattempted_basis': None}
            resource = self.resource(fact, reg['id'], connection)
            connection.execute('UPDATE actions SET fact=?,state=? WHERE book=? AND id=?',
                (canonical(resource).decode(), outcome, reg['book'], intent['action']))
        self.project_plan(reg['id'], plan)
        return committed

    @staticmethod
    def resource_manifest(bundle, root):
        from annotation.contracts.a03_bridge._resources import ResourceReader
        root = Path(root).resolve()
        reader, found = ResourceReader(root), {}

        def walk(value):
            if isinstance(value, dict):
                if {'path', 'sha256', 'media_type'} <= set(value):
                    token = (value['path'], value['sha256'], value['media_type'])
                    if token in found:
                        return
                    found[token] = {key: value[key] for key in ('path', 'sha256', 'media_type', 'origin')}
                    walk(reader.read(value))
                else:
                    for child in value.values():
                        walk(child)
            elif isinstance(value, list):
                for child in value:
                    walk(child)
        walk(plain(bundle))
        return [found[key] for key in sorted(found)]

    def begin_native_pre(self, registration_id, *, owner_id, generation, observer, kind='INITIAL'):
        from annotation.runtime.recovery.observation import observe_bounded
        reg = self.registration(registration_id)
        self._hold_observer(reg, observer)
        self._observers[reg['book']] = observer
        with self.effect_gate(self.target_key(reg['id'])).acquire():
            with self.transaction() as connection:
                book = self._pre_lease(connection, reg, owner_id, generation, kind=kind)
                if (kind == 'INITIAL' and book['hold']) or (kind == 'POST_HOLD' and not book['hold']) or kind not in ('INITIAL', 'POST_HOLD'):
                    fail('NATIVE_PRE_CONTEXT_INVALID')
                hold = None
                if book['hold']:
                    hold = self._post_hold_event(connection, reg, book)
                context = {'kind': kind, 'hold_id': book['hold'],
                    'hold_head': {'sequence': book['head_sequence'], 'hash': book['head_hash']} if hold else None,
                    'hold_ref': self.resource(hold, reg['id'], connection) if hold else None}
                binding = {'registry_id': self.native_registry.registry_id, 'registration_id': reg['id'],
                    'owner_id': owner_id, 'generation': generation, 'target_store_id': self.target_store_id,
                    'target_session_id': reg['session'], 'context': context}
                run_id = unique('native-pre')
                # Count before the independent read. Unique head window and the
                # persisted created time prevent retry/reopen budget refresh.
                connection.execute('INSERT INTO native_pre_runs VALUES(?,?,?,?,?,?,1,?,NULL,NULL,NULL,NULL,NULL,NULL,NULL)',
                    (run_id, reg['id'], canonical(binding).decode(), book['head_sequence'], book['head_hash'], time.time(), 'READ_STARTED'))
            actual = observe_bounded(observer, timeout=2)
            if not actual.get('ok') or not actual.get('process_reaped') or actual['read_elapsed_seconds'] > 2:
                fail('NATIVE_PRE_READ_FAILED', 'actual read failed; the durable read is consumed')
            captured, snapshot = self.capture_observation(actual['observation'], observer, reg['id'])
            if snapshot is None:
                fail('NATIVE_PRE_READ_INCOMPLETE')
            bundle = self.bundle(reg['id'])
            bundle['artifacts'].append(snapshot)
            manifest = self.resource_manifest(bundle, reg['package_root'])
            with self.transaction() as connection:
                self._append(connection, reg['id'], snapshot)
                connection.execute('UPDATE native_pre_runs SET status=?,snapshot=?,observation=?,input_sha=?,input_manifest=? WHERE id=?',
                    ('OBSERVED', canonical(reference(snapshot)).decode(), canonical(captured).decode(), digest(bundle), canonical(manifest).decode(), run_id))
            handle = RegisteredRunHandle(run_id, self.native_registry)
            self.native_registry.handles[id(handle)] = handle
            return Handle(handle=handle, observation=captured, snapshot_ref=reference(snapshot),
                bundle=self._validate(self.bundle(reg['id']), asset_root=reg['package_root']))

    def accept_plan(self, registration_id, plan_ref, *, owner_id, generation):
        result = super().accept_plan(registration_id, plan_ref, owner_id=owner_id, generation=generation)
        plan = self._plan(registration_id)
        with self.transaction() as connection:
            connection.execute('UPDATE native_pre_runs SET accepted_plan=? WHERE pre_ref=? AND status=?',
                (digest(plan_ref), canonical(plan['payload']['precheck']).decode(), 'ADMITTED'))
        return result

    def record_native_plan(self, registration_id, bundle, plan_ref, config, *, owner_id, generation):
        from annotation.contracts import assert_plan_ready
        from annotation.delivery.planner import verify_generated_plan
        from annotation.quality.targetcheck import resolve_artifact
        reg = self.registration(registration_id)
        context = self.bridge_for(bundle, reg['package_root'])
        validated = validate_native_bundle(bundle, bridge_context=context)
        plan = resolve_artifact(validated, plan_ref, 'ApplyPlan')
        assert_plan_ready(validated, plan_ref, plan.payload.snapshot, bridge_context=context)
        verify_generated_plan(validated, plan, plan.payload.snapshot, config, bridge_context=context)
        with self.effect_gate(self.target_key(reg['id'])).acquire(), self.transaction() as connection:
            self._lease(connection, reg['book'], owner_id, generation)
            original = self.bundle(reg['id'])
            incoming = plain(validated)
            if incoming['artifacts'][:len(original['artifacts'])] != original['artifacts'] or incoming['evidence'] != original['evidence']:
                fail('NATIVE_PLAN_HISTORY_CHANGED')
            self._append(connection, reg['id'], *incoming['artifacts'][len(original['artifacts']):])
        return plan_ref


def init_native_state(anchor_path, state_dir, *, expected_ledger_id, expected_target_store_id, before_completion=None):
    anchor, directory = Path(anchor_path).resolve(), Path(state_dir).resolve()
    if anchor.exists() or directory.exists():
        fail('STATE_INIT_TARGET_EXISTS', 'native init requires two fresh paths', 5)
    directory.mkdir(parents=True)
    selection = select_native_codec()
    metadata = {'version': NativeRuntimeStore._db_version, 'ledger_id': expected_ledger_id,
        'target_store_id': expected_target_store_id, 'state_dir': str(directory), 'profile': selection.profile_id,
        'profile_sha256': selection.profile_sha256, 'adoption_sha256': selection.adoption_sha256,
        'initialization': 'COMPLETE', 'migration': 'NOT_IMPLEMENTED_BLOCKED'}
    with sqlite3.connect(str(directory / 'runtime.sqlite3')) as connection:
        connection.execute('PRAGMA application_id=' + str(NativeRuntimeStore._application_id))
        connection.execute('PRAGMA user_version=4')
        connection.executescript(SQL + NATIVE_SQL)
        if before_completion is not None:
            before_completion()
        connection.executemany('INSERT INTO meta VALUES(?,?)', metadata.items())
    descriptor = {'format_version': 'a03-native-runtime-anchor-1', 'state_dir': str(directory),
        'anchor_path': str(anchor), 'ledger_id': expected_ledger_id,
        'target_store_id': expected_target_store_id, 'db_version': NativeRuntimeStore._db_version}
    exclusive_bytes(anchor, canonical(descriptor))
    return open_native_state(anchor, expected_ledger_id=expected_ledger_id, expected_target_store_id=expected_target_store_id)


def open_native_state(anchor_path, *, expected_ledger_id, expected_target_store_id):
    store = NativeRuntimeStore(anchor_path, expected_ledger_id=expected_ledger_id,
        expected_target_store_id=expected_target_store_id)
    CURRENT.set(store)
    return store

9d43615270797ee8cac81f0d4a9e4ce463e7399e blob 2489
"""Separate, fresh-only target format. No old database migration or reset."""
from annotation.contracts.a03_native import select_native_codec, require_context
from annotation.delivery.mock.persistent import PersistentMockSession


class NativeTargetSession(PersistentMockSession):
    _native = True
    _format = 'a03-native-target-db-1'
    _application_id = 0x41303454
    _user_version = 4

    @staticmethod
    def native_metadata():
        selection = select_native_codec()
        return {'format': 'a03-native-target-adoption-1', 'profile': selection.profile_id,
            'profile_sha256': selection.profile_sha256, 'adoption_sha256': selection.adoption_sha256,
            'initialization': 'COMPLETE', 'migration': 'NOT_IMPLEMENTED_BLOCKED'}

    def snapshot_from_observation(self, observation, *, bridge_context=None):
        context = bridge_context or getattr(self, '_bridge_context', None)
        require_context(context)
        return super().snapshot_from_observation(observation, bridge_context=context)

    def verify_prepared_action(self, prepared, *, observation_binding=None,
                               expected_config_version=None, expected_plan_ref=None, bridge_context=None):
        context = bridge_context or getattr(prepared.get('bundle'), 'bridge_context', None)
        require_context(context, prepared['bundle'])
        return super().verify_prepared_action(prepared, observation_binding=observation_binding,
            expected_config_version=expected_config_version, expected_plan_ref=expected_plan_ref,
            bridge_context=context)

    def synthetic_external_add_directory(self, directory_id):
        """Explicit fixture operator action to model external target drift.

        This does not create/reset annotation fields, intents, permits or runs.
        It is confined to this fresh synthetic target format.
        """
        if not isinstance(directory_id, str) or not directory_id.startswith('synthetic-external-'):
            raise ValueError('explicit synthetic external directory identity required')
        with self._connect() as connection:
            connection.execute('BEGIN IMMEDIATE')
            state = self._load(connection)
            if directory_id in state['target']['directories']:
                raise ValueError('external operation identity already exists')
            state['target']['directories'].append(directory_id)
            state['epoch'] += 1
            self._save(connection, state)

d4cc80736a2ab98d0371beea03b6bc8de44653df blob 6092
"""Static post-run byte/phase/resource/release inventory; never opens original SQL."""
import json
from pathlib import Path
import sys
from capture import sha, write
from support_t1 import ROOT, HERE, OUT, TEST, GROUPS, BASE, WORKFLOW, check_frozen, process


def run():
    check_frozen()
    view = json.loads((HERE / 'source-view.json').read_bytes())
    assert view['source_commit'] == BASE and view['byte_modifications'] == 0
    for name, entry in view['files'].items():
        assert sha((ROOT / name).read_bytes()) == entry['raw_sha256']
    raw_commit = process(OUT / 'sealing/git-head', ['git', '-c', 'core.longpaths=true', 'rev-parse', 'HEAD'], 30)
    candidate = raw_commit.decode('ascii').strip()
    raw_diff = process(OUT / 'sealing/git-product-diff', ['git', '-c', 'core.longpaths=true',
        'diff', '--exit-code', BASE, '--', 'src', 'config', 'schemas', 'pyproject.toml'], 30)
    assert not raw_diff
    entries = {}
    for path in sorted(OUT.rglob('completed.json')):
        value = json.loads(path.read_bytes())
        assert value['alive'] is False and value['exit_code'] == 0 and not value.get('timeout', False)
        entries[path.relative_to(ROOT).as_posix()] = value
    phases, owners, resources = {}, {}, {}
    validation = OUT / 'validation/author-01'
    matrix = json.loads((validation / 'matrix.json').read_bytes())
    assert matrix == {n: 'PASS_AUTHOR_ONLY' for n in GROUPS}
    for name in GROUPS:
        case = validation / 'cases' / name
        phases[name] = {}
        expected = ['before-build', 'unknown-established', 'after-release'] + ([] if name == 'L1' else ['before-reconcile', 'after-reconcile'])
        for stage in expected:
            folder = case / 'captures' / stage
            data = json.loads((folder / 'capture.json').read_bytes())
            assert data['status'] == 'RAW_COPIES_RETAINED' and not data['cross_database_atomic']
            assert data['writer_boundary']['quiescent']['owned_async_writers'] == 0
            assert len(data['writer_boundary']['threads_quiet']) == 1
            phases[name][stage] = {}
            for entry in data['records']:
                retained = folder / (entry['kind'] + '.sqlite3')
                assert sha(retained.read_bytes()) == entry['sha256']
                assert not entry['sidecars_after_writer_join']
                assert entry['sha256'] == entry['source_sha256_after_copy'] == entry['source_sha256_after_copy_audit']
                phases[name][stage][entry['kind']] = {'path': retained.relative_to(ROOT).as_posix(), 'sha256': entry['sha256']}
        final_stage = expected[-1]
        sql = json.loads((case / 'captures' / final_stage / 'SQL.json').read_bytes())
        book, = sql['runtime']['tables']['books']
        assert book['owner'] is None and book['pid'] is None and book['lease'] == 0 and book['phase'] == 'RELEASED'
        released = json.loads((case / 'owner-release.json').read_bytes())
        assert released['normal_release'] and not released['keeper_alive']
        assert all(not t['alive'] and t['error'] is None for t in released['lifecycle']['all_keeper_threads'])
        owners[name] = {'execution': released, 'final_book': book}
        for label in ('runtime', 'target'):
            original = case / label / (label + '.sqlite3')
            assert sha(original.read_bytes()) == phases[name][final_stage][label]['sha256']
        # Every Resource persisted in the final immutable package must retain its bytes.
        def walk(value, package):
            if isinstance(value, dict):
                if {'path', 'sha256', 'media_type'} <= set(value):
                    path = (package / value['path']).resolve()
                    assert path.is_relative_to(package.resolve()) and path.is_file()
                    assert sha(path.read_bytes()) == value['sha256']
                    resources[path.relative_to(ROOT).as_posix()] = value['sha256']
                    if value['media_type'] == 'application/json':
                        if path not in seen:
                            seen.add(path)
                            walk(json.loads(path.read_bytes()), package)
                for member in value.values():
                    walk(member, package)
            elif isinstance(value, list):
                for member in value:
                    walk(member, package)
        seen = set()
        for registration in sql['runtime']['tables']['registrations']:
            package = Path(registration['package_root'])
            bundle_path = Path(registration['bundle_path'])
            walk(json.loads(bundle_path.read_bytes()), package)
            for artifact in sql['runtime']['tables']['artifacts']:
                walk(json.loads(Path(artifact['path']).read_bytes()), package)
        proof = json.loads((case / 'unknown-proof.json').read_bytes())
        assert proof['status']['paused'] and proof['status']['pending_count'] == 1
        assert not sql['runtime']['tables']['native_report_reads']
    # Native observation children also provide product-owned Popen receipts.
    assert len(entries) >= 25
    write(OUT / 'sealing/release-and-phases.json', {'status': 'REVIEW', 'code_commit': candidate,
        'base_commit': BASE, 'workflow_commit': WORKFLOW, 'matrix': matrix, 'processes': entries,
        'owners': owners, 'phases': phases, 'resources': resources, 'product_diff': [],
        'field_reset': 'NOT_EXECUTED_NO_RERUN_VARIANT_OR_DELEGATION'})
    files = [p for p in HERE.rglob('*') if p.is_file()] + [TEST, ROOT / 'docs/tasks/A03-T1-execution-report.md']
    files += [p for p in OUT.rglob('*') if p.is_file() and p.name != 'manifest.json']
    assert all('__pycache__' not in p.parts for p in files)
    write(OUT / 'manifest.json', {'status': 'REVIEW', 'code_commit': candidate,
        'base_commit': BASE, 'workflow_commit': WORKFLOW, 'excludes': ['docs/evidence/A03/T1/execution/manifest.json'],
        'files': {p.relative_to(ROOT).as_posix(): {'sha256': sha(p.read_bytes()), 'size': p.stat().st_size} for p in sorted(set(files))}})


if __name__ == '__main__':
    run()

ac7279389b72307490273eb57b8cb281c2e738af blob 1115
"""Passive import provenance for driver and native observation child processes."""
import atexit
import hashlib
import json
import os
from pathlib import Path
import sys


def record_imports():
    folder = os.environ.get('A03_T1_IMPORT_AUDIT')
    if not folder:
        return
    result = {}
    for name, module in sorted(sys.modules.items()):
        source = getattr(module, '__file__', None)
        if source and (name.startswith('annotation') or name in ('__main__', 'capture', 'support_t1',
                'support', 'r12_fixed_helper', 'r8_fixed_helper', 'sitecustomize')):
            path = Path(source).resolve()
            if path.is_file():
                result[name] = {'path': str(path), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}
    output = Path(folder)
    output.mkdir(parents=True, exist_ok=True)
    with (output / (str(os.getpid()) + '.json')).open('x', encoding='utf-8', newline='\n') as stream:
        json.dump({'pid': os.getpid(), 'imports': result}, stream, ensure_ascii=False, sort_keys=True, indent=2)
        stream.write('\n')


atexit.register(record_imports)

