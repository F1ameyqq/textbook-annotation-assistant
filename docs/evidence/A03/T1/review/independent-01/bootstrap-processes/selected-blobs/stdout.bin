                  "origin"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "unresolved_issue_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "write_disposition": {
              "enum": [
                "RECHECK_TARGET",
                "PAUSE_RECONCILE",
                "POSTCHECK"
              ]
            }
          },
          "required": [
            "plan",
            "execution_mode",
            "results",
            "action_fact_refs",
            "unresolved_issue_ids",
            "write_disposition"
          ],
          "additionalProperties": false
        }
      },
