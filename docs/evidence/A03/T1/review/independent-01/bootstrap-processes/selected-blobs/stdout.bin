        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "intent_committed_at": {
          "type": "string",
          "format": "date-time"
        },
        "plan_dependency_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
