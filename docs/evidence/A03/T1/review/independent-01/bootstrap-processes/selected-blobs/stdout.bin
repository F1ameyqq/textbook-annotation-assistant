9122954eeaad2669cf1db67701db2ec772bf649d blob 4194
"""Static compile, source identity and expected matrix freeze; no business calls."""
import json
from pathlib import Path
import platform
import sys
from capture import sha, write
from support_t1 import ROOT, HERE, OUT, BASE, WORKFLOW, TEST, GROUPS, FAULTS, SOURCE, process


def run():
    sys.path.insert(0, str(SOURCE))
    import pydantic
    from annotation.contracts.a03_native import select_native_codec
    from dataclasses import asdict
    assert json.loads((OUT / 'fixture-01/result.json').read_bytes())['author_assertions'] == 'PASS'
    paths = set(p for p in (ROOT / 'src').rglob('*') if p.is_file() and '__pycache__' not in p.parts)
    paths.update(p for p in HERE.rglob('*') if p.is_file() and '__pycache__' not in p.parts and p.name != 'inputs.json')
    paths.add(TEST)
    paths.update(ROOT / name for name in ('tests/test_a03_p2_r12_r2_issue_ownership.py',
        'examples/a03/P2-R12-R2-issue-ownership/support.py', 'tests/test_a03_r8_r3_post_hold.py',
        'examples/a03/P2-R12-R2-issue-ownership/legacy-config.json'))
    for name in ('tests/fixtures/a03/P2-R8-R3-post-hold', 'examples/a03/P2-R12-R2-issue-ownership/legacy-recovery'):
        paths.update(p for p in (ROOT / name).rglob('*') if p.is_file())
    compiled = []
    for path in sorted(paths):
        if path.suffix == '.py':
            compile(path.read_bytes().decode('utf-8', errors='strict'), str(path), 'exec')
            compiled.append(path.relative_to(ROOT).as_posix())
    tree_raw = process(OUT / 'preflight-corrected/git-tree', ['git', '-c', 'core.longpaths=true',
        'ls-tree', '-r', BASE, '--', 'src', 'tests', 'examples/a03/P2-R12-R2-issue-ownership'], 30, frozen=False)
    tree = {}
    for line in tree_raw.decode('utf-8').splitlines():
        meta, name = line.split('\t', 1)
        tree[name] = meta.split()[2]
    inherited = [p for p in sorted(paths) if p.relative_to(ROOT).as_posix() in tree]
    blobs = process(OUT / 'preflight-corrected/git-blobs', ['git', '-c', 'core.longpaths=true', 'cat-file', '--batch'],
        30, stdin=('\n'.join(tree[p.relative_to(ROOT).as_posix()] for p in inherited) + '\n').encode('ascii'), frozen=False)
    offset, raw_entries = 0, {}
    for path in inherited:
        end = blobs.index(b'\n', offset)
        oid, kind, size = blobs[offset:end].decode('ascii').split()
        assert kind == 'blob'
        offset = end + 1
        raw = blobs[offset:offset + int(size)]
        offset += int(size) + 1
        name = path.relative_to(ROOT).as_posix()
        raw_entries[name] = {'base_blob_oid': oid, 'raw_git_sha256': sha(raw), 'raw_git_size': len(raw)}
    files = {p.relative_to(ROOT).as_posix(): dict(raw_entries.get(p.relative_to(ROOT).as_posix(), {}),
        execution_sha256=sha(p.read_bytes()), execution_size=p.stat().st_size) for p in sorted(paths)}
    write(HERE / 'inputs.json', {'base_commit': BASE, 'workflow_commit': WORKFLOW, 'files': files,
        'groups': GROUPS, 'faults': FAULTS, 'dispatch_per_scene': 1, 'reconcile_max_attempts': 1,
        'L1_reconcile': 'NOT_APPLICABLE_LEGACY_CONTROL', 'new_effects_during_reconcile': 0,
        'native_POST_Batch_report_reads': 0, 'lease_seconds': 10, 'observation_seconds': 2,
        'barrier_seconds': 5, 'business_seconds': 45, 'watchdog_seconds': 90,
        'expected_resolution': {n: ('NOT_APPLICABLE' if n == 'L1' else 'STILL_UNKNOWN') for n in GROUPS},
        'logical_stages': {n: ['before-build', 'unknown-established', 'after-release'] +
            ([] if n == 'L1' else ['before-reconcile', 'after-reconcile']) for n in GROUPS},
        'field_reset': 'NOT_EXECUTED_NO_RERUN_VARIANT_OR_DELEGATION'})
    write(OUT / 'preflight-corrected/static.json', {'UTF8_strict_compile': compiled,
        'python': sys.version, 'executable': sys.executable, 'platform': platform.platform(),
        'pydantic': pydantic.__version__, 'native_selection': asdict(select_native_codec()),
        'inputs_sha256': sha((HERE / 'inputs.json').read_bytes()),
        'raw_checkout_differences': {n: e for n, e in files.items() if e.get('raw_git_sha256', e['execution_sha256']) != e['execution_sha256']},
        'business_calls': 0})


if __name__ == '__main__':
    run()

4f004e625251b32d02d18e9bedfbe9e32c388c09 blob 1514
"""One six-scene matrix; first unexpected failure stops all successors."""
import argparse
import os
from pathlib import Path
import sys
import traceback
from capture import write
from support_t1 import OUT, ROOT, HERE, GROUPS, process, check_frozen


def run(root, groups):
    assert root.is_relative_to(OUT)
    root.mkdir(parents=True, exist_ok=False)
    check_frozen()
    statuses = {name: 'NOT_RUN' for name in GROUPS}
    write(root / 'invocation.json', {'pid': os.getpid(), 'argv': sys.argv, 'cwd': str(ROOT),
        'groups': groups, 'no_automatic_retries': True})
    for name in groups:
        try:
            process(root / 'watchdogs' / name, [sys.executable, '-X', 'utf8', '-B',
                str(HERE / 'support_t1.py'), name, str(root)], 90)
        except BaseException:
            statuses[name] = 'FAILED'
            write(root / 'first-failure.txt', traceback.format_exc().encode('utf-8'))
            write(root / 'matrix.json', statuses)
            raise
        statuses[name] = 'PASS_AUTHOR_ONLY'
        print(name + ': ' + statuses[name], flush=True)
    write(root / 'matrix.json', statuses)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--groups', nargs='+', choices=GROUPS, default=list(GROUPS))
    args = parser.parse_args()
    assert args.groups == list(GROUPS)[list(GROUPS).index(args.groups[0]):]
    run(args.output.resolve(), args.groups)

