            "WriteIntent": "#/$defs/WriteIntent",
            "ExecutionProgress": "#/$defs/ExecutionProgress",
            "ReconciliationResult": "#/$defs/ReconciliationResult"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SourceBundle"
          },
          {
            "$ref": "#/$defs/EvidenceBundle"
          },
          {
            "$ref": "#/$defs/QuestionGraph"
          },
          {
            "$ref": "#/$defs/PlatformSnapshot"
          },
          {
            "$ref": "#/$defs/CheckReport"
          },
          {
            "$ref": "#/$defs/ApplyPlan"
          },
          {
            "$ref": "#/$defs/ExecutionReceipt"
          },
          {
            "$ref": "#/$defs/ReviewPatch"
          },
          {
            "$ref": "#/$defs/BatchReport"
          },
          {
            "$ref": "#/$defs/WriteIntent"
          },
          {
            "$ref": "#/$defs/ExecutionProgress"
          },
          {
            "$ref": "#/$defs/ReconciliationResult"
          }
        ]
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    }
  },
  "required": [
    "format_version",
    "evidence",
    "policies",
    "artifacts"
  ],
  "title": "DESIGN_ONLY A03 candidate production shape; NOT IMPLEMENTED",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recovery-exchange.schema.json",
  "$comment": "P1 static proposal. Passing structure is not eligibility or local intent-commit evidence. P1-R1 DESIGN_ONLY revision; NOT IMPLEMENTED."
}

