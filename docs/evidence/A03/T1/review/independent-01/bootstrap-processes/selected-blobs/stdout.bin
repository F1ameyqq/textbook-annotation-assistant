          ],
          "title": "ArtifactRef",
          "type": "object"
        },
        "obligation_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "action_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "action_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "original_receipt_ref": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "artifact_id": {
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
                  "title": "Artifact Id",
                  "type": "string"
                },
                "revision": {
                  "exclusiveMinimum": 0,
                  "title": "Revision",
                  "type": "integer"
                },
                "kind": {
                  "const": "ExecutionReceipt",
                  "type": "string"
                },
                "content_hash": {
                  "pattern": "^[0-9a-f]{64}$",
                  "title": "Content Hash",
                  "type": "string"
                }
              },
              "required": [
                "artifact_id",
                "revision",
                "kind",
                "content_hash"
              ],
              "title": "ArtifactRef",
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_resolution_ref": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "artifact_id": {
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
                  "title": "Artifact Id",
                  "type": "string"
                },
                "revision": {
                  "exclusiveMinimum": 0,
                  "title": "Revision",
                  "type": "integer"
                },
                "kind": {
                  "const": "ReconciliationResult",
                  "type": "string"
                },
                "content_hash": {
                  "pattern": "^[0-9a-f]{64}$",
                  "title": "Content Hash",
                  "type": "string"
                }
              },
              "required": [
                "artifact_id",
                "revision",
                "kind",
                "content_hash"
              ],
              "title": "ArtifactRef",
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_snapshot_ref": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "artifact_id": {
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
                  "title": "Artifact Id",
                  "type": "string"
                },
                "revision": {
                  "exclusiveMinimum": 0,
                  "title": "Revision",
                  "type": "integer"
                },
                "kind": {
                  "const": "PlatformSnapshot",
                  "type": "string"
                },
                "content_hash": {
                  "pattern": "^[0-9a-f]{64}$",
                  "title": "Content Hash",
                  "type": "string"
                }
              },
              "required": [
                "artifact_id",
                "revision",
                "kind",
                "content_hash"
              ],
              "title": "ArtifactRef",
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "recovery_call_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "attempt_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "read_sequence": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "target_state_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "target_state_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation": {
          "type": "string",
          "enum": [
            "MATCH",
            "ABSENT",
            "CONFLICT",
            "INDETERMINATE"
          ]
        },
        "resolution": {
          "type": "string",
          "enum": [
            "RESOLVED_APPLIED",
            "RESOLVED_NOT_APPLIED",
            "STILL_UNKNOWN"
          ]
        },
        "platform_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "minItems": 0
        },
        "readback": {
          "anyOf": [
            {
              "$ref": "#/$defs/Resource"
            },
            {
              "type": "null"
            }
          ]
        },
        "comparator_version": {
          "const": "a02-facts-1"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "replay_allowed": {
          "const": false
        }
      },
      "required": [
        "plan_ref",
        "intent_ref",
        "obligation_id",
        "action_id",
        "action_digest",
        "original_receipt_ref",
        "previous_resolution_ref",
        "observed_snapshot_ref",
        "observation_id",
        "recovery_call_id",
        "attempt_index",
        "observed_at",
        "read_sequence",
        "target_state_version",
        "target_state_hash",
        "observation",
        "resolution",
        "platform_ids",
        "evidence_refs",
        "readback",
        "comparator_version",
        "reason_code",
        "replay_allowed"
      ]
    },
