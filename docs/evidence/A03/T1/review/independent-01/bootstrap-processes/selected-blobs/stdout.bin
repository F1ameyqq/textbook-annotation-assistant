65e617943229b5a76658d22d311e1d87f03b2fe2 blob 4248
"""Stopped delivery inventory only; no business calls, SQL, tests or seal retry."""
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[6]
OUT = ROOT / 'docs/evidence/A03/T1/execution'
HERE = ROOT / 'examples/a03/T1-capture'
CODE = '73f21654adb8ee86e33381a3ff3bf1a179303928'


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def write(path, value):
    with path.open('xb') as stream:
        stream.write((json.dumps(value, ensure_ascii=False, sort_keys=True, indent=2) + '\n').encode('utf-8'))


def main():
    # These are copied from tool-return receipts, not invented raw OS stream files.
    write(OUT / 'delivery/second-static-tool-receipt.json', {
        'provenance': 'actual exec_command terminal return, chunk 125e7e; no separate raw OS streams',
        'cwd': str(ROOT), 'entry': 'python -X utf8 -B - (inline post-run static summary)', 'exit_code': 1,
        'output': 'Traceback (most recent call last):\n  File "<stdin>", line 24, in <module>\nKeyError: \'native_report_reads\'\n',
        'failed_expression': "len(rt['native_report_reads']) for L1 legacy SQL copy",
        'partial_output_file_created': False, 'business_calls': 0,
        'frozen_seal_same_assumption': 'examples/a03/T1-capture/seal.py:83',
        'frozen_seal_executed': False, 'further_corrections': 0, 'further_business_runs': 0})
    completions = {p.relative_to(ROOT).as_posix(): json.loads(p.read_bytes())
                   for p in sorted(OUT.rglob('completed.json'))}
    released = {}
    phases = {}
    for name in ('L1', 'U1', 'U2', 'U3', 'U4', 'U5'):
        case = OUT / 'validation/author-01/cases' / name
        released[name] = {'execution': json.loads((case / 'owner-release.json').read_bytes()),
            'released_status': json.loads((case / 'released-status.json').read_bytes())}
        if name != 'L1':
            proof = json.loads((case / 'reconcile-proof.json').read_bytes())
            released[name]['recovery_final_status'] = proof['final']['status']
            released[name]['normal_reconcile_owner_release'] = proof['normal_reconcile_owner_release']
        phases[name] = {p.parent.name: {'capture': p.relative_to(ROOT).as_posix(),
            'raw_files': [q.relative_to(ROOT).as_posix() for q in sorted(p.parent.glob('*.sqlite3'))]}
            for p in sorted((case / 'captures').glob('*/capture.json'))}
    write(OUT / 'delivery/state.json', {
        'delivery_status': 'REVIEW', 'recommendation': 'REWORK', 'code_commit': CODE,
        'base_commit': '1330047dd29890dea0e433ff01b991f615bf78f4',
        'workflow_commit': 'f7084b2e8f2e9a1fcf758f9cba56ec9c9fb1f304',
        'matrix': json.loads((OUT / 'validation/author-01/matrix.json').read_bytes()),
        'Popen_receipt_count': len(completions), 'Popen_completions': completions,
        'all_recorded_Popen_reaped': all(v['alive'] is False for v in completions.values()),
        'all_recorded_Popen_exit_zero': all(v['exit_code'] == 0 for v in completions.values()),
        'external_failed_static_roots': [
            'docs/evidence/A03/T1/execution/preflight/first-static-tool-receipt.json',
            'docs/evidence/A03/T1/execution/delivery/second-static-tool-receipt.json'],
        'owners_from_existing_receipts': released, 'phases_from_existing_records': phases,
        'semantic_seal': 'NOT_RUN_KNOWN_LEGACY_TABLE_ASSUMPTION_STOP_AFTER_SECOND_TOOL_ERROR',
        'source_mutations_after_freeze': 0, 'business_reruns': 0,
        'field_reset': 'NOT_EXECUTED_NO_RERUN_VARIANT_OR_DELEGATION'})
    files = [p for p in HERE.rglob('*') if p.is_file()]
    files += [ROOT / 'tests/test_a03_t1_capture.py', ROOT / 'docs/tasks/A03-T1-execution-report.md']
    files += [p for p in OUT.rglob('*') if p.is_file() and p != OUT / 'manifest.json']
    write(OUT / 'manifest.json', {'delivery_status': 'REVIEW', 'recommendation': 'REWORK',
        'code_commit': CODE, 'meaning': 'byte inventory only; semantic seal incomplete',
        'excluded_self': 'docs/evidence/A03/T1/execution/manifest.json',
        'files': {p.relative_to(ROOT).as_posix(): {'sha256': sha(p.read_bytes()), 'size': p.stat().st_size}
                  for p in sorted(set(files))}})


if __name__ == '__main__':
    main()

