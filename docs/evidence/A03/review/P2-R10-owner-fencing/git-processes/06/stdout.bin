    "target_session_id",
    "scope_id",
    "complete_uncalled_prefix",
    "first_observation_ref",
    "readonly_prepared_ref",
    "second_observation_ref"
  ],
  "$defs": {
    "JsonResource": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "media_type": {
          "const": "application/json"
        },
        "origin": {
          "type": "string",
          "enum": [
            "SYNTHETIC",
            "ORIGINAL",
            "OBSERVED"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type",
        "origin"
      ],
      "title": "Resource",
      "type": "object"
    }
  }
}

