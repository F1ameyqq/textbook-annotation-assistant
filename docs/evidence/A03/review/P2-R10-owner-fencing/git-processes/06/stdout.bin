            },
            "owner_id": {
              "type": "string",
              "minLength": 1
            },
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "payload": {
              "type": "object",
              "properties": {
                "reservations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/action_binding"
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "reservations"
              ],
              "additionalProperties": false
            },
            "previous_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "event_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
