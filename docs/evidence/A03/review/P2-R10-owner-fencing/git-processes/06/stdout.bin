  "new_version": "1.3.0-a03-static-proposal",
  "prefix_boundary": "Only exact profile/format + valid schema + bytes-bound prefix.frames, reached through Resource; each frame owns recursive declarations; all other ordinary refs same book/scope; one global mixed DAG",
  "session_binding_fields": [
    "ledger_id",
