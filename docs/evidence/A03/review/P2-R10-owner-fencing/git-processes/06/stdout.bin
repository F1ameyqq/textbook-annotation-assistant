          "type": "array"
        },
        "pages_acquired": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Pages Acquired",
          "type": "array"
        },
        "external_page_mappings": {
          "items": {
            "$ref": "#/$defs/PageMapping"
          },
          "title": "External Page Mappings",
          "type": "array"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/HistoryReference"
          },
          "title": "History",
          "type": "array"
        },
        "scope_manifest": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Scope Manifest",
          "type": "array"
        },
        "scope_manifest_basis": {
          "minLength": 1,
          "title": "Scope Manifest Basis",
          "type": "string"
        },
        "metadata_page_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Metadata Page Count"
        }
      },
      "required": [
        "assets",
        "directories",
        "pages_expected",
        "pages_acquired",
        "external_page_mappings",
        "history",
        "scope_manifest",
        "scope_manifest_basis",
        "metadata_page_count"
      ],
      "title": "SourcePayload",
      "type": "object"
    },
    "Strategy": {
      "additionalProperties": false,
      "properties": {
        "strategy_id": {
          "enum": [
            "NONE",
            "LOAD_ADJACENT_PAGE",
            "EXPAND_CROP",
            "ADD_ANSWER_CONTEXT",
            "SWITCH_RECOGNIZER",
            "HUMAN_REVIEW",
            "RECONCILE",
            "RECHECK_TARGET",
            "WAIT_CONTENT",
            "HUMAN_SUBMIT",
            "LOGIN",
            "RAISE_BUDGET"
          ],
          "title": "Strategy Id",
          "type": "string"
        },
        "max_attempts": {
          "minimum": 0,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_cost": {
          "minimum": 0,
          "title": "Max Cost",
          "type": "number"
        }
      },
      "required": [
        "strategy_id",
        "max_attempts",
        "max_cost"
      ],
      "title": "Strategy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": "c01-exchange-1",
      "title": "Format Version",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "policies": {
      "items": {
        "$ref": "#/$defs/PlatformPolicy"
      },
      "minItems": 1,
      "title": "Policies",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "discriminator": {
          "mapping": {
            "ApplyPlan": "#/$defs/ApplyPlan",
            "BatchReport": "#/$defs/BatchReport",
            "CheckReport": "#/$defs/CheckReport",
            "EvidenceBundle": "#/$defs/EvidenceBundle",
            "ExecutionReceipt": "#/$defs/ExecutionReceipt",
            "PlatformSnapshot": "#/$defs/PlatformSnapshot",
            "QuestionGraph": "#/$defs/QuestionGraph",
            "ReviewPatch": "#/$defs/ReviewPatch",
            "SourceBundle": "#/$defs/SourceBundle"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SourceBundle"
          },
          {
            "$ref": "#/$defs/EvidenceBundle"
          },
          {
            "$ref": "#/$defs/QuestionGraph"
          },
          {
            "$ref": "#/$defs/PlatformSnapshot"
          },
          {
            "$ref": "#/$defs/CheckReport"
          },
          {
            "$ref": "#/$defs/ApplyPlan"
          },
          {
            "$ref": "#/$defs/ExecutionReceipt"
          },
          {
            "$ref": "#/$defs/ReviewPatch"
          },
          {
            "$ref": "#/$defs/BatchReport"
          }
        ]
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    }
  },
  "required": [
    "format_version",
    "evidence",
    "policies",
    "artifacts"
  ],
  "title": "ExchangeBundle",
  "type": "object",
  "$comment": "DESIGN_ONLY static public schema export from ec1b4def; archive read shape only, no new recovery eligibility. P1-R1 DESIGN_ONLY revision; NOT IMPLEMENTED."
}

