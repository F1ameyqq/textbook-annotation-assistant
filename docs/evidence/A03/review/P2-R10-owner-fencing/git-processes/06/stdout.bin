              "type": "integer",
              "minimum": 1
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "payload": {
              "type": "object",
              "properties": {
                "action_id": {
                  "type": "string",
                  "minLength": 1
                },
                "action_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "fact": {
                  "$ref": "#/$defs/fact_resource"
                },
                "outcome": {
                  "const": "NOT_APPLIED"
                },
                "plan_state": {
                  "const": "INTERRUPTED"
                }
              },
              "required": [
                "action_id",
                "action_digest",
                "fact",
                "outcome",
                "plan_state"
              ],
              "additionalProperties": false
            },
            "previous_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
