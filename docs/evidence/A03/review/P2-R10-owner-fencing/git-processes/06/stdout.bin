          "type": "string"
        },
        "platform_ids": {
          "items": {
            "type": "string"
          },
          "title": "Platform Ids",
          "type": "array"
        },
        "before_evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
