            "event",
            "journal_id",
            "target_key",
            "plan_ref",
            "owner_id",
            "generation",
            "recorded_at",
            "payload",
            "previous_hash",
            "event_hash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "event": {
              "const": "PLAN_ACTIONS_RESERVED"
