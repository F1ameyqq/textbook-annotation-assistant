            },
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "payload": {
              "type": "object",
              "properties": {
                "plan_ref": {
                  "$ref": "#/$defs/plan_ref"
                },
                "actions": {
                  "type": "array",
