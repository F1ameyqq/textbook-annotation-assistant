              "minLength": 1
            },
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "payload": {
              "type": "object",
              "properties": {
                "action_id": {
                  "type": "string",
                  "minLength": 1
