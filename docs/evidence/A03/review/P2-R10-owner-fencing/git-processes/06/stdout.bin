                "obligation_id": {
                  "type": "string",
                  "minLength": 1
                },
                "fact": {
                  "$ref": "#/$defs/fact_resource"
                },
                "outcome": {
                  "enum": [
                    "APPLIED",
                    "UNKNOWN",
                    "NOT_APPLIED"
                  ]
                },
                "plan_state": {
                  "enum": [
                    "RUNNING",
                    "INTERRUPTED"
                  ]
                }
              },
              "required": [
                "action_id",
                "action_digest",
                "intent_ref",
                "obligation_id",
                "fact",
                "outcome",
                "plan_state"
