"""Frozen raw SQL, identity and barrier timeline cross-checks; stdlib only."""
from datetime import datetime
import hashlib
import json
from pathlib import Path
import sqlite3

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / 'docs/evidence/A03/execution/P2-R10-owner-fencing'
RUN = OUT / 'validation/r10-01'


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def load(path):
    return json.loads(path.read_bytes())


def read_db(path):
    raw = path.read_bytes()
    with sqlite3.connect(path.as_uri() + '?mode=ro&immutable=1', uri=True) as db:
        db.row_factory = sqlite3.Row
        db.execute('PRAGMA query_only=ON')
        tables = [r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")]
        rows = {name: [dict(r) for r in db.execute('SELECT * FROM "' + name.replace('"', '""') + '"')] for name in tables}
        quick = db.execute('PRAGMA quick_check').fetchone()[0]
    assert raw == path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': sha(raw), 'bytes': len(raw),
        'quick_check': quick, 'counts': {k: len(v) for k, v in rows.items()}, 'tables': rows, 'bytes_unchanged_after_read': True}


if __name__ == '__main__':
    result = {'mode': 'stdlib only; mode=ro&immutable=1; query_only', 'cases': {}}
    for group in ('C1', 'C2'):
        case = RUN / 'cases' / group
        runtime, target = read_db(case / 'runtime/runtime.sqlite3'), read_db(case / 'target/target.sqlite3')
        assert all(runtime['counts'][name] == 0 for name in ('plans', 'actions', 'intents', 'permits'))
        assert target['counts']['effects'] == 0
        book = runtime['tables']['books'][0]
        assert book['owner'] is None and book['phase'] == 'RELEASED'
        reg = runtime['tables']['registrations'][0]
        bundle_path = Path(reg['bundle_path'])
        bundle_raw = bundle_path.read_bytes()
        bundle = json.loads(bundle_raw)
        refs = [json.loads(r['ref']) for r in runtime['tables']['artifacts']]
        def ref(a):
            return {k: a[k] for k in ('artifact_id', 'revision', 'kind', 'content_hash')}
        assert all(ref(a) in refs for a in bundle['artifacts'])
        result['cases'][group] = {'runtime': runtime, 'target': target, 'current_bundle': bundle,
            'current_bundle_path': bundle_path.relative_to(ROOT).as_posix(), 'current_bundle_sha256': sha(bundle_raw),
            'all_current_refs_formally_registered': True}
    c1 = RUN / 'control/C1'
    common = load(c1 / 'claim-go.barrier')
    competition = load(c1 / 'simultaneous-competition.json')
    before_common = load(c1 / 'before-common-release.json')
    completions = {role: load(RUN / 'processes' / ('C1-' + role) / 'completed.json') for role in ('A', 'B')}
    for role in ('A', 'B'):
        marker = before_common['markers'][role + '-BEFORE_CLAIM.json']
        marker_seconds = datetime.fromisoformat(marker['at'].replace('Z', '+00:00')).timestamp()
        assert marker_seconds < common['at_ns'] / 1e9
        assert competition['claims'][role]['at_ns'] > common['at_ns']
        assert completions[role]['ended_at_ns'] > competition['at_ns']
        assert completions[role]['exit_code'] == 0 and not completions[role]['alive']
    assert competition['both_processes_still_alive']
    assert len({competition['claims'][role]['pid'] for role in ('A', 'B')}) == 2
    assert len({competition['claims'][role]['instance'] for role in ('A', 'B')}) == 2
    result['C1_timeline'] = {'both_markers_before_common_release': True, 'both_results_after_release': True,
        'both_process_exits_after_live_observation': True, 'common_release': common, 'competition': competition,
        'worker_completions': completions}
    c2 = RUN / 'control/C2'
    names = ('A-qualified.json', 'A-released.json', 'B-active.json', 'A-stale-attempt.barrier',
        'A-stale-result.json', 'after-stale-live-observation.json', 'B-released.json')
    timeline = {name: load(c2 / name) for name in names}
    times = [timeline[name]['at_ns'] for name in names]
    assert times == sorted(times)
    a, b = timeline['A-qualified.json'], timeline['B-active.json']
    assert a['pid'] != b['pid'] and b['claim']['generation'] > a['claim']['generation']
    assert timeline['A-stale-result.json']['refusal']['root_lease_guard_reached']
    assert timeline['after-stale-live-observation.json']['both_alive']
    for role in ('A', 'B'):
        completed = load(RUN / 'processes' / ('C2-' + role) / 'completed.json')
        assert completed['ended_at_ns'] > timeline['after-stale-live-observation.json']['at_ns']
    pre = next(a for a in result['cases']['C2']['current_bundle']['artifacts'] if a['kind'] == 'CheckReport' and a['payload']['stage'] == 'PRE_APPLY')
    plan = next(a for a in result['cases']['C2']['current_bundle']['artifacts'] if a['kind'] == 'ApplyPlan')
    assert ref(plan) == timeline['A-qualified.json']['plan_ref']
    assert ref(pre) == timeline['A-qualified.json']['pre_ref']
    result['C2_timeline'] = {'ordered_real_qualification_release_claim_stale_refusal_and_final_release': True, 'records': timeline}
    with (OUT / 'database-and-timeline-readback.json').open('xb') as stream:
        stream.write((json.dumps(result, ensure_ascii=False, indent=2) + '\n').encode())
    print(json.dumps({'C1': 'concurrent_live_claim_mutex', 'C2': 'actual_turnover_live_old_owner_refused',
        'each_effect_count': 0, 'product_calls': 0}))

64fa2d8ef60c722fc035f0e0bd52bbe153d33dbc blob 5603
"""File-only R10 preservation, process release, manifest and raw Git checking."""
from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / 'docs/evidence/A03/execution/P2-R10-owner-fencing'
BASE = 'bfd7fe896a7eee663ea8e0b6cf967548d8dd8f39'
DIRS = ('examples/a03/P2-R10-owner-fencing', 'docs/evidence/A03/execution/P2-R10-owner-fencing')
FILES = {'tests/test_a03_p2_r10_owner_fencing.py', 'docs/tasks/A03-P2-R10-owner-fencing-report.md'}


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def git(*args, data=None):
    return subprocess.check_output(['git', '-c', 'core.longpaths=true', *args], cwd=ROOT, input=data)


def write(name, value):
    with (OUT / name).open('xb') as stream:
        stream.write((json.dumps(value, ensure_ascii=False, indent=2) + '\n').encode())


def tree(commit):
    return {line.split('\t', 1)[1]: line.split('\t', 1)[0].split() for line in git('ls-tree', '-r', commit).decode().splitlines()}


def inspect():
    baseline, head = tree(BASE), tree('HEAD')
    assert all(head.get(p) == row for p, row in baseline.items()), 'old raw Git entries changed'
    changed = git('diff', '--name-only', BASE).decode().splitlines()
    assert not set(changed) & set(baseline), 'old worktree file changed'
    assert all(p in FILES or any(p.startswith(d + '/') for d in DIRS) for p in changed), 'out of scope added path'
    pre = json.loads((OUT / 'driver-preregistered.json').read_bytes())
    for row in pre['drivers']:
        raw = (ROOT / row['path']).read_bytes()
        assert len(raw) == row['bytes'] and sha(raw) == row['sha256'], 'executed driver changed'
    indices = [(OUT / 'runs' / name / 'product-source-index.json').read_bytes() for name in ('C1', 'C2', 'frozen-readback')]
    assert len(set(indices)) == 1
    for row in json.loads(indices[0]):
        raw = (ROOT / row['path']).read_bytes()
        assert len(raw) == row['bytes'] and sha(raw) == row['sha256'], 'executed product source changed'
    report = ROOT / 'docs/tasks/A03-P2-R10-owner-fencing-report.md'
    links = re.findall(r'\[[^\]]+\]\(([^)]+)\)', report.read_text(encoding='utf-8'))
    assert all((report.parent / link.split('#', 1)[0]).resolve().exists() for link in links), 'report link missing'
    return {'all_base_raw_Git_entries_unchanged': len(baseline), 'product_pins_old_tests_old_evidence_unchanged': True,
        'report_links_checked': len(links), 'product_source_index_sha256': sha(indices[0]),
        'all_executed_product_source_indices_identical': True, 'executed_driver_bytes_unchanged': True,
        'product_or_test_execution': False}


def paths():
    result = set(git('diff', '--name-only', BASE).decode().splitlines()) | FILES
    for directory in DIRS:
        result.update(p.relative_to(ROOT).as_posix() for p in (ROOT / directory).rglob('*') if p.is_file())
    result.discard('docs/evidence/A03/execution/P2-R10-owner-fencing/manifest.json')
    return sorted(result)


def seal():
    records = []
    for path in sorted(OUT.rglob('started.json')):
        start = json.loads(path.read_bytes())
        end = json.loads(path.with_name('completed.json').read_bytes())
        assert end['alive'] is False
        records.append({'path': path.relative_to(OUT).as_posix(), 'pid': start['pid'],
            'parent_pid': start.get('parent_pid'), 'exit_code': end['exit_code'], 'alive': False,
            'timed_out': end.get('timed_out', end.get('timeout', False))})
    write('process-release.json', {'recorded_at': datetime.now(timezone.utc).isoformat(),
        'all_recorded_owned_processes_waited_and_ended': True, 'records': records,
        'reruns_product_fixes_delegation_platform_network': 'NONE'})
    audit = inspect()
    write('final-file-audit.json', audit)
    rows = [{'path': p, 'bytes': (ROOT / p).stat().st_size, 'sha256': sha((ROOT / p).read_bytes())} for p in paths()]
    write('manifest.json', {'base': BASE, 'status': 'REVIEW', 'excludes_only': 'this manifest', 'entries': rows})
    print(json.dumps({'entries': len(rows), 'recorded_processes_ended': len(records), **audit,
        'manifest_sha256': sha((OUT / 'manifest.json').read_bytes())}))


def check():
    audit = inspect()
    rows = json.loads((OUT / 'manifest.json').read_bytes())['entries']
    assert set(paths()) == {r['path'] for r in rows}
    indexed = {}
    for line in git('ls-files', '--stage').decode().splitlines():
        metadata, path = line.split('\t', 1)
        mode, blob, stage = metadata.split()
        assert stage == '0'
        indexed[path] = blob
    requests = []
    for row in rows:
        raw = (ROOT / row['path']).read_bytes()
        assert len(raw) == row['bytes'] and sha(raw) == row['sha256'], row['path']
        requests.append(indexed[row['path']])
    result = git('cat-file', '--batch', data=('\n'.join(requests) + '\n').encode())
    offset = 0
    for row in rows:
        end = result.index(b'\n', offset)
        size = int(result[offset:end].split()[2])
        raw = result[end + 1:end + 1 + size]
        assert size == row['bytes'] and sha(raw) == row['sha256'], row['path']
        offset = end + size + 2
    raw = (OUT / 'manifest.json').read_bytes()
    assert git('cat-file', 'blob', indexed['docs/evidence/A03/execution/P2-R10-owner-fencing/manifest.json']) == raw
    print(json.dumps({'raw_Git_blobs_verified_including_manifest': len(rows) + 1, **audit,
        'manifest_sha256': sha(raw)}))


if __name__ == '__main__':
    {'seal': seal, 'check': check}[sys.argv[1]]()

