                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "minProperties": 1,
          "title": "Expected Before",
          "type": "object"
        },
        "operation": {
          "enum": [
            "CREATE_FRAMES",
            "UPDATE_FRAMES"
          ],
          "title": "Operation",
          "type": "string"
        },
        "expected_after": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
