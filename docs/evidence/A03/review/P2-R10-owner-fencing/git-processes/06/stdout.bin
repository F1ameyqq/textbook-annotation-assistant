                "type": "string"
              },
              "title": "After Evidence Refs",
              "type": "array"
            },
            "readback": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Resource"
                },
                {
                  "type": "null"
                }
              ]
            },
            "effect_match": {
              "const": "ABSENT"
            },
            "next_step": {
              "enum": [
                "POSTCHECK",
                "RECHECK_TARGET",
                "RECONCILE"
              ],
              "title": "Next Step",
              "type": "string"
            },
            "replay_allowed": {
              "const": false
            },
            "reason": {
              "minLength": 1,
              "title": "Reason",
              "type": "string"
            },
            "attempt_fact": {
              "const": "NOT_ATTEMPTED"
            },
            "attempt_evidence_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Resource"
              },
              "minItems": 0
            },
            "intent_ref": {
              "type": "null"
            }
          },
          "required": [
            "action_id",
            "outcome",
            "platform_ids",
            "before_evidence_refs",
            "after_evidence_refs",
            "readback",
            "effect_match",
            "next_step",
            "replay_allowed",
            "reason",
            "attempt_fact",
            "attempt_evidence_refs",
            "intent_ref"
          ],
          "title": "ActionResult",
          "type": "object"
        },
        "journal_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "predecessor_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "design_only": {
          "type": "boolean"
        },
        "unattempted_basis": {
          "$ref": "#/$defs/Resource"
        }
      },
      "required": [
        "format_version",
        "plan_ref",
        "origin_phase",
        "resolution_ref",
        "intent_ref",
        "obligation_id",
        "action_id",
        "action_digest",
        "prepared_before",
        "observed_snapshot_ref",
        "readback",
        "comparator_version",
        "result",
        "journal_sequence",
        "predecessor_hash",
        "unattempted_basis"
      ]
    }
  ]
}

