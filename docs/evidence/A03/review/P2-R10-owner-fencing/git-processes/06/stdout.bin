          "title": "Next Step",
          "type": "string"
        },
        "replay_allowed": {
          "const": false,
          "title": "Replay Allowed",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
