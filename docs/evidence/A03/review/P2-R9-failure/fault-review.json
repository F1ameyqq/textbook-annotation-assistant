        {
          "line": 13,
          "text": "    from . import open_observer, claim_current"
        },
        {
          "line": 14,
          "text": "    reg = store.registration(registration_id)"
        },
        {
          "line": 15,
          "text": "    plan = store._plan(registration_id)"
        },
        {
          "line": 16,
          "text": "    projection = projection or store.project_plan(registration_id, plan)"
        },
        {
          "line": 17,
          "text": "    if projection.get('receipt_ref') is None:"
        },
        {
          "line": 18,
          "text": "        return Handle(status='NO_COMPLETE_RECEIPT', content_check_status='PENDING', submission_status='NOT_SUBMITTED')"
        },
        {
          "line": 19,
          "text": "    observer = open_observer(store, registration_id)"
        },
        {
          "line": 20,
          "text": "    key = store.target_key(registration_id)"
        },
        {
          "line": 21,
          "text": "    claim = claim_current(store, observer, key)"
        },
        {
          "line": 22,
          "text": "    try:"
        },
        {
          "line": 23,
          "text": "        with store.transaction() as connection:"
        },
        {
          "line": 24,
          "text": "            store._lease(connection, reg['book'], claim['owner_id'], claim['generation'], pending_ok=True)"
        },
        {
          "line": 25,
          "text": "            connection.execute('INSERT INTO native_report_reads VALUES(?,?,1)', (digest(reference(plan)), time.time()))"
        },
        {
          "line": 26,
          "text": "        actual = observe_bounded(observer, timeout=2)"
        },
        {
          "line": 27,
          "text": "        if not actual.get('ok') or actual['read_elapsed_seconds'] > 2:"
        },
        {
          "line": 28,
          "text": "            fail('NATIVE_REPORT_READ_FAILED', 'durable report read consumed; no implicit retry')"
        }
      ]
