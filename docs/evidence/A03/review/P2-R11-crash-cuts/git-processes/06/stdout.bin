"""Local JSON-request CLI. No network, browser or automatic recovery loop."""
import argparse
import json
import sys
from pathlib import Path

from annotation.runtime.storage import init_state, open_state
from annotation.runtime.storage.common import FaultController, RuntimeFailure, plain, reference, fail, unique
from . import open_observer, claim_current, configuration, run_plan, reconcile, publish_quality


def operate(request):
    from annotation.contracts import load_recovery_bundle
    from annotation.delivery.mock.persistent import PersistentMockSession
    operation = request["operation"]
    expected = {key: request[key] for key in ("expected_ledger_id", "expected_target_store_id")}
    if operation == "init":
        bundle = load_recovery_bundle(request["bundle_path"], asset_root=request.get("asset_root"))
        data = plain(bundle)
        source = request.get("source_ref") or reference(next(a for a in data["artifacts"] if a["kind"] == "SourceBundle"))
        snapshot = request.get("snapshot_ref") or reference(next(a for a in data["artifacts"] if a["kind"] == "PlatformSnapshot"))
        snapshot_value = next(a for a in data["artifacts"] if reference(a) == snapshot)
        namespace = request.get("platform_namespace", "a03-mock")
        key = {"platform_namespace": namespace, "target_id": snapshot_value["payload"]["target_id"], "book_id": snapshot_value["book_id"]}
        config = json.loads(Path(request["config_path"]).read_bytes())
        store = init_state(request["anchor_path"], state_dir=request["state_dir"], **expected)
        root = request.get("asset_root", str(Path(request["bundle_path"]).resolve().parent))
        session = request.get("target_session_id", "a03-p2-session")
        registered = store.register_book(bundle, target_key=key, target_dir=request["target_dir"], target_session_id=session,
            source_ref=source, asset_root=root, config=config, registration_id=request.get("registration_id"))
        observer = PersistentMockSession.create(request["target_dir"], bundle, snapshot, platform_namespace=namespace,
            source_ref=source, asset_root=registered["package_root"], expected_store_id=store.target_store_id, target_session_id=session)
        current = build_current_plan(store, registered["registration_id"], observer, config)
        result = plain(registered)
        result.update(plan_ref=reference(current), action_ids=[a["action_id"] for a in current["payload"]["actions"]],
                      snapshot_ref=current["payload"]["snapshot"])
        return result
    store = open_state(request["anchor_path"], **expected)
    rid = request.get("registration_id")
    fault = request.get("fault") or ({"point": request["fault_point"]} if request.get("fault_point") else None)
    store.fault = FaultController(fault)
    if operation == "status":
        return store.status(rid)
    if operation == "export":
        return store.export(rid)
    if operation == "target-status":
        observer = open_observer(store, rid)
        return plain(observer.export_book_context(store.target_key(store.registration(rid)["id"])))
    if operation == "run":
        return run_plan(store, rid, fault=fault, fault_action_index=request.get("fault_action_index", 0),
            effect_fault=request.get("effect_fault"), read_fault=request.get("read_fault"),
            owner_id=request.get("owner_id"), generation=request.get("generation"),
            config=json.loads(Path(request["config_path"]).read_bytes()) if request.get("config_path") else None)
    if operation == "reconcile":
        return reconcile(store, rid, call_id=request.get("call_id"), read_fault=request.get("read_fault"),
            owner_id=request.get("owner_id"), max_attempts=request.get("max_attempts", 3), intent_filter=request.get("intent_filter"))
    if operation == "quality":
        return publish_quality(store, store.registration(rid)["id"])
    if operation in ("detect-drift", "clear-hold"):
        from .lease import LeaseKeeper
        reg = store.registration(rid)
        observer = open_observer(store, reg["id"])
        key = store.target_key(reg["id"])
        claim = claim_current(store, observer, key, request.get("owner_id"))
        owner, generation = claim["owner_id"], claim["generation"]
        keeper = LeaseKeeper(store, key, owner, generation).start()
        try:
            if operation == "detect-drift":
                return plain(store.detect_target_drift(key, owner_id=owner, generation=generation, observer=observer))
            return plain(store.clear_target_drift_hold(request["hold_id"], request["snapshot_ref"],
                request["precheck_ref"], request["targetcheck_ref"], request["candidate_plan_ref"],
                owner_id=owner, generation=generation))
        finally:
            keeper.stop()
            store.release(key, owner_id=owner, generation=generation)
    if operation == "claim":
        observer = open_observer(store, rid)
        return plain(store.claim(store.target_key(store.registration(rid)["id"]), observer=observer, owner_id=request.get("owner_id")))
    if operation in ("import-history", "import_history_archive", "history-import", "historyimport"):
        return store.import_history_archive(request["package_path"], expected_ledger_id=store.ledger_id,
            target_key=request.get("target_key") or store.target_key(store.registration(rid)["id"]))
    if operation == "replan":
        reg = store.registration(rid)
        observer = open_observer(store, reg["id"])
        if store.status(reg["id"])["pending_count"]:
            fail("BOOK_WRITE_PAUSED")
        config = json.loads(Path(request["config_path"]).read_bytes()) if request.get("config_path") else json.loads(reg["config"])
        plan = build_current_plan(store, reg["id"], observer, config)
        return {"plan_ref": reference(plan), "action_ids": [a["action_id"] for a in plan["payload"]["actions"]],
                "snapshot_ref": plan["payload"]["snapshot"]}
    if operation in ("tail-absence", "commit-unattempted-absence", "tailabsence"):
        reg = store.registration(rid)
        observer = open_observer(store, reg["id"])
        claim = claim_current(store, observer, store.target_key(reg["id"]), request.get("owner_id"))
        try:
            status = store.status(reg["id"])
            plan = store._plan(reg["id"])
            action = next(a for a in plan["payload"]["actions"] if a["action_id"] == request["action_id"])
            return plain(store.commit_unattempted_absence(store.bundle(reg["id"]), {"registration_id": reg["id"],
                "plan_ref": reference(plan), "action_id": action["action_id"], "action_digest": __import__("annotation.runtime.storage.common", fromlist=["digest"]).digest(action),
                "expected_event_head": status["event_head"]}, owner_id=claim["owner_id"], generation=claim["generation"],
                asset_root=reg["package_root"], observer=observer))
        finally:
            store.release(store.target_key(reg["id"]), owner_id=claim["owner_id"], generation=claim["generation"])
    fail("INVALID_OPERATION", operation)


def build_current_plan(store, registration_id, observer, config):
    with store.effect_gate(store.target_key(registration_id)).acquire():
        if store.status(registration_id)["pending_count"]:
            fail("BOOK_WRITE_PAUSED")
        return _build_current_plan_locked(store, registration_id, observer, config)


def _build_current_plan_locked(store, registration_id, observer, config):
    """Read the actual target then reuse public A02 checks/planning authority.

    The immutable source/graph content PRE_APPLY stays exact; this does not
    pretend to implement B-side recognition or a new precheck algorithm.
    """
    from annotation.contracts import validate_recovery_bundle, policy_ref
    from annotation.delivery.planner import create_plan
    from annotation.quality.targetcheck import append_artifacts, check_target
    reg = store.registration(registration_id)
    observation = observer.observe_target(store.target_key(registration_id), observation_id=unique("plan-observation"))
    captured, snapshot = store.capture_observation(observation, observer, registration_id)
    bundle = validate_recovery_bundle(store.bundle(registration_id), asset_root=reg["package_root"])
    bundle = append_artifacts(bundle, snapshot, asset_root=reg["package_root"])
    graph = next(a for a in bundle.artifacts if a.kind == "QuestionGraph")
    pre = next(a for a in bundle.artifacts if a.kind == "CheckReport" and a.payload.stage == "PRE_APPLY")
    cfg = configuration(config)
    output = check_target(bundle, reference(graph), reference(snapshot), reference(snapshot), policy_ref(bundle.policies[0]),
        cfg, artifact_id=unique("targetcheck"), created_at=snapshot["created_at"])
    target = output.artifacts[-1]
    output = create_plan(output, reference(graph), reference(pre), reference(target), reference(snapshot), reference(snapshot),
        policy_ref(bundle.policies[0]), cfg, artifact_id=unique("plan"), created_at=snapshot["created_at"])
    with store.transaction() as connection:
        for artifact in plain(output)["artifacts"]:
            store._artifact(connection, artifact)
        store._save_bundle(connection, registration_id, plain(output))
    return plain(output.artifacts[-1])


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--request", required=True, type=Path)
    args = parser.parse_args(argv)
    operation = None
    try:
        request = json.loads(args.request.read_bytes())
        operation = request.get("operation")
        result = operate(request)
        print(json.dumps({"ok": True, "operation": operation, "result": plain(result)}, ensure_ascii=False, sort_keys=True))
        if result.get("deadline_exceeded"):
            return 6
        return 3 if operation in ("run", "reconcile") and result.get("pending_count", 0) else 0
    except RuntimeFailure as error:
        print(json.dumps({"ok": False, "operation": operation, "code": error.code, "message": str(error)}, ensure_ascii=False))
        return error.exit_code
    except Exception as error:
        errors = getattr(error, "issues", None)
        if errors is not None:
            code = errors[0].get("code", "INVALID_INPUT") if isinstance(errors, list) and errors else "INVALID_INPUT"
            print(json.dumps({"ok": False, "operation": operation, "code": code, "errors": errors}, ensure_ascii=False))
            return 7 if code in ("SYNTHETIC_ONLY", "SYNTHETIC_COMPLETE_REQUIRED") else 2
        print(json.dumps({"ok": False, "operation": operation, "code": "UNEXPECTED_IMPLEMENTATION_ERROR",
                          "message": str(error), "type": type(error).__name__}, ensure_ascii=False))
        return 5


if __name__ == "__main__":
    sys.exit(main())

a3eeb6a43fab864918399dcba4b2c10a0ef75433 blob 1162
"""Bounded owner lease renewal; process liveness alone never grants authority."""
import threading

from annotation.runtime.storage.common import fail


class LeaseKeeper:
    def __init__(self, store, target_key, owner_id, generation):
        self.store, self.target_key = store, target_key
        self.owner_id, self.generation = owner_id, generation
        self.stopped = threading.Event()
        self.error = None
        self.thread = threading.Thread(target=self._run, name="a03-lease-renewal", daemon=False)

    def _run(self):
        while not self.stopped.wait(2):
            try:
                self.store.renew(self.target_key, owner_id=self.owner_id, generation=self.generation)
            except Exception as error:
                self.error = error
                return

    def start(self):
        self.thread.start()
        return self

    def check(self):
        if self.error is not None:
            raise self.error

    def stop(self):
        self.stopped.set()
        self.thread.join(timeout=7)
        if self.thread.is_alive():
            fail("LEASE_RENEWAL_SHUTDOWN_TIMEOUT", "owned renewal thread did not stop", 6)

a8540adef1fac5e1a804ce955a00b7693fd336cc blob 3320
"""Bounded, preregistered native read subprocess. Retries are always zero."""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import time


def _write(path, value):
    with path.open('xb') as stream:
        stream.write((json.dumps(value, sort_keys=True, indent=2) + '\n').encode('utf-8'))


def observe_native_bounded(observer, *, read_fault=None, timeout=2):
    from annotation.runtime.storage.common import unique, plain
    folder = observer.directory / 'process-audit' / unique('read')
    folder.mkdir(parents=True, exist_ok=False)
    request = {'descriptor': plain(observer.descriptor), 'target_dir': str(observer.directory),
        'observation_id': unique('native-observation'), 'read_fault': read_fault}
    _write(folder / 'request.json', request)
    argv = [sys.executable, '-X', 'utf8', '-B', '-m', 'annotation.runtime.recovery.native_observation', str(folder / 'request.json')]
    _write(folder / 'preregistered.json', {'argv': argv, 'cwd': os.getcwd(), 'timeout_seconds': timeout,
        'input_sha256': hashlib.sha256((folder / 'request.json').read_bytes()).hexdigest(),
        'script_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(), 'retries': 0})
    with (folder / 'script-snapshot.py').open('xb') as stream:
        stream.write(Path(__file__).read_bytes())
    started = time.monotonic()
    forced = False
    with (folder / 'stdout.txt').open('xb') as stdout, (folder / 'stderr.txt').open('xb') as stderr:
        process = subprocess.Popen(argv, stdout=stdout, stderr=stderr)
        _write(folder / 'started.json', {'pid': process.pid, 'parent_pid': os.getpid()})
        try:
            code = process.wait(timeout=max(.01, timeout - (time.monotonic() - started)))
        except subprocess.TimeoutExpired:
            forced = True
            process.kill()
            code = process.wait(timeout=5)
    elapsed = time.monotonic() - started
    _write(folder / 'completed.json', {'pid': process.pid, 'exit_code': code, 'alive': process.poll() is None,
        'timeout': forced, 'elapsed_seconds': elapsed})
    result = {'ok': False, 'code': 'TARGET_READ_TIMEOUT' if forced else 'TARGET_READ_FAILED'}
    if code == 0 and not forced:
        result = json.loads((folder / 'stdout.txt').read_bytes())
    result.update(read_elapsed_seconds=elapsed, process_pid=process.pid, process_exit_code=code,
        process_reaped=process.poll() is not None, forced_termination=forced, process_audit_path=str(folder))
    return result


def worker(path):
    from annotation.runtime.storage.native_target import NativeTargetSession
    request = json.loads(Path(path).read_bytes())
    descriptor = request['descriptor']
    observer = NativeTargetSession.open(request['target_dir'], expected_store_id=descriptor['store_id'],
        expected_target_session_id=descriptor['target_session_id'], expected_target_key=descriptor['target_key'],
        expected_scope_id=descriptor['fixed_scope_id'], expected_source_ref=descriptor['fixed_source_ref'])
    observation = observer.observe_target(descriptor['target_key'], observation_id=request['observation_id'], read_fault=request['read_fault'])
    print(json.dumps({'ok': True, 'observation': observation, 'pid': os.getpid()}))


if __name__ == '__main__':
    worker(sys.argv[1])

7506ef0f15355dd16b35f8e4ea6c350c3c1f911e blob 6464
"""Native independent report read and typed POST/Batch production."""
import json
import time

from annotation.contracts import artifact_ref
from annotation.delivery.planner import compare_action_effect
from annotation.quality.targetcheck import append_artifacts, make_artifact, resolve_artifact
from annotation.runtime.storage.common import Handle, canonical, digest, fail, now, plain, reference, unique
from .observation import observe_bounded


def publish_native_quality(store, registration_id, projection=None, *, owner_id=None, generation=None):
    from . import open_observer, claim_current
    reg = store.registration(registration_id)
    key = store.target_key(registration_id)
    borrowed = owner_id is not None or generation is not None
    if borrowed:
        if owner_id is None or generation is None:
            fail('OWNER_GENERATION_STALE', 'report owner_id and generation must be supplied together', 4)
        # Use the existing instance/PID/ACTIVE/owner/generation/expiry guard.
        # Validate before projecting or consuming the durable report read.
        with store.connect() as connection:
            store._lease(connection, reg['book'], owner_id, generation, pending_ok=True)
    plan = store._plan(registration_id)
    projection = projection or store.project_plan(registration_id, plan)
    if projection.get('receipt_ref') is None:
        return Handle(status='NO_COMPLETE_RECEIPT', content_check_status='PENDING', submission_status='NOT_SUBMITTED')
    observer = open_observer(store, registration_id)
    claim = Handle(owner_id=owner_id, generation=generation) if borrowed else claim_current(store, observer, key)
    try:
        with store.transaction() as connection:
            store._lease(connection, reg['book'], claim['owner_id'], claim['generation'], pending_ok=True)
            connection.execute('INSERT INTO native_report_reads VALUES(?,?,1)', (digest(reference(plan)), time.time()))
        actual = observe_bounded(observer, timeout=2)
        if not actual.get('ok') or actual['read_elapsed_seconds'] > 2:
            fail('NATIVE_REPORT_READ_FAILED', 'durable report read consumed; no implicit retry')
        captured, snapshot = store.capture_observation(actual['observation'], observer, registration_id)
        if snapshot is None:
            fail('NATIVE_REPORT_READ_INCOMPLETE')
        with store.transaction() as connection:
            store._lease(connection, reg['book'], claim['owner_id'], claim['generation'], pending_ok=True)
            store._append(connection, registration_id, snapshot)
        bundle = store._validate(store.bundle(registration_id), asset_root=reg['package_root'])
        receipt = resolve_artifact(bundle, projection['receipt_ref'], 'ExecutionReceipt')
        graph = resolve_artifact(bundle, plan['payload']['graph'], 'QuestionGraph')
        bindings, heads, comparisons = [], [], []
        for action, resource in zip(plan['payload']['actions'], receipt.payload.action_fact_refs):
            fact = store.read_resource(plain(resource), registration_id)
            before = store.read_resource(fact['prepared_before'], registration_id)
            comparison = compare_action_effect(action, before, actual['observation'])
            comparisons.append(comparison)
            head = resolve_artifact(bundle, fact['resolution_ref'], 'ReconciliationResult') if fact['resolution_ref'] else None
            if head:
                heads.append(artifact_ref(head))
            bindings.append({'action_id': action['action_id'], 'action_digest': digest(action),
                'intent_ref': fact['intent_ref'], 'fact_ref': plain(resource),
                'resolution_head_ref': artifact_ref(head) if head else None,
                'head_original_receipt_ref': plain(head.payload.original_receipt_ref) if head else None,
                'observed_snapshot_ref': fact['observed_snapshot_ref'], 'effective_outcome': fact['result']['outcome']})
        frame_pass = all(c['effect_match'] == 'MATCH' for c in comparisons)
        payload = {'stage': 'POST_APPLY', 'subject': artifact_ref(receipt), 'graph': plan['payload']['graph'],
            'policy': plan['payload']['policy'], 'receipt': artifact_ref(receipt), 'report_snapshot_ref': reference(snapshot),
            'report_observation': captured['resource'], 'action_bindings': bindings, 'recovery_refs': heads,
            'frame_structure': 'PASS' if frame_pass else 'FAIL', 'content_check_status': 'PENDING',
            'submission_status': 'NOT_SUBMITTED', 'decision': 'HOLD', 'issues': ['CONTENT_REVIEW_PENDING']}
        post = make_artifact('CheckReport', unique('native-post'), graph, payload, list(bundle.artifacts),
            graph.producer.config_version, 'a03-native-independent-report', now(), bridge_context=bundle.bridge_context)
        bundle = append_artifacts(bundle, post, bridge_context=bundle.bridge_context)
        source = resolve_artifact(bundle, graph.payload.source, 'SourceBundle')
        batch_payload = {'source': artifact_ref(source), 'graph': artifact_ref(graph), 'receipt': artifact_ref(receipt),
            'postcheck': artifact_ref(post), 'report_snapshot_ref': reference(snapshot), 'recovery_refs': heads,
            'scope_manifest': list(source.payload.scope_manifest), 'total_expected': len(source.payload.scope_manifest),
            'questions': [{'question_id': q, 'state': 'PENDING'} for q in source.payload.scope_manifest],
            'state': 'CONTENT_PENDING', 'content_check_status': 'PENDING', 'submission_status': 'NOT_SUBMITTED'}
        batch = make_artifact('BatchReport', unique('native-batch'), graph, batch_payload, list(bundle.artifacts),
            graph.producer.config_version, 'a03-native-independent-report', now(), bridge_context=bundle.bridge_context)
        bundle = append_artifacts(bundle, batch, bridge_context=bundle.bridge_context)
        with store.effect_gate(key).acquire(), store.transaction() as connection:
            store._lease(connection, reg['book'], claim['owner_id'], claim['generation'], pending_ok=True)
            store._append(connection, registration_id, post, batch)
        return Handle(postcheck_ref=artifact_ref(post), batch_ref=artifact_ref(batch), frame_structure=payload['frame_structure'],
            content_check_status='PENDING', submission_status='NOT_SUBMITTED')
    finally:
        if not borrowed:
            store.release(key, owner_id=claim['owner_id'], generation=claim['generation'])

7ee1acf97c558dd1645284302487caaced16f66d blob 2610
"""Bounded controlled-target read process; never dispatches a business effect."""
import multiprocessing
import os
import time

from annotation.runtime.storage.common import plain, unique


def _worker(pipe, descriptor, target_dir, observation_id, read_fault):
    try:
        from annotation.delivery.mock.persistent import PersistentMockSession
        observer = PersistentMockSession.open(target_dir, expected_store_id=descriptor["store_id"],
            expected_target_session_id=descriptor["target_session_id"], expected_target_key=descriptor["target_key"],
            expected_scope_id=descriptor["fixed_scope_id"], expected_source_ref=descriptor["fixed_source_ref"])
        value = observer.observe_target(descriptor["target_key"], observation_id=observation_id, read_fault=read_fault)
        pipe.send({"ok": True, "observation": plain(value), "pid": os.getpid()})
    except Exception as error:
        pipe.send({"ok": False, "code": getattr(error, "code", "TARGET_READ_FAILED"),
                   "message": str(error), "pid": os.getpid()})
    finally:
        pipe.close()


def observe_bounded(observer, *, read_fault=None, timeout=2):
    if getattr(observer, '_native', False):
        from .native_observation import observe_native_bounded
        return observe_native_bounded(observer, read_fault=read_fault, timeout=timeout)
    context = multiprocessing.get_context("spawn")
    parent, child = context.Pipe(duplex=False)
    process = context.Process(target=_worker, args=(child, plain(observer.descriptor),
        str(observer.directory), unique("recovery-observation"), read_fault))
    started = time.monotonic()
    process.start()
    child.close()
    value = None
    forced = False
    try:
        if parent.poll(max(0, timeout - (time.monotonic() - started))):
            try:
                value = parent.recv()
            except EOFError:
                value = {"ok": False, "code": "TARGET_READ_PROCESS_EXIT"}
        else:
            forced = True
            process.terminate()
    finally:
        process.join(timeout=max(.01, timeout - (time.monotonic() - started)))
        if process.is_alive():
            forced = True
            process.kill()
            process.join(timeout=5)
        parent.close()
    result = value or {"ok": False, "code": "TARGET_READ_TIMEOUT"}
    result.update(read_elapsed_seconds=time.monotonic() - started, process_pid=process.pid,
        process_exit_code=process.exitcode, process_reaped=not process.is_alive(), forced_termination=forced)
    if result["process_reaped"]:
        process.close()
    return result

cb23cab5200ca1ee2d8c9c639a6f1274ccf2e3e5 blob 20659
"""Synthetic recovery report projection; no target I/O or store authority.

Reports are new immutable consumers of complete validated receipts and exact
resolution heads. Partial progress and unknown/empty denominators remain
diagnostic values. Frame evidence never verifies final content or submission.
"""
import copy
import json
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path

from annotation.contracts import (artifact_ref, content_digest, effective_recovery_outcomes,
    load_archive_bundle, seal_artifact, validate_recovery_bundle)
from annotation.quality.targetcheck import coverage_for, make_artifact, reject, resolve_artifact


@dataclass(frozen=True)
class QualityResult:
    bundle: object
    diagnostic: dict
    postcheck_ref: object = None
    batch_ref: object = None


def _plain(value):
    if hasattr(value, "model_dump"):
        return _plain(value.model_dump(mode="json"))
    if isinstance(value, dict):
        return {key: _plain(child) for key, child in value.items()}
    if isinstance(value, (list, tuple)):
        return [_plain(child) for child in value]
    return copy.deepcopy(value)


def _head_results(bundle, plan):
    items = [a for a in bundle.artifacts if a.kind == "ReconciliationResult" and
             a.book_id == plan.book_id and a.scope_id == plan.scope_id and
             _plain(a.payload.plan_ref) == artifact_ref(plan)]
    ref_key = lambda ref: tuple(ref[key] for key in ("artifact_id", "revision", "kind", "content_hash"))
    previous = {ref_key(_plain(a.payload.previous_resolution_ref)) for a in items
                if a.payload.previous_resolution_ref is not None}
    heads = [a for a in items if ref_key(artifact_ref(a)) not in previous]
    heads.sort(key=lambda a: next(i for i, action in enumerate(plan.payload.actions)
                                  if action.action_id == a.payload.action_id))
    return heads


def _source_states(source, graph, statuses, outcomes, action_questions):
    manifest = source.payload.scope_manifest
    if manifest is None:
        return []
    statuses = dict(statuses or {})
    if set(statuses) - set(manifest):
        reject("DENOMINATOR_CHANGED", "status input names a question outside the exact source scope")
    if any(state not in ("PENDING", "EXCEPTION", "SKIPPED") for state in statuses.values()):
        reject("COMPLETION_GUARD", "caller statuses cannot manufacture content verification or save outcomes")
    graph_questions = {q.question_id for q in graph.payload.questions} if graph is not None else set()
    values = []
    for question_id in manifest:
        state = statuses.get(question_id, "PENDING" if question_id in graph_questions else "EXCEPTION")
        if any(outcome == "UNKNOWN" and action_questions.get(action_id) == question_id for action_id, outcome in outcomes.items()):
            state = "UNKNOWN"
        reason = ("source scope item is absent from the graph and remains counted" if question_id not in graph_questions else
                  "actual save remains unresolved" if state == "UNKNOWN" else
                  "synthetic scope item; final content and human submission remain unverified")
        values.append({"question_id": question_id, "state": state, "reason": reason})
    return values


def _diagnostic(source, graph, statuses, outcomes, action_questions, *, state, paused=False,
                unresolved=(), progress_ref=None, recovery_refs=()):
    manifest = _plain(source.payload.scope_manifest)
    return {"format_version": "a03-quality-diagnostic-1", "origin": "SYNTHETIC",
            "execution_mode": "SIMULATED", "authority": "DIAGNOSTIC_ONLY",
            "source_ref": artifact_ref(source), "scope_manifest": manifest,
            "total_expected": None if manifest is None else len(manifest),
            "questions": _source_states(source, graph, statuses, outcomes, action_questions),
            "effective_outcomes": copy.deepcopy(outcomes), "state": state,
            "scope_paused": paused, "pause_authority": "SAME_SCOPE_CONTRACT_ONLY",
            "unresolved": _plain(list(unresolved)), "progress_ref": _plain(progress_ref),
            "recovery_refs": _plain(list(recovery_refs)), "postcheck_ref": None, "batch_ref": None,
            "content_check_status": "PENDING", "submission_status": "NOT_SUBMITTED",
            "completion_ratio": None, "model_calls": 0, "platform_actions": 0}


def _declare_consumed(artifact, evidence, root):
    """Declare this consumer's ordinary refs through its formal resource graph."""
    refs, visited = {}, set()
    records = {record["evidence_id"]: record for record in evidence}
    fields = {"evidence_refs", "before_evidence_refs", "after_evidence_refs", "submission_evidence_refs"}
    def walk(value):
        if isinstance(value, list):
            for child in value:
                walk(child)
        elif isinstance(value, dict):
            if set(value) == {"artifact_id", "revision", "kind", "content_hash"}:
                refs[tuple(value[k] for k in ("artifact_id", "revision", "kind", "content_hash"))] = value
            elif {"path", "sha256", "media_type"}.issubset(value):
                key = (value["path"], value["sha256"], value["media_type"])
                if value["media_type"] == "application/json" and key not in visited:
                    visited.add(key)
                    walk(json.loads((Path(root) / value["path"]).read_text(encoding="utf-8")))
            else:
                for name, child in value.items():
                    if name in fields and isinstance(child, list):
                        for member in child:
                            if isinstance(member, str):
                                if member not in records:
                                    reject("MISSING_REFERENCE", "report formal evidence ID is absent")
                                walk(records[member]["resource"])
                    walk(child)
    # The envelope is not a reference to itself.
    walk(artifact["payload"])
    walk(artifact["input_refs"])
    artifact["input_refs"] = list(refs.values())
    return seal_artifact(artifact)


def build_quality_report(bundle, *, target_key, source_ref=None, receipt_ref=None, progress_ref=None,
                         statuses=None, config_version, postcheck_id, batch_id, created_at, asset_root=None):
    """Produce new POST_APPLY/BatchReport, or a complete diagnostic projection.

    This same-scope value projection cannot clear runtime book pauses. The
    caller retains runtime's current all-scope scan and writes a new bundle.
    """
    bundle = validate_recovery_bundle(bundle, asset_root=asset_root)
    plan = graph = receipt = progress = None
    if receipt_ref is not None:
        receipt = resolve_artifact(bundle, receipt_ref, "ExecutionReceipt")
        plan = resolve_artifact(bundle, receipt.payload.plan, "ApplyPlan")
    if progress_ref is not None:
        progress = resolve_artifact(bundle, progress_ref, "ExecutionProgress")
        progress_plan = resolve_artifact(bundle, progress.payload.plan_ref, "ApplyPlan")
        if plan is not None and artifact_ref(plan) != artifact_ref(progress_plan):
            reject("BATCH_BINDING", "progress and receipt bind different plans")
        plan = progress_plan
    if plan is not None:
        graph = resolve_artifact(bundle, plan.payload.graph, "QuestionGraph")
        source = resolve_artifact(bundle, graph.payload.source, "SourceBundle")
        if source_ref is not None and _plain(source_ref) != artifact_ref(source):
            reject("SOURCE_BINDING", "requested source differs from the exact plan graph")
        if config_version != plan.producer.config_version:
            reject("AUTHORIZATION_CHANGED", "report configuration differs from its exact plan")
        snapshot = resolve_artifact(bundle, plan.payload.snapshot, "PlatformSnapshot")
        if target_key["target_id"] != snapshot.payload.target_id:
            reject("TARGET_IDENTITY_MISMATCH", "report target differs from its exact snapshot")
    elif source_ref is not None:
        source = resolve_artifact(bundle, source_ref, "SourceBundle")
    else:
        reject("MISSING_REFERENCE", "source, complete receipt or progress ref is required")
    if source.book_id != target_key["book_id"]:
        reject("TARGET_IDENTITY_MISMATCH", "report canonical book key differs from source")
    if receipt is not None:
        for result in receipt.payload.results:
            if result.intent_ref is not None:
                intent = resolve_artifact(bundle, result.intent_ref, "WriteIntent")
                if _plain(intent.payload.target_key) != target_key:
                    reject("TARGET_IDENTITY_MISMATCH", "receipt intent canonical target namespace differs")
    view = effective_recovery_outcomes(bundle, target_key=target_key, scope_id=source.scope_id)
    action_questions = {action.action_id: action.target.question_id for a in bundle.artifacts
                        if a.kind == "ApplyPlan" and a.book_id == source.book_id and a.scope_id == source.scope_id
                        for action in a.payload.actions}
    heads = _head_results(bundle, plan) if plan is not None else []
    head_refs = [artifact_ref(head) for head in heads]
    state = ("UNKNOWN_DENOMINATOR" if source.payload.scope_manifest is None else "NO_ACTIONS" if not source.payload.scope_manifest
             else "NEEDS_RECONCILIATION" if view.paused else "PARTIAL_PROGRESS")
    diagnostic = _diagnostic(source, graph, statuses, dict(view.outcomes), action_questions, state=state,
        paused=view.paused, unresolved=view.unresolved, progress_ref=progress_ref, recovery_refs=head_refs)
    if receipt is None or not source.payload.scope_manifest:
        diagnostic["report_kind"] = "DIAGNOSTIC_ONLY"
        return QualityResult(bundle, diagnostic)
    # Frozen CheckReport has one snapshot and requires exact original-receipt
    # binding. Do not invent a combined observation or retrofit an original ref.
    if any(_plain(head.payload.original_receipt_ref) != artifact_ref(receipt) for head in heads):
        diagnostic.update(state="REPORT_CONTRACT_GAP", reason_code="RECOVERY_RECEIPT_BINDING_UNREPRESENTABLE")
        return QualityResult(bundle, diagnostic)
    observed_refs = [_plain(head.payload.observed_snapshot_ref) for head in heads]
    if observed_refs and any(ref != observed_refs[0] for ref in observed_refs):
        diagnostic.update(state="REPORT_CONTRACT_GAP", reason_code="MULTIPLE_RECOVERY_SNAPSHOTS_UNREPRESENTABLE")
        return QualityResult(bundle, diagnostic)
    if any(a.artifact_id in (postcheck_id, batch_id) for a in bundle.artifacts) or postcheck_id == batch_id:
        reject("DUPLICATE_ID", "quality output identities must be new and distinct")
    created = datetime.fromisoformat(created_at.replace("Z", "+00:00"))
    if created.tzinfo is None or any(created < datetime.fromisoformat(h.payload.observed_at.replace("Z", "+00:00")) for h in heads):
        reject("OBSERVATION_NOT_FRESH", "new report cannot predate its consumed current resolution head")
    effective = {result.action_id: result.outcome for result in receipt.payload.results}
    effective.update({head.payload.action_id: {"RESOLVED_APPLIED": "APPLIED", "RESOLVED_NOT_APPLIED": "NOT_APPLIED",
                                              "STILL_UNKNOWN": "UNKNOWN"}[head.payload.resolution] for head in heads})
    all_applied = bool(effective) and all(value == "APPLIED" for value in effective.values())
    unknown = "UNKNOWN" in effective.values() or view.paused
    frames = "PASS" if all_applied else "UNAVAILABLE" if unknown or not effective else "FAIL"
    coverage, _ = coverage_for(bundle, graph)
    evidence = _plain(bundle.evidence)
    proof = list(receipt.payload.results[-1].after_evidence_refs) if receipt.payload.results else list(snapshot.payload.evidence_refs)
    for head in heads:
        resource = _plain(head.payload.readback)
        if resource is not None:
            evidence_id = "proof-quality-" + content_digest({"postcheck": postcheck_id, "resource": resource})[:32]
            if not any(record["evidence_id"] == evidence_id for record in evidence):
                evidence.append({"evidence_id": evidence_id, "resource": resource, "mode": "SYNTHETIC",
                                 "description": "actual immutable recovery observation consumed by this new report"})
            proof.append(evidence_id)
    proof = list(dict.fromkeys(proof))
    if not proof:
        reject("MISSING_REFERENCE", "report requires actual receipt or observation evidence")
    token = content_digest({"postcheck": postcheck_id, "receipt": artifact_ref(receipt)})[:28]
    issues = [{"issue_id": "issue-quality-content-" + token, "code": "CONTENT_MISMATCH", "scope_type": "scope",
               "scope_id": graph.scope_id, "evidence_refs": proof, "severity": "blocking", "blocks": ["COMPLETE"],
               "suggested_strategy": {"strategy_id": "WAIT_CONTENT", "max_attempts": 0, "max_cost": 0.0},
               "reason": "synthetic frame evidence does not verify final text, formula, image content or human submission"}]
    if unknown:
        issues.append({"issue_id": "issue-quality-save-" + token, "code": "SAVE_UNKNOWN", "scope_type": "scope",
                       "scope_id": graph.scope_id, "evidence_refs": proof, "severity": "blocking", "blocks": ["APPLY", "COMPLETE"],
                       "suggested_strategy": {"strategy_id": "RECONCILE", "max_attempts": 0, "max_cost": 0.0},
                       "reason": "current same-scope unresolved save obligations remain counted; no replay is allowed"})
    report_snapshot = observed_refs[0] if observed_refs else None
    if not heads and receipt.payload.action_fact_refs:
        last_fact = json.loads((bundle.asset_root / receipt.payload.action_fact_refs[-1].path).read_text(encoding="utf-8"))
        report_snapshot = last_fact["observed_snapshot_ref"]
    if report_snapshot is not None:
        actual_snapshot = resolve_artifact(bundle, report_snapshot, "PlatformSnapshot")
        if created < datetime.fromisoformat(actual_snapshot.payload.observed_at.replace("Z", "+00:00")):
            reject("OBSERVATION_NOT_FRESH", "new report cannot predate its actual receipt readback")
    dependencies = [source, graph, plan, receipt] + heads
    if report_snapshot is not None:
        dependencies.append(resolve_artifact(bundle, report_snapshot, "PlatformSnapshot"))
    post = make_artifact("CheckReport", postcheck_id, plan,
        {"stage": "POST_APPLY", "subject": artifact_ref(receipt), "graph": artifact_ref(graph),
         "policy": _plain(plan.payload.policy), "snapshot": report_snapshot, "receipt": artifact_ref(receipt),
         "coverage": coverage, "checks": [
             {"check_id": "frame_structure", "outcome": frames, "evidence_refs": proof,
              "reason": "effective committed action facts and exact current recovery chain heads"},
             {"check_id": "final_content", "outcome": "UNAVAILABLE", "evidence_refs": proof,
              "reason": "final content has no independent verification"}],
         "issues": issues, "decision": "HOLD", "reason": "synthetic recovery projection; final content remains pending",
         "recovery_refs": head_refs}, dependencies, config_version, "a03-runtime-quality", created_at)
    post = _declare_consumed(post, evidence, bundle.asset_root)
    states = _source_states(source, graph, statuses, dict(view.outcomes), action_questions)
    batch_state = "NEEDS_RECONCILIATION" if unknown else "CONTENT_PENDING" if all_applied and not any(
        item["state"] in ("EXCEPTION", "SKIPPED") for item in states) else "NEEDS_REVIEW"
    unresolved = list(plan.payload.blocked_issue_ids) + [issue["issue_id"] for issue in issues]
    batch = make_artifact("BatchReport", batch_id, plan,
        {"source": artifact_ref(source), "graph": artifact_ref(graph), "receipt": artifact_ref(receipt),
         "postcheck": artifact_ref(post), "scope_manifest": list(source.payload.scope_manifest), "questions": states,
         "total_expected": len(source.payload.scope_manifest), "coverage": coverage,
         "cost": {"model_calls": 0, "amount": 0.0, "currency": "USD", "billing_status": "KNOWN", "human_minutes": 0.0},
         "unresolved_issue_ids": list(dict.fromkeys(unresolved)), "submission_status": "NOT_SUBMITTED",
         "submission_evidence_refs": [], "content_check_status": "PENDING", "frame_check_status": frames,
         "state": batch_state, "recovery_refs": head_refs, "progress_refs": [_plain(progress_ref)] if progress_ref else []},
        dependencies + [post] + ([progress] if progress is not None else []), config_version, "a03-runtime-quality", created_at)
    batch = _declare_consumed(batch, evidence, bundle.asset_root)
    data = bundle.model_dump()
    data["evidence"] = evidence
    data["artifacts"].extend([post, batch])
    output = validate_recovery_bundle(data, asset_root=bundle.asset_root)
    diagnostic.update(state=batch_state, postcheck_ref=artifact_ref(post), batch_ref=artifact_ref(batch),
                      effective_outcomes=effective, frame_check_status=frames)
    return QualityResult(output, diagnostic, artifact_ref(post), artifact_ref(batch))


def describe_archived_source(archive, *, source_ref, statuses=None):
    """Unknown denominator stays an archive-only diagnostic, never admission."""
    if not isinstance(archive, dict) or archive.get("eligibility") != "ARCHIVE_ONLY":
        reject("ARCHIVE_REQUIRED", "use the explicit public archive loader")
    current = load_archive_bundle(archive["path"], verify_assets=True)
    if current.sha256 != archive.get("sha256"):
        reject("RESOURCE_HASH_MISMATCH", "archive bytes changed after selection")
    data = current.bundle
    if any(a["producer"]["evidence_mode"] != "SYNTHETIC" for a in data["artifacts"]) or any(
            item["mode"] != "SYNTHETIC" for item in data["evidence"]):
        reject("SYNTHETIC_ONLY", "this diagnostic scope is all synthetic")
    checked_resources = set()
    def synthetic(value):
        if isinstance(value, list):
            for member in value:
                synthetic(member)
        elif isinstance(value, dict):
            if (value.get("origin", "SYNTHETIC") != "SYNTHETIC" or
                    value.get("provenance", "SYNTHETIC") != "SYNTHETIC" or value.get("mode") == "OBSERVED" or
                    "execution_mode" in value and value["execution_mode"] not in ("SIMULATED", "NOT_EXECUTED") or
                    "region_id" in value and value.get("source", "SYNTHETIC") != "SYNTHETIC" or
                    "clue_id" in value and value.get("source", "SYNTHETIC") != "SYNTHETIC"):
                reject("SYNTHETIC_ONLY", "archive diagnostic cannot relabel real or observed material")
            if {"path", "sha256", "media_type"}.issubset(value) and value["media_type"] == "application/json":
                key = (value["path"], value["sha256"])
                if key not in checked_resources:
                    checked_resources.add(key)
                    synthetic(json.loads((Path(current.path).parent / value["path"]).read_text(encoding="utf-8")))
            for child in value.values():
                synthetic(child)
    synthetic(data)
    source = next((a for a in data["artifacts"] if artifact_ref(a) == _plain(source_ref) and a["kind"] == "SourceBundle"), None)
    if source is None:
        reject("MISSING_REFERENCE", "exact archived source is absent")
    manifest = source["payload"]["scope_manifest"]
    graphs = [a for a in data["artifacts"] if a["kind"] == "QuestionGraph" and
              a["book_id"] == source["book_id"] and a["scope_id"] == source["scope_id"] and
              a["payload"]["source"] == artifact_ref(source)]
    state = "UNKNOWN_DENOMINATOR" if manifest is None else "NO_ACTIONS" if not manifest else "ARCHIVED_SCOPE_ONLY"
    diagnostic = {"format_version": "a03-quality-diagnostic-1", "origin": "SYNTHETIC", "authority": "ARCHIVE_ONLY",
                  "state": state, "scope_manifest": copy.deepcopy(manifest), "total_expected": None if manifest is None else len(manifest),
                  "source_ref": artifact_ref(source), "completion_ratio": None, "postcheck_ref": None, "batch_ref": None,
                  "content_check_status": "PENDING", "submission_status": "NOT_SUBMITTED",
                  "questions": _source_states(source, graphs[0] if len(graphs) == 1 else None, statuses, {}, {}),
                  "provided_statuses": copy.deepcopy(statuses or {}), "model_calls": 0, "platform_actions": 0}
    return diagnostic

dabc8d4412c25f8190b5b5cdefd22e298fc581dc blob 77114
"""A03 controlled local ledger, immutable files and single-use authority.

SQLite transactions never include target effects. The common OS book gate is
held by the target around authorization and its independent effect transaction.
Opening a missing state is always an error; only explicit init creates a store.
"""
from contextlib import contextmanager
from contextvars import ContextVar
import copy
import hashlib
import json
import os
from pathlib import Path
import shutil
import sqlite3
import time

from .common import (RuntimeFailure, Handle, canonical, digest, exclusive_bytes,
                     fail, now, plain, reference, unique, FaultController)
from .holds import HoldSupport

DB_VERSION = "a03-runtime-db-1"
ZERO = "0" * 64
CURRENT = ContextVar("a03_current_runtime", default=None)


class ClosingConnection(sqlite3.Connection):
    """A read transaction context also releases its Windows file handle."""

    def __exit__(self, *args):
        try:
            return super().__exit__(*args)
        finally:
            self.close()


SQL = """
CREATE TABLE meta(key TEXT PRIMARY KEY,value TEXT NOT NULL);
CREATE TABLE files(path TEXT PRIMARY KEY,sha TEXT NOT NULL,size INTEGER NOT NULL);
CREATE TABLE books(key TEXT PRIMARY KEY,target_key TEXT NOT NULL,journal TEXT NOT NULL,
 owner TEXT,generation INTEGER NOT NULL DEFAULT 0,phase TEXT NOT NULL DEFAULT 'IDLE',
 pid INTEGER,process_id TEXT,lease REAL NOT NULL DEFAULT 0,head_sequence INTEGER NOT NULL DEFAULT 0,
 head_hash TEXT NOT NULL,hold TEXT);
CREATE TABLE registrations(id TEXT PRIMARY KEY,book TEXT NOT NULL,scope TEXT NOT NULL,
 source TEXT NOT NULL,session TEXT NOT NULL,target_dir TEXT NOT NULL,package_root TEXT NOT NULL,
 bundle_path TEXT NOT NULL,config TEXT NOT NULL);
CREATE TABLE artifacts(identity TEXT PRIMARY KEY,book TEXT NOT NULL,scope TEXT NOT NULL,
 ref TEXT NOT NULL,path TEXT NOT NULL);
CREATE TABLE events(book TEXT NOT NULL,sequence INTEGER NOT NULL,body TEXT NOT NULL,
 PRIMARY KEY(book,sequence));
CREATE TABLE plans(id TEXT PRIMARY KEY,book TEXT NOT NULL,registration TEXT NOT NULL,
 ref TEXT NOT NULL,status TEXT NOT NULL,cursor INTEGER NOT NULL DEFAULT 0);
CREATE TABLE actions(book TEXT NOT NULL,id TEXT NOT NULL,digest TEXT NOT NULL,plan TEXT NOT NULL,
 position INTEGER NOT NULL,state TEXT NOT NULL,intent TEXT,fact TEXT,PRIMARY KEY(book,id));
CREATE TABLE intents(id TEXT PRIMARY KEY,book TEXT NOT NULL,plan TEXT NOT NULL,action TEXT NOT NULL,
 ref TEXT NOT NULL,obligation TEXT UNIQUE NOT NULL,prepared TEXT NOT NULL,state TEXT NOT NULL,
 owner TEXT NOT NULL,generation INTEGER NOT NULL,receipt TEXT);
CREATE TABLE permits(token TEXT PRIMARY KEY,intent TEXT NOT NULL,state TEXT NOT NULL,head TEXT NOT NULL);
CREATE TABLE resolutions(id TEXT PRIMARY KEY,intent TEXT NOT NULL,ref TEXT NOT NULL,outcome TEXT NOT NULL);
CREATE TABLE legacy(id TEXT PRIMARY KEY,book TEXT NOT NULL,scope TEXT NOT NULL,classification TEXT NOT NULL,resource TEXT NOT NULL);
CREATE TABLE calls(id TEXT PRIMARY KEY,book TEXT NOT NULL,queue TEXT NOT NULL,created REAL NOT NULL);
CREATE TABLE attempts(call_id TEXT NOT NULL,intent TEXT NOT NULL,number INTEGER NOT NULL,
 status TEXT NOT NULL,resource TEXT,PRIMARY KEY(call_id,intent,number));
CREATE TABLE attempt_windows(call_id TEXT NOT NULL,intent TEXT NOT NULL,started REAL NOT NULL,
 PRIMARY KEY(call_id,intent));
"""


def init_state(anchor_path, *, state_dir, expected_ledger_id, expected_target_store_id):
    anchor, directory = Path(anchor_path).resolve(), Path(state_dir).resolve()
    if anchor.exists() or directory.exists():
        fail("STATE_INIT_TARGET_EXISTS", "explicit init requires a new state directory", 5)
    directory.mkdir(parents=True)
    database = directory / "runtime.sqlite3"
    connection = sqlite3.connect(str(database), timeout=1)
    try:
        connection.execute("PRAGMA application_id=1093677906")
        connection.execute("PRAGMA user_version=1")
        connection.executescript(SQL)
        for key, value in {"version": DB_VERSION, "ledger_id": expected_ledger_id,
                           "target_store_id": expected_target_store_id, "state_dir": str(directory)}.items():
            connection.execute("INSERT INTO meta VALUES(?,?)", (key, value))
        connection.commit()
    finally:
        connection.close()
    descriptor = {"format_version": "a03-runtime-anchor-1", "state_dir": str(directory),
        "anchor_path": str(anchor), "ledger_id": expected_ledger_id,
        "target_store_id": expected_target_store_id, "db_version": DB_VERSION}
    exclusive_bytes(anchor, canonical(descriptor))
    return open_state(anchor, expected_ledger_id=expected_ledger_id,
                      expected_target_store_id=expected_target_store_id)


def open_state(anchor_path, *, expected_ledger_id, expected_target_store_id):
    store = RuntimeStore(anchor_path, expected_ledger_id=expected_ledger_id,
                         expected_target_store_id=expected_target_store_id)
    CURRENT.set(store)
    return store


class RuntimeStore(HoldSupport):
    _db_version = DB_VERSION
    _application_id = 0x41303352
    _user_version = 1

    def bridge_for(self, bundle, root=None):
        return None

    def _validate(self, bundle, *, asset_root):
        from annotation.contracts import validate_recovery_bundle
        return validate_recovery_bundle(bundle, asset_root=asset_root, bridge_context=self.bridge_for(bundle, asset_root))

    def _expected_meta(self):
        return {"version": self._db_version, "ledger_id": self.ledger_id,
            "target_store_id": self.target_store_id, "state_dir": str(self.directory)}
    def __init__(self, anchor_path, *, expected_ledger_id, expected_target_store_id):
        self.anchor_path = Path(anchor_path).resolve()
        try:
            self.anchor = json.loads(self.anchor_path.read_bytes())
        except (OSError, ValueError) as error:
            fail("STATE_DIRECTORY_IDENTITY_MISMATCH", str(error), 5)
        self.directory = Path(self.anchor.get("state_dir", "")).resolve()
        if (self.anchor.get("anchor_path") != str(self.anchor_path) or self.anchor.get("ledger_id") != expected_ledger_id
                or self.anchor.get("target_store_id") != expected_target_store_id or self.anchor.get("db_version") != self._db_version):
            fail("STATE_DIRECTORY_IDENTITY_MISMATCH", "anchor/config identities differ", 5)
        self.database = self.directory / "runtime.sqlite3"
        if not self.database.is_file() or self.database.is_symlink():
            fail("LEDGER_MISSING", "open never initializes missing data", 5)
        self.ledger_id, self.target_store_id = expected_ledger_id, expected_target_store_id
        self.instance = unique("process")
        self.owner_id = self.instance
        self.current_claim = None
        self._issued = {}
        self._observations = {}
        self._observation_deadlines = {}
        self._observers = {}
        self._prepared_intents = {}
        self._gates = {}
        self.fault = FaultController()
        self.verify_integrity()

    def connect(self):
        try:
            connection = sqlite3.connect(self.database.as_uri() + "?mode=rw", uri=True, timeout=1,
                                         factory=ClosingConnection)
            connection.row_factory = sqlite3.Row
            connection.execute("PRAGMA foreign_keys=ON")
            connection.execute("PRAGMA busy_timeout=1000")
            return connection
        except sqlite3.Error as error:
            fail("LEDGER_CORRUPT", str(error), 5)

    @contextmanager
    def transaction(self):
        connection = self.connect()
        try:
            connection.execute("BEGIN IMMEDIATE")
            yield connection
            connection.commit()
        except sqlite3.Error as error:
            connection.rollback()
            fail("STORAGE_TRANSACTION_FAILED", str(error), 5)
        except BaseException:
            connection.rollback()
            raise
        finally:
            connection.close()

    def verify_integrity(self):
        try:
            with self.connect() as connection:
                meta = dict(connection.execute("SELECT key,value FROM meta"))
                if meta != self._expected_meta():
                    fail("LEDGER_VERSION_UNSUPPORTED", "metadata mismatch", 5)
                if connection.execute("PRAGMA integrity_check").fetchone()[0] != "ok":
                    fail("LEDGER_CORRUPT", "SQLite integrity check failed", 5)
                if connection.execute("PRAGMA application_id").fetchone()[0] != self._application_id or connection.execute("PRAGMA user_version").fetchone()[0] != self._user_version:
                    fail("LEDGER_VERSION_UNSUPPORTED", "SQLite application/user version mismatch", 5)
                if not connection.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='attempt_windows'").fetchone():
                    fail("LEDGER_VERSION_UNSUPPORTED", "runtime schema is incomplete", 5)
                for row in connection.execute("SELECT * FROM files"):
                    path = self.directory / row["path"]
                    if not path.is_file() or path.is_symlink():
                        fail("RESOURCE_MISSING", row["path"], 5)
                    raw = path.read_bytes()
                    if len(raw) != row["size"] or hashlib.sha256(raw).hexdigest() != row["sha"]:
                        fail("RESOURCE_HASH_MISMATCH", row["path"], 5)
                for book in connection.execute("SELECT * FROM books"):
                    previous, sequence = ZERO, 0
                    for row in connection.execute("SELECT body FROM events WHERE book=? ORDER BY sequence", (book["key"],)):
                        event = json.loads(row["body"])
                        sequence += 1
                        if (event["sequence"] != sequence or event["previous_hash"] != previous or
                            event["event_hash"] != digest({k: v for k, v in event.items() if k != "event_hash"})):
                            fail("LEDGER_CORRUPT", "event chain mismatch", 5)
                        previous = event["event_hash"]
                    if (sequence, previous) != (book["head_sequence"], book["head_hash"]):
                        fail("LEDGER_INCOMPLETE", "event head differs", 5)
        except sqlite3.Error as error:
            fail("LEDGER_CORRUPT", str(error), 5)
        return True

    def _file(self, path, data, connection=None):
        path = exclusive_bytes(path, data).resolve()
        if self.directory not in path.parents:
            fail("STATE_DIRECTORY_IDENTITY_MISMATCH", str(path), 5)
        args = (path.relative_to(self.directory).as_posix(), hashlib.sha256(data).hexdigest(), len(data))
        if connection is None:
            with self.transaction() as current:
                current.execute("INSERT OR IGNORE INTO files VALUES(?,?,?)", args)
        else:
            connection.execute("INSERT OR IGNORE INTO files VALUES(?,?,?)", args)
        return path

    def object(self, value, connection=None):
        data = canonical(value)
        return self._file(self.directory / "objects" / (hashlib.sha256(data).hexdigest() + ".json"), data, connection)

    def resource(self, value, registration_id, connection=None):
        reg = self.registration(registration_id)
        data = canonical(value)
        relative = "assets/runtime/" + hashlib.sha256(data).hexdigest() + ".json"
        self._file(Path(reg["package_root"]) / relative, data, connection)
        return {"path": relative, "sha256": hashlib.sha256(data).hexdigest(),
                "media_type": "application/json", "origin": "SYNTHETIC"}

    def read_resource(self, resource, registration_id):
        root = Path(self.registration(registration_id)["package_root"])
        path = (root / resource["path"]).resolve()
        if root not in path.parents or not path.is_file():
            fail("RESOURCE_MISSING", resource["path"], 5)
        raw = path.read_bytes()
        if hashlib.sha256(raw).hexdigest() != resource["sha256"]:
            fail("RESOURCE_HASH_MISMATCH", resource["path"], 5)
        return json.loads(raw)

    def registration(self, registration_id=None):
        with self.connect() as connection:
            if registration_id:
                row = connection.execute("SELECT * FROM registrations WHERE id=?", (registration_id,)).fetchone()
            else:
                rows = connection.execute("SELECT * FROM registrations").fetchall()
                row = rows[0] if len(rows) == 1 else None
        if row is None:
            fail("REGISTRATION_BINDING_MISMATCH", "explicit registration required")
        return dict(row)

    def bundle(self, registration_id):
        reg = self.registration(registration_id)
        return json.loads(Path(reg["bundle_path"]).read_bytes())

    def book_id(self, target_key):
        if not isinstance(target_key, dict) or set(target_key) != {"platform_namespace", "target_id", "book_id"}:
            fail("TARGET_IDENTITY_MISMATCH", "canonical three-part book key required")
        return digest(target_key)

    def register_book(self, bundle, *, target_key, target_dir, target_session_id, source_ref,
                      asset_root, config=None, registration_id=None):
        from annotation.contracts import validate_recovery_bundle
        validated = self._validate(bundle, asset_root=asset_root)
        value, root = plain(validated), Path(asset_root).resolve()
        key = self.book_id(target_key)
        source = next((a for a in value["artifacts"] if reference(a) == plain(source_ref)), None)
        if source is None or source["book_id"] != target_key["book_id"]:
            fail("SOURCE_BINDING", "registered source missing")
        package_root = self.directory / "packages" / digest(value)
        package_root.mkdir(parents=True, exist_ok=True)
        seen = set()

        def resources(node):
            if isinstance(node, dict):
                if {"path", "sha256"} <= set(node):
                    path = (root / node["path"]).resolve()
                    if root not in path.parents or path.is_symlink() or not path.is_file():
                        fail("RESOURCE_MISSING", str(node["path"]), 5)
                    raw = path.read_bytes()
                    if hashlib.sha256(raw).hexdigest() != node["sha256"]:
                        fail("RESOURCE_HASH_MISMATCH", node["path"], 5)
                    if node["path"] not in seen:
                        seen.add(node["path"])
                        self._file(package_root / node["path"], raw)
                        if node.get("media_type") == "application/json":
                            resources(json.loads(raw))
                for item in node.values():
                    resources(item)
            elif isinstance(node, list):
                for item in node:
                    resources(item)
        resources(value)
        stored = self._file(package_root / ("bundle-" + digest(value) + ".json"), canonical(value))
        rid = registration_id or unique("registration")
        with self.transaction() as connection:
            existing = connection.execute("SELECT * FROM registrations WHERE book=?", (key,)).fetchone()
            if existing:
                if (existing["scope"] != source["scope_id"] or json.loads(existing["source"]) != plain(source_ref)
                        or existing["session"] != target_session_id or existing["target_dir"] != str(Path(target_dir).resolve())):
                    fail("TARGET_SCOPE_SWITCH_UNSUPPORTED", "fixed registered session/source/scope")
                fail("TARGET_ALREADY_REGISTERED", "registration never resets history")
            connection.execute("INSERT INTO books(key,target_key,journal,head_hash) VALUES(?,?,?,?)",
                (key, canonical(target_key).decode(), unique("journal"), ZERO))
            connection.execute("INSERT INTO registrations VALUES(?,?,?,?,?,?,?,?,?)",
                (rid, key, source["scope_id"], canonical(source_ref).decode(), target_session_id,
                 str(Path(target_dir).resolve()), str(package_root), str(stored), canonical(config or {}).decode()))
            for artifact in value["artifacts"]:
                self._artifact(connection, artifact)
        return Handle(registration_id=rid, target_key=target_key, package_root=str(package_root))

    def _artifact(self, connection, artifact):
        artifact = plain(artifact)
        identity = canonical({k: artifact[k] for k in
            ("schema_version", "book_id", "scope_id", "artifact_id", "revision")}).decode()
        ref_text = canonical(reference(artifact)).decode()
        old = connection.execute("SELECT ref FROM artifacts WHERE identity=?", (identity,)).fetchone()
        if old and old["ref"] != ref_text:
            fail("HISTORY_ID_CONFLICT", identity)
        path = self.object(artifact, connection)
        connection.execute("INSERT OR IGNORE INTO artifacts VALUES(?,?,?,?,?)",
            (identity, artifact["book_id"], artifact["scope_id"], ref_text, str(path)))
        return reference(artifact)

    def _event(self, connection, key, name, payload):
        book = connection.execute("SELECT * FROM books WHERE key=?", (key,)).fetchone()
        event = {"sequence": book["head_sequence"] + 1, "event": name, "journal_id": book["journal"],
            "target_key": json.loads(book["target_key"]), "plan_ref": plain(payload.get("plan_ref")),
            "owner_id": book["owner"], "generation": book["generation"], "recorded_at": now(),
            "payload": plain(payload), "previous_hash": book["head_hash"]}
        event["event_hash"] = digest(event)
        connection.execute("INSERT INTO events VALUES(?,?,?)", (key, event["sequence"], canonical(event).decode()))
        connection.execute("UPDATE books SET head_sequence=?,head_hash=? WHERE key=?",
            (event["sequence"], event["event_hash"], key))
        return event

    def effect_gate(self, target_key):
        from annotation.delivery.mock.persistent import BookEffectGate
        key = self.book_id(target_key)
        if key not in self._gates:
            self._gates[key] = BookEffectGate(self.directory / "gates" / (key + ".lock"), target_key, timeout=5)
        return self._gates[key]

    def _lease(self, connection, key, owner_id, generation, *, pending_ok=False):
        row = connection.execute("SELECT * FROM books WHERE key=?", (key,)).fetchone()
        if row is None or row["owner"] != owner_id or row["generation"] != generation or row["phase"] != "ACTIVE" or row["lease"] < time.time() or row["process_id"] != self.instance or row["pid"] != os.getpid():
            fail("OWNER_GENERATION_STALE", "current ACTIVE lease required", 4)
        if not pending_ok and self._pending(connection, key):
            fail("BOOK_WRITE_PAUSED", "current complete ledger has pending obligations", 3)
        if not pending_ok and row["hold"]:
            fail("TARGET_DRIFT_HOLD", row["hold"], 3)
        return row

    def _pending(self, connection, key, except_intent=None):
        rows = [dict(row) for row in connection.execute("SELECT * FROM intents WHERE book=? AND state='PENDING'", (key,))
                if row["id"] != except_intent]
        rows += [dict(row) for row in connection.execute("SELECT * FROM legacy WHERE book=?", (key,))]
        return rows

    def _handle(self, kind, **value):
        handle = Handle(kind=kind, instance=self.instance, **value)
        self._issued[id(handle)] = (handle, digest(handle))
        return handle

    def _opaque(self, handle, kind):
        saved = self._issued.get(id(handle))
        if not isinstance(handle, Handle) or saved is None or saved[0] is not handle or saved[1] != digest(handle) or handle.get("kind") != kind:
            fail("DISPATCH_PERMIT_INVALID", "opaque current-process handle required")
        return handle

    def _gate_check(self, gate, key):
        import threading
        if (gate is None or gate is not self._gates.get(key) or not getattr(gate, "held", False)
                or self.book_id(plain(gate.target_key)) != key
                or gate._local.get("thread") != threading.get_ident() or gate._local.get("depth", 0) < 1):
            fail("EFFECT_GATE_REQUIRED", "canonical held book gate required", 4)
        expected = (self.directory / "gates" / (key + ".lock")).resolve()
        if Path(gate.path).resolve() != expected or getattr(gate, "pid", os.getpid()) != os.getpid():
            fail("EFFECT_GATE_REQUIRED", "wrong gate identity", 4)

    @staticmethod
    def _pid_alive(pid):
        if pid == os.getpid():
            return True
        if os.name == "nt":
            import ctypes
            from ctypes import wintypes
            kernel = ctypes.WinDLL("kernel32", use_last_error=True)
            kernel.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
            kernel.OpenProcess.restype = wintypes.HANDLE
            kernel.GetExitCodeProcess.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]
            kernel.CloseHandle.argtypes = [wintypes.HANDLE]
            process = kernel.OpenProcess(0x1000, False, int(pid or 0))
            if not process:
                # Only a nonexistent PID proves exit; access denied is unknown.
                return ctypes.get_last_error() != 87 and bool(pid)
            code = wintypes.DWORD()
            ok = kernel.GetExitCodeProcess(process, ctypes.byref(code))
            kernel.CloseHandle(process)
            return not ok or code.value == 259
        try:
            os.kill(pid, 0)
            return True
        except ProcessLookupError:
            return False
        except PermissionError:
            return True

    def claim(self, target_key, *, observer, owner_id=None):
        key, owner = self.book_id(target_key), owner_id or self.owner_id
        self.fault("BEFORE_CLAIM")
        with self.effect_gate(target_key).acquire() as gate:
            with self.transaction() as connection:
                row = connection.execute("SELECT * FROM books WHERE key=?", (key,)).fetchone()
                if row is None:
                    fail("REGISTRATION_BINDING_MISMATCH")
                if row["owner"]:
                    # Explicit release is allowed only by the original instance.
                    if row["lease"] > time.time() or self._pid_alive(row["pid"]):
                        fail("OWNER_BUSY", "lease expired AND previous process exited required", 4)
                generation = row["generation"] + 1
                if row["generation"]:
                    connection.execute("UPDATE plans SET status='INTERRUPTED' WHERE book=? AND status='RUNNING'", (key,))
                connection.execute("UPDATE books SET owner=?,generation=?,phase='CLAIMING',pid=?,process_id=?,lease=? WHERE key=?",
                    (owner, generation, os.getpid(), self.instance, time.time() + 10, key))
                event = self._event(connection, key, "OWNER_CLAIM_RESERVED", {})
                reservation = self._handle("claim", ledger_id=self.ledger_id, target_key=target_key,
                    owner_id=owner, generation=generation, target_store_id=self.target_store_id,
                    target_session_id=observer.target_session_id, predecessor_event_head=event)
                self.current_claim = reservation
            observer.activate_fence(target_key, target_session_id=observer.target_session_id,
                owner_id=owner, generation=generation, authority=self)
            with self.transaction() as connection:
                row = connection.execute("SELECT * FROM books WHERE key=?", (key,)).fetchone()
                if row["owner"] != owner or row["generation"] != generation or row["phase"] != "CLAIMING":
                    fail("OWNER_GENERATION_STALE", "claim CAS changed", 4)
                connection.execute("UPDATE books SET phase='ACTIVE' WHERE key=?", (key,))
                self._event(connection, key, "OWNER_ACTIVE", {})
            self._observers[key] = observer
        return Handle(owner_id=owner, generation=generation, target_key=target_key)

    def verify_claim(self, reservation, *, effect_gate):
        self._opaque(reservation, "claim")
        key = self.book_id(reservation["target_key"])
        self._gate_check(effect_gate, key)
        with self.connect() as connection:
            row = connection.execute("SELECT * FROM books WHERE key=?", (key,)).fetchone()
            if row["phase"] != "CLAIMING" or row["owner"] != reservation["owner_id"] or row["generation"] != reservation["generation"]:
                fail("OWNER_GENERATION_STALE", "claim no longer current", 4)
        return reservation

    def renew(self, target_key, *, owner_id, generation):
        key = self.book_id(target_key)
        with self.effect_gate(target_key).acquire(), self.transaction() as connection:
            self._lease(connection, key, owner_id, generation, pending_ok=True)
            connection.execute("UPDATE books SET lease=? WHERE key=?", (time.time() + 10, key))

    def release(self, target_key, *, owner_id, generation):
        key = self.book_id(target_key)
        with self.effect_gate(target_key).acquire(), self.transaction() as connection:
            self._lease(connection, key, owner_id, generation, pending_ok=True)
            connection.execute("UPDATE books SET phase='RELEASED',lease=0,owner=NULL,pid=NULL WHERE key=?", (key,))
            self._event(connection, key, "OWNER_RELEASED", {})

    def accept_plan(self, registration_id, plan_ref, *, owner_id, generation):
        from annotation.contracts import assert_recovery_plan_ready, validate_recovery_bundle
        reg = self.registration(registration_id)
        self._guard_target_effect(reg["book"], owner_id, generation)
        bundle = self._validate(self.bundle(registration_id), asset_root=reg["package_root"])
        plan = plain(next(a for a in plain(bundle)["artifacts"] if reference(a) == plain(plan_ref)))
        key, plan_key = reg["book"], digest(plan_ref)
        with self.effect_gate(self.target_key(registration_id)).acquire(), self.transaction() as connection:
            self._lease(connection, key, owner_id, generation)
            if connection.execute("SELECT 1 FROM plans WHERE id=?", (plan_key,)).fetchone():
                fail("REPLAY_FORBIDDEN", "accepted plan is permanently reserved")
            assert_recovery_plan_ready(bundle, plan_ref, plan["payload"]["snapshot"], bridge_context=self.bridge_for(bundle, reg["package_root"]))
            actions = plan["payload"]["actions"]
            for index, action in enumerate(actions):
                existing = connection.execute("SELECT digest FROM actions WHERE book=? AND id=?", (key, action["action_id"])).fetchone()
                if existing:
                    fail("INTENT_CONFLICT" if existing[0] != digest(action) else "REPLAY_FORBIDDEN")
                connection.execute("INSERT INTO actions VALUES(?,?,?,?,?,'RESERVED',NULL,NULL)",
                    (key, action["action_id"], digest(action), plan_key, index))
            connection.execute("INSERT INTO plans VALUES(?,?,?,?,?,0)",
                (plan_key, key, registration_id, canonical(plan_ref).decode(), "RUNNING"))
            bindings = [{"action_id": a["action_id"], "action_digest": digest(a)} for a in actions]
            self._event(connection, key, "PLAN_ACCEPTED", {"plan_ref": plan_ref, "actions": bindings})
            self._event(connection, key, "PLAN_ACTIONS_RESERVED", {"plan_ref": plan_ref, "reservations": bindings})
            self._event(connection, key, "PLAN_STARTED", {"plan_ref": plan_ref, "plan_state": "RUNNING"})
        return Handle(plan_ref=plan_ref, plan_id=plan_key, action_count=len(actions))

    def target_key(self, registration_id):
        reg = self.registration(registration_id)
        with self.connect() as connection:
            return json.loads(connection.execute("SELECT target_key FROM books WHERE key=?", (reg["book"],)).fetchone()[0])

    def _new_artifact(self, plan, kind, payload, dependencies, artifact_id=None):
        value = {key: copy.deepcopy(plan[key]) for key in
            ("schema_version", "run_id", "book_id", "scope_id", "producer")}
        value.update(artifact_id=artifact_id or unique(kind.lower()), revision=1, kind=kind,
            payload=plain(payload), input_refs=list({canonical(reference(a)): reference(a) for a in dependencies}.values()), created_at=now())
        value["producer"].update(module="a03-runtime", implementation_version="a03-p2")
        value["content_hash"] = digest(value)
        return value

    def _save_bundle(self, connection, registration_id, bundle):
        reg = self.registration(registration_id)
        path = self._file(Path(reg["package_root"]) / ("bundle-" + digest(bundle) + ".json"), canonical(bundle), connection)
        connection.execute("UPDATE registrations SET bundle_path=? WHERE id=?", (str(path), registration_id))

    def _append(self, connection, registration_id, *artifacts):
        current_path = connection.execute("SELECT bundle_path FROM registrations WHERE id=?", (registration_id,)).fetchone()[0]
        value = json.loads(Path(current_path).read_bytes())
        for artifact in artifacts:
            self._artifact(connection, artifact)
            if not any(reference(a) == reference(artifact) for a in value["artifacts"]):
                value["artifacts"].append(plain(artifact))
        self._save_bundle(connection, registration_id, value)

    def _evidence(self, connection, registration_id, resource):
        path = connection.execute("SELECT bundle_path FROM registrations WHERE id=?", (registration_id,)).fetchone()[0]
        bundle = json.loads(Path(path).read_bytes())
        identity = "proof-runtime-" + resource["sha256"][:40]
        record = {"evidence_id": identity, "resource": resource,
            "description": "SYNTHETIC actual controlled local observation; no platform evidence", "mode": "SYNTHETIC"}
        found = next((r for r in bundle["evidence"] if r["evidence_id"] == identity), None)
        if found and found != record:
            fail("HISTORY_ID_CONFLICT", "evidence identity differs")
        if not found:
            bundle["evidence"].append(record)
            self._save_bundle(connection, registration_id, bundle)
        return identity

    def import_resource(self, resource, source_root, registration_id, connection=None):
        source = Path(source_root).resolve()
        path = (source / resource["path"]).resolve()
        if source not in path.parents or not path.is_file() or path.is_symlink():
            fail("RESOURCE_MISSING", str(path), 5)
        raw = path.read_bytes()
        if hashlib.sha256(raw).hexdigest() != resource["sha256"]:
            fail("RESOURCE_HASH_MISMATCH", str(path), 5)
        if resource["media_type"] != "application/json":
            fail("RESOURCE_FORMAT", "runtime observations require JSON")
        body = json.loads(raw)
        # Capture nested content before making a portable immutable copy.
        def visit(value):
            if isinstance(value, dict):
                if {"path", "sha256", "media_type"} <= set(value):
                    return self.import_resource(value, source, registration_id, connection)
                return {k: visit(v) for k, v in value.items() if k != "asset_root"}
            if isinstance(value, list):
                return [visit(v) for v in value]
            return value
        body = visit(body)
        return self.resource(body, registration_id, connection)

    def capture_observation(self, observation, observer, registration_id, connection=None):
        value = plain(observation)
        raw_resource = value.get("resource") or value.get("readback")
        resource = self.import_resource(raw_resource, value.get("asset_root", observer.asset_root), registration_id, connection)
        result = Handle(value)
        result["resource"] = result["readback"] = resource
        snapshot = None
        if value.get("read_status") == "OK" and value.get("scope_complete"):
            snapshot = plain(observer.snapshot_from_observation(observation, bridge_context=self.bridge_for(self.bundle(registration_id), self.registration(registration_id)["package_root"])))
            # An actual duplicate-identity read is retained as evidence, but
            # cannot be projected into a valid canonical PlatformSnapshot.
            from annotation.contracts import validate_recovery_bundle
            identities = [q["platform_question_id"] for q in snapshot["payload"]["questions"]]
            if len(identities) != len(set(identities)):
                snapshot = None
            else:
                candidate = self.bundle(registration_id)
                candidate["artifacts"].append(snapshot)
                self._validate(candidate, asset_root=self.registration(registration_id)["package_root"])
            if snapshot is not None:
                result["snapshot_ref"] = reference(snapshot)
        self._observations[value["observation_id"]] = (observation, observer, registration_id, resource, snapshot)
        return result, snapshot

    def _guard_target_effect(self, key, owner_id, generation):
        with self.connect() as connection:
            book = self._lease(connection, key, owner_id, generation, pending_ok=True)
            target_key = json.loads(book["target_key"])
        self.detect_target_drift(target_key, owner_id=owner_id, generation=generation)
        with self.connect() as connection:
            row = connection.execute("SELECT hold FROM books WHERE key=?", (key,)).fetchone()
            if row["hold"]:
                fail("TARGET_DRIFT_HOLD", row["hold"], 3)

    def _verify_prepared(self, prepared, registration, plan_ref, *, observation_binding=None):
        from annotation.runtime.recovery import configuration
        observer = self._observers.get(registration["book"])
        if observer is None:
            fail("PREPARED_ACTION_UNVERIFIED", "current controlled observer is required")
        checked = observer.verify_prepared_action(prepared, observation_binding=observation_binding,
            expected_config_version=configuration(json.loads(registration["config"])).version, expected_plan_ref=plan_ref,
            bridge_context=self.bridge_for(prepared['bundle'], prepared['asset_root']))
        if (checked.target_store_id != self.target_store_id or checked.target_session_id != registration["session"]
                or checked.target_key != self.target_key(registration["id"])
                or checked.scope_id != registration["scope"] or checked.source_ref != json.loads(registration["source"])):
            fail("INTENT_BINDING_MISMATCH", "native preparation differs from registered target")
        return checked

    def _verify_intent_prepared(self, intent, plan, *, prepared_action=None, observation_binding=None):
        native = self._prepared_intents.get(intent["id"])
        if native is None or (prepared_action is not None and native[0] is not prepared_action):
            fail("PREPARED_ACTION_UNVERIFIED", "persisted intent copies do not recreate dispatch authority")
        checked = self._verify_prepared(native[0], self.registration(plan["registration"]),
            json.loads(plan["ref"]), observation_binding=observation_binding)
        if checked.attestation_digest != native[1] or checked.action_id != intent["action"]:
            fail("OBSERVATION_BINDING_MISMATCH", "native preparation differs from committed intent")
        return checked

    def commit_intent(self, prepared_action, *, owner_id, generation):
        p = prepared_action
        key, action_id = self.book_id(plain(p["target_key"])), p["action_id"]
        self._guard_target_effect(key, owner_id, generation)
        self.fault("BEFORE_INTENT_COMMIT")
        with self.effect_gate(plain(p["target_key"])).acquire(), self.transaction() as connection:
            book = self._lease(connection, key, owner_id, generation)
            action = connection.execute("SELECT * FROM actions WHERE book=? AND id=?", (key, action_id)).fetchone()
            if action is None or action["digest"] != p["action_digest"]:
                fail("PLAN_ACTION_MISMATCH")
            plan_row = connection.execute("SELECT * FROM plans WHERE id=?", (action["plan"],)).fetchone()
            if plan_row["status"] != "RUNNING":
                fail("PLAN_INTERRUPTED")
            if action["state"] != "RESERVED" or action["position"] != plan_row["cursor"]:
                fail("REPLAY_FORBIDDEN")
            reg = self.registration(plan_row["registration"])
            checked = self._verify_prepared(p, reg, json.loads(plan_row["ref"]))
            prepared = self.import_resource(plain(p["prepared_before"]), p["asset_root"], reg["id"], connection)
            plan = plain(p["plan"])
            fresh_snapshot = plain(p.get("snapshot"))
            if fresh_snapshot:
                self._append(connection, reg["id"], fresh_snapshot)
            action_value = plain(p["action"])
            payload = {"plan_ref": plain(p["plan_ref"]), "action_id": action_id, "action_digest": p["action_digest"],
                "target_key": plain(p["target_key"]), "question_id": action_value["target"]["question_id"],
                "source_entity_ids": action_value["source_entity_ids"], "before_snapshot_ref": plain(p["before_snapshot_ref"]),
                "target_session_id": reg["session"], "source_ref": json.loads(reg["source"]),
                "prepared_before": prepared, "execution_mode": "SIMULATED", "journal_id": book["journal"],
                "journal_sequence": book["head_sequence"] + 1, "journal_head_hash": book["head_hash"],
                "owner_id": owner_id, "generation": generation, "intent_committed_at": now(),
                "plan_dependency_digest": ""}
            from annotation.contracts.recovery import plan_dependency_digest
            payload["plan_dependency_digest"] = plan_dependency_digest(plan, payload["source_ref"], reg["session"], prepared)
            dependencies = [a for a in self.bundle(reg["id"])["artifacts"] if a["book_id"] == plan["book_id"] and a["scope_id"] == plan["scope_id"]]
            if fresh_snapshot:
                dependencies.append(fresh_snapshot)
            artifact = self._new_artifact(plan, "WriteIntent", payload, dependencies)
            intent_ref = self._artifact(connection, artifact)
            self._append(connection, reg["id"], artifact)
            obligation = "obl-" + digest({k: payload[k] for k in ("journal_id", "target_key", "journal_sequence", "journal_head_hash")} | {"intent_ref": intent_ref})
            iid = unique("intent")
            path = self.object({"prepared": {k: plain(v) for k, v in p.items() if k not in ("bundle",)}, "intent": artifact}, connection)
            connection.execute("INSERT INTO intents VALUES(?,?,?,?,?,?,?,?,?,?,NULL)",
                (iid, key, action["plan"], action_id, canonical(intent_ref).decode(), obligation, str(path), "PENDING", owner_id, generation))
            connection.execute("UPDATE actions SET state='INTENT',intent=? WHERE book=? AND id=?", (iid, key, action_id))
            self._event(connection, key, "WRITE_INTENT_COMMITTED", {"plan_ref": p["plan_ref"], "action_id": action_id,
                "action_digest": p["action_digest"], "intent_ref": intent_ref, "obligation_id": obligation})
        self._prepared_intents[iid] = (p, checked.attestation_digest)
        self.fault("AFTER_INTENT_COMMIT")
        return self._handle("intent", id=iid, intent_ref=intent_ref, artifact=artifact, obligation_id=obligation,
            target_key=plain(p["target_key"]), owner_id=owner_id, generation=generation, registration_id=reg["id"])

    def _plan(self, registration_id, plan_id=None):
        bundle = self.bundle(registration_id)
        plans = [a for a in bundle["artifacts"] if a["kind"] == "ApplyPlan" and (not plan_id or digest(reference(a)) == plan_id)]
        if not plans:
            fail("MISSING_REFERENCE", "ApplyPlan absent")
        return plans[-1]

    def _fact(self, connection, reg, plan, action_id, result, *, intent=None, prepared=None,
              snapshot_ref=None, readback=None, basis=None):
        book = connection.execute("SELECT * FROM books WHERE key=?", (reg["book"],)).fetchone()
        action = next(a for a in plan["payload"]["actions"] if a["action_id"] == action_id)
        fact = {"format_version": "a03-action-fact-3" if plan['schema_version'] == '1.4.0-a03-native-proposal' else "a03-action-fact-1", "design_only": False,
            "origin_phase": "UNATTEMPTED_ABSENCE" if intent is None else "EXECUTION", "resolution_ref": None,
            "plan_ref": reference(plan), "intent_ref": json.loads(intent["ref"]) if intent else None,
            "obligation_id": intent["obligation"] if intent else None, "action_id": action_id,
            "action_digest": digest(action), "prepared_before": prepared,
            "observed_snapshot_ref": snapshot_ref, "readback": readback, "comparator_version": "a02-facts-1",
            "result": result, "journal_sequence": book["head_sequence"] + 1,
            "predecessor_hash": book["head_hash"], "unattempted_basis": basis}
        return fact, self.resource(fact, reg["id"], connection)

    @staticmethod
    def _comparison(comparison):
        comparison = plain(comparison)
        classification = comparison.get("classification") or comparison.get("observation") or comparison.get("effect_match")
        if classification is None:
            classification = {"APPLIED": "MATCH", "NOT_APPLIED": "ABSENT", "UNKNOWN": "INDETERMINATE"}.get(comparison.get("outcome"), "INDETERMINATE")
        outcome = {"MATCH": "APPLIED", "ABSENT": "NOT_APPLIED"}.get(classification, "UNKNOWN")
        return classification, outcome, comparison.get("platform_ids", []), comparison.get("reason", comparison.get("reason_code", classification))

    def commit_action_result(self, committed_intent, prepared_action, observation, comparison, *, owner_id, generation):
        handle = self._opaque(committed_intent, "intent")
        reg = self.registration(handle["registration_id"])
        key, plan = reg["book"], plain(prepared_action["plan"])
        observer = self._observers[key]
        captured, snapshot = self.capture_observation(observation, observer, reg["id"])
        classification, outcome, platform_ids, reason = self._comparison(comparison)
        with self.effect_gate(handle["target_key"]).acquire(), self.transaction() as connection:
            self._lease(connection, key, owner_id, generation, pending_ok=True)
            intent = connection.execute("SELECT * FROM intents WHERE id=?", (handle["id"],)).fetchone()
            plan_row = connection.execute("SELECT * FROM plans WHERE id=?", (intent["plan"],)).fetchone()
            if intent["owner"] != owner_id or intent["generation"] != generation or intent["state"] != "PENDING" or plan_row["status"] != "RUNNING":
                fail("PLAN_INTERRUPTED", "original current RUNNING intent required")
            self._verify_intent_prepared(intent, plan_row, prepared_action=prepared_action)
            from annotation.delivery.mock import compare_action
            original_before = self.read_resource(handle["artifact"]["payload"]["prepared_before"], reg["id"])
            checked = self._comparison(compare_action(prepared_action["action"], original_before, observation))
            if checked[:3] != (classification, outcome, platform_ids):
                fail("OBSERVATION_BINDING_MISMATCH", "caller comparison differs from public comparator")
            if observation["observed_at"] <= handle["artifact"]["payload"]["intent_committed_at"]:
                fail("OBSERVATION_NOT_FRESH", "result read predates committed intent")
            if snapshot:
                self._append(connection, reg["id"], snapshot)
            prepared = handle["artifact"]["payload"]["prepared_before"]
            before_id = self._evidence(connection, reg["id"], prepared)
            after_id = self._evidence(connection, reg["id"], captured["readback"])
            result = {"action_id": intent["action"], "outcome": outcome, "platform_ids": platform_ids,
                "before_evidence_refs": [before_id], "after_evidence_refs": [after_id], "readback": captured["readback"],
                "effect_match": "INDETERMINATE" if outcome == "UNKNOWN" else classification,
                "next_step": {"APPLIED": "POSTCHECK", "NOT_APPLIED": "RECHECK_TARGET", "UNKNOWN": "RECONCILE"}[outcome],
                "replay_allowed": False, "reason": classification + ": " + str(reason), "attempt_fact": "MAY_HAVE_BEEN_ATTEMPTED" if outcome == "UNKNOWN" else "ATTEMPTED",
                "attempt_evidence_refs": [captured["resource"]], "intent_ref": handle["intent_ref"]}
            fact, resource = self._fact(connection, reg, plan, intent["action"], result, intent=intent,
                prepared=prepared, snapshot_ref=reference(snapshot) if snapshot else None, readback=captured["resource"])
            connection.execute("UPDATE actions SET state=?,fact=? WHERE book=? AND id=?", (outcome, canonical(resource).decode(), key, intent["action"]))
            connection.execute("UPDATE intents SET state=? WHERE id=?", ("PENDING" if outcome == "UNKNOWN" else outcome, intent["id"]))
            if outcome == "APPLIED":
                connection.execute("UPDATE plans SET cursor=cursor+1 WHERE id=?", (intent["plan"],))
            else:
                connection.execute("UPDATE plans SET status='INTERRUPTED' WHERE id=?", (intent["plan"],))
            event = self._event(connection, key, "ACTION_RESULT_COMMITTED", {"plan_ref": reference(plan),
                "action_id": intent["action"], "action_digest": fact["action_digest"], "intent_ref": handle["intent_ref"],
                "obligation_id": intent["obligation"], "fact": resource, "outcome": outcome,
                "plan_state": "INTERRUPTED" if outcome != "APPLIED" else "RUNNING"})
        projection = self.project_plan(reg["id"], plan)
        if projection["receipt_ref"] is not None:
            self.fault("AFTER_RECEIPT_COMMIT")
        return Handle(fact=resource, event=event, result=result, progress=projection)

    def project_plan(self, registration_id, plan=None):
        with self.effect_gate(self.target_key(registration_id)).acquire():
            return self._project_plan_locked(registration_id, plan)

    @staticmethod
    def _progress_attempt(row, intent_ref, plan_ref, fact):
        """Project attempt provenance from its exact immutable material fact."""
        if row['fact'] is None:
            return ('NOT_ATTEMPTED' if intent_ref is None else
                    'MAY_HAVE_BEEN_ATTEMPTED' if row['state'] in ('INTENT', 'UNKNOWN') else 'ATTEMPTED'), []
        if (not isinstance(fact, dict) or fact.get('plan_ref') != plain(plan_ref)
                or fact.get('action_id') != row['id'] or fact.get('action_digest') != row['digest']
                or fact.get('intent_ref') != plain(intent_ref)
                or fact.get('result', {}).get('action_id') != row['id']
                or fact.get('result', {}).get('intent_ref') != plain(intent_ref)):
            fail('RECOVERY_CHAIN_INVALID', 'material fact must bind the exact plan/action/intent before attempt projection')
        return fact['result']['attempt_fact'], copy.deepcopy(fact['result']['attempt_evidence_refs'])

    def _project_plan_locked(self, registration_id, plan=None):
        reg, plan = self.registration(registration_id), plan or self._plan(registration_id)
        plan_id = digest(reference(plan))
        with self.transaction() as connection:
            rows = connection.execute("SELECT * FROM actions WHERE plan=? ORDER BY position", (plan_id,)).fetchall()
            if not rows:
                return {"actions": [], "state": "NO_ACTIONS"}
            bundle = self.bundle(registration_id)
            dependencies = [a for a in bundle["artifacts"] if a["book_id"] == plan["book_id"] and a["scope_id"] == plan["scope_id"]]
            receipt = None
            if all(row["fact"] for row in rows):
                resources = [json.loads(row["fact"]) for row in rows]
                facts = [self.read_resource(r, registration_id) for r in resources]
                unknown = [f for f in facts if f["result"]["outcome"] == "UNKNOWN"]
                issues = [{"issue_id": "issue-save-unknown-" + digest(f)[:32], "code": "SAVE_UNKNOWN",
                    "scope_type": "action", "scope_id": f["action_id"],
                    "evidence_refs": f["result"]["after_evidence_refs"] or f["result"]["before_evidence_refs"],
                    "severity": "blocking", "blocks": ["APPLY", "COMPLETE"],
                    "suggested_strategy": {"strategy_id": "RECONCILE", "max_attempts": 0, "max_cost": 0.0},
                    "reason": "Actual controlled read did not establish this action's effect; retain original UNKNOWN"}
                    for f in unknown]
                payload = {"plan": reference(plan), "execution_mode": "SIMULATED", "results": [f["result"] for f in facts],
                    "action_fact_refs": resources, "unresolved_issue_ids": [i["issue_id"] for i in issues],
                    "write_disposition": "PAUSE_RECONCILE" if any(f["result"]["outcome"] == "UNKNOWN" for f in facts) else "POSTCHECK" if all(f["result"]["outcome"] == "APPLIED" for f in facts) else "RECHECK_TARGET"}
                receipt = next((a for a in dependencies if a["kind"] == "ExecutionReceipt"
                    and a["payload"]["plan"] == reference(plan) and a["payload"].get("action_fact_refs") == resources), None)
                if receipt is None:
                    receipt = self._new_artifact(plan, "ExecutionReceipt", payload, dependencies)
                    self._append(connection, registration_id, receipt)
                    dependencies.append(receipt)
                    if issues:
                        pre = next(a for a in dependencies if reference(a) == plan["payload"]["precheck"])
                        proof = list(dict.fromkeys(e for i in issues for e in i["evidence_refs"]))
                        post = self._new_artifact(plan, "CheckReport", {"stage": "POST_APPLY",
                            "subject": reference(receipt), "graph": plan["payload"]["graph"],
                            "policy": plan["payload"]["policy"], "snapshot": facts[-1]["observed_snapshot_ref"],
                            "receipt": reference(receipt), "coverage": pre["payload"]["coverage"],
                            "checks": [{"check_id": name, "outcome": "UNAVAILABLE", "evidence_refs": proof,
                                "reason": "Original save result remains UNKNOWN"} for name in ("frame_structure", "final_content")],
                            "issues": issues, "decision": "HOLD", "reason": "Actual UNKNOWN facts require read-only reconciliation",
                            "recovery_refs": []}, dependencies)
                        self._append(connection, registration_id, post)
                        dependencies.append(post)
                for row in rows:
                    if row["intent"]:
                        connection.execute("UPDATE intents SET receipt=? WHERE id=? AND receipt IS NULL", (canonical(reference(receipt)).decode(), row["intent"]))
            book = connection.execute("SELECT * FROM books WHERE key=?", (reg["book"],)).fetchone()
            items = []
            for row in rows:
                intent = connection.execute("SELECT * FROM intents WHERE id=?", (row["intent"],)).fetchone() if row["intent"] else None
                resolution = connection.execute("SELECT * FROM resolutions WHERE intent=? ORDER BY rowid DESC LIMIT 1", (row["intent"],)).fetchone() if row["intent"] else None
                intent_ref = json.loads(intent['ref']) if intent else None
                material = self.read_resource(json.loads(row['fact']), registration_id) if row['fact'] is not None else None
                attempt_fact, attempt_evidence = self._progress_attempt(row, intent_ref, reference(plan), material)
                effective = {"RESOLVED_APPLIED": "APPLIED", "RESOLVED_NOT_APPLIED": "NOT_APPLIED"}.get(resolution["outcome"] if resolution else "", row["state"] if row["state"] in ("APPLIED", "NOT_APPLIED") else "UNDETERMINED" if not intent else "UNKNOWN")
                items.append({"action_id": row["id"], "intent_ref": json.loads(intent["ref"]) if intent else None,
                    "attempt_fact": attempt_fact,
                    "dependency_status": "SATISFIED" if row["position"] == 0 or all(x["state"] == "APPLIED" for x in rows[:row["position"]]) else "BLOCKED",
                    "attempt_evidence_refs": attempt_evidence, "receipt_ref": reference(receipt) if receipt else json.loads(intent["receipt"]) if intent and intent["receipt"] else None,
                    "resolution_head_ref": json.loads(resolution["ref"]) if resolution else None, "effective_outcome": effective,
                    "result_fact": json.loads(row["fact"]) if row["fact"] else None})
            progress = self._new_artifact(plan, "ExecutionProgress", {"plan_ref": reference(plan), "journal_id": book["journal"],
                "journal_head_sequence": book["head_sequence"], "journal_head_hash": book["head_hash"], "actions": items}, dependencies)
            self._append(connection, registration_id, progress)
            if all(row["state"] == "APPLIED" for row in rows):
                connection.execute("UPDATE plans SET status='FINISHED' WHERE id=?", (plan_id,))
        return {"progress_ref": reference(progress), "receipt_ref": reference(receipt) if receipt else None, "actions": items}

    def load_book_context(self, target_key, *, owner_id, generation):
        self.verify_integrity()
        key = self.book_id(target_key)
        with self.connect() as connection:
            book = self._lease(connection, key, owner_id, generation, pending_ok=True)
            histories = [dict(row) for row in connection.execute("SELECT * FROM registrations WHERE book=?", (key,))]
            refs = [json.loads(row[0]) for row in connection.execute("SELECT ref FROM artifacts WHERE book=?", (target_key["book_id"],))]
            progress = []
            for row in connection.execute("SELECT path FROM artifacts WHERE book=?", (target_key["book_id"],)):
                artifact = json.loads(Path(row[0]).read_bytes())
                if artifact["kind"] == "ExecutionProgress":
                    progress.append(reference(artifact))
            context = self._handle("context", ledger_id=self.ledger_id, target_key=target_key,
                owner_id=owner_id, generation=generation, event_head={"sequence": book["head_sequence"], "hash": book["head_hash"]},
                history_refs=refs, registrations=histories, pending=self._pending(connection, key),
                pause_reasons=[r.get("classification", "UNKNOWN") for r in self._pending(connection, key)], progress_refs=progress,
                target_store_id=self.target_store_id)
        return context

    def verify_context(self, context, *, target_key, expected_ledger_id, effect_gate):
        self._opaque(context, "context")
        key = self.book_id(target_key)
        self._gate_check(effect_gate, key)
        if expected_ledger_id != self.ledger_id or context["target_key"] != target_key:
            fail("BOOK_CONTEXT_UNVERIFIED")
        actual = self.load_book_context(target_key, owner_id=context["owner_id"], generation=context["generation"])
        if any(actual[k] != context[k] for k in ("event_head", "pending", "history_refs")):
            fail("BOOK_CONTEXT_UNVERIFIED", "current full scan differs")
        return actual

    def status(self, registration_id=None):
        reg = self.registration(registration_id)
        self.verify_integrity()
        with self.connect() as connection:
            book = dict(connection.execute("SELECT * FROM books WHERE key=?", (reg["book"],)).fetchone())
            pending = self._pending(connection, reg["book"])
            events = [json.loads(row[0]) for row in connection.execute("SELECT body FROM events WHERE book=? ORDER BY sequence", (reg["book"],))]
            actions = [dict(row) for row in connection.execute("SELECT * FROM actions WHERE book=? ORDER BY rowid", (reg["book"],))]
        return {"ledger_id": self.ledger_id, "registration_id": reg["id"], "target_key": json.loads(book["target_key"]),
            "owner_id": book["owner"], "generation": book["generation"], "owner_phase": book["phase"], "lease_until": book["lease"],
            "pending_count": len(pending), "pending": pending, "paused": bool(pending) or bool(book["hold"]),
            "events": events, "actions": actions, "event_head": {"sequence": book["head_sequence"], "hash": book["head_hash"]},
            "target_drift_hold": book["hold"]}

    def import_history_archive(self, package_path, *, expected_ledger_id, target_key):
        from annotation.contracts import load_archive_bundle
        if expected_ledger_id != self.ledger_id:
            fail("STATE_DIRECTORY_IDENTITY_MISMATCH")
        archive = load_archive_bundle(package_path)
        value = plain(archive)
        if "bundle" in value:
            value = value["bundle"]
        for snapshot in (a for a in value["artifacts"] if a["kind"] == "PlatformSnapshot" and a["book_id"] == target_key["book_id"]):
            if snapshot["payload"]["target_id"] != target_key["target_id"]:
                fail("TARGET_IDENTITY_MISMATCH", "archive target differs from requested canonical book")
        original_path = Path(package_path).resolve()
        original_bytes = original_path.read_bytes()
        archive_root = self.directory / "archives" / hashlib.sha256(original_bytes).hexdigest()
        self._file(archive_root / "input.json", original_bytes)
        seen = set()
        def copy_declared(node):
            if isinstance(node, list):
                for item in node:
                    copy_declared(item)
            elif isinstance(node, dict):
                if {"path", "sha256"} <= set(node) and node["path"] not in seen:
                    seen.add(node["path"])
                    source = (original_path.parent / node["path"]).resolve()
                    if original_path.parent not in source.parents or not source.is_file() or source.is_symlink():
                        fail("RESOURCE_MISSING", node["path"], 5)
                    raw = source.read_bytes()
                    if hashlib.sha256(raw).hexdigest() != node["sha256"]:
                        fail("RESOURCE_HASH_MISMATCH", node["path"], 5)
                    self._file(archive_root / node["path"], raw)
                    if node.get("media_type") == "application/json":
                        copy_declared(json.loads(raw))
                for child in node.values():
                    copy_declared(child)
        copy_declared(value)
        key = self.book_id(target_key)
        resource = self.object({"eligibility": "ARCHIVE_ONLY", "bundle": value,
            "archive_root": str(archive_root), "original_sha256": hashlib.sha256(original_bytes).hexdigest()})
        rows = []
        with self.transaction() as connection:
            if not connection.execute("SELECT 1 FROM books WHERE key=?", (key,)).fetchone():
                connection.execute("INSERT INTO books(key,target_key,journal,head_hash) VALUES(?,?,?,?)", (key, canonical(target_key).decode(), unique("journal"), ZERO))
            for artifact in value["artifacts"]:
                self._artifact(connection, artifact)
                if artifact["kind"] == "ExecutionReceipt" and artifact["book_id"] == target_key["book_id"]:
                    for result in artifact["payload"]["results"]:
                        if result["outcome"] == "UNKNOWN":
                            identity = digest({"receipt": reference(artifact), "action": result["action_id"]})
                            connection.execute("INSERT OR IGNORE INTO legacy VALUES(?,?,?,?,?)", (identity, key, artifact["scope_id"], "LEGACY_UNRECORDED", str(resource)))
                            rows.append(identity)
            self._event(connection, key, "HISTORY_ARCHIVE_IMPORTED", {"archive_sha256": digest(value), "legacy_ids": rows})
        return {"archive_only": True, "legacy_ids": rows, "classification": "LEGACY_UNRECORDED" if rows else "ARCHIVE_ONLY"}

    def begin_recovery_call(self, target_key, call_id=None):
        key, call_id = self.book_id(target_key), call_id or unique("recovery-call")
        with self.transaction() as connection:
            old = connection.execute("SELECT * FROM calls WHERE id=?", (call_id,)).fetchone()
            if old:
                if old["book"] != key:
                    fail("RECOVERY_CALL_CONFLICT")
                return dict(old)
            queue = [row["id"] for row in connection.execute("SELECT id FROM intents WHERE book=? AND state='PENDING' ORDER BY rowid", (key,))]
            connection.execute("INSERT INTO calls VALUES(?,?,?,?)", (call_id, key, canonical(queue).decode(), time.time()))
        return {"id": call_id, "book": key, "queue": canonical(queue).decode(), "created": time.time()}

    def register_attempt(self, call_id, intent_id, *, owner_id, generation):
        with self.transaction() as connection:
            call = connection.execute("SELECT * FROM calls WHERE id=?", (call_id,)).fetchone()
            if not call or intent_id not in json.loads(call["queue"]):
                fail("RECOVERY_CALL_CONFLICT")
            self._lease(connection, call["book"], owner_id, generation, pending_ok=True)
            if time.time() - call["created"] >= 60:
                fail("RECOVERY_DEADLINE_EXCEEDED", "persisted call deadline exhausted", 6)
            window = connection.execute("SELECT started FROM attempt_windows WHERE call_id=? AND intent=?", (call_id, intent_id)).fetchone()
            if window and time.time() - window[0] >= 8:
                fail("RECOVERY_DEADLINE_EXCEEDED", "persisted intent window exhausted", 6)
            connection.execute("INSERT OR IGNORE INTO attempt_windows VALUES(?,?,?)", (call_id, intent_id, time.time()))
            count = connection.execute("SELECT COUNT(*) FROM attempts WHERE call_id=? AND intent=?", (call_id, intent_id)).fetchone()[0]
            if count >= 3:
                fail("RECONCILE_ATTEMPT_LIMIT", "persisted per-call attempts exhausted", 3)
            number = count + 1
            connection.execute("INSERT INTO attempts VALUES(?,?,?,'STARTED',NULL)", (call_id, intent_id, number))
        return number

    def intent_remaining_seconds(self, call_id, intent_id):
        with self.connect() as connection:
            row = connection.execute("SELECT started FROM attempt_windows WHERE call_id=? AND intent=?", (call_id, intent_id)).fetchone()
        return 8 if not row else max(0, 8 - (time.time() - row[0]))

    def pending_intent(self, intent_id):
        with self.connect() as connection:
            row = connection.execute("SELECT * FROM intents WHERE id=?", (intent_id,)).fetchone()
        if row is None:
            fail("LOCAL_INTENT_COMMIT_REQUIRED")
        return dict(row)

    def fail_attempt(self, call_id, intent_id, number, failure, registration_id):
        with self.transaction() as connection:
            resource = self.resource({"origin": "SYNTHETIC", "execution_mode": "SIMULATED",
                "failure": plain(failure), "read_sequence": None, "target_state_version": None,
                "target_state_hash": None}, registration_id, connection)
            connection.execute("UPDATE attempts SET status='FAILED_READ',resource=? WHERE call_id=? AND intent=? AND number=?",
                (canonical(resource).decode(), call_id, intent_id, number))
        return resource

    def commit_reconciliation(self, result, *, owner_id, generation):
        from annotation.contracts import validate_recovery_bundle
        result = plain(result)
        payload = result["payload"]
        registered = self._observations.get(payload["observation_id"])
        if registered is None:
            fail("OBSERVATION_NOT_FRESH", "only current controlled target reads can be committed")
        original, observer, registration_id, resource, snapshot = registered
        reg = self.registration(registration_id)
        key = reg["book"]
        deadline = self._observation_deadlines.get(payload["observation_id"])
        if deadline is None or time.monotonic() >= deadline:
            fail("RECOVERY_DEADLINE_EXCEEDED", "actual observation call deadline absent/expired", 6)
        with self.effect_gate(self.target_key(registration_id)).acquire(), self.transaction() as connection:
            self._lease(connection, key, owner_id, generation, pending_ok=True)
            row = connection.execute("SELECT * FROM intents WHERE ref=?", (canonical(payload["intent_ref"]).decode(),)).fetchone()
            if not row or row["book"] != key or row["obligation"] != payload["obligation_id"] or row["state"] != "PENDING":
                fail("INTENT_BINDING_MISMATCH")
            attempt = connection.execute("SELECT * FROM attempts WHERE call_id=? AND intent=? AND number=?",
                (payload["recovery_call_id"], row["id"], payload["attempt_index"])).fetchone()
            if not attempt or attempt["status"] != "STARTED":
                fail("RECONCILE_ATTEMPT_LIMIT")
            previous = connection.execute("SELECT * FROM resolutions WHERE intent=? ORDER BY rowid DESC LIMIT 1", (row["id"],)).fetchone()
            if payload["previous_resolution_ref"] != (json.loads(previous["ref"]) if previous else None):
                fail("RESOLUTION_FORK")
            if payload["readback"] != resource or (snapshot and payload["observed_snapshot_ref"] != reference(snapshot)):
                fail("OBSERVATION_BINDING_MISMATCH")
            from annotation.delivery.reconciler import reconcile_action
            stored = json.loads(Path(row["prepared"]).read_bytes())
            before = self.read_resource(stored["intent"]["payload"]["prepared_before"], registration_id)
            recomputed = plain(reconcile_action(stored["prepared"]["action"], before, original))
            if (payload["observation"], payload["resolution"], payload["platform_ids"]) != (recomputed["effect_match"], recomputed["resolution"], recomputed["platform_ids"]):
                fail("OBSERVATION_BINDING_MISMATCH", "resolution differs from actual public comparator")
            bundle = self.bundle(registration_id)
            if snapshot and not any(reference(a) == reference(snapshot) for a in bundle["artifacts"]):
                bundle["artifacts"].append(snapshot)
            candidate = copy.deepcopy(bundle)
            candidate["artifacts"].append(result)
            self._validate(candidate, asset_root=reg["package_root"])
            if time.monotonic() >= deadline:
                fail("RECOVERY_DEADLINE_EXCEEDED", "deadline reached before terminal transaction", 6)
            self._append(connection, registration_id, *([snapshot] if snapshot else []), result)
            terminal = payload["resolution"] != "STILL_UNKNOWN"
            connection.execute("INSERT INTO resolutions VALUES(?,?,?,?)", (result["artifact_id"], row["id"], canonical(reference(result)).decode(), payload["resolution"]))
            connection.execute("UPDATE attempts SET status=?,resource=? WHERE call_id=? AND intent=? AND number=?",
                (payload["resolution"], canonical(resource).decode(), payload["recovery_call_id"], row["id"], payload["attempt_index"]))
            if terminal:
                connection.execute("UPDATE intents SET state=? WHERE id=?", (payload["resolution"], row["id"]))
            event = self._event(connection, key, "RECONCILIATION_COMMITTED", {"plan_ref": payload["plan_ref"],
                "action_id": payload["action_id"], "action_digest": payload["action_digest"], "intent_ref": payload["intent_ref"],
                "obligation_id": payload["obligation_id"], "resolution_ref": reference(result), "observation_id": payload["observation_id"],
                "resolution": payload["resolution"], "plan_state": "INTERRUPTED"})
        self.project_plan(registration_id, self._plan(registration_id, row["plan"]))
        return Handle(result_ref=reference(result), resolution=payload["resolution"], classification=payload["observation"], event=event)

    def export(self, registration_id=None):
        reg = self.registration(registration_id)
        result = self.status(reg["id"])
        result.update(bundle=self.bundle(reg["id"]), package_root=reg["package_root"], database=str(self.database))
        with self.connect() as connection:
            calls = [dict(row) for row in connection.execute("SELECT * FROM calls WHERE book=?", (reg["book"],))]
            for call in calls:
                call["intent_queue"] = []
                for iid in json.loads(call["queue"]):
                    attempts = [dict(row) for row in connection.execute("SELECT * FROM attempts WHERE call_id=? AND intent=? ORDER BY number", (call["id"], iid))]
                    call["intent_queue"].append({"intent_id": iid, "status": attempts[-1]["status"] if attempts else "NOT_VISITED", "attempts": attempts})
            result["recovery_calls"] = calls
        return result

    def commit_unattempted_absence(self, bundle, request, *, owner_id, generation, asset_root, observer):
        # Frozen R2 only models one same-plan journal from sequence one. Do not
        # rewrite real ledger coordinates or omit control events to fit it.
        fail("EVENT_PREFIX_CONTRACT_GAP", "P2 global prefix profile requires explicit coordinator approval", 2)


    def issue_first_dispatch(self, intent_ref, *, owner_id, generation, plan_ref, action_id, observation_binding):
        with self.connect() as connection:
            current = connection.execute("SELECT book FROM intents WHERE ref=?", (canonical(intent_ref).decode(),)).fetchone()
        if current is None:
            fail("LOCAL_INTENT_COMMIT_REQUIRED")
        self._guard_target_effect(current["book"], owner_id, generation)
        with self.transaction() as connection:
            row = connection.execute("SELECT * FROM intents WHERE ref=?", (canonical(intent_ref).decode(),)).fetchone()
            if row is None:
                fail("LOCAL_INTENT_COMMIT_REQUIRED")
            self._lease(connection, row["book"], owner_id, generation, pending_ok=True)
            if self._pending(connection, row["book"], row["id"]):
                fail("BOOK_WRITE_PAUSED")
            plan = connection.execute("SELECT * FROM plans WHERE id=?", (row["plan"],)).fetchone()
            if (row["owner"] != owner_id or row["generation"] != generation or plan["status"] != "RUNNING"
                    or row["action"] != action_id or json.loads(plan["ref"]) != plain(plan_ref)):
                fail("PLAN_INTERRUPTED")
            self._verify_intent_prepared(row, plan, observation_binding=observation_binding)
            if connection.execute("SELECT 1 FROM permits WHERE intent=?", (row["id"],)).fetchone():
                fail("REPLAY_FORBIDDEN")
            token = unique("permit")
            event = self._event(connection, row["book"], "DISPATCH_PERMIT_ISSUED", {"plan_ref": plan_ref,
                "action_id": action_id, "intent_ref": intent_ref, "permit_id": token})
            connection.execute("INSERT INTO permits VALUES(?,?,'ISSUED',?)", (token, row["id"], event["event_hash"]))
        return self._handle("permit", token=token, intent_id=row["id"], target_key=self.target_key(plan["registration"]),
            owner_id=owner_id, generation=generation, intent_ref=plain(intent_ref), obligation_id=row["obligation"])

    def consume_first_dispatch(self, permit, *, effect_gate, prepared_action, target_store_id, target_session_id):
        self._opaque(permit, "permit")
        key = self.book_id(permit["target_key"])
        self._gate_check(effect_gate, key)
        self._guard_target_effect(key, permit["owner_id"], permit["generation"])
        with self.transaction() as connection:
            self._lease(connection, key, permit["owner_id"], permit["generation"], pending_ok=True)
            row = connection.execute("SELECT * FROM permits WHERE token=?", (permit["token"],)).fetchone()
            intent = connection.execute("SELECT * FROM intents WHERE id=?", (permit["intent_id"],)).fetchone()
            if row is None or row["state"] != "ISSUED" or self._pending(connection, key, intent["id"]):
                fail("REPLAY_FORBIDDEN")
            plan = connection.execute("SELECT * FROM plans WHERE id=?", (intent["plan"],)).fetchone()
            reg = self.registration(plan["registration"])
            self._verify_intent_prepared(intent, plan, prepared_action=prepared_action)
            if (target_store_id != self.target_store_id or target_session_id != reg["session"] or
                prepared_action["action_id"] != intent["action"] or prepared_action["action_digest"] !=
                plain(json.loads(Path(intent["prepared"]).read_bytes())["intent"])["payload"]["action_digest"]):
                fail("INTENT_BINDING_MISMATCH")
            connection.execute("UPDATE permits SET state='CONSUMED' WHERE token=?", (permit["token"],))
            for name in ("DISPATCH_PERMIT_CONSUMED", "DISPATCH_STARTED"):
                event = self._event(connection, key, name, {"plan_ref": json.loads(plan["ref"]),
                    "action_id": intent["action"], "intent_ref": json.loads(intent["ref"]), "permit_id": permit["token"]})
        self.fault("AFTER_DISPATCH_STARTED")
        return self._handle("authorization", **{k: v for k, v in permit.items() if k not in ("kind", "instance")},
            action_digest=prepared_action["action_digest"], target_store_id=target_store_id,
            target_session_id=target_session_id, dispatch_event=event, used=False)

    def verify_target_authorization(self, authorization, *, effect_gate, target_key, target_store_id,
                                    target_session_id, generation, action_digest):
        self._opaque(authorization, "authorization")
        key = self.book_id(target_key)
        self._gate_check(effect_gate, key)
        if (authorization["used"] or authorization["target_key"] != plain(target_key)
            or authorization["generation"] != generation or authorization["action_digest"] != action_digest
            or authorization["target_store_id"] != target_store_id or authorization["target_session_id"] != target_session_id):
            fail("DISPATCH_PERMIT_INVALID")
        with self.connect() as connection:
            book = self._lease(connection, key, authorization["owner_id"], generation, pending_ok=True)
            if book["hold"]:
                fail("TARGET_DRIFT_HOLD", book["hold"], 3)
            if self._pending(connection, key, authorization["intent_id"]):
                fail("BOOK_WRITE_PAUSED")
        authorization["used"] = True
        # Retire the actual identity as well as its caller-visible diagnostic.
        self._issued.pop(id(authorization), None)
        return authorization


def _delegate(name, *args, **kwargs):
    store = CURRENT.get()
    if store is None:
        fail("STATE_DIRECTORY_IDENTITY_MISMATCH", "open an explicit store first", 5)
    return getattr(store, name)(*args, **kwargs)


def commit_intent(prepared_action, *, owner_id, generation):
    return _delegate("commit_intent", prepared_action, owner_id=owner_id, generation=generation)


def commit_action_result(committed_intent, prepared_action, observation, comparison, *, owner_id, generation):
    return _delegate("commit_action_result", committed_intent, prepared_action, observation, comparison,
                     owner_id=owner_id, generation=generation)


def commit_reconciliation(result, *, owner_id, generation):
    return _delegate("commit_reconciliation", result, owner_id=owner_id, generation=generation)


def load_book_context(target_key, *, owner_id, generation):
    return _delegate("load_book_context", target_key, owner_id=owner_id, generation=generation)


def import_history_archive(package_path, *, expected_ledger_id, target_key):
    return _delegate("import_history_archive", package_path, expected_ledger_id=expected_ledger_id, target_key=target_key)


def commit_unattempted_absence(bundle, request, *, owner_id, generation, asset_root, observer):
    return _delegate("commit_unattempted_absence", bundle, request, owner_id=owner_id,
                     generation=generation, asset_root=asset_root, observer=observer)


def clear_target_drift_hold(hold_id, snapshot_ref, precheck_ref, targetcheck_ref, candidate_plan_ref, *, owner_id, generation):
    return _delegate("clear_target_drift_hold", hold_id, snapshot_ref, precheck_ref, targetcheck_ref,
                     candidate_plan_ref, owner_id=owner_id, generation=generation)

b34ecc5b1278608a97110d1a4f531205e7370e51 blob 3972
"""Local runtime values. No target business rules or ambient authority."""
from collections.abc import Mapping
import copy
import hashlib
import json
import os
from pathlib import Path
import time
import uuid


class RuntimeFailure(Exception):
    def __init__(self, code, message="", exit_code=None):
        super().__init__(message or code)
        self.code = code
        self.exit_code = exit_code or (4 if any(x in code for x in ("OWNER", "CAS", "GATE")) else
            6 if any(x in code for x in ("TIMEOUT", "DEADLINE")) else
            5 if any(x in code for x in ("CORRUPT", "STORAGE", "LEDGER", "DIRECTORY", "RESOURCE_MISSING")) else
            7 if code in ("SYNTHETIC_ONLY", "SYNTHETIC_COMPLETE_REQUIRED") else 3 if code in
            ("BOOK_WRITE_PAUSED", "LEGACY_UNRECORDED", "PLAN_INTERRUPTED", "TARGET_DRIFT_HOLD") else 2)


def plain(value):
    if isinstance(value, Path):
        return str(value)
    if hasattr(value, "model_dump"):
        return plain(value.model_dump(mode="json"))
    if isinstance(value, Mapping):
        return {key: plain(item) for key, item in value.items()}
    if isinstance(value, (list, tuple)):
        return [plain(item) for item in value]
    return value


def canonical(value):
    return json.dumps(plain(value), ensure_ascii=False, sort_keys=True,
                      separators=(",", ":"), allow_nan=False).encode("utf-8")


def digest(value):
    return hashlib.sha256(canonical(value)).hexdigest()


def reference(artifact):
    artifact = plain(artifact)
    return {key: artifact[key] for key in ("artifact_id", "revision", "kind", "content_hash")}


def now():
    from datetime import datetime, timezone
    return datetime.now(timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")


class Handle(dict):
    """Public diagnostic fields; authority also requires process-local identity."""
    def __getattr__(self, name):
        try:
            return self[name]
        except KeyError:
            raise AttributeError(name)


def unique(prefix):
    return prefix + "-" + uuid.uuid4().hex


def fail(code, message="", exit_code=None):
    raise RuntimeFailure(code, message, exit_code)


def exclusive_bytes(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        with path.open("xb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
    except FileExistsError:
        if path.read_bytes() != data:
            fail("IMMUTABLE_FILE_CONFLICT", str(path), 5)
    if path.read_bytes() != data:
        fail("RESOURCE_HASH_MISMATCH", str(path), 5)
    return path


class FaultController:
    ALIASES = {"before_intent": "BEFORE_INTENT_COMMIT", "after_intent": "AFTER_INTENT_COMMIT",
        "after_dispatch_started": "AFTER_DISPATCH_STARTED", "after_effect": "AFTER_TARGET_EFFECT_COMMIT",
        "after_readback": "AFTER_READBACK_CAPTURE", "after_receipt": "AFTER_RECEIPT_COMMIT"}

    def __init__(self, specification=None):
        self.specification = specification or {}

    def __call__(self, point):
        point = self.ALIASES.get(point, point)
        wanted = self.ALIASES.get(self.specification.get("point"), self.specification.get("point"))
        if point != wanted:
            return
        marker = self.specification.get("marker")
        if marker:
            exclusive_bytes(marker, canonical({"point": point, "pid": os.getpid(), "at": now()}))
        release = self.specification.get("release")
        if release:
            deadline = time.monotonic() + 5
            while not Path(release).exists():
                if time.monotonic() >= deadline:
                    fail("BARRIER_TIMEOUT", point, 6)
                time.sleep(.01)
        if self.specification.get("mode") == "barrier":
            return
        if self.specification.get("exit_code", 90) is not None:
            os._exit(int(self.specification.get("exit_code", 90)))

ecd39bac900c7750c2ca7534f75e97fb0fee002a blob 25758
"""Current target drift holds, separate from immutable resolution histories.

This mixin uses RuntimeStore's controlled files, book gate and transactions.
Observations are verified again by the independent target's persisted registry;
neither caller hashes nor a serialized completeness flag grant clearance.
"""
import hashlib
import json
from datetime import datetime
from pathlib import Path
import sqlite3
import time

from .common import Handle, canonical, digest, fail, plain, reference, unique


def _time(value):
    try:
        result = datetime.fromisoformat(value.replace('Z', '+00:00'))
        if result.tzinfo is None:
            raise ValueError('timezone required')
        return result
    except (ValueError, AttributeError):
        fail('HOLD_EVIDENCE_INVALID', 'invalid evidence timestamp')


class HoldSupport:
    def _hold_registration(self, target_key):
        key = self.book_id(plain(target_key))
        with self.connect() as connection:
            rows = connection.execute('SELECT * FROM registrations WHERE book=?', (key,)).fetchall()
        if len(rows) != 1:
            fail('REGISTRATION_BINDING_MISMATCH', 'one fixed target registration is required')
        return dict(rows[0])

    def _hold_observer(self, reg, observer=None):
        from annotation.delivery.mock.persistent import PersistentMockSession
        key = self.target_key(reg['id'])
        observer = observer or self._observers.get(reg['book'])
        if observer is None:
            observer = PersistentMockSession.open(reg['target_dir'], expected_store_id=self.target_store_id,
                expected_target_session_id=reg['session'], expected_target_key=key,
                expected_scope_id=reg['scope'], expected_source_ref=json.loads(reg['source']))
        if not isinstance(observer, PersistentMockSession):
            fail('HOLD_EVIDENCE_INVALID', 'only the registered controlled target observer is supported')
        descriptor = plain(observer.descriptor)
        expected = {'store_id': self.target_store_id, 'target_session_id': reg['session'],
                    'target_key': key, 'fixed_scope_id': reg['scope'],
                    'fixed_source_ref': json.loads(reg['source'])}
        if (any(descriptor.get(k) != v for k, v in expected.items()) or
                Path(observer.directory).resolve() != Path(reg['target_dir']).resolve() or
                Path(observer.asset_root).resolve() != Path(reg['package_root']).resolve()):
            fail('HOLD_EVIDENCE_INVALID', 'observer store/session/source/scope/root differs from registration')
        return observer

    def _hold_fence(self, observer, target_key, owner_id, generation):
        context = plain(observer.export_book_context(target_key))
        if (context.get('fence_generation') != generation or context.get('fence_owner_id') != owner_id or
                context.get('target_store_id') != self.target_store_id or context.get('target_key') != target_key):
            fail('OWNER_GENERATION_STALE', 'current independent target fence differs', 4)
        return context

    def _hold_artifact(self, connection, ref, reg, kind=None):
        from annotation.contracts import content_digest
        ref = plain(ref)
        if not isinstance(ref, dict) or set(ref) != {'artifact_id', 'revision', 'kind', 'content_hash'}:
            fail('HOLD_EVIDENCE_INVALID', 'exact four-field artifact reference required')
        rows = connection.execute('SELECT path FROM artifacts WHERE ref=? AND book=? AND scope=?',
            (canonical(ref).decode(), self.target_key(reg['id'])['book_id'], reg['scope'])).fetchall()
        if len(rows) != 1:
            fail('HOLD_EVIDENCE_INVALID', 'artifact is not indexed in the exact registered book/scope')
        artifact = json.loads(Path(rows[0]['path']).read_bytes())
        if reference(artifact) != ref or content_digest(artifact) != ref['content_hash'] or (kind and artifact['kind'] != kind):
            fail('HOLD_EVIDENCE_INVALID', 'indexed artifact identity or bytes differ')
        return artifact

    def _hold_native(self, reg, observer, resource, snapshot_ref=None):
        """Revalidate an old observation against target.sqlite3, across processes."""
        body = self.read_resource(plain(resource), reg['id'])
        if (body.get('format_version') != 'a03-target-observation-1' or
                body.get('target_key') != self.target_key(reg['id']) or
                body.get('target_session_id') != reg['session'] or
                body.get('source_ref') != json.loads(reg['source']) or body.get('scope_id') != reg['scope'] or
                body.get('store_id') != self.target_store_id or body.get('scope_complete') is not True):
            fail('HOLD_EVIDENCE_INVALID', 'native observation bindings are incomplete or foreign')
        # Runtime capture normalizes nested Resource paths and removes asset_root.
        # Verify the original target evidence first, then reproduce that portable
        # projection without writing files or trusting normalized caller fields.
        target = sqlite3.connect(observer.path.as_uri() + '?mode=ro', uri=True, timeout=1)
        try:
            row = target.execute('SELECT body FROM observations WHERE observation_id=?',
                                 (body.get('observation_id'),)).fetchone()
        finally:
            target.close()
        if row is None:
            fail('HOLD_EVIDENCE_INVALID', 'native persisted observation is missing')
        original = json.loads(row[0])
        raw = (json.dumps(original, sort_keys=True, ensure_ascii=False, indent=2, allow_nan=False) + '\n').encode('utf-8')
        original_resource = {'path': 'assets/a03-target/' + hashlib.sha256(raw).hexdigest() + '.json',
                             'sha256': hashlib.sha256(raw).hexdigest(), 'media_type': 'application/json', 'origin': 'SYNTHETIC'}
        root = Path(observer.asset_root).resolve()
        visiting = set()
        normalized_resources = {}

        def normalize_resource(ref):
            key = canonical(ref)
            if key in normalized_resources:
                return normalized_resources[key]
            path = (root / ref['path']).resolve()
            if root not in path.parents or path.is_symlink() or not path.is_file() or path in visiting:
                fail('HOLD_EVIDENCE_INVALID', 'native resource is missing, unsafe or cyclic')
            raw = path.read_bytes()
            if hashlib.sha256(raw).hexdigest() != ref['sha256'] or ref.get('media_type') != 'application/json':
                fail('HOLD_EVIDENCE_INVALID', 'native JSON resource digest or type differs')
            visiting.add(path)
            normalized = normalize(json.loads(raw))
            visiting.remove(path)
            sha = hashlib.sha256(canonical(normalized)).hexdigest()
            result = ({'path': 'assets/runtime/' + sha + '.json', 'sha256': sha,
                       'media_type': 'application/json', 'origin': 'SYNTHETIC'}, normalized)
            normalized_resources[key] = result
            return result

        def normalize(value):
            if isinstance(value, dict):
                if {'path', 'sha256', 'media_type'} <= set(value):
                    return normalize_resource(value)[0]
                return {name: normalize(member) for name, member in value.items() if name != 'asset_root'}
            if isinstance(value, list):
                return [normalize(member) for member in value]
            return value

        # This public target method reads its independent persisted observation
        # registry and verifies exact resource bytes before deriving the snapshot.
        snapshot = plain(observer.snapshot_from_observation(dict(original, resource=original_resource, readback=original_resource)))
        expected_resource, expected_body = normalize_resource(original_resource)
        if plain(resource) != expected_resource or body != expected_body:
            fail('HOLD_EVIDENCE_INVALID', 'runtime observation differs from the exact normalized native read')
        if snapshot_ref is not None and reference(snapshot) != plain(snapshot_ref):
            fail('HOLD_EVIDENCE_INVALID', 'snapshot is not derived from the exact persisted native observation')
        return original, snapshot

    def _hold_native_for_snapshot(self, connection, reg, observer, snapshot_ref):
        root = Path(reg['package_root']).resolve()
        snapshot = self._hold_artifact(connection, snapshot_ref, reg, 'PlatformSnapshot')
        for row in connection.execute('SELECT path,sha FROM files ORDER BY path'):
            path = (self.directory / row['path']).resolve()
            if root not in path.parents or path.suffix.lower() != '.json':
                continue
            try:
                value = json.loads(path.read_bytes())
            except (OSError, ValueError):
                fail('HOLD_EVIDENCE_INVALID', 'indexed JSON evidence is unreadable')
            if (not isinstance(value, dict) or value.get('format_version') != 'a03-target-observation-1' or
                    value.get('observed_at') != snapshot['payload']['observed_at']):
                continue
            resource = {'path': path.relative_to(root).as_posix(), 'sha256': row['sha'],
                        'media_type': 'application/json', 'origin': 'SYNTHETIC'}
            body, actual = self._hold_native(reg, observer, resource)
            if reference(actual) == plain(snapshot_ref):
                return body, actual, resource
        fail('HOLD_EVIDENCE_INVALID', 'snapshot has no persisted runtime/target native observation binding')

    def _hold_baseline(self, connection, reg, observer):
        terminal_seen, expected = False, None
        for row in connection.execute('SELECT body FROM events WHERE book=? ORDER BY sequence', (reg['book'],)):
            event = json.loads(row['body'])
            payload = event['payload']
            resource, snapshot_ref, ref = None, None, None
            if event['event'] == 'RECONCILIATION_COMMITTED' and payload.get('resolution') in ('RESOLVED_APPLIED', 'RESOLVED_NOT_APPLIED'):
                resolution = self._hold_artifact(connection, payload['resolution_ref'], reg, 'ReconciliationResult')
                rp = resolution['payload']
                if rp['resolution'] != payload['resolution']:
                    fail('HOLD_EVIDENCE_INVALID', 'terminal event differs from immutable resolution')
                terminal_seen = True
                resource, snapshot_ref, ref = rp['readback'], rp['observed_snapshot_ref'], reference(resolution)
            elif terminal_seen and event['event'] == 'ACTION_RESULT_COMMITTED' and payload.get('outcome') == 'APPLIED':
                fact = self.read_resource(payload['fact'], reg['id'])
                if (fact['action_id'] != payload['action_id'] or fact['action_digest'] != payload['action_digest'] or
                        fact['result']['outcome'] != 'APPLIED' or fact['journal_sequence'] != event['sequence'] or
                        fact['predecessor_hash'] != event['previous_hash']):
                    fail('HOLD_EVIDENCE_INVALID', 'applied event differs from immutable fact')
                resource, snapshot_ref, ref = fact['readback'], fact['observed_snapshot_ref'], payload['fact']
            elif terminal_seen and event['event'] == 'HOLD_CLEARED':
                resource, snapshot_ref, ref = payload['verification_observation'], payload['verification_snapshot_ref'], payload['candidate_plan_ref']
            if resource is not None:
                expected = {'event_sequence': event['sequence'], 'event_hash': event['event_hash'],
                    'event': event['event'], 'binding': ref, 'plan_ref': payload.get('plan_ref'),
                    '_resource': resource, '_snapshot_ref': snapshot_ref}
        if expected is not None:
            body, _ = self._hold_native(reg, observer, expected.pop('_resource'), expected.pop('_snapshot_ref'))
            expected.update(target_state_hash=body['target_state_hash'], target_state_version=body['target_state_version'],
                            read_sequence=body['read_sequence'], observed_at=body['observed_at'])
        return expected if terminal_seen else None

    def _hold_read(self, reg, observer, deadline, *, capture=True):
        from annotation.runtime.recovery.observation import observe_bounded
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            fail('RECOVERY_DEADLINE_EXCEEDED', 'hold operation deadline exhausted', 6)
        result = observe_bounded(observer, timeout=min(2, remaining))
        if not result.get('ok') or not result.get('process_reaped') or result['read_elapsed_seconds'] > 2:
            fail(result.get('code', 'TARGET_READ_TIMEOUT'), 'hold observation failed within its bounded process', 6)
        original = result['observation']
        if not capture:
            snapshot = plain(observer.snapshot_from_observation(original))
            if (original.get('target_key') != self.target_key(reg['id']) or
                    original.get('target_session_id') != reg['session'] or original.get('scope_id') != reg['scope'] or
                    original.get('source_ref') != json.loads(reg['source']) or original.get('store_id') != self.target_store_id):
                fail('HOLD_EVIDENCE_INVALID', 'current native observation differs from registration')
            return original, snapshot, original
        captured, snapshot = self.capture_observation(original, observer, reg['id'])
        if snapshot is None:
            fail('HOLD_EVIDENCE_INVALID', 'hold requires a complete fresh native observation')
        body, actual = self._hold_native(reg, observer, captured['resource'], reference(snapshot))
        return captured, actual, body

    def _hold_assert_head(self, book, expected):
        if (book['head_sequence'], book['head_hash']) != expected:
            fail('EVENT_HEAD_CAS_MISMATCH', 'book event head changed during hold operation', 4)

    def _hold_current(self, observer, target_key, owner_id, generation, actual):
        from annotation.contracts import target_state_digest
        current = self._hold_fence(observer, target_key, owner_id, generation)
        live = plain(observer.read_target(target_key['book_id']))
        if (current['target_state_hash'] != actual['target_state_hash'] or
                (target_state_digest(live), 'a03-target-epoch-' + str(live['epoch'])) !=
                (actual['target_state_hash'], actual['target_state_version'])):
            fail('TARGET_CHANGED', 'target changed during final hold transaction', 3)

    def detect_target_drift(self, target_key, *, owner_id, generation, observer=None):
        target_key = plain(target_key)
        reg = self._hold_registration(target_key)
        observer = self._hold_observer(reg, observer)
        deadline = time.monotonic() + 60
        with self.effect_gate(target_key).acquire():
            self.verify_integrity()
            with self.connect() as connection:
                book = self._lease(connection, reg['book'], owner_id, generation, pending_ok=True)
                if book['hold']:
                    return Handle(status='TARGET_DRIFT_HOLD', hold_id=book['hold'], created=False)
                expected_head = (book['head_sequence'], book['head_hash'])
                baseline = self._hold_baseline(connection, reg, observer)
            if baseline is None:
                return Handle(status='NO_TERMINAL_BASELINE', hold_id=None, created=False)
            self._hold_fence(observer, target_key, owner_id, generation)
            captured, snapshot, actual = self._hold_read(reg, observer, deadline, capture=False)
            matches = (actual['target_state_hash'], actual['target_state_version']) == (baseline['target_state_hash'], baseline['target_state_version'])
            if not matches:
                captured, snapshot = self.capture_observation(captured, observer, reg['id'])
                if snapshot is None:
                    fail('HOLD_EVIDENCE_INVALID', 'hold requires a complete valid native snapshot')
                actual, snapshot = self._hold_native(reg, observer, captured['resource'], reference(snapshot))
            with self.transaction() as connection:
                book = self._lease(connection, reg['book'], owner_id, generation, pending_ok=True)
                self._hold_assert_head(book, expected_head)
                self._hold_current(observer, target_key, owner_id, generation, actual)
                if time.monotonic() >= deadline:
                    fail('RECOVERY_DEADLINE_EXCEEDED', 'hold operation deadline exhausted', 6)
                if matches:
                    return Handle(status='NO_DRIFT', hold_id=None, created=False,
                                  target_state_hash=actual['target_state_hash'], target_state_version=actual['target_state_version'],
                                  read_sequence=actual['read_sequence'])
                self._append(connection, reg['id'], snapshot)
                hold_id = unique('target-drift-hold')
                prior_prechecks = []
                bundle = self.bundle(reg['id'])
                for artifact in bundle['artifacts']:
                    if artifact['kind'] == 'ApplyPlan':
                        ref = artifact['payload']['precheck']
                        if ref not in prior_prechecks:
                            prior_prechecks.append(ref)
                payload = {'hold_id': hold_id, 'registration_id': reg['id'], 'plan_ref': baseline['plan_ref'],
                    'baseline': baseline, 'observation': captured['resource'], 'snapshot_ref': reference(snapshot),
                    'observation_id': actual['observation_id'], 'observed_at': actual['observed_at'],
                    'read_sequence': actual['read_sequence'], 'target_state_hash': actual['target_state_hash'],
                    'target_state_version': actual['target_state_version'], 'target_store_id': self.target_store_id,
                    'target_session_id': reg['session'], 'source_ref': json.loads(reg['source']), 'scope_id': reg['scope'],
                    'prior_precheck_refs': prior_prechecks}
                event = self._event(connection, reg['book'], 'TARGET_DRIFT_HOLD', payload)
                connection.execute('UPDATE books SET hold=? WHERE key=?', (hold_id, reg['book']))
            return Handle(status='TARGET_DRIFT_HOLD', hold_id=hold_id, created=True, event=event,
                          snapshot_ref=reference(snapshot), observation=captured['resource'])

    def clear_target_drift_hold(self, hold_id, snapshot_ref, precheck_ref, targetcheck_ref,
                               candidate_plan_ref, *, owner_id, generation):
        from annotation.contracts import (ContractError, assert_recovery_plan_ready, validate_recovery_bundle)
        from annotation.delivery.planner import verify_generated_plan
        from annotation.runtime.recovery import configuration
        deadline = time.monotonic() + 60
        with self.connect() as connection:
            rows = connection.execute('SELECT key FROM books WHERE hold=?', (hold_id,)).fetchall()
            if len(rows) != 1:
                fail('HOLD_EVIDENCE_INVALID', 'exact active hold does not exist')
            target_key = json.loads(connection.execute('SELECT target_key FROM books WHERE key=?', (rows[0]['key'],)).fetchone()[0])
        reg = self._hold_registration(target_key)
        observer = self._hold_observer(reg)
        with self.effect_gate(target_key).acquire():
            self.verify_integrity()
            with self.connect() as connection:
                book = self._lease(connection, reg['book'], owner_id, generation, pending_ok=True)
                if book['hold'] != hold_id:
                    fail('HOLD_EVIDENCE_INVALID', 'active hold changed')
                if self._pending(connection, reg['book']):
                    fail('BOOK_WRITE_PAUSED', 'all book scopes must have no unresolved save obligation', 3)
                expected_head = (book['head_sequence'], book['head_hash'])
                hold = None
                for row in connection.execute('SELECT body FROM events WHERE book=? ORDER BY sequence DESC', (reg['book'],)):
                    event = json.loads(row['body'])
                    if event['event'] == 'TARGET_DRIFT_HOLD' and event['payload'].get('hold_id') == hold_id:
                        hold = event
                        break
                if hold is None:
                    fail('HOLD_EVIDENCE_INVALID', 'active hold lacks its immutable event')
                refs = [(snapshot_ref, 'PlatformSnapshot'), (precheck_ref, 'CheckReport'),
                        (targetcheck_ref, 'CheckReport'), (candidate_plan_ref, 'ApplyPlan')]
                snapshot, precheck, targetcheck, plan = [self._hold_artifact(connection, ref, reg, kind) for ref, kind in refs]
                native, _, native_resource = self._hold_native_for_snapshot(connection, reg, observer, snapshot_ref)
            self._hold_fence(observer, target_key, owner_id, generation)
            hp = hold['payload']
            if (_time(native['observed_at']) <= max(_time(hp['observed_at']), _time(hold['recorded_at'])) or
                    native['read_sequence'] <= hp['read_sequence']):
                fail('OBSERVATION_NOT_FRESH', 'candidate snapshot must be a new actual observation after the hold')
            if (plain(precheck_ref) in hp['prior_precheck_refs'] or _time(precheck['created_at']) <= _time(hold['recorded_at']) or
                    precheck['payload']['stage'] != 'PRE_APPLY' or precheck['payload']['decision'] != 'PASS'):
                fail('HOLD_EVIDENCE_INVALID', 'a genuinely new post-hold PRE_APPLY is required; old PRE cannot be relabeled by this runtime')
            pp = plan['payload']
            if (pp['snapshot'] != plain(snapshot_ref) or pp['precheck'] != plain(precheck_ref) or
                    pp['targetcheck'] != plain(targetcheck_ref) or targetcheck['payload']['stage'] != 'TARGET' or
                    targetcheck['payload']['snapshot'] != plain(snapshot_ref) or targetcheck['payload']['subject'] != plain(snapshot_ref) or
                    targetcheck['payload']['decision'] != 'PASS' or _time(targetcheck['created_at']) < _time(native['observed_at']) or
                    _time(plan['created_at']) < max(_time(native['observed_at']), _time(precheck['created_at']), _time(targetcheck['created_at']))):
                fail('HOLD_EVIDENCE_INVALID', 'candidate plan/new PRE/new TARGET/current snapshot bindings differ')
            try:
                bundle = self._validate(self.bundle(reg['id']), asset_root=reg['package_root'])
                selected = assert_recovery_plan_ready(bundle, candidate_plan_ref, snapshot_ref, bridge_context=getattr(bundle, "bridge_context", None))
                verify_generated_plan(bundle, selected, snapshot_ref, configuration(json.loads(reg['config'])), bridge_context=getattr(bundle, "bridge_context", None))
            except ContractError as error:
                code = error.issues[0]['code'] if error.issues else 'HOLD_EVIDENCE_INVALID'
                fail(code if code in ('TARGET_CHANGED', 'OBSERVATION_NOT_FRESH', 'BOOK_WRITE_PAUSED') else 'HOLD_EVIDENCE_INVALID', str(error))
            # Retain the same book gate while the independent target is read.
            # No dispatch permit is issued or consumed by this route.
            self.renew(target_key, owner_id=owner_id, generation=generation)
            captured, verified_snapshot, actual = self._hold_read(reg, observer, deadline)
            if (actual['target_state_hash'], actual['target_state_version']) != (native['target_state_hash'], native['target_state_version']):
                fail('TARGET_CHANGED', 'target changed after candidate planning; hold remains', 3)
            self.fault('BEFORE_HOLD_CLEAR_COMMIT')
            with self.transaction() as connection:
                book = self._lease(connection, reg['book'], owner_id, generation, pending_ok=True)
                self._hold_assert_head(book, expected_head)
                if book['hold'] != hold_id or self._pending(connection, reg['book']):
                    fail('BOOK_WRITE_PAUSED', 'hold or full-book unresolved set changed', 3)
                self._hold_current(observer, target_key, owner_id, generation, actual)
                if time.monotonic() >= deadline:
                    fail('RECOVERY_DEADLINE_EXCEEDED', 'hold clearance deadline exhausted', 6)
                self._append(connection, reg['id'], verified_snapshot)
                payload = {'hold_id': hold_id, 'hold_event_hash': hold['event_hash'], 'registration_id': reg['id'],
                    'plan_ref': plain(candidate_plan_ref), 'candidate_plan_ref': plain(candidate_plan_ref),
                    'snapshot_ref': plain(snapshot_ref), 'precheck_ref': plain(precheck_ref), 'targetcheck_ref': plain(targetcheck_ref),
                    'candidate_observation': native_resource, 'verification_observation': captured['resource'],
                    'verification_snapshot_ref': reference(verified_snapshot), 'target_state_hash': actual['target_state_hash'],
                    'target_state_version': actual['target_state_version'], 'read_sequence': actual['read_sequence']}
                event = self._event(connection, reg['book'], 'HOLD_CLEARED', payload)
                connection.execute('UPDATE books SET hold=NULL WHERE key=? AND hold=?', (reg['book'], hold_id))
            return Handle(cleared=True, hold_id=hold_id, event_head={'sequence': event['sequence'], 'hash': event['event_hash']},
                          event=event, target_effects=0)

