          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "recovery_call_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "attempt_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "read_sequence": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
