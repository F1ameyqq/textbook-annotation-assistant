1a8a3f13c67491833413d9616a9b369c646e8389 blob 2138
{
  "profile_id": "a03-p2-r2-static-2-PROPOSAL",
  "status": "STATIC_UNIMPLEMENTED",
  "implementation_authorized": false,
  "new_artifact_version": "1.3.0-a03-static-proposal",
  "exchange_version": "a03-exchange-3-proposal",
  "schema_pins": [
    {
      "path": "schemas/basis-v3.schema.json",
      "sha256": "40db0538a512f65e2f8668c528f98643d372cdc195b9b868c446cce2b0743202"
    },
    {
      "path": "schemas/conversion-v3.schema.json",
      "sha256": "ac28365f16d028af83e385108cb06cdb3a6f81e2a2e792051692952640c116e4"
