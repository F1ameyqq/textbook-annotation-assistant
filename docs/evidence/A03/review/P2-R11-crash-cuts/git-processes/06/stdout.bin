                          "type": "null"
                        },
                        "hold_head": {
                          "type": "null"
                        },
                        "hold_ref": {
                          "type": "null"
                        }
                      },
                      "required": [
                        "kind",
                        "hold_id",
                        "hold_head",
                        "hold_ref"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
