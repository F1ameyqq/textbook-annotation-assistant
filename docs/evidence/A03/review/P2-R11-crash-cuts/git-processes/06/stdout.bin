"""Read-only recovery comparison and result construction.

No runtime database, target effects, retries or pause-clearing live here. Runtime
commits a validated result only after checking its current complete book ledger.
"""
import json
from pathlib import Path

from annotation.contracts import artifact_ref, validate_bundle, seal_artifact
from annotation.delivery.planner import compare_action_effect
from annotation.quality.targetcheck import reject, resolve_artifact


def reconcile_action(action, before_observation, after_observation, *, comparator_version="a02-facts-1"):
    """Compare independent evidence with the single shared A02 authority."""
    result = compare_action_effect(action, before_observation, after_observation,
                                   comparator_version=comparator_version)
    result["resolution"] = {"MATCH": "RESOLVED_APPLIED", "ABSENT": "RESOLVED_NOT_APPLIED"}.get(
        result["effect_match"], "STILL_UNKNOWN")
    result["replay_allowed"] = False
    return result


def _plain(value):
    return value.model_dump(mode="json") if hasattr(value, "model_dump") else value


def make_reconciliation_result(bundle, intent_ref, observation, comparison, *, obligation_id,
                               recovery_call_id, attempt_index, artifact_id,
                               original_receipt_ref=None, previous_resolution_ref=None,
                               observed_snapshot_ref=None, bridge_context=None):
    """Build a new immutable proposal; this function grants no commit authority."""
    bundle = validate_bundle(bundle, bridge_context=bridge_context)
    intent = resolve_artifact(bundle, intent_ref, "WriteIntent")
    if not 1 <= attempt_index <= 3:
        reject("RECONCILE_ATTEMPT_LIMIT", "at most three observations per intent per invocation")
    observation, comparison = _plain(observation), _plain(comparison)
    if (comparison["action_id"] != intent.payload.action_id or
            comparison["action_digest"] != intent.payload.action_digest):
        reject("ACTION_DIGEST_MISMATCH", "comparison is for a different committed action")
    match = comparison["effect_match"]
    conclusive = match in ("MATCH", "ABSENT")
    snapshot = _plain(observed_snapshot_ref) if observed_snapshot_ref is not None else observation.get("snapshot_ref")
    if conclusive and (snapshot is None or observation.get("read_sequence") is None or observation.get("read_status") != "OK"):
        reject("CONCLUSIVE_READBACK_REQUIRED", "a terminal resolution requires actual complete read and fresh snapshot")
    resource = observation.get("resource", observation.get("readback"))
    payload = {"plan_ref": _plain(intent.payload.plan_ref), "intent_ref": artifact_ref(intent),
               "obligation_id": obligation_id, "action_id": intent.payload.action_id,
               "action_digest": intent.payload.action_digest,
               "original_receipt_ref": _plain(original_receipt_ref),
               "previous_resolution_ref": _plain(previous_resolution_ref),
               "observed_snapshot_ref": snapshot, "observation_id": observation["observation_id"],
               "recovery_call_id": recovery_call_id, "attempt_index": attempt_index,
               "observed_at": observation["observed_at"], "read_sequence": observation.get("read_sequence"),
               "target_state_version": observation.get("target_state_version"),
               "target_state_hash": observation.get("target_state_hash"), "observation": match,
               "resolution": {"MATCH": "RESOLVED_APPLIED", "ABSENT": "RESOLVED_NOT_APPLIED"}.get(match, "STILL_UNKNOWN"),
               "platform_ids": comparison.get("platform_ids", []), "evidence_refs": [resource] if resource else [],
               "readback": resource, "comparator_version": comparison["comparator_version"],
               "reason_code": match, "replay_allowed": False}
    # Each consuming artifact declares every exact ordinary ref in its own
    # payload and recursively consumed JSON Resources; referenced Artifact
    # payloads are deliberately not inherited into this consumer's closure.
    refs = {}
    visited = set()
    root = getattr(bundle, "asset_root", None)
    def walk(value):
        if isinstance(value, list):
            for member in value:
                walk(member)
        elif isinstance(value, dict):
            if set(value) == {"artifact_id", "revision", "kind", "content_hash"}:
                refs[tuple(value[k] for k in ("artifact_id", "revision", "kind", "content_hash"))] = value
            elif {"path", "sha256", "media_type"}.issubset(value):
                token = (value["path"], value["sha256"])
                if token not in visited and value["media_type"] == "application/json":
                    visited.add(token)
                    if root is None:
                        reject("RESOURCE_MISSING", "resource closure needs fixed package root")
                    walk(json.loads((Path(root) / value["path"]).read_text(encoding="utf-8")))
            else:
                for member in value.values():
                    walk(member)
    walk(payload)
    return seal_artifact({"schema_version": intent.schema_version, "artifact_id": artifact_id,
                          "revision": 1, "kind": "ReconciliationResult", "run_id": intent.run_id,
                          "book_id": intent.book_id, "scope_id": intent.scope_id,
                          "input_refs": list(refs.values()), "producer": {
                              "module": "a03-reconciler", "implementation_version": "a03-1",
                              "config_version": intent.producer.config_version,
                              "policy_versions": [_plain(p) for p in intent.producer.policy_versions],
                              "model_version": None, "prompt_version": None, "evidence_mode": "SYNTHETIC"},
                          "created_at": observation["observed_at"], "payload": payload}, bridge_context=bridge_context)


__all__ = ["reconcile_action", "make_reconciliation_result"]

857cbf5f11ce0d75b50c9c6eb3b66a772234dfc0 blob 9708
"""Actual five checks for the adopted, fixed 32x32 synthetic language only.

No SQL, durable registry ownership, dispatch permit, OCR or model calls.
"""
import hashlib
from importlib import resources
import json
from pathlib import Path

from annotation.contracts import artifact_ref, policy_ref, validate_bundle
from annotation.contracts.a03_native import require_context, derive_context
from annotation.quality.targetcheck import (append_artifacts, coverage_for, make_artifact,
    resolve_artifact, resolve_policy, reject)

CHECKS = ('source_integrity', 'structure', 'answer_matching', 'coverage', 'policy')


def _raw_oracle():
    return resources.files('annotation.contracts.a03_native').joinpath('data/oracle.json').read_bytes()


def _write(root, raw, suffix):
    digest = hashlib.sha256(raw).hexdigest()
    path = Path(root) / 'assets/native-pre' / (digest + suffix)
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        if path.read_bytes() != raw:
            reject('RESOURCE_HASH_MISMATCH', 'immutable PRE resource differs')
    else:
        with path.open('xb') as stream:
            stream.write(raw)
    return {'path': path.relative_to(root).as_posix(), 'sha256': digest,
            'media_type': 'application/json', 'origin': 'SYNTHETIC'}


def compare_synthetic_inputs(bundle, source_ref, evidence_ref, graph_ref, policy_reference, *, asset_root):
    """Compute five comparisons, using exact unique inputs and every PGM pixel."""
    root = Path(asset_root).resolve(strict=True)
    source = resolve_artifact(bundle, source_ref, 'SourceBundle')
    evidence = resolve_artifact(bundle, evidence_ref, 'EvidenceBundle')
    graph = resolve_artifact(bundle, graph_ref, 'QuestionGraph')
    policy = resolve_policy(bundle, policy_reference)
    for kind, selected in (('SourceBundle', source), ('EvidenceBundle', evidence), ('QuestionGraph', graph)):
        if sum(a.kind == kind for a in bundle.artifacts) != 1:
            reject('SYNTHETIC_INPUT_AMBIGUOUS', 'one explicit unique ' + kind + ' required')
    if len(bundle.policies) != 1 or graph.payload.source != artifact_ref(source) or graph.payload.evidence != artifact_ref(evidence):
        reject('SYNTHETIC_INPUT_BINDING', 'graph/policy exact inputs differ')
    oracle = json.loads(_raw_oracle())
    sp, ep, gp = source.payload, evidence.payload, graph.payload
    asset_ok = len(sp.assets) == 1
    for asset in sp.assets:
        path = (root / asset.path).resolve(strict=True)
        if root not in path.parents or path.is_symlink():
            reject('RESOURCE_PATH', 'PGM escaped explicit root')
        raw = path.read_bytes()
        if hashlib.sha256(raw).hexdigest() != asset.sha256:
            reject('RESOURCE_HASH_MISMATCH', 'PGM raw bytes differ')
        try:
            # P2 permits comments; consume the complete raster, never just header.
            tokens = b' '.join(line.split(b'#', 1)[0] for line in raw.splitlines()).split()
            header = tokens[:4]
            pixels = [int(value) for value in tokens[4:]]
            expected = [0 if (4 <= x < 28 and (4 <= y < 10 or 18 <= y < 24)) else 255
                        for y in range(32) for x in range(32)]
            asset_ok = asset_ok and header == [b'P2', b'32', b'32', b'255'] and pixels == expected
        except ValueError:
            asset_ok = False
        asset_ok = asset_ok and asset.width == 32 and asset.height == 32
    source_ok = asset_ok and len(sp.pages_expected) == len(sp.pages_acquired) == 1 and sp.pages_expected == sp.pages_acquired == [sp.assets[0].asset_id]
    questions, regions, fragments = gp.questions, ep.regions, gp.fragments
    structure_ok = (len(questions) == 1 and len(regions) == 2 and [f.role for f in fragments] == ['stem', 'answer']
        and [r.box.bbox for r in regions] == [[4, 4, 28, 10], [4, 18, 28, 24]]
        and not questions[0].shared_fragment_ids and not questions[0].cross_page
        and questions[0].fragment_ids == [f.fragment_id for f in fragments]
        and len(fragments) == 2 and all(f.region_ids == [r.region_id] for f, r in zip(fragments, regions)))
    answers = [f.fragment_id for f in fragments if f.role == 'answer']
    relations = gp.answer_relations
    answer_ok = len(relations) == 1 and len(answers) == 1 and relations[0].status == 'SELECTED' and relations[0].question_id == questions[0].question_id and relations[0].candidate_fragment_ids == relations[0].selected_fragment_ids == answers
    coverage_ok = (sp.scope_manifest == [q.question_id for q in questions]
        and len(sp.pages_expected) == 1 and len(ep.coverage_clues) == 2
        and [c.disposition for c in ep.coverage_clues] == ['ASSIGNED', 'ASSIGNED']
        and {rid for c in ep.coverage_clues for rid in c.region_ids} == {r.region_id for r in regions})
    policy_ok = (policy.option_grouping == 'SEPARATE' and dict(policy.role_mapping) ==
        {'stem': 'Q', 'option': 'W', 'answer': 'A', 'explanation': 'E', 'shared_material': 'Q'}
        and all(q.question_type == 'free_response' for q in questions))
    return dict(zip(CHECKS, ['PASS' if value else 'FAIL' for value in
        (source_ok, structure_ok, answer_ok, coverage_ok, policy_ok)]))


def _pre_coverage_decision(bundle, graph, checks):
    """Keep the public pair contract and retain completeness in PRE decisions."""
    coverage, complete = coverage_for(bundle, graph)
    checked = dict(checks)
    if not complete:
        checked['coverage'] = 'FAIL'
    decision = 'PASS' if complete and all(value == 'PASS' for value in checked.values()) else 'HOLD'
    return coverage, checked, decision


def produce_a03_pre_run(bundle, source_ref, evidence_ref, graph_ref, policy_reference, *,
                        bridge_context, registered_run_handle, actual_snapshot_ref,
                        actual_observation, asset_root, artifact_id, created_at):
    """Produce immutable PRE/run bytes from new checks; runtime records/adopts them."""
    bundle = validate_bundle(bundle, asset_root=asset_root, bridge_context=bridge_context)
    callback = require_context(bridge_context, bundle)
    binding = callback('producer_binding', bridge_context, handle=registered_run_handle,
        snapshot_ref=actual_snapshot_ref, observation=actual_observation)
    graph = resolve_artifact(bundle, graph_ref, 'QuestionGraph')
    source = resolve_artifact(bundle, source_ref, 'SourceBundle')
    evidence = resolve_artifact(bundle, evidence_ref, 'EvidenceBundle')
    snapshot = resolve_artifact(bundle, actual_snapshot_ref, 'PlatformSnapshot')
    results = compare_synthetic_inputs(bundle, source_ref, evidence_ref, graph_ref, policy_reference, asset_root=asset_root)
    coverage, results, decision = _pre_coverage_decision(bundle, graph, results)
    oracle_resource = _write(Path(asset_root), _raw_oracle(), '.json')
    run = {'format_version': 'a03-native-pre-run-1', 'run_id': binding['run_id'],
        'context': binding['context'], 'source_ref': source_ref, 'evidence_ref': evidence_ref,
        'graph_ref': graph_ref, 'policy_ref': policy_reference, 'snapshot_ref': actual_snapshot_ref,
        'oracle': oracle_resource, 'input_raw_sha256': bridge_context.canonical_sha256,
        'implementation_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        'actual_observation': actual_observation['resource'], 'observed_at': actual_observation['observed_at'],
        'produced_at': created_at, 'checks': results, 'input_manifest': binding['input_manifest'],
        'native_binding': binding['native_binding'], 'runtime_status': 'ACTUAL_CHECKS_COMPUTED',
        'admission': 'RUNTIME_RECHECK_REQUIRED'}
    raw = (json.dumps(run, sort_keys=True, ensure_ascii=False, indent=2) + '\n').encode('utf-8')
    run_resource = _write(Path(asset_root), raw, '.json')
    evidence_id = 'native-pre-proof-' + run_resource['sha256'][:40]
    augmented = bundle.model_dump()
    augmented['evidence'].append({'evidence_id': evidence_id, 'resource': run_resource,
        'description': 'Actual fixed synthetic five-check run; no dispatch authority', 'mode': 'SYNTHETIC'})
    bridge_context = derive_context(bridge_context, augmented)
    bundle = validate_bundle(augmented, bridge_context=bridge_context, asset_root=asset_root)
    payload = {'stage': 'PRE_APPLY', 'subject': graph_ref, 'graph': graph_ref, 'policy': policy_reference,
        'snapshot': actual_snapshot_ref, 'receipt': None, 'coverage': coverage,
        'checks': [{'check_id': key, 'outcome': value, 'evidence_refs': [evidence_id], 'reason': 'Actual fixed synthetic comparison: ' + value}
                   for key, value in results.items()], 'issues': [],
        'decision': decision,
        'reason': 'Actual five fixed synthetic comparisons; content remains unverified',
        'recovery_refs': [], 'synthetic_run_ref': run_resource, 'verification_context': binding['context']}
    pre = make_artifact('CheckReport', artifact_id, graph, payload, list(bundle.artifacts),
        'a03-native-pre-1', 'annotation.quality.synthetic_precheck', created_at,
        run_id=binding['run_id'], bridge_context=bridge_context)
    return append_artifacts(bundle, pre, asset_root=asset_root, bridge_context=bridge_context), artifact_ref(pre)


def admit_a03_pre_run(bundle, pre_ref, *, bridge_context, registered_run_handle, actual_snapshot_ref, asset_root):
    """Ask runtime to recheck the actual durable run/currentness; never a permit."""
    bundle = validate_bundle(bundle, asset_root=asset_root, bridge_context=bridge_context)
    return require_context(bridge_context, bundle)('admit_pre', bridge_context, bundle=bundle,
        pre_ref=pre_ref, handle=registered_run_handle, snapshot_ref=actual_snapshot_ref)

ed8e43cf18fa8c44f4981f129470d76aeca234ea blob 16661
"""A02 target checks. Pure, synthetic-only; no target mutation or I/O."""
from dataclasses import asdict, dataclass
from typing import Dict, Tuple

from annotation.contracts import (
    ContractError, artifact_ref, content_digest, policy_ref, seal_artifact,
    validate_bundle,
)

VERSION = "a02-1"


@dataclass(frozen=True)
class SimulationConfig:
    """Local simulation authorization, not an extension of the C01 contract.

    Directory namespaces are connected explicitly here, never by string equality.
    The entire configuration is bound by CheckReport/ApplyPlan producer.config_version.
    """
    book_id: str
    target_id: str
    scope_id: str
    directory_map: Dict[str, str]
    session_mode: str = "SAME_SESSION_HANDOFF"
    allowed_operations: Tuple[str, ...] = ("CREATE_FRAMES",)

    @property
    def version(self):
        return "a02-config-" + content_digest(asdict(self))


def reject(code, message, path="$.a02"):
    raise ContractError([{"path": path, "code": code, "message": message}])


def resolve_artifact(bundle, reference, kind=None):
    ref = reference.model_dump(mode="json") if hasattr(reference, "model_dump") else reference
    for item in bundle.artifacts:
        if artifact_ref(item) == ref and (kind is None or item.kind == kind):
            return item
    reject("MISSING_REFERENCE", "exact artifact reference not found: " + str(ref))


def resolve_policy(bundle, reference):
    ref = reference.model_dump(mode="json") if hasattr(reference, "model_dump") else reference
    for item in bundle.policies:
        if policy_ref(item) == ref:
            return item
    reject("POLICY_CONFLICT", "exact policy reference not found")


def make_artifact(kind, identity, anchor, payload, dependencies, config_version,
                  module, created_at, run_id=None, *, bridge_context=None):
    """Seal using C01's single structural authority; no local contract definitions."""
    payload = dict(payload)
    if anchor.schema_version in ("1.1.0-a-recovery-proposal", "1.4.0-a03-native-proposal") and kind == "CheckReport":
        payload.setdefault("recovery_refs", [])
    refs = [artifact_ref(item) for item in dependencies]
    if anchor.schema_version == '1.4.0-a03-native-proposal':
        exact = {}
        for ref in refs:
            key = (ref['artifact_id'], ref['revision'])
            if key in exact and exact[key] != ref:
                reject('NATIVE_DEPENDENCY_CONFLICT', 'same identity with different exact reference')
            exact[key] = ref
    refs = list({(r["artifact_id"], r["revision"]): r for r in refs}.values())
    policies = [payload["policy"]] if "policy" in payload else [
        p.model_dump(mode="json") for p in anchor.producer.policy_versions]
    return seal_artifact({
        "schema_version": anchor.schema_version, "artifact_id": identity,
        "revision": 1, "kind": kind, "run_id": run_id or anchor.run_id,
        "book_id": anchor.book_id, "scope_id": anchor.scope_id, "input_refs": refs,
        "producer": {"module": module, "implementation_version": VERSION,
                     "config_version": config_version, "policy_versions": policies,
                     "model_version": None, "prompt_version": None,
                     "evidence_mode": "SYNTHETIC"},
        "created_at": created_at, "payload": payload,
    }, bridge_context=bridge_context)


def append_artifacts(bundle, *artifacts, asset_root=None, bridge_context=None):
    if asset_root is None:
        asset_root = getattr(bundle, "asset_root", None)
    data = bundle.model_dump(mode="json")
    data["artifacts"].extend(artifacts)
    if data.get('format_version') == 'a03-exchange-4-proposal':
        from annotation.contracts.a03_native import derive_context
        bridge_context = derive_context(bridge_context, data, asset_root=asset_root)
    return validate_bundle(data, asset_root=asset_root, bridge_context=bridge_context)


def coverage_for(bundle, graph):
    source = resolve_artifact(bundle, graph.payload.source, "SourceBundle")
    evidence = resolve_artifact(bundle, graph.payload.evidence, "EvidenceBundle")
    owned = {f for q in graph.payload.questions for f in q.fragment_ids + q.shared_fragment_ids}
    owned.update(f for r in graph.payload.answer_relations for f in r.selected_fragment_ids)
    assigned = {r for f in graph.payload.fragments if f.fragment_id in owned for r in f.region_ids}
    unassigned = {r for c in evidence.payload.coverage_clues if c.disposition == "UNASSIGNED"
                  for r in c.region_ids}
    unassigned.update(r.region_id for r in evidence.payload.regions if r.region_id not in assigned)
    coverage = {"scope_id": graph.scope_id, "pages_expected": source.payload.pages_expected,
                "pages_checked": source.payload.pages_acquired,
                "clue_ids": [c.clue_id for c in evidence.payload.coverage_clues],
                "unassigned_region_ids": sorted(unassigned)}
    complete = (set(source.payload.scope_manifest) == {q.question_id for q in graph.payload.questions}
                and set(source.payload.pages_expected) == set(source.payload.pages_acquired)
                and not unassigned
                and all(c.disposition != "UNASSIGNED" for c in evidence.payload.coverage_clues))
    return coverage, complete


def projection_frames(bundle, graph, question, policy):
    """Project owned/selected original regions; never select candidate answers by label."""
    evidence = resolve_artifact(bundle, graph.payload.evidence, "EvidenceBundle")
    regions = {r.region_id: r for r in evidence.payload.regions}
    selected = {f for rel in graph.payload.answer_relations if rel.question_id == question.question_id
                for f in rel.selected_fragment_ids}
    direct = set(question.fragment_ids + question.shared_fragment_ids)
    fragments = [f for f in graph.payload.fragments
                 if (f.fragment_id in selected or
                     (f.fragment_id in direct and f.role not in ("answer", "explanation")))]
    frames = []
    for fragment in sorted(fragments, key=lambda f: (f.reading_order, f.fragment_id)):
        for region_id in fragment.region_ids:
            region = regions[region_id]
            frames.append({"fragment_id": fragment.fragment_id, "region_id": region_id,
                           "box": region.box.model_dump(mode="json"),
                           "platform_role": policy.role_mapping[fragment.role],
                           "platform_type": "text" if fragment.content_type == "formula" else fragment.content_type})
    return frames


def analyze_target(bundle, graph_ref, snapshot_ref, current_snapshot_ref, policy_reference, config, *, bridge_context=None):
    """Compute TARGET payload from facts, independent of any input CheckReport decision."""
    bundle = validate_bundle(bundle, bridge_context=bridge_context)
    graph = resolve_artifact(bundle, graph_ref, "QuestionGraph")
    snapshot = resolve_artifact(bundle, snapshot_ref, "PlatformSnapshot")
    current = resolve_artifact(bundle, current_snapshot_ref, "PlatformSnapshot")
    policy = resolve_policy(bundle, policy_reference)
    source = resolve_artifact(bundle, graph.payload.source, "SourceBundle")
    evidence = resolve_artifact(bundle, graph.payload.evidence, "EvidenceBundle")
    proof = list(snapshot.payload.evidence_refs)
    coverage, complete = coverage_for(bundle, graph)
    checks, issues = [], []
    token = content_digest({"graph": artifact_ref(graph), "snapshot": artifact_ref(snapshot),
                            "current": artifact_ref(current), "config": config.version,
                            "policy": policy_ref(policy)})[:20]

    def check(name, problems, code, strategy="HUMAN_REVIEW"):
        checks.append({"check_id": name, "outcome": "FAIL" if problems else "PASS",
                       "evidence_refs": proof, "reason": "; ".join(problems) if problems else
                       "SYNTHETIC facts checked by A02: " + name})
        if problems:
            issues.append({"issue_id": "issue-a02-" + token + "-" + name,
                           "code": code, "scope_type": "scope", "scope_id": graph.scope_id,
                           "evidence_refs": proof, "severity": "blocking", "blocks": ["PLAN", "APPLY"],
                           "suggested_strategy": {"strategy_id": strategy, "max_attempts": 0, "max_cost": 0.0},
                           "reason": "; ".join(problems)})

    target_problems = []
    if artifact_ref(snapshot) != artifact_ref(current):
        target_problems.append("current snapshot revision/hash differs from checked snapshot")
    platform = {q.platform_question_id: q for q in snapshot.payload.questions}
    mapped = []
    for q in graph.payload.questions:
        ext = q.external_refs
        if ext.platform_question_id is not None:
            existing = platform.get(ext.platform_question_id)
            mapped.append(ext.platform_question_id)
            if not ext.platform_question_id or existing is None:
                target_problems.append(q.question_id + ": mapped platform question ID absent/empty")
            elif ext.platform_order is not None and ext.platform_order != existing.platform_order:
                target_problems.append(q.question_id + ": mapped platform order differs")
            elif config.directory_map.get(q.directory_id) != existing.directory_id:
                target_problems.append(q.question_id + ": explicit directory mapping differs")
        elif ext.platform_order is not None:
            target_problems.append(q.question_id + ": unmapped new question cannot claim an existing order")
    if len(set(mapped)) != len(mapped):
        target_problems.append("multiple internal questions share one platform ID; projection unsupported")
    if graph.schema_version in ("1.1.0-a-recovery-proposal", "1.4.0-a03-native-proposal"):
        from annotation.contracts import effective_recovery_outcomes
        # Namespace is fixed by the actual runtime target. Same-scope public
        # eligibility can infer it only from exact locally bound intent inputs.
        keys = [a.payload.target_key.model_dump(mode="json") for a in bundle.artifacts
                if a.kind == "WriteIntent" and a.book_id == graph.book_id and a.scope_id == graph.scope_id
                and a.payload.target_key.target_id == snapshot.payload.target_id]
        if len({content_digest(k) for k in keys}) > 1:
            reject("TARGET_IDENTITY_MISMATCH", "same target has conflicting canonical namespace bindings")
        unknown = (effective_recovery_outcomes(bundle, target_key=keys[0], scope_id=graph.scope_id, bridge_context=bridge_context).paused
                   if keys else any(a.kind == "ExecutionReceipt" and a.book_id == graph.book_id and
                                    any(r.outcome == "UNKNOWN" for r in a.payload.results) for a in bundle.artifacts))
    else:
        unknown = any(a.kind == "ExecutionReceipt" and a.book_id == graph.book_id and
                      any(r.outcome == "UNKNOWN" for r in a.payload.results) for a in bundle.artifacts)
    if unknown:
        target_problems.append("same book has unresolved UNKNOWN history; reconciliation interface missing")
    check("target_version", target_problems, "TARGET_CHANGED", "RECHECK_TARGET")

    auth_problems = []
    if (config.book_id != graph.book_id or config.book_id != snapshot.book_id or
            config.target_id != snapshot.payload.target_id or config.scope_id != graph.scope_id or
            config.scope_id != snapshot.scope_id or config.scope_id != snapshot.payload.authorized_scope_id):
        auth_problems.append("authorization book/target/scope differs from graph or snapshot")
    if "CREATE_FRAMES" not in config.allowed_operations:
        auth_problems.append("CREATE_FRAMES is not authorized")
    for q in graph.payload.questions:
        if config.directory_map.get(q.directory_id) not in snapshot.payload.directories:
            auth_problems.append(q.question_id + ": explicit platform directory not authorized/present")
    check("authorized_scope", auth_problems, "TARGET_CHANGED")

    cap_problems = []
    if config.session_mode not in ("PERSISTENT", "SAME_SESSION_HANDOFF"):
        cap_problems.append("unsupported session_mode")
    required = ["frame_readback", "persistent_draft" if config.session_mode == "PERSISTENT" else "same_session_handoff"]
    caps = {c.name: c for c in snapshot.payload.capabilities}
    for name in required:
        cap = caps.get(name)
        if cap is None or cap.status != "VERIFIED" or not cap.evidence_refs:
            cap_problems.append(name + ": capability not VERIFIED with evidence")
        elif cap.platform_version != snapshot.payload.platform_version:
            cap_problems.append(name + ": capability applies to a different platform version")
    check("capabilities", cap_problems, "TARGET_CHANGED")

    policy_problems = []
    if policy.confirmation_status == "UNRESOLVED":
        policy_problems.append("policy confirmation is UNRESOLVED")
    if any(a.producer.evidence_mode != "SYNTHETIC" for a in (graph, snapshot, source, evidence)):
        policy_problems.append("A02 only supports SYNTHETIC inputs")
    for q in graph.payload.questions:
        if q.question_type not in ("free_response", "ordinary_choice") or q.parent_question_id is not None:
            policy_problems.append(q.question_id + ": unsupported combination/seven-choice/parent-child projection")
        if q.question_type == "ordinary_choice" and not (
                policy.confirmation_status == "SYNTHETIC_ASSUMPTION" and
                policy.applicability == "SYNTHETIC_ONLY" and policy.option_grouping == "SEPARATE"):
            policy_problems.append(q.question_id + ": choice needs explicit synthetic SEPARATE assumption")
        if q.question_type == "free_response" and any(f.role == "option" for f in graph.payload.fragments
                                                       if f.fragment_id in q.fragment_ids):
            policy_problems.append(q.question_id + ": free-response option projection unsupported")
        relations = [r for r in graph.payload.answer_relations if r.question_id == q.question_id]
        if not relations or any(r.status != "SELECTED" or not r.selected_fragment_ids for r in relations):
            policy_problems.append(q.question_id + ": selected answer closure required")
        if q.external_refs.platform_question_id is not None and any(
                f.platform_question_id == q.external_refs.platform_question_id for f in snapshot.payload.frames):
            policy_problems.append(q.question_id + ": existing frames need UPDATE_FRAMES; A02 delta unsupported")
    unresolved_policy = policy.confirmation_status == "UNRESOLVED" or (
        policy.option_grouping == "UNRESOLVED" and
        any(q.question_type == "ordinary_choice" for q in graph.payload.questions))
    check("policy", policy_problems, "POLICY_UNRESOLVED" if unresolved_policy else "UNSUPPORTED_LAYOUT")
    check("coverage", [] if complete else ["independent scope/pages/clues are incomplete"], "UNASSIGNED_CONTENT")
    decision = "PASS" if not issues else "EXCEPTION" if policy_problems or not complete else "HOLD"
    result = {"stage": "TARGET", "subject": artifact_ref(snapshot), "graph": artifact_ref(graph),
            "policy": policy_ref(policy), "snapshot": artifact_ref(snapshot), "receipt": None,
            "coverage": coverage, "checks": checks, "issues": issues, "decision": decision,
            "reason": "SYNTHETIC target conditions computed by A02; no algorithm or platform acceptance"}
    if graph.schema_version in ("1.1.0-a-recovery-proposal", "1.4.0-a03-native-proposal"):
        result["recovery_refs"] = []
    return result


def check_target(bundle, graph_ref, snapshot_ref, current_snapshot_ref, policy_reference, config,
                 *, artifact_id, created_at, run_id=None, bridge_context=None):
    bundle = validate_bundle(bundle, bridge_context=bridge_context)
    graph = resolve_artifact(bundle, graph_ref, "QuestionGraph")
    snapshot = resolve_artifact(bundle, snapshot_ref, "PlatformSnapshot")
    current = resolve_artifact(bundle, current_snapshot_ref, "PlatformSnapshot")
    payload = analyze_target(bundle, graph_ref, snapshot_ref, current_snapshot_ref, policy_reference, config, bridge_context=bridge_context)
    report = make_artifact("CheckReport", artifact_id, graph, payload, [graph, snapshot, current],
                           config.version, "a02-targetcheck", created_at, run_id, bridge_context=bridge_context)
    return append_artifacts(bundle, report, bridge_context=bridge_context)

96f465e5690ce62867b4ae7de93ac5f32b480efe blob 13701
"""Finite local recovery orchestration; it never replays an old action."""
import copy
import json
from pathlib import Path
import time

from annotation.runtime.storage.common import Handle, RuntimeFailure, fail, plain, reference, unique, now


def configuration(value):
    from annotation.quality.targetcheck import SimulationConfig
    value = dict(value)
    value["allowed_operations"] = tuple(value.get("allowed_operations", ("CREATE_FRAMES",)))
    return SimulationConfig(**value)


def open_observer(store, registration_id=None):
    from annotation.delivery.mock.persistent import PersistentMockSession
    reg = store.registration(registration_id)
    return PersistentMockSession.open(reg["target_dir"], expected_store_id=store.target_store_id,
        expected_target_session_id=reg["session"], expected_target_key=store.target_key(reg["id"]),
        expected_scope_id=reg["scope"], expected_source_ref=json.loads(reg["source"]),
        bridge_context=store.bridge_for(store.bundle(reg["id"]), reg["package_root"]))


def publish_quality(store, registration_id, projection=None, *, owner_id=None, generation=None):
    """Append complete report consumers or return a full diagnostic scope."""
    if getattr(store, '_user_version', 1) == 4:
        from .native_quality import publish_native_quality
        return publish_native_quality(store, registration_id, projection,
            owner_id=owner_id, generation=generation)
    from .quality import build_quality_report
    from annotation.contracts import validate_recovery_bundle
    reg = store.registration(registration_id)
    with store.effect_gate(store.target_key(reg["id"])).acquire():
        bundle = store._validate(store.bundle(reg["id"]), asset_root=reg["package_root"])
        if projection is None:
            plan = store._plan(reg["id"])
            projection = store.project_plan(reg["id"], plan)
            bundle = store._validate(store.bundle(reg["id"]), asset_root=reg["package_root"])
        expected_path = store.registration(reg["id"])["bundle_path"]
        output = build_quality_report(bundle, target_key=store.target_key(reg["id"]),
            source_ref=json.loads(reg["source"]), receipt_ref=projection.get("receipt_ref"),
            progress_ref=projection.get("progress_ref"), config_version=configuration(json.loads(reg["config"])).version,
            postcheck_id=unique("postcheck"), batch_id=unique("batch"), created_at=now(), asset_root=reg["package_root"])
        if output.postcheck_ref is not None:
            with store.transaction() as connection:
                current = connection.execute("SELECT bundle_path FROM registrations WHERE id=?", (reg["id"],)).fetchone()
                if current["bundle_path"] != expected_path:
                    fail("REPORT_SOURCE_CHANGED", "history changed during report projection")
                for artifact in plain(output.bundle)["artifacts"]:
                    store._artifact(connection, artifact)
                store._save_bundle(connection, reg["id"], plain(output.bundle))
        return output.diagnostic


def claim_current(store, observer, target_key, owner_id=None, *, deadline=None):
    # A dead owner's unexpired lease is a real bound, not permission to steal.
    deadline = min(time.monotonic() + 11, deadline) if deadline is not None else time.monotonic() + 11
    while True:
        if time.monotonic() >= deadline:
            fail("RECOVERY_DEADLINE_EXCEEDED", "owner acquisition deadline exhausted", 6)
        try:
            with store.effect_gate(target_key).acquire(timeout=min(5, max(0, deadline - time.monotonic()))):
                return store.claim(target_key, observer=observer, owner_id=owner_id)
        except RuntimeFailure as error:
            if error.code != "OWNER_BUSY":
                raise
            with store.connect() as connection:
                previous = connection.execute("SELECT pid,lease FROM books WHERE key=?", (store.book_id(target_key),)).fetchone()
            if not previous or store._pid_alive(previous["pid"]) or time.monotonic() >= deadline:
                raise
            time.sleep(min(.1, max(.01, previous["lease"] - time.time())))


def run_plan(store, registration_id=None, *, fault=None, fault_action_index=0, effect_fault=None, read_fault=None,
             owner_id=None, generation=None, config=None):
    from annotation.contracts import validate_recovery_bundle
    from annotation.delivery.mock import compare_action
    from annotation.runtime.storage.common import FaultController
    reg = store.registration(registration_id)
    key = store.target_key(reg["id"])
    observer = open_observer(store, reg["id"])
    if generation is not None:
        with store.connect() as connection:
            store._lease(connection, reg["book"], owner_id, generation)
        claim = Handle(owner_id=owner_id, generation=generation)
        store._observers[reg["book"]] = observer
    else:
        claim = claim_current(store, observer, key, owner_id)
    owner_id, generation = claim["owner_id"], claim["generation"]
    config = configuration(config or json.loads(reg["config"]))
    plan = store._plan(reg["id"])
    completed = []
    from .lease import LeaseKeeper
    keeper = LeaseKeeper(store, key, owner_id, generation).start()
    try:
        store.accept_plan(reg["id"], reference(plan), owner_id=owner_id, generation=generation)
        for index, action in enumerate(plan["payload"]["actions"]):
            keeper.check()
            store.fault = FaultController(fault if index == fault_action_index else None)
            store.renew(key, owner_id=owner_id, generation=generation)
            context = store.load_book_context(key, owner_id=owner_id, generation=generation)
            observer.import_book_context(context, authority=store)
            bundle = store._validate(store.bundle(reg["id"]), asset_root=reg["package_root"])
            prepared = observer.prepare_action(bundle, reference(plan), action["action_id"], config,
                current_snapshot_ref=plan["payload"]["snapshot"], asset_root=reg["package_root"],
                bridge_context=getattr(bundle, "bridge_context", None))
            intent = store.commit_intent(prepared, owner_id=owner_id, generation=generation)
            permit = store.issue_first_dispatch(intent["intent_ref"], owner_id=owner_id, generation=generation,
                plan_ref=reference(plan), action_id=action["action_id"], observation_binding=prepared["observation_binding"])
            observer.dispatch_action(prepared, committed_intent=intent, dispatch_permit=permit,
                authority=store, effect_fault=effect_fault if index == fault_action_index else None)
            observed = observer.observe_target(key, observation_id=unique("execute-observation"),
                read_fault=read_fault if index == fault_action_index else None)
            store.fault("AFTER_READBACK_CAPTURE")
            comparison = compare_action(prepared["action"], prepared["observation"], observed)
            record = store.commit_action_result(intent, prepared, observed, comparison, owner_id=owner_id, generation=generation)
            completed.append(plain(record))
            if record["result"]["outcome"] != "APPLIED":
                break
        status = store.status(reg["id"])
        projection = store.project_plan(reg["id"], plan)
        quality = publish_quality(store, reg["id"], projection, owner_id=owner_id, generation=generation)
        return {"records": completed, "pending_count": status["pending_count"], "paused": status["paused"],
            "progress": projection, "quality": quality, "status": "HOLD_PENDING" if status["paused"] else "FINISHED",
            "target": plain(observer.export_book_context(key))}
    finally:
        # os._exit bypasses this deliberately; lease/OS gate recovery is tested.
        store.fault = FaultController()
        keeper.stop()
        store.release(key, owner_id=owner_id, generation=generation)


def reconcile(store, registration_id=None, *, call_id=None, read_fault=None, owner_id=None,
              max_attempts=3, intent_filter=None):
    from annotation.contracts import validate_recovery_bundle
    from annotation.delivery.reconciler import reconcile_action, make_reconciliation_result
    from .observation import observe_bounded
    if type(max_attempts) is not int or not 1 <= max_attempts <= 3:
        fail("RECONCILE_ATTEMPT_LIMIT", "approved per-call maximum is three", 2)
    reg = store.registration(registration_id)
    key, observer = store.target_key(reg["id"]), open_observer(store, reg["id"])
    call = store.begin_recovery_call(key, call_id)
    deadline = time.monotonic() + min(60, max(0, call["created"] + 60 - time.time()))
    claim = claim_current(store, observer, key, owner_id, deadline=deadline)
    owner, generation = claim["owner_id"], claim["generation"]
    results = []
    attempts_total = 0
    from .lease import LeaseKeeper
    keeper = LeaseKeeper(store, key, owner, generation).start()
    try:
        for iid in json.loads(call["queue"]):
            keeper.check()
            row = store.pending_intent(iid)
            if row["state"] != "PENDING":
                continue
            if intent_filter and iid != intent_filter:
                results.append({"intent_id": iid, "status": "NOT_VISITED", "attempt_count": 0})
                continue
            intent_started = time.monotonic()
            per_intent = min(deadline, intent_started + store.intent_remaining_seconds(call["id"], iid))
            record = {"intent_id": iid, "status": "STILL_UNKNOWN", "classification": "INDETERMINATE", "attempt_count": 0}
            for _ in range(max_attempts):
                keeper.check()
                if time.monotonic() >= per_intent:
                    record["code"] = "RECOVERY_DEADLINE_EXCEEDED"
                    break
                try:
                    number = store.register_attempt(call["id"], iid, owner_id=owner, generation=generation)
                except RuntimeFailure as error:
                    if error.code == "RECONCILE_ATTEMPT_LIMIT":
                        record["code"] = error.code
                        break
                    raise
                store.renew(key, owner_id=owner, generation=generation)
                source = json.loads(Path(row["prepared"]).read_bytes())
                before = store.read_resource(source["intent"]["payload"]["prepared_before"], reg["id"])
                captured_process = observe_bounded(observer, read_fault=read_fault,
                    timeout=min(2, max(0, per_intent - time.monotonic())))
                elapsed = captured_process["read_elapsed_seconds"]
                if not captured_process["ok"] or elapsed > 2 or time.monotonic() >= per_intent:
                    failed = store.fail_attempt(call["id"], iid, number, captured_process, reg["id"])
                    attempts_total += 1
                    record.update(attempt_count=record["attempt_count"] + 1, last_attempt_index=number,
                        code=captured_process.get("code", "TARGET_READ_TIMEOUT"), failure_resource=failed)
                    continue
                observation = captured_process["observation"]
                store._observation_deadlines[observation["observation_id"]] = per_intent
                captured, snapshot = store.capture_observation(observation, observer, reg["id"])
                if snapshot:
                    with store.transaction() as connection:
                        store._append(connection, reg["id"], snapshot)
                comparison = reconcile_action(source["prepared"]["action"], before, observation)
                bundle = store._validate(store.bundle(reg["id"]), asset_root=reg["package_root"])
                with store.connect() as connection:
                    previous = connection.execute("SELECT ref FROM resolutions WHERE intent=? ORDER BY rowid DESC LIMIT 1", (iid,)).fetchone()
                result = make_reconciliation_result(bundle, json.loads(row["ref"]), captured, comparison,
                    obligation_id=row["obligation"], recovery_call_id=call["id"], attempt_index=number,
                    artifact_id=unique("resolution"), original_receipt_ref=json.loads(row["receipt"]) if row["receipt"] else None,
                    previous_resolution_ref=json.loads(previous[0]) if previous else None,
                    observed_snapshot_ref=reference(snapshot) if snapshot else None, bridge_context=getattr(bundle, "bridge_context", None))
                committed = store.commit_reconciliation(result, owner_id=owner, generation=generation)
                attempts_total += 1
                record.update(status=committed["resolution"], classification=committed["classification"],
                    attempt_count=record["attempt_count"] + 1, result_ref=committed["result_ref"], last_attempt_index=number)
                if committed["resolution"] != "STILL_UNKNOWN":
                    break
            record["intent_elapsed_seconds"] = time.monotonic() - intent_started
            results.append(record)
        status = store.status(reg["id"])
        return {"call_id": call["id"], "resolutions": results, "attempt_count": attempts_total,
            "pending_count": status["pending_count"], "paused": status["paused"],
            "deadline_exceeded": any(r.get("code") in ("TARGET_READ_TIMEOUT", "RECOVERY_DEADLINE_EXCEEDED") for r in results),
            "target_effects_during_reconcile": 0, "status": "HOLD_PENDING" if status["paused"] else "RESOLVED"}
    finally:
        keeper.stop()
        store.release(key, owner_id=owner, generation=generation)

