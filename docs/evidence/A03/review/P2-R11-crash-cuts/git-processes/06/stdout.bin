"""Freeze R11 exact authority, source and fixed-input identities; no product calls."""
import hashlib
import json
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / 'docs/evidence/A03/execution/P2-R11-crash-cuts'
BASE = '1c26b4a8eb378af33e57668472d2071e9ea6afff'
WORKFLOW = 'bc0074bc8b852ef14012ee338bf3153ccb1f932b'


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(value if isinstance(value, bytes) else (json.dumps(value, ensure_ascii=False, indent=2) + '\n').encode())


def git(*args):
    return subprocess.check_output(['git', '-c', 'core.longpaths=true', *args], cwd=ROOT)


if __name__ == '__main__':
    assert git('rev-parse', 'HEAD').decode().strip() == BASE
    assert not git('status', '--porcelain', '--untracked-files=no')
    attributes = b'* -text whitespace=trailing-space,space-before-tab,cr-at-eol\n**/stdout.txt -whitespace\n**/stderr.txt -whitespace\n'
    write(OUT / '.gitattributes', attributes)
    write(Path(__file__).parent / '.gitattributes', attributes)
    pins = []
    for name, expected in (
        ('A03-P2-R11-crash-cut-validation.md', 'ef09227381b7b8f2f0e9c9f590b67fb63dd898ca9758cab490e3044c2cc3f500'),
        ('A03-P2-R10-owner-fencing-coordinator-decision.md', None),
        ('A03-runtime-recovery.md', None), ('A03-independent-review.md', None)):
        raw = git('show', WORKFLOW + ':docs/tasks/' + name)
        assert expected is None or sha(raw) == expected, name
        write(OUT / 'inputs' / name, raw)
        pins.append({'workflow': WORKFLOW, 'path': 'docs/tasks/' + name, 'bytes': len(raw), 'sha256': sha(raw)})
    references = []
    names = ['tests/test_a03_p2_r10_owner_fencing.py', 'tests/test_a03_r8_r3_post_hold.py', 'src/annotation/runtime/storage/native.py',
        'src/annotation/runtime/recovery/__init__.py', 'src/annotation/runtime/recovery/native_quality.py',
        'src/annotation/contracts/a03_native/data/profile.json', 'src/annotation/contracts/a03_native/data/adoption.json']
    names += [p.relative_to(ROOT).as_posix() for p in sorted((ROOT / 'tests/fixtures/a03/P2-R8-R3-post-hold').rglob('*')) if p.is_file()]
    for name in names:
        raw = git('show', BASE + ':' + name)
        assert (ROOT / name).read_bytes() == raw, name
        references.append({'base': BASE, 'path': name, 'bytes': len(raw), 'sha256': sha(raw)})
    tree = git('ls-tree', '-r', BASE)
    write(OUT / 'inputs.json', {'base': BASE, 'workflow': WORKFLOW, 'files': pins,
        'unchanged_references_and_copied_fixture_sources': references,
        'base_entries': len(tree.splitlines()), 'base_tree_sha256': sha(tree)})
    print(json.dumps({'pins': len(pins), 'references': len(references), 'base_entries': len(tree.splitlines()), 'product_calls': 0}))

5c5ac41f14ce898a7b9a02a8c44bbb54ce08e073 blob 5401
"""Frozen SQL/resource/process cross-readback; no product imports or calls."""
import hashlib
import json
from pathlib import Path
import sqlite3

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / 'docs/evidence/A03/execution/P2-R11-crash-cuts'
RUN = OUT / 'validation/r11-01'
POINTS = {'F1': 'BEFORE_INTENT_COMMIT', 'F2': 'AFTER_DISPATCH_STARTED', 'F3': 'AFTER_READBACK_CAPTURE', 'F4': 'AFTER_RECEIPT_COMMIT'}


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def load(path):
    return json.loads(path.read_bytes())


def database(path):
    raw = path.read_bytes()
    with sqlite3.connect(path.as_uri() + '?mode=ro&immutable=1', uri=True) as db:
        db.row_factory = sqlite3.Row
        db.execute('PRAGMA query_only=ON')
        tables = [r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")]
        rows = {name: [dict(r) for r in db.execute('SELECT * FROM "' + name.replace('"', '""') + '"')] for name in tables}
        quick = db.execute('PRAGMA quick_check').fetchone()[0]
    assert raw == path.read_bytes()
    return {'path': path.relative_to(ROOT).as_posix(), 'sha256': sha(raw), 'bytes': len(raw), 'quick_check': quick,
        'counts': {k: len(v) for k, v in rows.items()}, 'tables': rows, 'bytes_unchanged_after_read': True}


def ref(a):
    return {k: a[k] for k in ('artifact_id', 'revision', 'kind', 'content_hash')}


if __name__ == '__main__':
    result = {'mode': 'stdlib only; mode=ro&immutable=1; query_only', 'cases': {}}
    for group, point in POINTS.items():
        case = RUN / 'cases' / group
        marker = load(case / 'crash.marker.json')
        started = load(RUN / 'processes' / (group + '-crash') / 'started.json')
        completed = load(RUN / 'processes' / (group + '-crash') / 'completed.json')
        query_start = load(RUN / 'processes' / (group + '-query') / 'started.json')
        query_end = load(RUN / 'processes' / (group + '-query') / 'completed.json')
        assert marker['point'] == point and marker['pid'] == started['pid'] == completed['pid']
        assert completed['exit_code'] == 90 and not completed['alive'] and not completed['timed_out']
        assert query_start['pid'] != completed['pid'] and query_start['started_at_ns'] >= completed['ended_at_ns']
        assert query_end['exit_code'] == 0 and not query_end['alive']
        runtime, target = database(case / 'runtime/runtime.sqlite3'), database(case / 'target/target.sqlite3')
        reg = runtime['tables']['registrations'][0]
        bundle_path = Path(reg['bundle_path'])
        bundle_raw = bundle_path.read_bytes()
        bundle = json.loads(bundle_raw)
        registered = [json.loads(r['ref']) for r in runtime['tables']['artifacts']]
        assert all(ref(a) in registered for a in bundle['artifacts'])
        resources = []
        for row in runtime['tables']['actions']:
            if row['fact']:
                resource = json.loads(row['fact'])
                raw = (Path(reg['package_root']) / resource['path']).read_bytes()
                assert sha(raw) == resource['sha256']
                resources.append({'resource': resource, 'body': json.loads(raw)})
        after_exit = load(RUN / (group + '-after-exit90-before-reopen.json'))
        case_result = load(case / 'result.json')
        if group in ('F1', 'F4'):
            assert runtime['sha256'] == after_exit['runtime']['raw_sha256_after']
            assert target['sha256'] == after_exit['target']['raw_sha256_after']
            assert runtime['counts']['calls'] == runtime['counts']['attempts'] == runtime['counts']['resolutions'] == 0
        else:
            assert runtime['counts']['calls'] == runtime['counts']['attempts'] == runtime['counts']['resolutions'] == 1
            assert case_result['attempt_fact_before'] == case_result['attempt_fact_after']
        assert target['counts']['effects'] == (0 if group in ('F1', 'F2') else 1)
        result['cases'][group] = {'point': point, 'marker': marker, 'crash_started': started, 'crash_completed': completed,
            'new_process_started_after_crash_wait': query_start, 'query_completed': query_end,
            'before_run_runtime_copy': database(case / 'before-run-runtime.sqlite3'),
            'before_run_target_copy': database(case / 'before-run-target.sqlite3'),
            'pre_run_copy_limit': 'Sequential raw copies while own keeper existed, not a cross-database atomic backup.',
            'after_exit_before_reopen': after_exit, 'final_runtime': runtime, 'final_target': target,
            'current_bundle': bundle, 'current_bundle_path': bundle_path.relative_to(ROOT).as_posix(),
            'current_bundle_sha256': sha(bundle_raw), 'facts': resources, 'actual_result': case_result,
            'fault_before_actual_imports': load(case / 'before-run.json')['imports'],
            'crash_exit_import_file_present': (RUN / 'imports' / (group + '-crash.json')).is_file(),
            'query_actual_imports': load(RUN / 'imports' / (group + '-query.json'))}
    with (OUT / 'database-and-boundary-readback.json').open('xb') as stream:
        stream.write((json.dumps(result, ensure_ascii=False, indent=2) + '\n').encode())
    print(json.dumps({'four_actual_exit90': True, 'each_new_query_after_crash_wait': True,
        'F1_F4_reconcile_calls': 0, 'F2_F3_each_reconcile_calls': 1, 'effect_counts': [0, 0, 1, 1],
        'product_calls': 0}))

7c9227f8cfe6a3e18787b99da677daad31732310 blob 5591
"""File-only R11 preservation, process release, manifest and raw Git checking."""
from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / 'docs/evidence/A03/execution/P2-R11-crash-cuts'
BASE = '1c26b4a8eb378af33e57668472d2071e9ea6afff'
DIRS = ('examples/a03/P2-R11-crash-cuts', 'docs/evidence/A03/execution/P2-R11-crash-cuts')
FILES = {'tests/test_a03_p2_r11_crash_cuts.py', 'docs/tasks/A03-P2-R11-crash-cuts-report.md'}


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def git(*args, data=None):
    return subprocess.check_output(['git', '-c', 'core.longpaths=true', *args], cwd=ROOT, input=data)


def write(name, value):
    with (OUT / name).open('xb') as stream:
        stream.write((json.dumps(value, ensure_ascii=False, indent=2) + '\n').encode())


def tree(commit):
    return {line.split('\t', 1)[1]: line.split('\t', 1)[0].split() for line in git('ls-tree', '-r', commit).decode().splitlines()}


def inspect():
    baseline, head = tree(BASE), tree('HEAD')
    assert all(head.get(p) == row for p, row in baseline.items()), 'old raw Git entries changed'
    changed = git('diff', '--name-only', BASE).decode().splitlines()
    assert not set(changed) & set(baseline), 'old worktree file changed'
    assert all(p in FILES or any(p.startswith(d + '/') for d in DIRS) for p in changed), 'out of scope added path'
    pre = json.loads((OUT / 'driver-preregistered.json').read_bytes())
    for row in pre['drivers']:
        raw = (ROOT / row['path']).read_bytes()
        assert len(raw) == row['bytes'] and sha(raw) == row['sha256'], 'executed driver changed'
    indices = [(OUT / 'runs' / name / 'product-source-index.json').read_bytes() for name in ('F1', 'F2', 'F3', 'F4', 'frozen-readback')]
    assert len(set(indices)) == 1
    for row in json.loads(indices[0]):
        raw = (ROOT / row['path']).read_bytes()
        assert len(raw) == row['bytes'] and sha(raw) == row['sha256'], 'executed product source changed'
    report = ROOT / 'docs/tasks/A03-P2-R11-crash-cuts-report.md'
    links = re.findall(r'\[[^\]]+\]\(([^)]+)\)', report.read_text(encoding='utf-8'))
    assert all((report.parent / link.split('#', 1)[0]).resolve().exists() for link in links), 'report link missing'
    return {'all_base_raw_Git_entries_unchanged': len(baseline), 'product_pins_old_tests_old_evidence_unchanged': True,
        'report_links_checked': len(links), 'product_source_index_sha256': sha(indices[0]),
        'all_executed_product_source_indices_identical': True, 'executed_driver_bytes_unchanged': True,
        'product_or_test_execution': False}


def paths():
    result = set(git('diff', '--name-only', BASE).decode().splitlines()) | FILES
    for directory in DIRS:
        result.update(p.relative_to(ROOT).as_posix() for p in (ROOT / directory).rglob('*') if p.is_file())
    result.discard('docs/evidence/A03/execution/P2-R11-crash-cuts/manifest.json')
    return sorted(result)


def seal():
    records = []
    for path in sorted(OUT.rglob('started.json')):
        start = json.loads(path.read_bytes())
        end = json.loads(path.with_name('completed.json').read_bytes())
        assert end['alive'] is False
        records.append({'path': path.relative_to(OUT).as_posix(), 'pid': start['pid'],
            'parent_pid': start.get('parent_pid'), 'exit_code': end['exit_code'], 'alive': False,
            'timed_out': end.get('timed_out', end.get('timeout', False))})
    write('process-release.json', {'recorded_at': datetime.now(timezone.utc).isoformat(),
        'all_recorded_owned_processes_waited_and_ended': True, 'records': records,
        'reruns_product_fixes_delegation_platform_network': 'NONE'})
    audit = inspect()
    write('final-file-audit.json', audit)
    rows = [{'path': p, 'bytes': (ROOT / p).stat().st_size, 'sha256': sha((ROOT / p).read_bytes())} for p in paths()]
    write('manifest.json', {'base': BASE, 'status': 'REVIEW', 'excludes_only': 'this manifest', 'entries': rows})
    print(json.dumps({'entries': len(rows), 'recorded_processes_ended': len(records), **audit,
        'manifest_sha256': sha((OUT / 'manifest.json').read_bytes())}))


def check():
    audit = inspect()
    rows = json.loads((OUT / 'manifest.json').read_bytes())['entries']
    assert set(paths()) == {r['path'] for r in rows}
    indexed = {}
    for line in git('ls-files', '--stage').decode().splitlines():
        metadata, path = line.split('\t', 1)
        mode, blob, stage = metadata.split()
        assert stage == '0'
        indexed[path] = blob
    requests = []
    for row in rows:
        raw = (ROOT / row['path']).read_bytes()
        assert len(raw) == row['bytes'] and sha(raw) == row['sha256'], row['path']
        requests.append(indexed[row['path']])
    result = git('cat-file', '--batch', data=('\n'.join(requests) + '\n').encode())
    offset = 0
    for row in rows:
        end = result.index(b'\n', offset)
        size = int(result[offset:end].split()[2])
        raw = result[end + 1:end + 1 + size]
        assert size == row['bytes'] and sha(raw) == row['sha256'], row['path']
        offset = end + size + 2
    raw = (OUT / 'manifest.json').read_bytes()
    assert git('cat-file', 'blob', indexed['docs/evidence/A03/execution/P2-R11-crash-cuts/manifest.json']) == raw
    print(json.dumps({'raw_Git_blobs_verified_including_manifest': len(rows) + 1, **audit,
        'manifest_sha256': sha(raw)}))


if __name__ == '__main__':
    {'seal': seal, 'check': check}[sys.argv[1]]()

