    "exact adopted version/profile/schema/API/interface pins",
    "typed model/parser and kind-specific factory",
    "full C01/recovery business rules",
    "R3 EvidenceRecord/typed-frame/reference closure",
    "effective-history/head/report rules",
    "private PRE admission and runtime gate ABI",
    "explicit adoption receipt"
  ],
  "new_types_proposed_not_existing": {
    "BridgeSelection": "immutable exact codec/pins/role data; no authority",
    "BridgeContext": "controlled context binding selected codec and approved producer/creation inputs; JSON cannot construct native proof",
    "ValidatedA03Bundle": "full typed 1.3 model plus immutable full package and asset root, original refs preserved",
    "AdmittedPreRun": "actual approved producer/run proof for exact inputs, only quality admission",
    "HistoricalDerivationView": "private read-only recomputation projection; never current eligibility or returned admitted bundle",
    "CurrentWriteEligibility": "runtime-private bounded single-use proof after real registry/fence/current head/pending/counters; not assert_plan_ready result"
  },
  "no_downgrade": "Never change schema_version/content_hash/ref identity to feed 1.3 into 1.1 model or let 1.1 dispatch through new bridge",
  "history_closure": "Full original bundle validated first; retain every UNKNOWN and registration event in admitted history. Historical recomputation uses exact creation-input anchor and complete formal evidence/resource closure; cannot confer current write eligibility.",
  "runtime_split": {
    "native_only": [
      "actual full registration/source/book/scope/key/store/session equality",
      "owner/generation and persistent target fence",
      "full book current head/pending/holds and CAS",
      "persistent read/parent-entry budgets before target reads",
      "intent/permit uniqueness and effect gate",
      "persist fresh snapshot/resources and all consuming refs before commit"
    ],
    "pure_bridge": [
      "exact generated projection/action digest and action facts",
      "complete actual-read binding values and applied prefix consistency",
      "state digest/version equivalence result"
    ],
    "read_budget": "prepare observes a real target read; verification of an already-persisted row/snapshot is local credential checking, not a hidden fourth business read"
  },
  "progress_and_observation_binding": {
    "binding_fields": [
      "plan_ref",
