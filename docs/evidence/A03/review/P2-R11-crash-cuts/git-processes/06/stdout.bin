80ba8d3ae10ea6dc0dba3c8f65f4cfb17189b506 blob 21592
"""Two fresh bounded process cases; product authority is never fabricated."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import sqlite3
import subprocess
import sys
import time
import traceback

import test_a03_r8_r3_post_hold as helper

ROOT = Path(__file__).resolve().parents[1]
SCRIPT = Path(__file__).resolve()
OUT = ROOT / 'docs/evidence/A03/execution/P2-R10-owner-fencing'


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(value if isinstance(value, bytes) else (json.dumps(value, ensure_ascii=False, indent=2) + '\n').encode())


def tick():
    return time.time_ns()


def imports():
    return {'pid': os.getpid(), 'executable': sys.executable, 'modules': {
        name: {'path': str(Path(module.__file__).resolve()), 'sha256': sha(Path(module.__file__).read_bytes())}
        for name, module in list(sys.modules.items()) if getattr(module, '__file__', None)
        and Path(module.__file__).is_file() and (name.startswith('annotation') or name in ('__main__', 'test_a03_r8_r3_post_hold'))}}


def wait_file(path, *, abort=None, seconds=5):
    deadline = time.monotonic() + seconds
    while not path.is_file():
        if abort and abort.is_file():
            raise RuntimeError('parent aborted this owned worker')
        if time.monotonic() >= deadline:
            raise TimeoutError('bounded driver barrier: ' + str(path))
        time.sleep(.01)


def read_db(path, immutable=False):
    if not path.is_file():
        return {'status': 'NOT_CREATED'}
    before = path.read_bytes()
    uri = path.as_uri() + ('?mode=ro&immutable=1' if immutable else '?mode=ro')
    with sqlite3.connect(uri, uri=True, timeout=1) as db:
        db.row_factory = sqlite3.Row
        db.execute('PRAGMA query_only=ON')
        db.execute('BEGIN')
        names = [r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")]
        rows = {name: [dict(r) for r in db.execute('SELECT * FROM "' + name.replace('"', '""') + '"')] for name in names}
        quick = db.execute('PRAGMA quick_check').fetchone()[0]
    after = path.read_bytes()
    if immutable:
        assert before == after
    return {'path': path.relative_to(ROOT).as_posix(), 'raw_sha256_before': sha(before), 'raw_sha256_after': sha(after),
        'bytes': len(after), 'quick_check': quick, 'immutable': immutable,
        'counts': {k: len(v) for k, v in rows.items()}, 'tables': rows}


def state(case, immutable=False):
    runtime = read_db(case / 'runtime/runtime.sqlite3', immutable)
    target = read_db(case / 'target/target.sqlite3', immutable)
    result = {'recorded_at_ns': tick(), 'runtime': runtime, 'target': target,
        'snapshot_limit': 'Each SQLite read transaction is consistent; two databases and raw-byte reads are sequential, not an atomic cross-database snapshot.'}
    if 'tables' in runtime and runtime['tables']['books']:
        result['book'] = runtime['tables']['books'][0]
    if 'tables' in target:
        meta = {r['key']: r['value'] for r in target['tables'].get('meta', [])}
        target_state = json.loads(meta['state']) if 'state' in meta else {}
        result['target_fence'] = {k: target_state.get(k) for k in ('fence_owner_id', 'fence_generation')}
    return result


def bootstrap_claim_case(case):
    from annotation.contracts import artifact_ref, validate_bundle
    from annotation.runtime.storage.native import init_native_state
    from annotation.quality.targetcheck import SimulationConfig
    from annotation.delivery.mock.persistent import PersistentMockSession
    case.mkdir(parents=True, exist_ok=False)
    shutil.copytree(helper.FIXTURE, case / 'input')
    raw = json.loads((case / 'input/initial.json').read_bytes())
    store = init_native_state(case / 'anchor.json', case / 'runtime', expected_ledger_id='ledger-r10-C1', expected_target_store_id='store-r10-C1')
    context = store.bridge_for(raw, case / 'input')
    bundle = validate_bundle(raw, asset_root=case / 'input', bridge_context=context)
    source, evidence, graph, snapshot = bundle.artifacts
    key = {'platform_namespace': 'a03-r10', 'target_id': snapshot.payload.target_id, 'book_id': source.book_id}
    config = SimulationConfig(source.book_id, snapshot.payload.target_id, source.scope_id, {'directory-r8-r3': 'platform-r8-r3'})
    reg = store.register_book(bundle, target_key=key, target_dir=case / 'target', target_session_id='session-r10-C1',
        source_ref=artifact_ref(source), asset_root=case / 'input', config=vars(config), registration_id='registration-r10-C1')
    root = Path(reg.package_root)
    context = store.bridge_for(store.bundle(reg.registration_id), root)
    PersistentMockSession.create(case / 'target', bundle, artifact_ref(snapshot), platform_namespace='a03-r10',
        source_ref=artifact_ref(source), asset_root=root, expected_store_id=store.target_store_id,
        target_session_id='session-r10-C1', bridge_context=context)
    write(case / 'bootstrap.json', {'state': state(case, True), 'imports': imports(), 'claim_calls': 0})


def open_case(case):
    if case.name == 'C1':
        from annotation.runtime.storage.native import open_native_state
        return open_native_state(case / 'anchor.json', expected_ledger_id='ledger-r10-C1', expected_target_store_id='store-r10-C1')
    return helper.open_case(case)


def qualify_old_owner(case):
    from annotation.contracts import artifact_ref, policy_ref
    from annotation.quality.targetcheck import check_target
    from annotation.delivery.planner import create_plan
    from annotation.runtime.storage.common import now
    store, observer, claim, keeper, bundle, pre_ref, actual, admitted, config = helper.setup_pre(case)
    try:
        reg = store.registration()
        graph = next(a for a in bundle.artifacts if a.kind == 'QuestionGraph')
        bundle = check_target(bundle, artifact_ref(graph), actual.snapshot_ref, actual.snapshot_ref, policy_ref(bundle.policies[0]),
            config, artifact_id='target-r10-C2', created_at=now(), bridge_context=bundle.bridge_context)
        target = artifact_ref(bundle.artifacts[-1])
        bundle = create_plan(bundle, artifact_ref(graph), pre_ref, target, actual.snapshot_ref, actual.snapshot_ref,
            policy_ref(bundle.policies[0]), config, artifact_id='plan-r10-C2', created_at=now(), bridge_context=bundle.bridge_context)
        plan = bundle.artifacts[-1]
        assert len(plan.payload.actions) == 1 and plan.payload.actions[0].operation == 'CREATE_FRAMES'
        store.record_native_plan(reg['id'], bundle, artifact_ref(plan), config, owner_id=claim.owner_id, generation=claim.generation)
        qualified = state(case)
        assert all(qualified['runtime']['counts'][name] == 0 for name in ('plans', 'intents', 'permits'))
        assert qualified['target']['counts']['effects'] == 0
        return store, claim, keeper, config, {'plan_ref': artifact_ref(plan), 'pre_ref': pre_ref,
            'native_pre_run_id': admitted.run_id, 'snapshot_ref': actual.snapshot_ref, 'state': qualified, 'imports': imports()}
    except BaseException:
        keeper.stop()
        raise


def c1_worker(case, control, role):
    from annotation.runtime.recovery import open_observer
    from annotation.runtime.recovery.lease import LeaseKeeper
    from annotation.runtime.storage.common import FaultController, plain
    store = open_case(case)
    reg = store.registration()
    observer = open_observer(store, reg['id'])
    key = store.target_key(reg['id'])
    write(control / (role + '-ready.json'), {'pid': os.getpid(), 'instance': store.instance, 'owner_id': store.owner_id, 'at_ns': tick(), 'imports': imports()})
    store.fault = FaultController({'point': 'BEFORE_CLAIM', 'mode': 'barrier',
        'marker': str(control / (role + '-BEFORE_CLAIM.json')), 'release': str(control / 'claim-go.barrier')})
    claim = keeper = None
    try:
        try:
            claim = store.claim(key, observer=observer)
        except Exception as error:
            write(control / (role + '-claim-result.json'), {'outcome': 'REFUSED', 'pid': os.getpid(), 'instance': store.instance,
                'code': getattr(error, 'code', None), 'type': type(error).__name__, 'message': str(error),
                'traceback': traceback.format_exc(), 'at_ns': tick()})
        else:
            keeper = LeaseKeeper(store, key, claim.owner_id, claim.generation).start()
            write(control / (role + '-claim-result.json'), {'outcome': 'ACTIVE', 'pid': os.getpid(), 'instance': store.instance,
                'claim': plain(claim), 'state': state(case), 'at_ns': tick()})
        wait_file(control / (role + '-finish.barrier'), abort=control / 'abort.barrier')
    finally:
        if keeper is not None:
            keeper.stop()
            store.release(key, owner_id=claim.owner_id, generation=claim.generation)
            write(control / (role + '-released.json'), {'pid': os.getpid(), 'claim': plain(claim), 'state': state(case), 'at_ns': tick()})


def c2_worker(case, control, role):
    from annotation.runtime.recovery import open_observer, run_plan
    from annotation.runtime.recovery.lease import LeaseKeeper
    from annotation.runtime.storage.common import plain
    if role == 'A':
        store, claim, keeper, config, qualified = qualify_old_owner(case)
        released = False
        try:
            write(control / 'A-qualified.json', {'pid': os.getpid(), 'instance': store.instance, 'claim': plain(claim), 'at_ns': tick(), **qualified})
            wait_file(control / 'A-release.barrier', abort=control / 'abort.barrier')
            keeper.stop()
            store.release(store.target_key(store.registration()['id']), owner_id=claim.owner_id, generation=claim.generation)
            released = True
            write(control / 'A-released.json', {'pid': os.getpid(), 'old_claim': plain(claim), 'state': state(case), 'at_ns': tick()})
            wait_file(control / 'A-stale-attempt.barrier', abort=control / 'abort.barrier')
            before = state(case)
            assert before['book']['generation'] > claim.generation and before['book']['phase'] == 'ACTIVE'
            try:
                run_plan(store, store.registration()['id'], owner_id=claim.owner_id, generation=claim.generation, config=vars(config))
            except Exception as error:
                frames = traceback.extract_tb(error.__traceback__)
                refusal = {'code': getattr(error, 'code', None), 'type': type(error).__name__, 'message': str(error),
                    'traceback': traceback.format_exc(), 'root_lease_guard_reached': any(f.name == '_lease' for f in frames)}
                assert refusal['root_lease_guard_reached'], 'stale call failed before reaching the lease guard'
            else:
                raise AssertionError('live stale owner reached run_plan without refusal')
            after = state(case)
            for name in ('plans', 'intents', 'permits'):
                assert before['runtime']['counts'][name] == after['runtime']['counts'][name] == 0
            assert after['target']['counts']['effects'] == before['target']['counts']['effects'] == 0
            assert all(before['book'][k] == after['book'][k] for k in ('owner', 'generation', 'phase', 'pid', 'process_id'))
            assert after['target_fence'] == before['target_fence']
            write(control / 'A-stale-result.json', {'pid': os.getpid(), 'old_claim': plain(claim), 'refusal': refusal,
                'before': before, 'after': after, 'at_ns': tick(), 'old_owner_renew_or_release_after_handover': 0})
            wait_file(control / 'A-finish.barrier', abort=control / 'abort.barrier')
        finally:
            keeper.stop()
            if not released:
                store.release(store.target_key(store.registration()['id']), owner_id=claim.owner_id, generation=claim.generation)
    else:
        wait_file(control / 'A-released.json', abort=control / 'abort.barrier')
        store = open_case(case)
        reg = store.registration()
        observer = open_observer(store, reg['id'])
        claim = store.claim(store.target_key(reg['id']), observer=observer)
        keeper = LeaseKeeper(store, store.target_key(reg['id']), claim.owner_id, claim.generation).start()
        try:
            write(control / 'B-active.json', {'pid': os.getpid(), 'instance': store.instance, 'claim': plain(claim), 'state': state(case), 'at_ns': tick(), 'imports': imports()})
            wait_file(control / 'B-finish.barrier', abort=control / 'abort.barrier')
        finally:
            keeper.stop()
            store.release(store.target_key(reg['id']), owner_id=claim.owner_id, generation=claim.generation)
            write(control / 'B-released.json', {'pid': os.getpid(), 'claim': plain(claim), 'state': state(case), 'at_ns': tick()})


class OwnedProcesses:
    def __init__(self, root, group):
        self.root, self.group, self.records = root, group, []

    def start(self, role):
        folder = self.root / 'processes' / (self.group + '-' + role)
        folder.mkdir(parents=True, exist_ok=False)
        argv = [sys.executable, '-X', 'utf8', '-B', str(SCRIPT), self.group, '--worker', role,
            '--output-root', self.root.relative_to(ROOT).as_posix()]
        write(folder / 'preregistered.json', {'argv': argv, 'cwd': str(ROOT), 'timeout_seconds': 45,
            'script_sha256': sha(SCRIPT.read_bytes()), 'inputs_sha256': sha((OUT / 'inputs.json').read_bytes()),
            'helper_sha256': sha(Path(helper.__file__).read_bytes())})
        write(folder / 'script-snapshot.py', SCRIPT.read_bytes())
        stdout, stderr = (folder / 'stdout.txt').open('xb'), (folder / 'stderr.txt').open('xb')
        started = time.monotonic()
        process = subprocess.Popen(argv, cwd=ROOT, stdout=stdout, stderr=stderr)
        write(folder / 'started.json', {'pid': process.pid, 'parent_pid': os.getpid(), 'started_at_ns': tick()})
        self.records.append((role, folder, process, stdout, stderr, started))
        return process

    def finish(self):
        results = []
        for role, folder, process, stdout, stderr, start in self.records:
            timed_out = False
            try:
                code = process.wait(timeout=max(.01, 45 - (time.monotonic() - start)))
            except subprocess.TimeoutExpired:
                timed_out = True
                process.kill()
                code = process.wait(timeout=5)
            stdout.close()
            stderr.close()
            result = {'role': role, 'pid': process.pid, 'exit_code': code, 'timed_out': timed_out,
                'alive': process.poll() is None, 'ended_at_ns': tick(), 'stdout_sha256': sha((folder / 'stdout.txt').read_bytes()),
                'stderr_sha256': sha((folder / 'stderr.txt').read_bytes())}
            write(folder / 'completed.json', result)
            results.append(result)
        return results


def parent(root, group):
    case, control = root / 'cases' / group, root / 'control' / group
    control.mkdir(parents=True, exist_ok=False)
    owned = OwnedProcesses(root, group)
    try:
        if group == 'C1':
            bootstrap_claim_case(case)
            a, b = owned.start('A'), owned.start('B')
            for name in ('A-ready.json', 'B-ready.json', 'A-BEFORE_CLAIM.json', 'B-BEFORE_CLAIM.json'):
                wait_file(control / name)
            assert a.poll() is None and b.poll() is None
            for role, process in (('A', a), ('B', b)):
                assert json.loads((control / (role + '-ready.json')).read_bytes())['pid'] == process.pid
                assert json.loads((control / (role + '-BEFORE_CLAIM.json')).read_bytes())['pid'] == process.pid
            write(control / 'before-common-release.json', {'at_ns': tick(), 'A_pid': a.pid, 'B_pid': b.pid,
                'both_alive': True, 'markers': {n: json.loads((control / n).read_bytes()) for n in ('A-BEFORE_CLAIM.json', 'B-BEFORE_CLAIM.json')}})
            write(control / 'claim-go.barrier', {'at_ns': tick(), 'participants_ready_before_release': True})
            for role in ('A', 'B'):
                wait_file(control / (role + '-claim-result.json'))
            claims = {role: json.loads((control / (role + '-claim-result.json')).read_bytes()) for role in ('A', 'B')}
            winners = [role for role in claims if claims[role]['outcome'] == 'ACTIVE']
            assert len(winners) == 1 and sum(r['outcome'] == 'REFUSED' for r in claims.values()) == 1
            loser = next(r for r in claims.values() if r['outcome'] == 'REFUSED')
            assert 'OWNER_BUSY' in loser['traceback'], 'refusal did not reach the existing busy-owner guard'
            assert a.poll() is None and b.poll() is None, 'winner or loser exited before competition observation'
            observed = state(case)
            winner = claims[winners[0]]
            assert observed['book']['owner'] == winner['claim']['owner_id'] and observed['book']['pid'] == winner['pid']
            assert observed['book']['process_id'] == winner['instance']
            assert observed['book']['phase'] == 'ACTIVE'
            assert observed['book']['lease'] > time.time()
            assert observed['target_fence'] == {'fence_owner_id': winner['claim']['owner_id'], 'fence_generation': winner['claim']['generation']}
            events = [json.loads(r['body'])['event'] for r in observed['runtime']['tables']['events']]
            assert events.count('OWNER_CLAIM_RESERVED') == events.count('OWNER_ACTIVE') == 1
            assert observed['target']['counts']['effects'] == 0
            write(control / 'simultaneous-competition.json', {'at_ns': tick(), 'both_processes_still_alive': True,
                'A_pid': a.pid, 'B_pid': b.pid, 'claims': claims, 'observed_state': observed, 'winner': winners[0]})
            for role in ('A', 'B'):
                write(control / (role + '-finish.barrier'), {'at_ns': tick(), 'competition_observation_saved': True})
        else:
            a = owned.start('A')
            wait_file(control / 'A-qualified.json', seconds=30)
            b = owned.start('B')
            write(control / 'A-release.barrier', {'at_ns': tick()})
            wait_file(control / 'A-released.json')
            wait_file(control / 'B-active.json')
            assert a.poll() is None and b.poll() is None
            qualified = json.loads((control / 'A-qualified.json').read_bytes())
            active = json.loads((control / 'B-active.json').read_bytes())
            assert active['claim']['generation'] > qualified['claim']['generation']
            assert active['state']['target_fence'] == {'fence_owner_id': active['claim']['owner_id'], 'fence_generation': active['claim']['generation']}
            write(control / 'before-stale-call.json', {'at_ns': tick(), 'A_pid': a.pid, 'B_pid': b.pid,
                'both_alive': True, 'old_claim': qualified['claim'], 'new_claim': active['claim'], 'state': state(case)})
            write(control / 'A-stale-attempt.barrier', {'at_ns': tick(), 'B_active_saved_before_old_call': True})
            wait_file(control / 'A-stale-result.json')
            assert a.poll() is None and b.poll() is None
            observed = state(case)
            assert observed['book']['owner'] == active['claim']['owner_id'] and observed['book']['generation'] == active['claim']['generation']
            assert observed['book']['phase'] == 'ACTIVE' and observed['target']['counts']['effects'] == 0
            write(control / 'after-stale-live-observation.json', {'at_ns': tick(), 'both_alive': True, 'state': observed})
            for role in ('A', 'B'):
                write(control / (role + '-finish.barrier'), {'at_ns': tick(), 'stale_call_observation_saved': True})
    except BaseException:
        write(root / (group + '-first-failure-state.json'), {'state': state(case), 'traceback': traceback.format_exc(), 'at_ns': tick()})
        write(control / 'abort.barrier', {'at_ns': tick(), 'no_further_business_calls': True})
        raise
    finally:
        results = owned.finish()
        write(root / (group + '-process-results.json'), results)
    assert all(r['exit_code'] == 0 and not r['timed_out'] for r in results), 'worker failed; retain first outputs'
    final = state(case, True)
    assert final['book']['phase'] == 'RELEASED' and final['book']['owner'] is None
    assert final['target']['counts']['effects'] == 0
    write(root / (group + '-result.json'), {'status': 'REVIEW', 'final_state': final,
        'coverage': 'claim mutual exclusion only' if group == 'C1' else 'live former owner refused after actual normal release/claim',
        'product_modifications': 0, 'field_reset_probe': 'NOT_EXECUTED_NO_RERUN_VARIANT_OR_DELEGATION'})


if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('group', choices=('C1', 'C2'))
    parser.add_argument('--worker', choices=('A', 'B'))
    parser.add_argument('--output-root', default='docs/evidence/A03/execution/P2-R10-owner-fencing/validation/r10-01')
    args = parser.parse_args()
    root = (ROOT / args.output_root).resolve()
    assert root.is_relative_to(OUT)
    if args.worker:
        try:
            (c1_worker if args.group == 'C1' else c2_worker)(root / 'cases' / args.group, root / 'control' / args.group, args.worker)
        finally:
            write(root / 'imports' / (args.group + '-' + args.worker + '.json'), imports())
    else:
        parent(root, args.group)

b5e2a1c7270678faca4b424f6e12c783f06e76c9 blob 15589
"""Four existing crash cuts, each once in fresh dual stores and real processes."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import time

import test_a03_p2_r10_owner_fencing as files

ROOT = Path(__file__).resolve().parents[1]
SCRIPT = Path(__file__).resolve()
OUT = ROOT / 'docs/evidence/A03/execution/P2-R11-crash-cuts'
POINTS = {'F1': 'BEFORE_INTENT_COMMIT', 'F2': 'AFTER_DISPATCH_STARTED',
    'F3': 'AFTER_READBACK_CAPTURE', 'F4': 'AFTER_RECEIPT_COMMIT'}
write, sha = files.write, files.sha


def imports():
    value = files.imports()
    value['modules']['test_a03_p2_r10_owner_fencing'] = {'path': files.__file__, 'sha256': sha(Path(files.__file__).read_bytes())}
    return value


def ref(artifact):
    return {k: artifact[k] for k in ('artifact_id', 'revision', 'kind', 'content_hash')}


def qualify(case):
    from annotation.contracts import artifact_ref, policy_ref
    from annotation.quality.targetcheck import check_target
    from annotation.delivery.planner import create_plan
    from annotation.runtime.storage.common import now, plain
    store, observer, claim, keeper, bundle, pre_ref, actual, admitted, config = files.helper.setup_pre(case)
    try:
        reg = store.registration()
        graph = next(a for a in bundle.artifacts if a.kind == 'QuestionGraph')
        bundle = check_target(bundle, artifact_ref(graph), actual.snapshot_ref, actual.snapshot_ref, policy_ref(bundle.policies[0]),
            config, artifact_id='target-r11-' + case.name, created_at=now(), bridge_context=bundle.bridge_context)
        target = artifact_ref(bundle.artifacts[-1])
        bundle = create_plan(bundle, artifact_ref(graph), pre_ref, target, actual.snapshot_ref, actual.snapshot_ref,
            policy_ref(bundle.policies[0]), config, artifact_id='plan-r11-' + case.name, created_at=now(), bridge_context=bundle.bridge_context)
        plan = bundle.artifacts[-1]
        assert len(plan.payload.actions) == 1 and plan.payload.actions[0].operation == 'CREATE_FRAMES'
        store.record_native_plan(reg['id'], bundle, artifact_ref(plan), config, owner_id=claim.owner_id, generation=claim.generation)
        write(case / 'before-run.json', {'pid': os.getpid(), 'instance': store.instance, 'claim': plain(claim),
            'plan_ref': artifact_ref(plan), 'plan': plain(plan), 'pre_ref': pre_ref, 'snapshot_ref': actual.snapshot_ref,
            'native_pre_run_id': admitted.run_id, 'imports': imports(), 'at_ns': time.time_ns()})
        # Retain actual pre-run bytes; this is a sequential raw copy while the
        # own keeper exists, not a cross-database transactional backup.
        write(case / 'before-run-runtime.sqlite3', store.database.read_bytes())
        write(case / 'before-run-target.sqlite3', (case / 'target/target.sqlite3').read_bytes())
        return store, claim, keeper, config
    except BaseException:
        keeper.stop()
        raise


def crash(case, group):
    from annotation.runtime.recovery import run_plan
    store, claim, keeper, config = qualify(case)
    try:
        run_plan(store, store.registration()['id'], owner_id=claim.owner_id, generation=claim.generation, config=vars(config),
            fault={'point': POINTS[group], 'marker': str(case / 'crash.marker.json')})
        raise AssertionError('existing FaultController did not exit90 at ' + POINTS[group])
    finally:
        # A true os._exit bypasses this and the exit-import writer deliberately.
        keeper.stop()


def bundle_boundary(store, case):
    reg = store.registration()
    bundle = store.bundle(reg['id'])
    snapshot = files.state(case, True)
    registered = [json.loads(row['ref']) for row in snapshot['runtime']['tables']['artifacts']]
    assert all(ref(a) in registered for a in bundle['artifacts'])
    resources = []
    for row in snapshot['runtime']['tables']['actions']:
        if row['fact']:
            resource = json.loads(row['fact'])
            raw = (Path(reg['package_root']) / resource['path']).read_bytes()
            assert sha(raw) == resource['sha256']
            resources.append({'resource': resource, 'body': json.loads(raw)})
    return {'bundle': bundle, 'state': snapshot, 'facts': resources, 'all_current_refs_formally_registered': True}


def query(case, group):
    from annotation.runtime.recovery import reconcile
    store = files.helper.open_case(case)
    reg = store.registration()
    before_status = store.status(reg['id'])
    before = bundle_boundary(store, case)
    write(case / 'reopened-before.json', {'pid': os.getpid(), 'instance': store.instance, 'status': before_status, **before, 'imports': imports()})
    effect_before = before['state']['target']['counts']['effects']
    current = before['bundle']
    plan = next(a for a in current['artifacts'] if a['kind'] == 'ApplyPlan')
    assert ref(plan) == json.loads((case / 'before-run.json').read_bytes())['plan_ref']
    if group == 'F1':
        assert before['state']['runtime']['counts']['plans'] == before['state']['runtime']['counts']['actions'] == 1
        assert before['state']['runtime']['counts']['intents'] == before['state']['runtime']['counts']['permits'] == effect_before == 0
        assert not any(a['kind'] in ('WriteIntent', 'ExecutionReceipt') for a in current['artifacts'])
        result = {'open_status_query_only': True, 'reconcile_calls': 0, 'effect_count': effect_before,
            'attempt_fact': None, 'attempt_fact_note': 'NO_FORMAL_RESULT_NOT_FABRICATED', 'plan_action_reserved_without_intent': True}
    elif group == 'F4':
        assert effect_before == 1
        receipts = [a for a in current['artifacts'] if a['kind'] == 'ExecutionReceipt']
        assert len(receipts) == 1 and len(before['facts']) == 1
        receipt, fact = receipts[0], before['facts'][0]
        intent = before['state']['runtime']['tables']['intents'][0]
        assert json.loads(intent['receipt']) == ref(receipt)
        assert receipt['payload']['plan'] == ref(plan)
        assert receipt['payload']['action_fact_refs'] == [fact['resource']]
        assert fact['body']['plan_ref'] == ref(plan) and fact['body']['intent_ref'] == json.loads(intent['ref'])
        assert fact['body']['action_id'] == plan['payload']['actions'][0]['action_id']
        assert fact['body']['result']['outcome'] == 'APPLIED'
        assert before['state']['runtime']['counts']['resolutions'] == 0
        result = {'open_status_query_only': True, 'reconcile_calls': 0, 'effect_count': effect_before,
            'receipt_ref': ref(receipt), 'fact': fact, 'attempt_fact': fact['body']['result']['attempt_fact']}
    else:
        assert before_status['pending_count'] == 1
        assert before['state']['runtime']['counts']['intents'] == before['state']['runtime']['counts']['permits'] == 1
        assert before['state']['runtime']['tables']['permits'][0]['state'] == 'CONSUMED'
        assert effect_before == (0 if group == 'F2' else 1)
        events = [e['event'] for e in before_status['events']]
        assert 'DISPATCH_STARTED' in events and 'ACTION_RESULT_COMMITTED' not in events
        assert not any(a['kind'] == 'ExecutionReceipt' for a in current['artifacts'])
        projection = store.project_plan(reg['id'])
        assert projection['receipt_ref'] is None and projection['actions'][0]['effective_outcome'] == 'UNKNOWN'
        write(case / 'pre-reconcile-UNKNOWN.json', {'projection': projection, **bundle_boundary(store, case)})
        read_sequences = [json.loads(row['body'])['read_sequence'] for row in before['state']['target']['tables']['observations']]
        max_read_sequence = max(x for x in read_sequences if x is not None)
        reconciled = reconcile(store, reg['id'], call_id='call-r11-' + group, max_attempts=1)
        write(case / 'reconcile-once.json', reconciled)
        expected = 'RESOLVED_NOT_APPLIED' if group == 'F2' else 'RESOLVED_APPLIED'
        assert reconciled['attempt_count'] == 1 and reconciled['resolutions'][0]['status'] == expected
        after = bundle_boundary(store, case)
        assert after['state']['target']['counts']['effects'] == effect_before
        assert after['state']['target']['counts']['observations'] == before['state']['target']['counts']['observations'] + 1
        resolution = next(a for a in after['bundle']['artifacts'] if ref(a) == reconciled['resolutions'][0]['result_ref'])
        payload = resolution['payload']
        intent = before['state']['runtime']['tables']['intents'][0]
        assert payload['plan_ref'] == ref(plan) and payload['intent_ref'] == json.loads(intent['ref'])
        assert payload['action_id'] == plan['payload']['actions'][0]['action_id']
        assert payload['observation'] == ('ABSENT' if group == 'F2' else 'MATCH')
        assert payload['original_receipt_ref'] is None and payload['replay_allowed'] is False
        readback_raw = (Path(reg['package_root']) / payload['readback']['path']).read_bytes()
        assert sha(readback_raw) == payload['readback']['sha256']
        readback = json.loads(readback_raw)
        assert readback['read_status'] == 'OK' and readback['scope_complete'] is True
        assert readback['target_key'] == before_status['target_key']
        assert readback['target_store_id'] == store.target_store_id and readback['target_session_id'] == reg['session']
        assert readback['scope_id'] == reg['scope'] and readback['source_ref'] == json.loads(reg['source'])
        assert readback['observation_id'] == payload['observation_id'] and readback['read_sequence'] == payload['read_sequence'] > max_read_sequence
        observed_snapshot = next(a for a in after['bundle']['artifacts'] if ref(a) == payload['observed_snapshot_ref'])
        assert observed_snapshot['kind'] == 'PlatformSnapshot'
        target_observation = next(json.loads(row['body']) for row in after['state']['target']['tables']['observations']
            if row['observation_id'] == payload['observation_id'])
        assert target_observation['read_sequence'] == payload['read_sequence']
        progress = [a for a in after['bundle']['artifacts'] if a['kind'] == 'ExecutionProgress'][-1]
        assert progress['payload']['actions'][0]['attempt_fact'] == projection['actions'][0]['attempt_fact']
        assert progress['payload']['actions'][0]['attempt_fact'] != 'NOT_ATTEMPTED'
        assert any(a['kind'] == 'ExecutionProgress' and any(r['effective_outcome'] == 'UNKNOWN' for r in a['payload']['actions']) for a in after['bundle']['artifacts'])
        write(case / 'fresh-terminal-readback.json', {'resolution': resolution, 'readback_resource': payload['readback'], 'readback': readback,
            'old_max_target_read_sequence': max_read_sequence, 'actual_new_target_observation': target_observation, 'observed_snapshot': observed_snapshot})
        result = {'reconcile_calls': 1, 'max_attempts': 1, 'effect_count_before_after': [effect_before, effect_before],
            'resolution_ref': ref(resolution), 'resolution': payload['resolution'], 'observation': payload['observation'],
            'attempt_fact_before': projection['actions'][0]['attempt_fact'], 'attempt_fact_after': progress['payload']['actions'][0]['attempt_fact'],
            'new_read_sequence': payload['read_sequence'], 'old_max_read_sequence': max_read_sequence,
            'old_action_replay_calls': 0, 'formal_original_UNKNOWN_retained': True}
    after_status = store.status(reg['id'])
    final = bundle_boundary(store, case)
    result.update(status='REVIEW', group=group, actual_plan_status=final['state']['runtime']['tables']['plans'][0]['status'],
        POST_count=sum(a['kind'] == 'CheckReport' and a['payload']['stage'] == 'POST_APPLY' for a in final['bundle']['artifacts']),
        Batch_count=sum(a['kind'] == 'BatchReport' for a in final['bundle']['artifacts']),
        report_read_count=final['state']['runtime']['counts']['native_report_reads'])
    write(case / 'reopened-after.json', {'pid': os.getpid(), 'status': after_status, **final})
    write(case / 'result.json', result)


def run_phase(root, group, phase):
    folder = root / 'processes' / (group + '-' + phase)
    folder.mkdir(parents=True, exist_ok=False)
    expected = 90 if phase == 'crash' else 0
    argv = [sys.executable, '-X', 'utf8', '-B', str(SCRIPT), group, '--phase', phase, '--output-root', root.relative_to(ROOT).as_posix()]
    write(folder / 'preregistered.json', {'argv': argv, 'cwd': str(ROOT), 'timeout_seconds': 45, 'expected_exit': expected,
        'script_sha256': sha(SCRIPT.read_bytes()), 'inputs_sha256': sha((OUT / 'inputs.json').read_bytes()),
        'helpers': {m.__file__: sha(Path(m.__file__).read_bytes()) for m in (files, files.helper)}})
    write(folder / 'script-snapshot.py', SCRIPT.read_bytes())
    with (folder / 'stdout.txt').open('xb') as stdout, (folder / 'stderr.txt').open('xb') as stderr:
        process = subprocess.Popen(argv, cwd=ROOT, stdout=stdout, stderr=stderr)
        write(folder / 'started.json', {'pid': process.pid, 'parent_pid': os.getpid(), 'started_at_ns': time.time_ns()})
        timed_out = False
        try:
            code = process.wait(timeout=45)
        except subprocess.TimeoutExpired:
            timed_out = True
            process.kill()
            code = process.wait(timeout=5)
    write(folder / 'completed.json', {'pid': process.pid, 'exit_code': code, 'timed_out': timed_out, 'alive': process.poll() is None,
        'ended_at_ns': time.time_ns(), 'stdout_sha256': sha((folder / 'stdout.txt').read_bytes()), 'stderr_sha256': sha((folder / 'stderr.txt').read_bytes())})
    assert code == expected and not timed_out, 'first phase failure: ' + str(folder / 'stderr.txt')
    return process.pid


if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('group', choices=tuple(POINTS))
    parser.add_argument('--phase', choices=('crash', 'query'))
    parser.add_argument('--output-root', default='docs/evidence/A03/execution/P2-R11-crash-cuts/validation/r11-01')
    args = parser.parse_args()
    root = (ROOT / args.output_root).resolve()
    assert root.is_relative_to(OUT)
    case = root / 'cases' / args.group
    if args.phase:
        try:
            (crash if args.phase == 'crash' else query)(case, args.group)
        finally:
            # os._exit does not run this; fault-before imports above are the
            # actual identity evidence for crash workers. No fabricated exits.
            write(root / 'imports' / (args.group + '-' + args.phase + '.json'), imports())
    else:
        try:
            pid = run_phase(root, args.group, 'crash')
            marker = json.loads((case / 'crash.marker.json').read_bytes())
            assert marker['pid'] == pid and marker['point'] == POINTS[args.group]
            frozen = files.state(case, True)
            write(root / (args.group + '-after-exit90-before-reopen.json'), frozen)
            assert frozen['target']['counts']['effects'] == (1 if args.group in ('F3', 'F4') else 0)
            assert frozen['runtime']['counts']['intents'] == (0 if args.group == 'F1' else 1)
            if args.group in ('F2', 'F3'):
                events = [json.loads(row['body'])['event'] for row in frozen['runtime']['tables']['events']]
                assert 'DISPATCH_STARTED' in events and 'ACTION_RESULT_COMMITTED' not in events
            run_phase(root, args.group, 'query')
            write(root / (args.group + '-final-SQL.json'), files.state(case, True))
        except BaseException:
            write(root / (args.group + '-first-failure-SQL.json'), files.state(case, True))
            raise

cdaef1157e25a522ca59d8a1ff80919cfd387577 blob 32139
"""Bounded R8 groups. Drivers arrange inputs/faults; product owns business rows."""
import copy
from dataclasses import replace
import hashlib
import json
import os
from pathlib import Path
import shutil
import sqlite3
import subprocess
import sys
import time
import unittest

ROOT = Path(__file__).resolve().parents[1]
FIXTURE = ROOT / 'tests/fixtures/a03/P2-R8-R3-post-hold'
BASE_EVIDENCE = ROOT / 'docs/evidence/A03/execution/P2-R8-R3-post-hold'
EVIDENCE = BASE_EVIDENCE / 'validation' / os.environ.get('A03_R8_R3_RUN_ID', 'native-r3-01')


def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write((json.dumps(value, ensure_ascii=False, sort_keys=True, indent=2) + '\n').encode('utf-8'))


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def open_case(path):
    from annotation.runtime.storage.native import open_native_state
    return open_native_state(path / 'anchor.json', expected_ledger_id='ledger-r8-r3-' + path.name,
        expected_target_store_id='target-store-r8-r3-' + path.name)


def setup_pre(path):
    from annotation.contracts import artifact_ref, policy_ref
    from annotation.delivery.mock.persistent import PersistentMockSession
    from annotation.quality.targetcheck import SimulationConfig
    from annotation.runtime.storage.native import init_native_state
    from annotation.runtime.recovery.lease import LeaseKeeper
    from annotation.quality.synthetic_precheck import produce_a03_pre_run, admit_a03_pre_run
    from annotation.runtime.storage.common import now
    path.mkdir(parents=True, exist_ok=False)
    source_root = path / 'input'
    shutil.copytree(FIXTURE, source_root)
    raw = json.loads((source_root / 'initial.json').read_bytes())
    store = init_native_state(path / 'anchor.json', path / 'runtime',
        expected_ledger_id='ledger-r8-r3-' + path.name, expected_target_store_id='target-store-r8-r3-' + path.name)
    context = store.bridge_for(raw, source_root)
    from annotation.contracts import validate_bundle
    bundle = validate_bundle(raw, asset_root=source_root, bridge_context=context)
    source, evidence, graph, snapshot = bundle.artifacts
    target_key = {'platform_namespace': 'a03-r8-r3-native', 'target_id': snapshot.payload.target_id, 'book_id': source.book_id}
    config = SimulationConfig(source.book_id, snapshot.payload.target_id, source.scope_id, {'directory-r8-r3': 'platform-r8-r3'})
    reg = store.register_book(bundle, target_key=target_key, target_dir=path / 'target', target_session_id='target-session-r8-r3-' + path.name,
        source_ref=artifact_ref(source), asset_root=source_root, config=vars(config), registration_id='registration-r8-r3-' + path.name)
    registration = store.registration(reg.registration_id)
    package_root = Path(reg.package_root)
    context = store.bridge_for(store.bundle(reg.registration_id), package_root)
    observer = PersistentMockSession.create(path / 'target', bundle, artifact_ref(snapshot), platform_namespace='a03-r8-r3-native',
        source_ref=artifact_ref(source), asset_root=package_root, expected_store_id=store.target_store_id,
        target_session_id=registration['session'], bridge_context=context)
    claim = store.claim(target_key, observer=observer)
    keeper = LeaseKeeper(store, target_key, claim.owner_id, claim.generation).start()
    try:
        actual = store.begin_native_pre(reg.registration_id, owner_id=claim.owner_id, generation=claim.generation, observer=observer)
        bundle, pre_ref = produce_a03_pre_run(actual.bundle, artifact_ref(source), artifact_ref(evidence), artifact_ref(graph), policy_ref(bundle.policies[0]),
            bridge_context=actual.bundle.bridge_context, registered_run_handle=actual.handle,
            actual_snapshot_ref=actual.snapshot_ref, actual_observation=actual.observation, asset_root=package_root,
            artifact_id='pre-r8-r3-' + path.name, created_at=now())
        admitted = admit_a03_pre_run(bundle, pre_ref, bridge_context=bundle.bridge_context,
            registered_run_handle=actual.handle, actual_snapshot_ref=actual.snapshot_ref, asset_root=package_root)
        return store, observer, claim, keeper, bundle, pre_ref, actual, admitted, config
    except BaseException:
        keeper.stop()
        raise


def n1_child(path):
    from annotation.contracts import artifact_ref, policy_ref
    from annotation.quality.targetcheck import check_target
    from annotation.delivery.planner import create_plan
    from annotation.runtime.storage.common import now
    from annotation.runtime.recovery import run_plan
    store, observer, claim, keeper, bundle, pre_ref, actual, admitted, config = setup_pre(path)
    reg = store.registration()
    graph = next(a for a in bundle.artifacts if a.kind == 'QuestionGraph')
    bundle = check_target(bundle, artifact_ref(graph), actual.snapshot_ref, actual.snapshot_ref, policy_ref(bundle.policies[0]), config,
        artifact_id='target-r8-r3-n1', created_at=now(), bridge_context=bundle.bridge_context)
    target_ref = artifact_ref(bundle.artifacts[-1])
    bundle = create_plan(bundle, artifact_ref(graph), pre_ref, target_ref, actual.snapshot_ref, actual.snapshot_ref,
        policy_ref(bundle.policies[0]), config, artifact_id='plan-r8-r3-n1', created_at=now(), bridge_context=bundle.bridge_context)
    plan = bundle.artifacts[-1]
    if len(plan.payload.actions) != 1 or plan.payload.actions[0].operation != 'CREATE_FRAMES':
        raise AssertionError('actual planner did not generate singleton CREATE_FRAMES')
    store.record_native_plan(reg['id'], bundle, artifact_ref(plan), config, owner_id=claim.owner_id, generation=claim.generation)
    write(path / 'before-dispatch.json', {'registration_id': reg['id'], 'pre_ref': pre_ref, 'plan_ref': artifact_ref(plan),
        'snapshot_ref': actual.snapshot_ref, 'run_id': admitted.run_id, 'product_import': __import__('annotation').__path__[0]})
    run_plan(store, reg['id'], owner_id=claim.owner_id, generation=claim.generation, config=vars(config),
        fault={'point': 'after_effect', 'mode': 'barrier', 'marker': str(path / 'effect-committed.barrier.json'), 'release': str(path / 'release.barrier')},
        effect_fault='after_effect_exit')
    raise AssertionError('expected actual child exit after effect')


class R8R3NativeBridgeTests(unittest.TestCase):
    def test_N1(self):
        from annotation.runtime.recovery import reconcile, publish_quality
        from annotation.runtime.storage.common import reference
        case = EVIDENCE / 'cases/N1'
        audit = EVIDENCE / 'processes/n1-child'
        audit.mkdir(parents=True, exist_ok=False)
        argv = [sys.executable, '-X', 'utf8', '-B', str(Path(__file__).resolve()), '--n1-child', str(case)]
        write(audit / 'preregistered.json', {'argv': argv, 'cwd': str(ROOT), 'timeout_seconds': 45,
            'script_sha256': sha(Path(__file__).read_bytes()), 'fixture_sha256': sha((FIXTURE / 'initial.json').read_bytes()),
            'input_index_sha256': sha((BASE_EVIDENCE / 'inputs.json').read_bytes())})
        with (audit / 'script-snapshot.py').open('xb') as stream:
            stream.write(Path(__file__).read_bytes())
        with (audit / 'stdout.txt').open('xb') as stdout, (audit / 'stderr.txt').open('xb') as stderr:
            process = subprocess.Popen(argv, cwd=ROOT, stdout=stdout, stderr=stderr)
            write(audit / 'started.json', {'pid': process.pid, 'parent_pid': os.getpid()})
            started = time.monotonic()
            released = False
            while process.poll() is None and time.monotonic() - started < 45:
                if (case / 'effect-committed.barrier.json').is_file() and not released:
                    # Observe the committed independent target while the child is
                    # held after SQLite commit and before deliberate process exit.
                    with sqlite3.connect((case / 'target/target.sqlite3').as_uri() + '?mode=ro', uri=True) as db:
                        self.assertEqual(db.execute('SELECT count(*) FROM effects').fetchone()[0], 1)
                    (case / 'release.barrier').write_bytes(b'release after independent effect count\n')
                    released = True
                time.sleep(.01)
            timed_out = process.poll() is None
            if timed_out:
                process.kill()
            code = process.wait(timeout=5)
        write(audit / 'completed.json', {'pid': process.pid, 'exit_code': code, 'alive': process.poll() is None,
            'timed_out': timed_out, 'barrier_released': released, 'stdout_sha256': sha((audit / 'stdout.txt').read_bytes()),
            'stderr_sha256': sha((audit / 'stderr.txt').read_bytes())})
        self.assertEqual(code, 87, (audit / 'stderr.txt').read_text(encoding='utf-8'))
        self.assertTrue(released)
        store = open_case(case)
        reg = store.registration()
        pending = store.status(reg['id'])
        self.assertEqual(pending['pending_count'], 1)
        with store.connect() as db:
            self.assertIsNone(db.execute('SELECT receipt FROM intents').fetchone()[0])
        projection = store.project_plan(reg['id'])
        self.assertIsNone(projection['receipt_ref'])
        self.assertEqual(projection['actions'][0]['effective_outcome'], 'UNKNOWN')
        restored = reconcile(store, reg['id'], call_id='call-r8-r3-n1', max_attempts=1)
        self.assertEqual(restored['resolutions'][0]['status'], 'RESOLVED_APPLIED')
        bundle = store.bundle(reg['id'])
        heads = [a for a in bundle['artifacts'] if a['kind'] == 'ReconciliationResult']
        self.assertEqual(len(heads), 1)
        self.assertIsNone(heads[0]['payload']['original_receipt_ref'])
        receipts = [a for a in bundle['artifacts'] if a['kind'] == 'ExecutionReceipt']
        self.assertEqual(len(receipts), 1)
        self.assertEqual(receipts[0]['payload']['results'][0]['intent_ref'], heads[0]['payload']['intent_ref'])
        formal_receipt_ref = reference(receipts[0])
        with store.connect() as db:
            formal_refs = [json.loads(row[0]) for row in db.execute('SELECT ref FROM artifacts')]
            intent_receipt = json.loads(db.execute('SELECT receipt FROM intents').fetchone()[0])
            material_resource = json.loads(db.execute('SELECT fact FROM actions').fetchone()[0])
        self.assertIn(formal_receipt_ref, formal_refs)
        self.assertEqual(intent_receipt, formal_receipt_ref)
        material = store.read_resource(material_resource, reg['id'])
        material_progress = next(a for a in reversed(bundle['artifacts']) if a['kind'] == 'ExecutionProgress')['payload']
        projected = material_progress['actions'][0]
        self.assertEqual(material_progress['plan_ref'], material['plan_ref'])
        self.assertEqual(projected['action_id'], material['action_id'])
        self.assertEqual(projected['intent_ref'], material['intent_ref'])
        self.assertEqual(projected['attempt_fact'], material['result']['attempt_fact'])
        self.assertEqual(projected['attempt_evidence_refs'], material['result']['attempt_evidence_refs'])
        self.assertEqual(projected['result_fact'], material_resource)
        self.assertEqual(projected['receipt_ref'], formal_receipt_ref)
        self.assertEqual(projected['attempt_fact'], 'MAY_HAVE_BEEN_ATTEMPTED')
        report = publish_quality(store, reg['id'])
        self.assertEqual(report['content_check_status'], 'PENDING')
        self.assertEqual(report['submission_status'], 'NOT_SUBMITTED')
        current = store.bundle(reg['id'])
        with store.connect() as db:
            formal_refs = [json.loads(row[0]) for row in db.execute('SELECT ref FROM artifacts')]
        for report_ref in (report['postcheck_ref'], report['batch_ref']):
            self.assertIn(report_ref, formal_refs)
            self.assertTrue(any(reference(a) == report_ref for a in current['artifacts']))
        self.assertTrue(any(reference(a) == projection['progress_ref'] for a in current['artifacts']))
        self.assertIsNone(next(a for a in current['artifacts'] if a['kind'] == 'ReconciliationResult')['payload']['original_receipt_ref'])
        with sqlite3.connect((case / 'target/target.sqlite3').as_uri() + '?mode=ro', uri=True) as db:
            effect_count = db.execute('SELECT count(*) FROM effects').fetchone()[0]
        self.assertEqual(effect_count, 1)
        write(EVIDENCE / 'N1-result.json', {'status': 'REVIEW', 'effect_count': effect_count,
            'original_receipt_ref': None, 'terminal_head': reference(heads[0]), 'quality': report,
            'formal_receipt_ref': formal_receipt_ref, 'SQL_artifacts_current_bundle_intent_receipt_agree': True,
            'material_progress_plan_action_intent_attempt_agree': True, 'attempt_evidence_matches_original_fact': True,
            'UNKNOWN_retained': any(a['kind'] == 'ExecutionProgress' and any(r['effective_outcome'] == 'UNKNOWN' for r in a['payload']['actions']) for a in store.bundle(reg['id'])['artifacts'])})

    def test_N2(self):
        from annotation.runtime.recovery import open_observer, claim_current
        from annotation.runtime.recovery.lease import LeaseKeeper
        from annotation.quality.synthetic_precheck import produce_a03_pre_run, admit_a03_pre_run
        from annotation.contracts import artifact_ref, policy_ref
        from annotation.runtime.storage.common import now, reference
        from test_a03_r8_r3_local import refusal
        case = EVIDENCE / 'cases/N1'
        store = open_case(case)
        reg = store.registration()
        observer = open_observer(store, reg['id'])
        key = store.target_key(reg['id'])
        observer.synthetic_external_add_directory('synthetic-external-N2')
        claim = claim_current(store, observer, key)
        keeper = LeaseKeeper(store, key, claim.owner_id, claim.generation).start()
        records = []
        produced = []
        try:
            hold = store.detect_target_drift(key, owner_id=claim.owner_id, generation=claim.generation, observer=observer)
            with store.connect() as db:
                self.assertIsNotNone(db.execute('SELECT hold FROM books').fetchone()[0])
            old = json.loads((case / 'before-dispatch.json').read_bytes())
            refusal(self, 'NATIVE_ADMITTED_RUN_REQUIRED', lambda: store.native_registry._dispatch('assert_pre',
                store.bridge_for(store.bundle(reg['id']), reg['package_root']), pre_ref=old['pre_ref'],
                snapshot_ref=old['snapshot_ref']), records, 'old_INITIAL_after_registry_reopen')
            refusal(self, 'TARGET_DRIFT_HOLD', lambda: store.begin_native_pre(reg['id'], owner_id=claim.owner_id,
                generation=claim.generation, observer=observer, kind='INITIAL'), records, 'INITIAL_while_held')
            refusal(self, 'TARGET_DRIFT_HOLD', lambda: store.accept_plan(reg['id'], old['plan_ref'],
                owner_id=claim.owner_id, generation=claim.generation), records, 'ordinary_plan_accept_while_held')

            def produce_post(identity):
                actual = store.begin_native_pre(reg['id'], owner_id=claim.owner_id, generation=claim.generation, observer=observer, kind='POST_HOLD')
                source = next(a for a in actual.bundle.artifacts if a.kind == 'SourceBundle')
                evidence = next(a for a in actual.bundle.artifacts if a.kind == 'EvidenceBundle')
                graph = next(a for a in actual.bundle.artifacts if a.kind == 'QuestionGraph')
                bundle, pre_ref = produce_a03_pre_run(actual.bundle, artifact_ref(source), artifact_ref(evidence), artifact_ref(graph), policy_ref(actual.bundle.policies[0]),
                    bridge_context=actual.bundle.bridge_context, registered_run_handle=actual.handle, actual_snapshot_ref=actual.snapshot_ref,
                    actual_observation=actual.observation, asset_root=reg['package_root'], artifact_id=identity, created_at=now())
                proof = admit_a03_pre_run(bundle, pre_ref, bridge_context=bundle.bridge_context,
                    registered_run_handle=actual.handle, actual_snapshot_ref=actual.snapshot_ref, asset_root=reg['package_root'])
                self.assertEqual(proof.pre_ref, pre_ref)
                with store.connect() as db:
                    row = dict(db.execute('SELECT * FROM native_pre_runs WHERE id=?', (proof.run_id,)).fetchone())
                    book = dict(db.execute('SELECT * FROM books WHERE key=?', (reg['book'],)).fetchone())
                binding = json.loads(row['binding'])
                self.assertEqual(row['status'], 'ADMITTED')
                self.assertEqual(binding['context']['hold_id'], hold['hold_id'])
                self.assertEqual(binding['context']['hold_head'], {'sequence': row['head_sequence'], 'hash': row['head_hash']})
                self.assertEqual((book['head_sequence'], book['head_hash']), (row['head_sequence'], row['head_hash']))
                self.assertEqual(json.loads(row['snapshot']), actual.snapshot_ref)
                hold_body = store.read_resource(binding['context']['hold_ref'], reg['id'])
                self.assertEqual(hold_body['payload']['hold_id'], hold['hold_id'])
                produced.append({'run_id': proof.run_id, 'pre_ref': pre_ref, 'snapshot_ref': actual.snapshot_ref,
                    'hold_context': binding['context'], 'owner_id': claim.owner_id, 'generation': claim.generation,
                    'created': row['created'], 'observation_id': actual.observation['observation_id'],
                    'read_sequence': actual.observation['read_sequence']})
                print(json.dumps({'POST_HOLD_admitted': produced[-1]}, sort_keys=True), flush=True)
                return bundle, pre_ref, actual, proof, row

            first = produce_post('pre-r8-r3-post-hold-1')
            keeper.stop()
            store.release(key, owner_id=claim.owner_id, generation=claim.generation)
            claim = claim_current(store, observer, key)
            keeper = LeaseKeeper(store, key, claim.owner_id, claim.generation).start()
            refusal(self, 'OWNER_GENERATION_STALE', lambda: store.native_registry._dispatch('assert_pre',
                first[0].bridge_context, pre_ref=first[1], snapshot_ref=first[2].snapshot_ref), records, 'old_hold_run_after_normal_owner_head_progress')
            second = produce_post('pre-r8-r3-post-hold-2')
            self.assertGreater(second[2].observation['read_sequence'], first[2].observation['read_sequence'])
            refusal(self, 'TARGET_DRIFT_HOLD', lambda: store.accept_plan(reg['id'], old['plan_ref'],
                owner_id=claim.owner_id, generation=claim.generation), records, 'ordinary_write_still_blocked_after_POST_HOLD_admission')
            deadline = second[4]['created'] + 60.1
            print(json.dumps({'real_deadline_wait_until_epoch': deadline, 'clock_or_database_override': False}), flush=True)
            while time.time() < deadline:
                keeper.check()
                time.sleep(min(.25, max(.01, deadline - time.time())))
            refusal(self, 'NATIVE_PRE_DEADLINE_EXCEEDED', lambda: store.native_registry._dispatch('assert_pre',
                second[0].bridge_context, pre_ref=second[1], snapshot_ref=second[2].snapshot_ref), records, 'expired_current_hold_proof')
            with store.connect() as db:
                final_hold = db.execute('SELECT hold FROM books WHERE key=?', (reg['book'],)).fetchone()[0]
                permits = db.execute('SELECT count(*) FROM permits').fetchone()[0]
            with observer._connect() as db:
                effects = db.execute('SELECT count(*) FROM effects').fetchone()[0]
            self.assertEqual(final_hold, hold['hold_id'])
            self.assertEqual((permits, effects), (1, 1))
            write(EVIDENCE / 'N2-result.json', {'status': 'REVIEW', 'same_current_hold_preserved': final_hold,
                'POST_HOLD_runs': produced, 'refusals': records, 'permit_count': permits, 'target_effect_count': effects,
                'hold_clear_calls': 0, 'old_hold_control': 'same hold; old owner/generation and exact whole-book head after normal release/claim',
                'real_expiry_wait': True, 'clock_or_SQL_fabrication': False})
        finally:
            keeper.stop()
            store.release(key, owner_id=claim.owner_id, generation=claim.generation)

    def test_N3(self):
        from annotation.contracts.a03_native import NativeSchemas
        from annotation.contracts.recovery import _node
        from annotation.quality.synthetic_precheck import compare_synthetic_inputs, CHECKS
        from annotation.runtime.storage.common import digest, reference
        original = json.loads((FIXTURE / 'initial.json').read_bytes())
        results = []
        for index, check in enumerate(CHECKS):
            folder = EVIDENCE / 'cases' / ('N3-' + check)
            shutil.copytree(FIXTURE, folder)
            data = copy.deepcopy(original)
            source, evidence, graph, snapshot = data['artifacts']
            if check == 'source_integrity':
                path = folder / 'assets/page.pgm'
                raw = path.read_bytes().replace(b'255 255 255', b'254 255 255', 1)
                path.write_bytes(raw)
                new_sha = sha(raw)
                def images(value):
                    if isinstance(value, dict):
                        if value.get('asset_id') == 'page-r8-r3' and 'sha256' in value:
                            value['sha256'] = new_sha
                        for child in value.values():
                            images(child)
                    elif isinstance(value, list):
                        for child in value:
                            images(child)
                images(data)
            elif check == 'structure':
                evidence['payload']['regions'][0]['box']['bbox'][0] = 5
            elif check == 'answer_matching':
                graph['payload']['answer_relations'][0]['candidate_fragment_ids'].append('fragment-stem-r8-r3')
            elif check == 'coverage':
                clue = copy.deepcopy(evidence['payload']['coverage_clues'][0])
                clue['clue_id'] = 'clue-r8-r3-extra'
                evidence['payload']['coverage_clues'].append(clue)
            else:
                data['policies'][0]['role_mapping']['option'] = 'Q'
            policy = data['policies'][0]
            policy['content_hash'] = digest({k: v for k, v in policy.items() if k != 'content_hash'})
            policy_ref = {k: policy[k] for k in ('policy_id', 'revision', 'content_hash')}
            rewritten = {}
            def refs(value):
                if isinstance(value, dict):
                    if set(value) == {'artifact_id', 'revision', 'kind', 'content_hash'}:
                        return reference(rewritten[value['kind']])
                    return {k: refs(v) for k, v in value.items()}
                if isinstance(value, list):
                    return [refs(v) for v in value]
                return value
            for artifact in data['artifacts']:
                artifact.update(refs(artifact))
                artifact['producer']['policy_versions'] = [policy_ref]
                artifact['content_hash'] = digest({k: v for k, v in artifact.items() if k != 'content_hash'})
                rewritten[artifact['kind']] = artifact
            NativeSchemas().check(data)
            actual = compare_synthetic_inputs(_node(data), reference(data['artifacts'][0]), reference(data['artifacts'][1]), reference(data['artifacts'][2]), policy_ref, asset_root=folder)
            self.assertEqual(actual[check], 'FAIL')
            self.assertEqual([k for k, v in actual.items() if v == 'FAIL'], [check])
            results.append({'control': check, 'comparison': actual, 'admitted': False, 'effects': 0})
        write(EVIDENCE / 'N3-result.json', results)

    def test_N4(self):
        from annotation.quality.synthetic_precheck import admit_a03_pre_run
        from test_a03_r8_r3_local import refusal
        states = [setup_pre(EVIDENCE / 'cases' / name) for name in ('N4-a', 'N4-b')]
        codes = []
        try:
            a, b = states
            store, observer, claim, keeper, bundle, pre_ref, actual, proof, config = a
            for label, handle in (('missing_run', {}), ('serialized_run', {'run_id': proof.run_id}), ('foreign_run', b[6].handle)):
                refusal(self, 'NATIVE_RUN_HANDLE_REQUIRED', lambda handle=handle: admit_a03_pre_run(bundle, pre_ref,
                    bridge_context=bundle.bridge_context, registered_run_handle=handle,
                    actual_snapshot_ref=actual.snapshot_ref, asset_root=observer.asset_root), codes, label)
            refusal(self, 'NATIVE_PRE_OBSERVATION_FOREIGN', lambda: store.native_registry._dispatch('producer_binding',
                bundle.bridge_context, handle=actual.handle, snapshot_ref=actual.snapshot_ref, observation=b[6].observation), codes, 'foreign_observation')
            for state in states:
                with state[0].connect() as db:
                    self.assertEqual(db.execute('SELECT count(*) FROM permits').fetchone()[0], 0)
                with state[1]._connect() as db:
                    self.assertEqual(db.execute('SELECT count(*) FROM effects').fetchone()[0], 0)
            write(EVIDENCE / 'N4-result.json', {'refusals': codes, 'permit_count': 0, 'effect_count': 0})
        finally:
            for store, observer, claim, keeper, *_ in states:
                keeper.stop()
                store.release(observer.target_key, owner_id=claim.owner_id, generation=claim.generation)

    def test_N5(self):
        from annotation.contracts import validate_bundle
        from annotation.contracts.a03_native import BridgeContext, require_context, select_native_codec
        from annotation.contracts.a03_bridge import select_static_codec, open_static_context, validate_static_bundle
        from test_a03_r8_r3_local import refusal
        codes = []
        initial = json.loads((FIXTURE / 'initial.json').read_bytes())
        refusal(self, 'NATIVE_CONTEXT_REQUIRED', lambda: validate_bundle(initial, asset_root=FIXTURE), codes, 'native_without_context')
        selection = select_native_codec()
        refusal(self, 'NATIVE_CONTEXT_REQUIRED', lambda: require_context(BridgeContext(replace(selection, api_sha256='0' * 64), FIXTURE, sha(b''), (), {}, '')), codes, 'unknown_pins_unissued_context')
        refusal(self, 'NATIVE_CONTEXT_REQUIRED', lambda: require_context(select_static_codec()), codes, 'R7_selection_is_not_native_authority')
        static_root = ROOT / 'examples/a03/P2-R2-proposal/candidate-final'
        static = validate_static_bundle(json.loads((static_root / 'converted-initial.json').read_bytes()), context=open_static_context(asset_root=static_root))
        refusal(self, 'NATIVE_CONTEXT_REQUIRED', lambda: require_context(static), codes, 'R7_validated_static_object_is_not_native_authority')
        legacy_raw = (static_root / 'original/new-authored-initial-a.json').read_bytes()
        legacy_history = json.loads(legacy_raw)
        self.assertEqual(legacy_history['format_version'], 'a03-exchange-1')
        refusal(self, 'NATIVE_CONTEXT_REQUIRED', lambda: require_context(legacy_history), codes, 'actual_1_1_historical_JSON_is_not_native_authority')
        for version in ('a03-exchange-1', 'a03-exchange-3-proposal'):
            old = {'format_version': version, 'role': 'STATIC_INSPECTION'}
            refusal(self, 'NATIVE_CONTEXT_REQUIRED', lambda old=old: require_context(old), codes, 'old_role_descriptor_' + version)
        write(EVIDENCE / 'N5-result.json', {'refusals': codes, 'legacy_1_1_read_sha256': sha(legacy_raw),
            'R7_static_validated': True, 'legacy_1_1_archive_validator_acceptance_claim': False})

    def test_N6(self):
        from annotation.contracts.recovery import _node
        from annotation.delivery.planner import verify_generated_plan
        from annotation.runtime.recovery import configuration
        from test_a03_r8_r3_local import refusal
        codes = []
        store = open_case(EVIDENCE / 'cases/N1')
        reg = store.registration()
        bundle = store._validate(store.bundle(reg['id']), asset_root=reg['package_root'])
        plan = next(a for a in bundle.artifacts if a.kind == 'ApplyPlan')
        verify_generated_plan(bundle, plan, plan.payload.snapshot, configuration(json.loads(reg['config'])), bridge_context=bundle.bridge_context)
        self.assertTrue(any(a.kind == 'ExecutionProgress' and any(r.effective_outcome == 'UNKNOWN' for r in a.payload.actions) for a in bundle.artifacts))
        with store.connect() as db:
            anchor = db.execute('SELECT * FROM native_creation_anchors').fetchone()
        missing = json.loads(Path(anchor['input_path']).read_bytes())
        missing['evidence'] = missing['evidence'][:-1]
        refusal(self, 'EVIDENCE_ID_MISSING', lambda: store.native_registry.context(missing, reg['package_root'], historical=True), codes, 'anchor_missing_formal_PRE_run_evidence')
        write(EVIDENCE / 'N6-result.json', {'same_plan_recomputed_from_creation_anchor': True,
            'full_current_history_keeps_UNKNOWN': True, 'refusals': codes})

    def test_N7(self):
        from annotation.runtime.storage import open_state
        from annotation.runtime.storage.native import init_native_state, open_native_state
        from annotation.delivery.mock.persistent import PersistentMockSession
        from annotation.runtime.storage.native_target import NativeTargetSession
        from annotation.runtime.recovery import open_observer
        from test_a03_r8_r3_local import refusal
        codes = []
        path = EVIDENCE / 'cases/N7'
        path.mkdir(parents=True, exist_ok=False)
        store = init_native_state(path / 'anchor.json', path / 'runtime', expected_ledger_id='ledger-N7', expected_target_store_id='store-N7')
        reopened = open_native_state(path / 'anchor.json', expected_ledger_id='ledger-N7', expected_target_store_id='store-N7')
        self.assertEqual(store.anchor, reopened.anchor)
        refusal(self, 'STATE_DIRECTORY_IDENTITY_MISMATCH', lambda: open_state(path / 'anchor.json',
            expected_ledger_id='ledger-N7', expected_target_store_id='store-N7'), codes, 'old_runtime_entry_rejects_native_database')
        n1_store = open_case(EVIDENCE / 'cases/N1')
        n1_reg = n1_store.registration()
        target = open_observer(n1_store, n1_reg['id'])
        self.assertEqual(target.native_metadata(), target.descriptor['native_adoption'])
        refusal(self, 'TARGET_STORE_VERSION_UNSUPPORTED', lambda: PersistentMockSession.open(n1_reg['target_dir'],
            expected_store_id=n1_store.target_store_id, expected_target_session_id=n1_reg['session'],
            expected_target_key=n1_store.target_key(n1_reg['id']), expected_scope_id=n1_reg['scope'],
            expected_source_ref=json.loads(n1_reg['source'])), codes, 'old_target_entry_rejects_native_database')
        incomplete = EVIDENCE / 'cases/N7-incomplete'
        incomplete.mkdir(parents=True, exist_ok=False)
        def stop_before_completion():
            raise RuntimeError('controlled interruption before native formal completion')
        with self.assertRaises(RuntimeError):
            init_native_state(incomplete / 'anchor.json', incomplete / 'runtime', expected_ledger_id='incomplete', expected_target_store_id='incomplete', before_completion=stop_before_completion)
        refusal(self, 'STATE_DIRECTORY_IDENTITY_MISMATCH', lambda: open_native_state(incomplete / 'anchor.json',
            expected_ledger_id='incomplete', expected_target_store_id='incomplete'), codes, 'incomplete_native_initialization_rejected')
        write(EVIDENCE / 'N7-result.json', {'runtime_reopened_same_identity': True, 'target_reopened_same_adoption': True,
            'old_database_migration': 'NOT_IMPLEMENTED_BLOCKED', 'refusals': codes})


if __name__ == '__main__':
    if len(sys.argv) > 1 and sys.argv[1] == '--n1-child':
        n1_child(Path(sys.argv[2]))
    else:
        unittest.main(failfast=True)

