                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "receipt": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ArtifactRef"
                    },
                    {
                      "type": "null"
                    }
                  ]
