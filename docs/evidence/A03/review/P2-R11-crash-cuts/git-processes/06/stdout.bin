                        "kind": {
                          "const": "POST_HOLD"
                        },
                        "hold_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "hold_head": {
                          "type": "object",
                          "properties": {
                            "sequence": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "hash": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            }
                          },
                          "required": [
                            "sequence",
                            "hash"
                          ],
                          "additionalProperties": false
                        },
                        "hold_ref": {
                          "type": "object",
                          "properties": {
                            "path": {
                              "type": "string",
                              "minLength": 1
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            },
                            "media_type": {
                              "type": "string",
                              "minLength": 1
                            },
                            "origin": {
                              "const": "SYNTHETIC"
                            }
                          },
                          "required": [
