              "type": "string"
            },
            "content_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Content Hash",
              "type": "string"
            }
          },
          "required": [
            "artifact_id",
            "revision",
            "kind",
            "content_hash"
          ],
          "title": "ArtifactRef",
          "type": "object"
        },
        "execution_mode": {
          "const": "SIMULATED"
        },
        "journal_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "journal_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "journal_head_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "owner_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "intent_committed_at": {
          "type": "string",
          "format": "date-time"
        },
        "plan_dependency_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "plan_ref",
        "action_id",
        "action_digest",
        "target_key",
        "question_id",
        "source_entity_ids",
        "target_session_id",
        "source_ref",
        "prepared_before",
        "before_snapshot_ref",
        "execution_mode",
        "journal_id",
        "journal_sequence",
        "journal_head_hash",
        "owner_id",
        "generation",
        "intent_committed_at",
        "plan_dependency_digest"
      ],
      "$comment": "NOT IMPLEMENTED. H=SHA256 of UTF8 canonical JSON(sort_keys=True, ensure_ascii=False, separators=(',', ':'), allow_nan=False). action_digest=H(complete Action). plan_dependency_digest=H({plan_dependencies_digest:H({graph,precheck,targetcheck,snapshot,policy,execution_mode,session_mode,required_capabilities}),source_ref,target_session_id,comparator_version:'a02-facts-1',prepared_before_sha256}). journal_head_hash is the transaction predecessor hash, not a self-inclusive head. Only a current-library actual durable local transaction gives a WriteIntent qualification."
    },
