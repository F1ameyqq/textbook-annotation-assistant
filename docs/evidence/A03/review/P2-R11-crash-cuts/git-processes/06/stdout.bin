                  "items": {
                    "$ref": "#/$defs/CheckResult"
                  },
                  "minItems": 1,
                  "title": "Checks",
                  "type": "array"
                },
                "issues": {
                  "items": {
                    "$ref": "#/$defs/Issue"
                  },
                  "title": "Issues",
                  "type": "array"
                },
                "decision": {
                  "enum": [
                    "PASS",
                    "RETRY",
                    "EXCEPTION",
                    "HOLD"
                  ],
                  "title": "Decision",
                  "type": "string"
                },
                "reason": {
                  "minLength": 1,
                  "title": "Reason",
                  "type": "string"
                },
                "recovery_refs": {
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "artifact_id": {
                        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
