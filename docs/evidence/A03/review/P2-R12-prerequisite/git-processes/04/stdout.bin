    "CheckPayload": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "PRE_APPLY",
            "TARGET",
            "POST_APPLY"
          ],
          "title": "Stage",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "graph": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "policy": {
          "$ref": "#/$defs/PolicyRef"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "decision": {
          "enum": [
            "PASS",
            "RETRY",
            "EXCEPTION",
            "HOLD"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "recovery_refs": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "properties": {
              "artifact_id": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
                "title": "Artifact Id",
                "type": "string"
              },
              "revision": {
                "exclusiveMinimum": 0,
                "title": "Revision",
                "type": "integer"
              },
              "kind": {
                "const": "ReconciliationResult",
                "type": "string"
              },
              "content_hash": {
                "pattern": "^[0-9a-f]{64}$",
                "title": "Content Hash",
                "type": "string"
              }
            },
            "required": [
              "artifact_id",
              "revision",
              "kind",
              "content_hash"
            ],
            "title": "ArtifactRef",
            "type": "object"
          },
          "minItems": 0
        }
      },
      "required": [
        "stage",
        "subject",
        "graph",
        "policy",
        "snapshot",
        "receipt",
        "coverage",
        "checks",
        "issues",
        "decision",
        "reason",
        "recovery_refs"
      ],
      "title": "CheckPayload",
      "type": "object"
    },
