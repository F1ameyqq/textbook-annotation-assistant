"""Exact raw authority and minimal source export for static R12 prerequisite review."""
import ast
import hashlib
import json
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / 'docs/evidence/A03/execution/P2-R12-inconclusive-readback'
BASE = 'cc5966dc58c62017a27266c40ca0cedc5c68485c'
WORKFLOW = '7593f880ebec191ed55e03b2d3893d68b00ab0ca'


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def git(*args):
    return subprocess.check_output(['git', '-c', 'core.longpaths=true', *args], cwd=ROOT)


def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(value if isinstance(value, bytes) else (json.dumps(value, ensure_ascii=False, indent=2) + '\n').encode())


if __name__ == '__main__':
    assert git('rev-parse', 'HEAD').decode().strip() == BASE
    assert not git('status', '--porcelain', '--untracked-files=no')
    attributes = b'* -text whitespace=trailing-space,space-before-tab,cr-at-eol\n**/stdout.txt -whitespace\n**/stderr.txt -whitespace\n'
    write(OUT / '.gitattributes', attributes)
    write(Path(__file__).parent / '.gitattributes', attributes)
    inputs = []
    for name, expected in (
        ('A03-P2-R12-inconclusive-readback-validation.md', '15c4f65a698a86ffeb0bbde8a6c97465905bcb0fb5f9bfc1856aec522161f1df'),
        ('A03-P2-R11-crash-cuts-coordinator-decision.md', None),
        ('A03-runtime-recovery.md', None), ('A03-independent-review.md', None)):
        path = 'docs/tasks/' + name
        raw = git('show', WORKFLOW + ':' + path)
        assert expected is None or sha(raw) == expected
        write(OUT / 'inputs' / name, raw)
        inputs.append({'workflow': WORKFLOW, 'path': path, 'bytes': len(raw), 'sha256': sha(raw)})
    sources = []
    for path in ('src/annotation/runtime/storage/__init__.py', 'src/annotation/runtime/storage/native.py',
        'src/annotation/runtime/recovery/__init__.py', 'src/annotation/delivery/mock/persistent.py',
        'src/annotation/delivery/planner/__init__.py', 'src/annotation/contracts/a03_native/__init__.py',
        'src/annotation/contracts/a03_native/_closure.py', 'src/annotation/contracts/a03_native/data/schemas/exchange.json',
        'src/annotation/contracts/a03_native/data/profile.json', 'src/annotation/contracts/a03_native/data/adoption.json'):
        raw, actual = git('show', BASE + ':' + path), (ROOT / path).read_bytes()
        write(OUT / 'inputs/base' / path, raw)
        sources.append({'base': BASE, 'path': path, 'bytes': len(raw), 'raw_Git_sha256': sha(raw),
            'worktree_bytes': len(actual), 'worktree_sha256': sha(actual), 'raw_bytes_identical': raw == actual})
    tree = git('ls-tree', '-r', BASE)
    write(OUT / 'inputs.json', {'base': BASE, 'workflow': WORKFLOW, 'files': inputs, 'sources': sources,
        'base_entries': len(tree.splitlines()), 'base_tree_sha256': sha(tree)})
    drivers = []
    paths = [ROOT / 'tests/test_a03_p2_r12_inconclusive_readback.py'] + list(Path(__file__).parent.glob('*.py'))
    for path in paths:
        raw = path.read_bytes()
        text = raw.decode('utf-8', errors='strict')
        compile(text, str(path), 'exec')
        ast.parse(text)
        drivers.append({'path': path.relative_to(ROOT).as_posix(), 'bytes': len(raw), 'sha256': sha(raw)})
    write(OUT / 'driver-preregistered.json', {'utf8_strict_compile_checked': True, 'drivers': drivers,
        'functional_calls': 0, 'scope': 'Static prerequisite stop only; no U1-U5 functional driver is run.',
        'expected_static_finding': 'Legacy UNKNOWN diagnostic POST fields conflict with current native POST schema.'})
    print(json.dumps({'authority_files': len(inputs), 'source_files': len(sources), 'base_entries': len(tree.splitlines()), 'product_calls': 0}))

1b63dfd7c210587c41302530955558a52cbbde0d blob 5680
"""File-only R12 preservation, process release, manifest and raw Git checking."""
from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[3]
OUT = ROOT / 'docs/evidence/A03/execution/P2-R12-inconclusive-readback'
BASE = 'cc5966dc58c62017a27266c40ca0cedc5c68485c'
DIRS = ('examples/a03/P2-R12-inconclusive-readback', 'docs/evidence/A03/execution/P2-R12-inconclusive-readback')
FILES = {'tests/test_a03_p2_r12_inconclusive_readback.py', 'docs/tasks/A03-P2-R12-inconclusive-readback-report.md'}


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def git(*args, data=None):
    return subprocess.check_output(['git', '-c', 'core.longpaths=true', *args], cwd=ROOT, input=data)


def write(name, value):
    with (OUT / name).open('xb') as stream:
        stream.write((json.dumps(value, ensure_ascii=False, indent=2) + '\n').encode())


def tree(commit):
    return {line.split('\t', 1)[1]: line.split('\t', 1)[0].split() for line in git('ls-tree', '-r', commit).decode().splitlines()}


def inspect():
    baseline, head = tree(BASE), tree('HEAD')
    assert all(head.get(p) == row for p, row in baseline.items()), 'old raw Git entries changed'
    changed = git('diff', '--name-only', BASE).decode().splitlines()
    assert not set(changed) & set(baseline), 'old worktree file changed'
    assert all(p in FILES or any(p.startswith(d + '/') for d in DIRS) for p in changed), 'out of scope added path'
    pre = json.loads((OUT / 'driver-preregistered.json').read_bytes())
    for row in pre['drivers']:
        raw = (ROOT / row['path']).read_bytes()
        assert len(raw) == row['bytes'] and sha(raw) == row['sha256'], 'executed driver changed'
    indices = [(OUT / 'runs' / name / 'product-source-index.json').read_bytes() for name in ('static-prerequisite',)]
    assert len(set(indices)) == 1
    for row in json.loads(indices[0]):
        raw = (ROOT / row['path']).read_bytes()
        assert len(raw) == row['bytes'] and sha(raw) == row['sha256'], 'executed product source changed'
    report = ROOT / 'docs/tasks/A03-P2-R12-inconclusive-readback-report.md'
    links = re.findall(r'\[[^\]]+\]\(([^)]+)\)', report.read_text(encoding='utf-8'))
    assert all((report.parent / link.split('#', 1)[0]).resolve().exists() for link in links), 'report link missing'
    return {'all_base_raw_Git_entries_unchanged': len(baseline), 'product_pins_old_tests_old_evidence_unchanged': True,
        'report_links_checked': len(links), 'product_source_index_sha256': sha(indices[0]),
        'all_executed_product_source_indices_identical': True, 'executed_driver_bytes_unchanged': True,
        'product_or_test_execution': False}


def paths():
    result = set(git('diff', '--name-only', BASE).decode().splitlines()) | FILES
    for directory in DIRS:
        result.update(p.relative_to(ROOT).as_posix() for p in (ROOT / directory).rglob('*') if p.is_file())
    result.discard('docs/evidence/A03/execution/P2-R12-inconclusive-readback/manifest.json')
    return sorted(result)


def seal():
    records = []
    for path in sorted(OUT.rglob('started.json')):
        start = json.loads(path.read_bytes())
        end = json.loads(path.with_name('completed.json').read_bytes())
        assert end['alive'] is False
        records.append({'path': path.relative_to(OUT).as_posix(), 'pid': start['pid'],
            'parent_pid': start.get('parent_pid'), 'exit_code': end['exit_code'], 'alive': False,
            'timed_out': end.get('timed_out', end.get('timeout', False))})
    write('process-release.json', {'recorded_at': datetime.now(timezone.utc).isoformat(),
        'all_recorded_owned_processes_waited_and_ended': True, 'records': records,
        'reruns_product_fixes_delegation_platform_network': 'NONE'})
    audit = inspect()
    write('final-file-audit.json', audit)
    rows = [{'path': p, 'bytes': (ROOT / p).stat().st_size, 'sha256': sha((ROOT / p).read_bytes())} for p in paths()]
    write('manifest.json', {'base': BASE, 'status': 'REVIEW_PREPARATION_BLOCKED', 'excludes_only': 'this manifest', 'entries': rows})
    print(json.dumps({'entries': len(rows), 'recorded_processes_ended': len(records), **audit,
        'manifest_sha256': sha((OUT / 'manifest.json').read_bytes())}))


def check():
    audit = inspect()
    rows = json.loads((OUT / 'manifest.json').read_bytes())['entries']
    assert set(paths()) == {r['path'] for r in rows}
    indexed = {}
    for line in git('ls-files', '--stage').decode().splitlines():
        metadata, path = line.split('\t', 1)
        mode, blob, stage = metadata.split()
        assert stage == '0'
        indexed[path] = blob
    requests = []
    for row in rows:
        raw = (ROOT / row['path']).read_bytes()
        assert len(raw) == row['bytes'] and sha(raw) == row['sha256'], row['path']
        requests.append(indexed[row['path']])
    result = git('cat-file', '--batch', data=('\n'.join(requests) + '\n').encode())
    offset = 0
    for row in rows:
        end = result.index(b'\n', offset)
        size = int(result[offset:end].split()[2])
        raw = result[end + 1:end + 1 + size]
        assert size == row['bytes'] and sha(raw) == row['sha256'], row['path']
        offset = end + size + 2
    raw = (OUT / 'manifest.json').read_bytes()
    assert git('cat-file', 'blob', indexed['docs/evidence/A03/execution/P2-R12-inconclusive-readback/manifest.json']) == raw
    print(json.dumps({'raw_Git_blobs_verified_including_manifest': len(rows) + 1, **audit,
        'manifest_sha256': sha(raw)}))


if __name__ == '__main__':
    {'seal': seal, 'check': check}[sys.argv[1]]()

