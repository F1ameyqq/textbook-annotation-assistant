        "artifact_id",
        "revision",
        "kind",
        "run_id",
        "book_id",
        "scope_id",
        "input_refs",
        "producer",
        "content_hash",
        "created_at",
        "payload"
      ],
      "title": "BatchReport",
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
