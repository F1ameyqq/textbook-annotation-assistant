          "type": "array"
        },
        "directories": {
          "items": {
            "$ref": "#/$defs/Directory"
          },
          "minItems": 1,
          "title": "Directories",
          "type": "array"
        },
        "pages_expected": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Pages Expected",
          "type": "array"
        },
        "pages_acquired": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
