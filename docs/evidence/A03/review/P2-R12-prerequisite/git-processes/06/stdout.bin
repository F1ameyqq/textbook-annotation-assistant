      "properties": {
        "schema_version": {
          "const": "1.1.0-a-recovery-proposal",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "kind": {
          "const": "QuestionGraph",
          "title": "Kind",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "book_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Book Id",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Scope Id",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/GraphPayload"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "revision",
        "kind",
        "run_id",
        "book_id",
        "scope_id",
        "input_refs",
        "producer",
        "content_hash",
        "created_at",
        "payload"
      ],
      "title": "QuestionGraph",
      "type": "object"
    },
    "QuestionStatus": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Question Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "PENDING",
            "VERIFIED",
            "EXCEPTION",
            "SKIPPED",
            "UNKNOWN"
          ],
          "title": "State",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "state",
        "reason"
      ],
      "title": "QuestionStatus",
      "type": "object"
    },
    "ReceiptPayload": {
      "additionalProperties": false,
      "properties": {
        "plan": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "execution_mode": {
          "enum": [
            "SIMULATED",
            "PLATFORM_OBSERVED",
            "NOT_EXECUTED"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/ActionResult"
          },
          "title": "Results",
          "type": "array"
        },
        "unresolved_issue_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "title": "Unresolved Issue Ids",
          "type": "array"
        },
        "write_disposition": {
          "enum": [
            "POSTCHECK",
            "RECHECK_TARGET",
            "PAUSE_RECONCILE",
            "NOT_EXECUTED"
          ],
          "title": "Write Disposition",
          "type": "string"
        },
        "action_fact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "minItems": 0
        }
      },
      "required": [
        "plan",
        "execution_mode",
        "results",
        "unresolved_issue_ids",
        "write_disposition",
        "action_fact_refs"
      ],
      "title": "ReceiptPayload",
      "type": "object"
    },
    "Region": {
      "additionalProperties": false,
      "properties": {
        "region_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Region Id",
          "type": "string"
        },
        "box": {
          "$ref": "#/$defs/OriginalBox"
        },
        "crop_transform": {
          "$ref": "#/$defs/CropTransform"
        },
        "content_type": {
          "enum": [
            "text",
            "formula",
            "image",
            "table"
          ],
          "title": "Content Type",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text"
        },
        "source": {
          "enum": [
            "SYNTHETIC",
            "OCR",
            "DETECTOR",
            "HUMAN",
            "HISTORICAL"
          ],
          "title": "Source",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "printed_number_candidates": {
          "items": {
            "type": "string"
          },
          "title": "Printed Number Candidates",
          "type": "array"
        },
        "certainty": {
          "enum": [
            "CONFIRMED",
            "UNCERTAIN"
          ],
          "title": "Certainty",
          "type": "string"
        }
      },
      "required": [
        "region_id",
        "box",
        "crop_transform",
        "content_type",
        "text",
        "source",
        "evidence_refs",
        "printed_number_candidates",
        "certainty"
      ],
      "title": "Region",
      "type": "object"
    },
    "Resource": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "media_type": {
          "enum": [
