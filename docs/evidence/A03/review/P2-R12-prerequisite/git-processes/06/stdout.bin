d3db4f639ca296bfe51d0f88805bf870b338c006 blob 1447
"""Minimal offline command line interface."""
import argparse
import json
import sys

from . import ContractError, load_bundle, schema


def main(argv=None):
    parser = argparse.ArgumentParser(description="C01 offline contract proposal validator")
    commands = parser.add_subparsers(dest="command", required=True)
    validate = commands.add_parser("validate", help="validate a closed exchange and resource bytes")
    validate.add_argument("bundle")
    validate.add_argument("--structure-only", action="store_true", help="skip resource file bytes, not reference semantics")
    commands.add_parser("schema", help="emit generated JSON Schema (semantic validation is additional)")
    args = parser.parse_args(argv)
    try:
        if args.command == "schema":
            print(json.dumps(schema(), ensure_ascii=False, indent=2))
        else:
            bundle = load_bundle(args.bundle, verify_assets=not args.structure_only)
            print(json.dumps({"valid": True, "schema_version": "1.0.0-a-proposal",
                              "artifacts": len(bundle.artifacts), "resources_verified": not args.structure_only,
                              "validation_layer": "OFFLINE_CONTRACT"}, ensure_ascii=False))
        return 0
    except ContractError as error:
        print(json.dumps({"valid": False, "issues": error.issues}, ensure_ascii=False), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())

1b2ed55b413dda3482f99cbe21f54ae71ab7a5f3 blob 2198
"""Deterministic exchange serialization and local-resource integrity."""
import hashlib
import json
from pathlib import Path
from typing import Any

from pydantic import BaseModel, TypeAdapter

from .models import Artifact, PlatformPolicy

ARTIFACT_ADAPTER = TypeAdapter(Artifact)


def as_data(value: Any):
    return value.model_dump(mode="json") if isinstance(value, BaseModel) else value


def content_digest(value) -> str:
    data = dict(as_data(value))
    data.pop("content_hash", None)
    encoded = json.dumps(data, ensure_ascii=False, sort_keys=True, separators=(",", ":"),
                         allow_nan=False).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def seal_artifact(data):
    candidate = dict(as_data(data))
    candidate["content_hash"] = "0" * 64
    candidate = ARTIFACT_ADAPTER.validate_python(candidate).model_dump(mode="json")
    candidate["content_hash"] = content_digest(candidate)
    return candidate


def seal_policy(data):
    candidate = dict(as_data(data))
    candidate["content_hash"] = "0" * 64
    candidate = PlatformPolicy.model_validate(candidate).model_dump(mode="json")
    candidate["content_hash"] = content_digest(candidate)
    return candidate


def artifact_ref(artifact):
    data = as_data(artifact)
    return {key: data[key] for key in ("artifact_id", "revision", "kind", "content_hash")}


def policy_ref(policy):
    data = as_data(policy)
    return {key: data[key] for key in ("policy_id", "revision", "content_hash")}


def file_digest(path: Path):
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON key: " + key)
        result[key] = value
    return result


def read_json(path):
    def reject_constant(value):
        raise ValueError("non-finite JSON number: " + value)
    return json.loads(Path(path).read_text(encoding="utf-8"), object_pairs_hook=unique_object,
                      parse_constant=reject_constant)

4a9b82d454033742c25fe7d521149e3525a14392 blob 22216
"""The sole structural authority for the C01 v1 exchange proposal (Python 3.9)."""
import math
import re
from datetime import datetime
from pathlib import PurePosixPath, PureWindowsPath
from typing import Annotated, Dict, List, Literal, Optional, Union

from pydantic import BaseModel, ConfigDict, Field, field_validator, model_validator

SCHEMA_VERSION = "1.0.0-a-proposal"
Digest = Annotated[str, Field(pattern=r"^[0-9a-f]{64}$")]
Identifier = Annotated[str, Field(pattern=r"^[A-Za-z][A-Za-z0-9_.:-]{0,127}$")]
ExternalIdentifier = Annotated[str, Field(pattern=r"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$")]
PositiveInt = Annotated[int, Field(gt=0)]
Nonnegative = Annotated[float, Field(ge=0)]
Kind = Literal["SourceBundle", "EvidenceBundle", "QuestionGraph", "PlatformSnapshot",
               "CheckReport", "ApplyPlan", "ExecutionReceipt", "ReviewPatch", "BatchReport"]
Role = Literal["stem", "option", "answer", "explanation", "shared_material"]
ContentType = Literal["text", "formula", "image", "table"]
Stage = Literal["PRE_APPLY", "TARGET", "POST_APPLY"]
Decision = Literal["PASS", "RETRY", "EXCEPTION", "HOLD"]
CapabilityName = Literal["persistent_draft", "frame_readback", "content_readback",
                         "ocr_before_submit", "resume_after_restart", "multi_session",
                         "same_session_handoff", "frame_update"]
FactValue = Union[str, int, float, bool, None]


class ContractModel(BaseModel):
    model_config = ConfigDict(extra="forbid", strict=True, frozen=True, allow_inf_nan=False)


def relative_path(value: str) -> str:
    # Use a portable POSIX subset on every host; also reject Windows drives/UNC/ADS.
    if (not value or "\\" in value or ":" in value or "\x00" in value
            or PurePosixPath(value).is_absolute() or PureWindowsPath(value).drive
            or any(part in ("", ".", "..") for part in value.split("/"))):
        raise ValueError("resource path must be a portable relative path without traversal")
    if any(part.endswith((".", " ")) or re.match(r"^(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\.|$)", part, re.I)
           or any(c in part for c in '<>"|?*') or any(ord(c) < 32 for c in part)
           for part in value.split("/")):
        raise ValueError("resource path contains nonportable Windows path components")
    return value


class ArtifactRef(ContractModel):
    artifact_id: Identifier
    revision: PositiveInt
    kind: Kind
    content_hash: Digest


class PolicyRef(ContractModel):
    policy_id: Identifier
    revision: PositiveInt
    content_hash: Digest


class Producer(ContractModel):
    module: Identifier
    implementation_version: str = Field(min_length=1)
    config_version: str = Field(min_length=1)
    policy_versions: List[PolicyRef]
    model_version: Optional[str]
    prompt_version: Optional[str]
    evidence_mode: Literal["SYNTHETIC", "OBSERVED"]


class Envelope(ContractModel):
    schema_version: Literal["1.0.0-a-proposal"]
    artifact_id: Identifier
    revision: PositiveInt
    kind: Kind
    run_id: Identifier
    book_id: ExternalIdentifier
    scope_id: Identifier
    input_refs: List[ArtifactRef]
    producer: Producer
    content_hash: Digest
    created_at: str

    @field_validator("created_at")
    @classmethod
    def timestamp(cls, value):
        try:
            parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
        except ValueError:
            raise ValueError("expected ISO 8601 timestamp with timezone")
        if parsed.tzinfo is None:
            raise ValueError("timestamp must include timezone")
        return value


class Resource(ContractModel):
    path: str
    sha256: Digest
    media_type: Literal["image/png", "image/jpeg", "image/x-portable-graymap", "text/plain", "application/json"]

    _relative = field_validator("path")(relative_path)


class Asset(Resource):
    asset_id: Identifier
    width: PositiveInt
    height: PositiveInt
    source_label: str = Field(min_length=1)
    provenance: Literal["SYNTHETIC", "ORIGINAL"]


class ImageBinding(ContractModel):
    asset_id: Identifier
    width: PositiveInt
    height: PositiveInt
    sha256: Digest


class OriginalBox(ContractModel):
    image: ImageBinding
    bbox: List[float] = Field(min_length=4, max_length=4)

    @model_validator(mode="after")
    def bounds(self):
        x1, y1, x2, y2 = self.bbox
        if not all(math.isfinite(x) for x in self.bbox):
            raise ValueError("bbox requires finite original-image coordinates")
        if not (0 <= x1 < x2 <= self.image.width and 0 <= y1 < y2 <= self.image.height):
            raise ValueError("bbox must have positive area within bound original image")
        return self


class Directory(ContractModel):
    directory_id: Identifier
    parent_id: Optional[Identifier]
    label: str


class PageMapping(ContractModel):
    asset_id: Identifier
    directory_id: Identifier
    external_page: str
    mapping_status: Literal["CONFIRMED", "UNCERTAIN"]
    evidence_refs: List[Identifier] = Field(min_length=1)


class HistoryReference(ContractModel):
    resource: Resource
