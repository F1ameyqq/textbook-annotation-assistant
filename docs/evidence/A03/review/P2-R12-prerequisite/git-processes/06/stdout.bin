          "title": "Media Type",
          "type": "string"
        },
        "origin": {
          "type": "string",
          "enum": [
            "SYNTHETIC",
            "ORIGINAL",
            "OBSERVED"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type",
        "origin"
      ],
      "title": "Resource",
      "type": "object"
    },
