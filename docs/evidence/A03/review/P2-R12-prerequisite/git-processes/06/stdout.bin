            "$ref": "#/$defs/Asset"
          },
          "minItems": 1,
          "title": "Assets",
          "type": "array"
        },
        "directories": {
          "items": {
            "$ref": "#/$defs/Directory"
          },
          "minItems": 1,
          "title": "Directories",
          "type": "array"
        },
        "pages_expected": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Pages Expected",
          "type": "array"
        },
        "pages_acquired": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Pages Acquired",
          "type": "array"
        },
        "external_page_mappings": {
          "items": {
            "$ref": "#/$defs/PageMapping"
          },
          "title": "External Page Mappings",
          "type": "array"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/HistoryReference"
          },
          "title": "History",
          "type": "array"
        },
        "scope_manifest": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
              },
              "minItems": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_manifest_basis": {
          "minLength": 1,
          "title": "Scope Manifest Basis",
          "type": "string"
        },
        "metadata_page_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Metadata Page Count"
        },
        "scope_integrity": {
          "$ref": "#/$defs/ScopeIntegrity"
        }
      },
      "required": [
        "assets",
        "directories",
        "pages_expected",
        "pages_acquired",
        "external_page_mappings",
        "history",
        "scope_manifest",
        "scope_manifest_basis",
        "metadata_page_count",
        "scope_integrity"
      ],
      "title": "SourcePayload",
