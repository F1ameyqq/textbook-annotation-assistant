                  "type": "integer",
                  "minimum": 1
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "content_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "artifact_id",
                "revision",
                "kind",
                "content_hash"
              ],
              "additionalProperties": false
            },
            "execution_mode": {
              "const": "SIMULATED"
