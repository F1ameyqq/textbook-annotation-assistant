"""Local JSON-request CLI. No network, browser or automatic recovery loop."""
import argparse
import json
import sys
from pathlib import Path

from annotation.runtime.storage import init_state, open_state
from annotation.runtime.storage.common import FaultController, RuntimeFailure, plain, reference, fail, unique
from . import open_observer, claim_current, configuration, run_plan, reconcile, publish_quality


def operate(request):
    from annotation.contracts import load_recovery_bundle
    from annotation.delivery.mock.persistent import PersistentMockSession
    operation = request["operation"]
    expected = {key: request[key] for key in ("expected_ledger_id", "expected_target_store_id")}
    if operation == "init":
        bundle = load_recovery_bundle(request["bundle_path"], asset_root=request.get("asset_root"))
        data = plain(bundle)
        source = request.get("source_ref") or reference(next(a for a in data["artifacts"] if a["kind"] == "SourceBundle"))
        snapshot = request.get("snapshot_ref") or reference(next(a for a in data["artifacts"] if a["kind"] == "PlatformSnapshot"))
        snapshot_value = next(a for a in data["artifacts"] if reference(a) == snapshot)
        namespace = request.get("platform_namespace", "a03-mock")
        key = {"platform_namespace": namespace, "target_id": snapshot_value["payload"]["target_id"], "book_id": snapshot_value["book_id"]}
        config = json.loads(Path(request["config_path"]).read_bytes())
        store = init_state(request["anchor_path"], state_dir=request["state_dir"], **expected)
        root = request.get("asset_root", str(Path(request["bundle_path"]).resolve().parent))
        session = request.get("target_session_id", "a03-p2-session")
        registered = store.register_book(bundle, target_key=key, target_dir=request["target_dir"], target_session_id=session,
            source_ref=source, asset_root=root, config=config, registration_id=request.get("registration_id"))
        observer = PersistentMockSession.create(request["target_dir"], bundle, snapshot, platform_namespace=namespace,
            source_ref=source, asset_root=registered["package_root"], expected_store_id=store.target_store_id, target_session_id=session)
        current = build_current_plan(store, registered["registration_id"], observer, config)
        result = plain(registered)
        result.update(plan_ref=reference(current), action_ids=[a["action_id"] for a in current["payload"]["actions"]],
                      snapshot_ref=current["payload"]["snapshot"])
        return result
    store = open_state(request["anchor_path"], **expected)
    rid = request.get("registration_id")
    fault = request.get("fault") or ({"point": request["fault_point"]} if request.get("fault_point") else None)
    store.fault = FaultController(fault)
    if operation == "status":
        return store.status(rid)
    if operation == "export":
        return store.export(rid)
    if operation == "target-status":
        observer = open_observer(store, rid)
        return plain(observer.export_book_context(store.target_key(store.registration(rid)["id"])))
    if operation == "run":
        return run_plan(store, rid, fault=fault, fault_action_index=request.get("fault_action_index", 0),
            effect_fault=request.get("effect_fault"), read_fault=request.get("read_fault"),
            owner_id=request.get("owner_id"), generation=request.get("generation"),
            config=json.loads(Path(request["config_path"]).read_bytes()) if request.get("config_path") else None)
    if operation == "reconcile":
        return reconcile(store, rid, call_id=request.get("call_id"), read_fault=request.get("read_fault"),
            owner_id=request.get("owner_id"), max_attempts=request.get("max_attempts", 3), intent_filter=request.get("intent_filter"))
    if operation == "quality":
        return publish_quality(store, store.registration(rid)["id"])
    if operation in ("detect-drift", "clear-hold"):
        from .lease import LeaseKeeper
        reg = store.registration(rid)
        observer = open_observer(store, reg["id"])
        key = store.target_key(reg["id"])
        claim = claim_current(store, observer, key, request.get("owner_id"))
        owner, generation = claim["owner_id"], claim["generation"]
        keeper = LeaseKeeper(store, key, owner, generation).start()
        try:
            if operation == "detect-drift":
                return plain(store.detect_target_drift(key, owner_id=owner, generation=generation, observer=observer))
            return plain(store.clear_target_drift_hold(request["hold_id"], request["snapshot_ref"],
                request["precheck_ref"], request["targetcheck_ref"], request["candidate_plan_ref"],
                owner_id=owner, generation=generation))
        finally:
            keeper.stop()
            store.release(key, owner_id=owner, generation=generation)
    if operation == "claim":
        observer = open_observer(store, rid)
        return plain(store.claim(store.target_key(store.registration(rid)["id"]), observer=observer, owner_id=request.get("owner_id")))
    if operation in ("import-history", "import_history_archive", "history-import", "historyimport"):
        return store.import_history_archive(request["package_path"], expected_ledger_id=store.ledger_id,
            target_key=request.get("target_key") or store.target_key(store.registration(rid)["id"]))
    if operation == "replan":
        reg = store.registration(rid)
        observer = open_observer(store, reg["id"])
        if store.status(reg["id"])["pending_count"]:
            fail("BOOK_WRITE_PAUSED")
        config = json.loads(Path(request["config_path"]).read_bytes()) if request.get("config_path") else json.loads(reg["config"])
        plan = build_current_plan(store, reg["id"], observer, config)
        return {"plan_ref": reference(plan), "action_ids": [a["action_id"] for a in plan["payload"]["actions"]],
                "snapshot_ref": plan["payload"]["snapshot"]}
    if operation in ("tail-absence", "commit-unattempted-absence", "tailabsence"):
        reg = store.registration(rid)
        observer = open_observer(store, reg["id"])
        claim = claim_current(store, observer, store.target_key(reg["id"]), request.get("owner_id"))
        try:
            status = store.status(reg["id"])
            plan = store._plan(reg["id"])
            action = next(a for a in plan["payload"]["actions"] if a["action_id"] == request["action_id"])
            return plain(store.commit_unattempted_absence(store.bundle(reg["id"]), {"registration_id": reg["id"],
                "plan_ref": reference(plan), "action_id": action["action_id"], "action_digest": __import__("annotation.runtime.storage.common", fromlist=["digest"]).digest(action),
                "expected_event_head": status["event_head"]}, owner_id=claim["owner_id"], generation=claim["generation"],
                asset_root=reg["package_root"], observer=observer))
        finally:
            store.release(store.target_key(reg["id"]), owner_id=claim["owner_id"], generation=claim["generation"])
    fail("INVALID_OPERATION", operation)


def build_current_plan(store, registration_id, observer, config):
    with store.effect_gate(store.target_key(registration_id)).acquire():
        if store.status(registration_id)["pending_count"]:
            fail("BOOK_WRITE_PAUSED")
        return _build_current_plan_locked(store, registration_id, observer, config)


def _build_current_plan_locked(store, registration_id, observer, config):
    """Read the actual target then reuse public A02 checks/planning authority.

    The immutable source/graph content PRE_APPLY stays exact; this does not
    pretend to implement B-side recognition or a new precheck algorithm.
    """
    from annotation.contracts import validate_recovery_bundle, policy_ref
    from annotation.delivery.planner import create_plan
    from annotation.quality.targetcheck import append_artifacts, check_target
    reg = store.registration(registration_id)
    observation = observer.observe_target(store.target_key(registration_id), observation_id=unique("plan-observation"))
    captured, snapshot = store.capture_observation(observation, observer, registration_id)
    bundle = validate_recovery_bundle(store.bundle(registration_id), asset_root=reg["package_root"])
    bundle = append_artifacts(bundle, snapshot, asset_root=reg["package_root"])
    graph = next(a for a in bundle.artifacts if a.kind == "QuestionGraph")
    pre = next(a for a in bundle.artifacts if a.kind == "CheckReport" and a.payload.stage == "PRE_APPLY")
    cfg = configuration(config)
    output = check_target(bundle, reference(graph), reference(snapshot), reference(snapshot), policy_ref(bundle.policies[0]),
        cfg, artifact_id=unique("targetcheck"), created_at=snapshot["created_at"])
    target = output.artifacts[-1]
    output = create_plan(output, reference(graph), reference(pre), reference(target), reference(snapshot), reference(snapshot),
        policy_ref(bundle.policies[0]), cfg, artifact_id=unique("plan"), created_at=snapshot["created_at"])
    with store.transaction() as connection:
        for artifact in plain(output)["artifacts"]:
            store._artifact(connection, artifact)
        store._save_bundle(connection, registration_id, plain(output))
    return plain(output.artifacts[-1])


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--request", required=True, type=Path)
    args = parser.parse_args(argv)
    operation = None
    try:
        request = json.loads(args.request.read_bytes())
        operation = request.get("operation")
        result = operate(request)
        print(json.dumps({"ok": True, "operation": operation, "result": plain(result)}, ensure_ascii=False, sort_keys=True))
        if result.get("deadline_exceeded"):
            return 6
        return 3 if operation in ("run", "reconcile") and result.get("pending_count", 0) else 0
    except RuntimeFailure as error:
        print(json.dumps({"ok": False, "operation": operation, "code": error.code, "message": str(error)}, ensure_ascii=False))
        return error.exit_code
    except Exception as error:
        errors = getattr(error, "issues", None)
        if errors is not None:
            code = errors[0].get("code", "INVALID_INPUT") if isinstance(errors, list) and errors else "INVALID_INPUT"
            print(json.dumps({"ok": False, "operation": operation, "code": code, "errors": errors}, ensure_ascii=False))
            return 7 if code in ("SYNTHETIC_ONLY", "SYNTHETIC_COMPLETE_REQUIRED") else 2
        print(json.dumps({"ok": False, "operation": operation, "code": "UNEXPECTED_IMPLEMENTATION_ERROR",
                          "message": str(error), "type": type(error).__name__}, ensure_ascii=False))
        return 5


if __name__ == "__main__":
    sys.exit(main())

a3eeb6a43fab864918399dcba4b2c10a0ef75433 blob 1162
"""Bounded owner lease renewal; process liveness alone never grants authority."""
import threading

from annotation.runtime.storage.common import fail


class LeaseKeeper:
    def __init__(self, store, target_key, owner_id, generation):
        self.store, self.target_key = store, target_key
        self.owner_id, self.generation = owner_id, generation
        self.stopped = threading.Event()
        self.error = None
        self.thread = threading.Thread(target=self._run, name="a03-lease-renewal", daemon=False)

    def _run(self):
        while not self.stopped.wait(2):
            try:
                self.store.renew(self.target_key, owner_id=self.owner_id, generation=self.generation)
            except Exception as error:
                self.error = error
                return

    def start(self):
        self.thread.start()
        return self

    def check(self):
        if self.error is not None:
            raise self.error

    def stop(self):
        self.stopped.set()
        self.thread.join(timeout=7)
        if self.thread.is_alive():
            fail("LEASE_RENEWAL_SHUTDOWN_TIMEOUT", "owned renewal thread did not stop", 6)

a8540adef1fac5e1a804ce955a00b7693fd336cc blob 3320
"""Bounded, preregistered native read subprocess. Retries are always zero."""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import time


def _write(path, value):
    with path.open('xb') as stream:
        stream.write((json.dumps(value, sort_keys=True, indent=2) + '\n').encode('utf-8'))


def observe_native_bounded(observer, *, read_fault=None, timeout=2):
    from annotation.runtime.storage.common import unique, plain
    folder = observer.directory / 'process-audit' / unique('read')
    folder.mkdir(parents=True, exist_ok=False)
    request = {'descriptor': plain(observer.descriptor), 'target_dir': str(observer.directory),
        'observation_id': unique('native-observation'), 'read_fault': read_fault}
    _write(folder / 'request.json', request)
    argv = [sys.executable, '-X', 'utf8', '-B', '-m', 'annotation.runtime.recovery.native_observation', str(folder / 'request.json')]
    _write(folder / 'preregistered.json', {'argv': argv, 'cwd': os.getcwd(), 'timeout_seconds': timeout,
        'input_sha256': hashlib.sha256((folder / 'request.json').read_bytes()).hexdigest(),
        'script_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(), 'retries': 0})
    with (folder / 'script-snapshot.py').open('xb') as stream:
        stream.write(Path(__file__).read_bytes())
    started = time.monotonic()
    forced = False
    with (folder / 'stdout.txt').open('xb') as stdout, (folder / 'stderr.txt').open('xb') as stderr:
        process = subprocess.Popen(argv, stdout=stdout, stderr=stderr)
        _write(folder / 'started.json', {'pid': process.pid, 'parent_pid': os.getpid()})
        try:
            code = process.wait(timeout=max(.01, timeout - (time.monotonic() - started)))
        except subprocess.TimeoutExpired:
            forced = True
            process.kill()
            code = process.wait(timeout=5)
    elapsed = time.monotonic() - started
    _write(folder / 'completed.json', {'pid': process.pid, 'exit_code': code, 'alive': process.poll() is None,
        'timeout': forced, 'elapsed_seconds': elapsed})
    result = {'ok': False, 'code': 'TARGET_READ_TIMEOUT' if forced else 'TARGET_READ_FAILED'}
    if code == 0 and not forced:
        result = json.loads((folder / 'stdout.txt').read_bytes())
    result.update(read_elapsed_seconds=elapsed, process_pid=process.pid, process_exit_code=code,
        process_reaped=process.poll() is not None, forced_termination=forced, process_audit_path=str(folder))
    return result


def worker(path):
    from annotation.runtime.storage.native_target import NativeTargetSession
    request = json.loads(Path(path).read_bytes())
    descriptor = request['descriptor']
    observer = NativeTargetSession.open(request['target_dir'], expected_store_id=descriptor['store_id'],
        expected_target_session_id=descriptor['target_session_id'], expected_target_key=descriptor['target_key'],
        expected_scope_id=descriptor['fixed_scope_id'], expected_source_ref=descriptor['fixed_source_ref'])
    observation = observer.observe_target(descriptor['target_key'], observation_id=request['observation_id'], read_fault=request['read_fault'])
    print(json.dumps({'ok': True, 'observation': observation, 'pid': os.getpid()}))


if __name__ == '__main__':
    worker(sys.argv[1])

7506ef0f15355dd16b35f8e4ea6c350c3c1f911e blob 6464
"""Native independent report read and typed POST/Batch production."""
import json
import time

from annotation.contracts import artifact_ref
from annotation.delivery.planner import compare_action_effect
from annotation.quality.targetcheck import append_artifacts, make_artifact, resolve_artifact
from annotation.runtime.storage.common import Handle, canonical, digest, fail, now, plain, reference, unique
from .observation import observe_bounded


def publish_native_quality(store, registration_id, projection=None, *, owner_id=None, generation=None):
    from . import open_observer, claim_current
    reg = store.registration(registration_id)
    key = store.target_key(registration_id)
    borrowed = owner_id is not None or generation is not None
    if borrowed:
        if owner_id is None or generation is None:
            fail('OWNER_GENERATION_STALE', 'report owner_id and generation must be supplied together', 4)
        # Use the existing instance/PID/ACTIVE/owner/generation/expiry guard.
        # Validate before projecting or consuming the durable report read.
        with store.connect() as connection:
            store._lease(connection, reg['book'], owner_id, generation, pending_ok=True)
    plan = store._plan(registration_id)
    projection = projection or store.project_plan(registration_id, plan)
    if projection.get('receipt_ref') is None:
        return Handle(status='NO_COMPLETE_RECEIPT', content_check_status='PENDING', submission_status='NOT_SUBMITTED')
    observer = open_observer(store, registration_id)
    claim = Handle(owner_id=owner_id, generation=generation) if borrowed else claim_current(store, observer, key)
    try:
        with store.transaction() as connection:
            store._lease(connection, reg['book'], claim['owner_id'], claim['generation'], pending_ok=True)
            connection.execute('INSERT INTO native_report_reads VALUES(?,?,1)', (digest(reference(plan)), time.time()))
        actual = observe_bounded(observer, timeout=2)
        if not actual.get('ok') or actual['read_elapsed_seconds'] > 2:
            fail('NATIVE_REPORT_READ_FAILED', 'durable report read consumed; no implicit retry')
        captured, snapshot = store.capture_observation(actual['observation'], observer, registration_id)
        if snapshot is None:
            fail('NATIVE_REPORT_READ_INCOMPLETE')
        with store.transaction() as connection:
            store._lease(connection, reg['book'], claim['owner_id'], claim['generation'], pending_ok=True)
            store._append(connection, registration_id, snapshot)
        bundle = store._validate(store.bundle(registration_id), asset_root=reg['package_root'])
        receipt = resolve_artifact(bundle, projection['receipt_ref'], 'ExecutionReceipt')
        graph = resolve_artifact(bundle, plan['payload']['graph'], 'QuestionGraph')
        bindings, heads, comparisons = [], [], []
        for action, resource in zip(plan['payload']['actions'], receipt.payload.action_fact_refs):
            fact = store.read_resource(plain(resource), registration_id)
            before = store.read_resource(fact['prepared_before'], registration_id)
            comparison = compare_action_effect(action, before, actual['observation'])
            comparisons.append(comparison)
            head = resolve_artifact(bundle, fact['resolution_ref'], 'ReconciliationResult') if fact['resolution_ref'] else None
            if head:
                heads.append(artifact_ref(head))
            bindings.append({'action_id': action['action_id'], 'action_digest': digest(action),
                'intent_ref': fact['intent_ref'], 'fact_ref': plain(resource),
                'resolution_head_ref': artifact_ref(head) if head else None,
                'head_original_receipt_ref': plain(head.payload.original_receipt_ref) if head else None,
                'observed_snapshot_ref': fact['observed_snapshot_ref'], 'effective_outcome': fact['result']['outcome']})
        frame_pass = all(c['effect_match'] == 'MATCH' for c in comparisons)
        payload = {'stage': 'POST_APPLY', 'subject': artifact_ref(receipt), 'graph': plan['payload']['graph'],
            'policy': plan['payload']['policy'], 'receipt': artifact_ref(receipt), 'report_snapshot_ref': reference(snapshot),
            'report_observation': captured['resource'], 'action_bindings': bindings, 'recovery_refs': heads,
            'frame_structure': 'PASS' if frame_pass else 'FAIL', 'content_check_status': 'PENDING',
            'submission_status': 'NOT_SUBMITTED', 'decision': 'HOLD', 'issues': ['CONTENT_REVIEW_PENDING']}
        post = make_artifact('CheckReport', unique('native-post'), graph, payload, list(bundle.artifacts),
            graph.producer.config_version, 'a03-native-independent-report', now(), bridge_context=bundle.bridge_context)
        bundle = append_artifacts(bundle, post, bridge_context=bundle.bridge_context)
        source = resolve_artifact(bundle, graph.payload.source, 'SourceBundle')
        batch_payload = {'source': artifact_ref(source), 'graph': artifact_ref(graph), 'receipt': artifact_ref(receipt),
            'postcheck': artifact_ref(post), 'report_snapshot_ref': reference(snapshot), 'recovery_refs': heads,
            'scope_manifest': list(source.payload.scope_manifest), 'total_expected': len(source.payload.scope_manifest),
            'questions': [{'question_id': q, 'state': 'PENDING'} for q in source.payload.scope_manifest],
            'state': 'CONTENT_PENDING', 'content_check_status': 'PENDING', 'submission_status': 'NOT_SUBMITTED'}
        batch = make_artifact('BatchReport', unique('native-batch'), graph, batch_payload, list(bundle.artifacts),
            graph.producer.config_version, 'a03-native-independent-report', now(), bridge_context=bundle.bridge_context)
        bundle = append_artifacts(bundle, batch, bridge_context=bundle.bridge_context)
        with store.effect_gate(key).acquire(), store.transaction() as connection:
            store._lease(connection, reg['book'], claim['owner_id'], claim['generation'], pending_ok=True)
            store._append(connection, registration_id, post, batch)
        return Handle(postcheck_ref=artifact_ref(post), batch_ref=artifact_ref(batch), frame_structure=payload['frame_structure'],
            content_check_status='PENDING', submission_status='NOT_SUBMITTED')
    finally:
        if not borrowed:
            store.release(key, owner_id=claim['owner_id'], generation=claim['generation'])

7ee1acf97c558dd1645284302487caaced16f66d blob 2610
"""Bounded controlled-target read process; never dispatches a business effect."""
import multiprocessing
import os
import time

from annotation.runtime.storage.common import plain, unique


def _worker(pipe, descriptor, target_dir, observation_id, read_fault):
    try:
        from annotation.delivery.mock.persistent import PersistentMockSession
        observer = PersistentMockSession.open(target_dir, expected_store_id=descriptor["store_id"],
            expected_target_session_id=descriptor["target_session_id"], expected_target_key=descriptor["target_key"],
            expected_scope_id=descriptor["fixed_scope_id"], expected_source_ref=descriptor["fixed_source_ref"])
        value = observer.observe_target(descriptor["target_key"], observation_id=observation_id, read_fault=read_fault)
        pipe.send({"ok": True, "observation": plain(value), "pid": os.getpid()})
    except Exception as error:
        pipe.send({"ok": False, "code": getattr(error, "code", "TARGET_READ_FAILED"),
                   "message": str(error), "pid": os.getpid()})
    finally:
        pipe.close()


def observe_bounded(observer, *, read_fault=None, timeout=2):
    if getattr(observer, '_native', False):
        from .native_observation import observe_native_bounded
        return observe_native_bounded(observer, read_fault=read_fault, timeout=timeout)
    context = multiprocessing.get_context("spawn")
    parent, child = context.Pipe(duplex=False)
    process = context.Process(target=_worker, args=(child, plain(observer.descriptor),
        str(observer.directory), unique("recovery-observation"), read_fault))
    started = time.monotonic()
    process.start()
    child.close()
    value = None
    forced = False
    try:
        if parent.poll(max(0, timeout - (time.monotonic() - started))):
            try:
                value = parent.recv()
            except EOFError:
                value = {"ok": False, "code": "TARGET_READ_PROCESS_EXIT"}
        else:
            forced = True
            process.terminate()
    finally:
        process.join(timeout=max(.01, timeout - (time.monotonic() - started)))
        if process.is_alive():
            forced = True
            process.kill()
            process.join(timeout=5)
        parent.close()
    result = value or {"ok": False, "code": "TARGET_READ_TIMEOUT"}
    result.update(read_elapsed_seconds=time.monotonic() - started, process_pid=process.pid,
        process_exit_code=process.exitcode, process_reaped=not process.is_alive(), forced_termination=forced)
    if result["process_reaped"]:
        process.close()
    return result

cb23cab5200ca1ee2d8c9c639a6f1274ccf2e3e5 blob 20659
"""Synthetic recovery report projection; no target I/O or store authority.

Reports are new immutable consumers of complete validated receipts and exact
resolution heads. Partial progress and unknown/empty denominators remain
diagnostic values. Frame evidence never verifies final content or submission.
"""
import copy
import json
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path

from annotation.contracts import (artifact_ref, content_digest, effective_recovery_outcomes,
    load_archive_bundle, seal_artifact, validate_recovery_bundle)
from annotation.quality.targetcheck import coverage_for, make_artifact, reject, resolve_artifact


@dataclass(frozen=True)
class QualityResult:
    bundle: object
    diagnostic: dict
    postcheck_ref: object = None
    batch_ref: object = None


def _plain(value):
    if hasattr(value, "model_dump"):
        return _plain(value.model_dump(mode="json"))
    if isinstance(value, dict):
        return {key: _plain(child) for key, child in value.items()}
    if isinstance(value, (list, tuple)):
        return [_plain(child) for child in value]
    return copy.deepcopy(value)


def _head_results(bundle, plan):
    items = [a for a in bundle.artifacts if a.kind == "ReconciliationResult" and
             a.book_id == plan.book_id and a.scope_id == plan.scope_id and
             _plain(a.payload.plan_ref) == artifact_ref(plan)]
    ref_key = lambda ref: tuple(ref[key] for key in ("artifact_id", "revision", "kind", "content_hash"))
    previous = {ref_key(_plain(a.payload.previous_resolution_ref)) for a in items
                if a.payload.previous_resolution_ref is not None}
    heads = [a for a in items if ref_key(artifact_ref(a)) not in previous]
    heads.sort(key=lambda a: next(i for i, action in enumerate(plan.payload.actions)
                                  if action.action_id == a.payload.action_id))
    return heads


def _source_states(source, graph, statuses, outcomes, action_questions):
    manifest = source.payload.scope_manifest
    if manifest is None:
        return []
    statuses = dict(statuses or {})
    if set(statuses) - set(manifest):
        reject("DENOMINATOR_CHANGED", "status input names a question outside the exact source scope")
    if any(state not in ("PENDING", "EXCEPTION", "SKIPPED") for state in statuses.values()):
        reject("COMPLETION_GUARD", "caller statuses cannot manufacture content verification or save outcomes")
    graph_questions = {q.question_id for q in graph.payload.questions} if graph is not None else set()
    values = []
    for question_id in manifest:
        state = statuses.get(question_id, "PENDING" if question_id in graph_questions else "EXCEPTION")
        if any(outcome == "UNKNOWN" and action_questions.get(action_id) == question_id for action_id, outcome in outcomes.items()):
            state = "UNKNOWN"
        reason = ("source scope item is absent from the graph and remains counted" if question_id not in graph_questions else
                  "actual save remains unresolved" if state == "UNKNOWN" else
                  "synthetic scope item; final content and human submission remain unverified")
        values.append({"question_id": question_id, "state": state, "reason": reason})
    return values


def _diagnostic(source, graph, statuses, outcomes, action_questions, *, state, paused=False,
                unresolved=(), progress_ref=None, recovery_refs=()):
    manifest = _plain(source.payload.scope_manifest)
    return {"format_version": "a03-quality-diagnostic-1", "origin": "SYNTHETIC",
            "execution_mode": "SIMULATED", "authority": "DIAGNOSTIC_ONLY",
            "source_ref": artifact_ref(source), "scope_manifest": manifest,
            "total_expected": None if manifest is None else len(manifest),
            "questions": _source_states(source, graph, statuses, outcomes, action_questions),
            "effective_outcomes": copy.deepcopy(outcomes), "state": state,
            "scope_paused": paused, "pause_authority": "SAME_SCOPE_CONTRACT_ONLY",
            "unresolved": _plain(list(unresolved)), "progress_ref": _plain(progress_ref),
            "recovery_refs": _plain(list(recovery_refs)), "postcheck_ref": None, "batch_ref": None,
            "content_check_status": "PENDING", "submission_status": "NOT_SUBMITTED",
            "completion_ratio": None, "model_calls": 0, "platform_actions": 0}


def _declare_consumed(artifact, evidence, root):
    """Declare this consumer's ordinary refs through its formal resource graph."""
    refs, visited = {}, set()
    records = {record["evidence_id"]: record for record in evidence}
    fields = {"evidence_refs", "before_evidence_refs", "after_evidence_refs", "submission_evidence_refs"}
    def walk(value):
        if isinstance(value, list):
            for child in value:
                walk(child)
        elif isinstance(value, dict):
            if set(value) == {"artifact_id", "revision", "kind", "content_hash"}:
                refs[tuple(value[k] for k in ("artifact_id", "revision", "kind", "content_hash"))] = value
            elif {"path", "sha256", "media_type"}.issubset(value):
                key = (value["path"], value["sha256"], value["media_type"])
                if value["media_type"] == "application/json" and key not in visited:
                    visited.add(key)
                    walk(json.loads((Path(root) / value["path"]).read_text(encoding="utf-8")))
            else:
                for name, child in value.items():
                    if name in fields and isinstance(child, list):
                        for member in child:
                            if isinstance(member, str):
                                if member not in records:
                                    reject("MISSING_REFERENCE", "report formal evidence ID is absent")
                                walk(records[member]["resource"])
                    walk(child)
    # The envelope is not a reference to itself.
    walk(artifact["payload"])
    walk(artifact["input_refs"])
    artifact["input_refs"] = list(refs.values())
    return seal_artifact(artifact)


def build_quality_report(bundle, *, target_key, source_ref=None, receipt_ref=None, progress_ref=None,
                         statuses=None, config_version, postcheck_id, batch_id, created_at, asset_root=None):
    """Produce new POST_APPLY/BatchReport, or a complete diagnostic projection.

    This same-scope value projection cannot clear runtime book pauses. The
    caller retains runtime's current all-scope scan and writes a new bundle.
    """
    bundle = validate_recovery_bundle(bundle, asset_root=asset_root)
    plan = graph = receipt = progress = None
    if receipt_ref is not None:
        receipt = resolve_artifact(bundle, receipt_ref, "ExecutionReceipt")
        plan = resolve_artifact(bundle, receipt.payload.plan, "ApplyPlan")
    if progress_ref is not None:
        progress = resolve_artifact(bundle, progress_ref, "ExecutionProgress")
        progress_plan = resolve_artifact(bundle, progress.payload.plan_ref, "ApplyPlan")
        if plan is not None and artifact_ref(plan) != artifact_ref(progress_plan):
            reject("BATCH_BINDING", "progress and receipt bind different plans")
        plan = progress_plan
    if plan is not None:
        graph = resolve_artifact(bundle, plan.payload.graph, "QuestionGraph")
        source = resolve_artifact(bundle, graph.payload.source, "SourceBundle")
        if source_ref is not None and _plain(source_ref) != artifact_ref(source):
            reject("SOURCE_BINDING", "requested source differs from the exact plan graph")
        if config_version != plan.producer.config_version:
            reject("AUTHORIZATION_CHANGED", "report configuration differs from its exact plan")
        snapshot = resolve_artifact(bundle, plan.payload.snapshot, "PlatformSnapshot")
        if target_key["target_id"] != snapshot.payload.target_id:
            reject("TARGET_IDENTITY_MISMATCH", "report target differs from its exact snapshot")
    elif source_ref is not None:
        source = resolve_artifact(bundle, source_ref, "SourceBundle")
    else:
        reject("MISSING_REFERENCE", "source, complete receipt or progress ref is required")
    if source.book_id != target_key["book_id"]:
        reject("TARGET_IDENTITY_MISMATCH", "report canonical book key differs from source")
    if receipt is not None:
        for result in receipt.payload.results:
            if result.intent_ref is not None:
                intent = resolve_artifact(bundle, result.intent_ref, "WriteIntent")
                if _plain(intent.payload.target_key) != target_key:
                    reject("TARGET_IDENTITY_MISMATCH", "receipt intent canonical target namespace differs")
    view = effective_recovery_outcomes(bundle, target_key=target_key, scope_id=source.scope_id)
    action_questions = {action.action_id: action.target.question_id for a in bundle.artifacts
                        if a.kind == "ApplyPlan" and a.book_id == source.book_id and a.scope_id == source.scope_id
                        for action in a.payload.actions}
    heads = _head_results(bundle, plan) if plan is not None else []
    head_refs = [artifact_ref(head) for head in heads]
    state = ("UNKNOWN_DENOMINATOR" if source.payload.scope_manifest is None else "NO_ACTIONS" if not source.payload.scope_manifest
             else "NEEDS_RECONCILIATION" if view.paused else "PARTIAL_PROGRESS")
    diagnostic = _diagnostic(source, graph, statuses, dict(view.outcomes), action_questions, state=state,
        paused=view.paused, unresolved=view.unresolved, progress_ref=progress_ref, recovery_refs=head_refs)
    if receipt is None or not source.payload.scope_manifest:
        diagnostic["report_kind"] = "DIAGNOSTIC_ONLY"
        return QualityResult(bundle, diagnostic)
    # Frozen CheckReport has one snapshot and requires exact original-receipt
    # binding. Do not invent a combined observation or retrofit an original ref.
    if any(_plain(head.payload.original_receipt_ref) != artifact_ref(receipt) for head in heads):
        diagnostic.update(state="REPORT_CONTRACT_GAP", reason_code="RECOVERY_RECEIPT_BINDING_UNREPRESENTABLE")
        return QualityResult(bundle, diagnostic)
    observed_refs = [_plain(head.payload.observed_snapshot_ref) for head in heads]
    if observed_refs and any(ref != observed_refs[0] for ref in observed_refs):
        diagnostic.update(state="REPORT_CONTRACT_GAP", reason_code="MULTIPLE_RECOVERY_SNAPSHOTS_UNREPRESENTABLE")
        return QualityResult(bundle, diagnostic)
    if any(a.artifact_id in (postcheck_id, batch_id) for a in bundle.artifacts) or postcheck_id == batch_id:
        reject("DUPLICATE_ID", "quality output identities must be new and distinct")
    created = datetime.fromisoformat(created_at.replace("Z", "+00:00"))
    if created.tzinfo is None or any(created < datetime.fromisoformat(h.payload.observed_at.replace("Z", "+00:00")) for h in heads):
        reject("OBSERVATION_NOT_FRESH", "new report cannot predate its consumed current resolution head")
    effective = {result.action_id: result.outcome for result in receipt.payload.results}
    effective.update({head.payload.action_id: {"RESOLVED_APPLIED": "APPLIED", "RESOLVED_NOT_APPLIED": "NOT_APPLIED",
                                              "STILL_UNKNOWN": "UNKNOWN"}[head.payload.resolution] for head in heads})
    all_applied = bool(effective) and all(value == "APPLIED" for value in effective.values())
    unknown = "UNKNOWN" in effective.values() or view.paused
    frames = "PASS" if all_applied else "UNAVAILABLE" if unknown or not effective else "FAIL"
    coverage, _ = coverage_for(bundle, graph)
    evidence = _plain(bundle.evidence)
    proof = list(receipt.payload.results[-1].after_evidence_refs) if receipt.payload.results else list(snapshot.payload.evidence_refs)
    for head in heads:
        resource = _plain(head.payload.readback)
        if resource is not None:
            evidence_id = "proof-quality-" + content_digest({"postcheck": postcheck_id, "resource": resource})[:32]
            if not any(record["evidence_id"] == evidence_id for record in evidence):
                evidence.append({"evidence_id": evidence_id, "resource": resource, "mode": "SYNTHETIC",
                                 "description": "actual immutable recovery observation consumed by this new report"})
            proof.append(evidence_id)
    proof = list(dict.fromkeys(proof))
    if not proof:
        reject("MISSING_REFERENCE", "report requires actual receipt or observation evidence")
    token = content_digest({"postcheck": postcheck_id, "receipt": artifact_ref(receipt)})[:28]
    issues = [{"issue_id": "issue-quality-content-" + token, "code": "CONTENT_MISMATCH", "scope_type": "scope",
               "scope_id": graph.scope_id, "evidence_refs": proof, "severity": "blocking", "blocks": ["COMPLETE"],
               "suggested_strategy": {"strategy_id": "WAIT_CONTENT", "max_attempts": 0, "max_cost": 0.0},
               "reason": "synthetic frame evidence does not verify final text, formula, image content or human submission"}]
    if unknown:
        issues.append({"issue_id": "issue-quality-save-" + token, "code": "SAVE_UNKNOWN", "scope_type": "scope",
                       "scope_id": graph.scope_id, "evidence_refs": proof, "severity": "blocking", "blocks": ["APPLY", "COMPLETE"],
                       "suggested_strategy": {"strategy_id": "RECONCILE", "max_attempts": 0, "max_cost": 0.0},
                       "reason": "current same-scope unresolved save obligations remain counted; no replay is allowed"})
    report_snapshot = observed_refs[0] if observed_refs else None
    if not heads and receipt.payload.action_fact_refs:
        last_fact = json.loads((bundle.asset_root / receipt.payload.action_fact_refs[-1].path).read_text(encoding="utf-8"))
        report_snapshot = last_fact["observed_snapshot_ref"]
    if report_snapshot is not None:
        actual_snapshot = resolve_artifact(bundle, report_snapshot, "PlatformSnapshot")
        if created < datetime.fromisoformat(actual_snapshot.payload.observed_at.replace("Z", "+00:00")):
            reject("OBSERVATION_NOT_FRESH", "new report cannot predate its actual receipt readback")
    dependencies = [source, graph, plan, receipt] + heads
    if report_snapshot is not None:
        dependencies.append(resolve_artifact(bundle, report_snapshot, "PlatformSnapshot"))
    post = make_artifact("CheckReport", postcheck_id, plan,
        {"stage": "POST_APPLY", "subject": artifact_ref(receipt), "graph": artifact_ref(graph),
         "policy": _plain(plan.payload.policy), "snapshot": report_snapshot, "receipt": artifact_ref(receipt),
         "coverage": coverage, "checks": [
             {"check_id": "frame_structure", "outcome": frames, "evidence_refs": proof,
              "reason": "effective committed action facts and exact current recovery chain heads"},
             {"check_id": "final_content", "outcome": "UNAVAILABLE", "evidence_refs": proof,
              "reason": "final content has no independent verification"}],
         "issues": issues, "decision": "HOLD", "reason": "synthetic recovery projection; final content remains pending",
         "recovery_refs": head_refs}, dependencies, config_version, "a03-runtime-quality", created_at)
    post = _declare_consumed(post, evidence, bundle.asset_root)
    states = _source_states(source, graph, statuses, dict(view.outcomes), action_questions)
    batch_state = "NEEDS_RECONCILIATION" if unknown else "CONTENT_PENDING" if all_applied and not any(
        item["state"] in ("EXCEPTION", "SKIPPED") for item in states) else "NEEDS_REVIEW"
    unresolved = list(plan.payload.blocked_issue_ids) + [issue["issue_id"] for issue in issues]
    batch = make_artifact("BatchReport", batch_id, plan,
        {"source": artifact_ref(source), "graph": artifact_ref(graph), "receipt": artifact_ref(receipt),
         "postcheck": artifact_ref(post), "scope_manifest": list(source.payload.scope_manifest), "questions": states,
         "total_expected": len(source.payload.scope_manifest), "coverage": coverage,
         "cost": {"model_calls": 0, "amount": 0.0, "currency": "USD", "billing_status": "KNOWN", "human_minutes": 0.0},
         "unresolved_issue_ids": list(dict.fromkeys(unresolved)), "submission_status": "NOT_SUBMITTED",
         "submission_evidence_refs": [], "content_check_status": "PENDING", "frame_check_status": frames,
         "state": batch_state, "recovery_refs": head_refs, "progress_refs": [_plain(progress_ref)] if progress_ref else []},
        dependencies + [post] + ([progress] if progress is not None else []), config_version, "a03-runtime-quality", created_at)
    batch = _declare_consumed(batch, evidence, bundle.asset_root)
    data = bundle.model_dump()
    data["evidence"] = evidence
    data["artifacts"].extend([post, batch])
    output = validate_recovery_bundle(data, asset_root=bundle.asset_root)
    diagnostic.update(state=batch_state, postcheck_ref=artifact_ref(post), batch_ref=artifact_ref(batch),
                      effective_outcomes=effective, frame_check_status=frames)
    return QualityResult(output, diagnostic, artifact_ref(post), artifact_ref(batch))


def describe_archived_source(archive, *, source_ref, statuses=None):
    """Unknown denominator stays an archive-only diagnostic, never admission."""
    if not isinstance(archive, dict) or archive.get("eligibility") != "ARCHIVE_ONLY":
        reject("ARCHIVE_REQUIRED", "use the explicit public archive loader")
    current = load_archive_bundle(archive["path"], verify_assets=True)
    if current.sha256 != archive.get("sha256"):
        reject("RESOURCE_HASH_MISMATCH", "archive bytes changed after selection")
    data = current.bundle
    if any(a["producer"]["evidence_mode"] != "SYNTHETIC" for a in data["artifacts"]) or any(
            item["mode"] != "SYNTHETIC" for item in data["evidence"]):
        reject("SYNTHETIC_ONLY", "this diagnostic scope is all synthetic")
    checked_resources = set()
    def synthetic(value):
        if isinstance(value, list):
            for member in value:
                synthetic(member)
        elif isinstance(value, dict):
            if (value.get("origin", "SYNTHETIC") != "SYNTHETIC" or
                    value.get("provenance", "SYNTHETIC") != "SYNTHETIC" or value.get("mode") == "OBSERVED" or
                    "execution_mode" in value and value["execution_mode"] not in ("SIMULATED", "NOT_EXECUTED") or
                    "region_id" in value and value.get("source", "SYNTHETIC") != "SYNTHETIC" or
                    "clue_id" in value and value.get("source", "SYNTHETIC") != "SYNTHETIC"):
                reject("SYNTHETIC_ONLY", "archive diagnostic cannot relabel real or observed material")
            if {"path", "sha256", "media_type"}.issubset(value) and value["media_type"] == "application/json":
                key = (value["path"], value["sha256"])
                if key not in checked_resources:
                    checked_resources.add(key)
                    synthetic(json.loads((Path(current.path).parent / value["path"]).read_text(encoding="utf-8")))
            for child in value.values():
                synthetic(child)
    synthetic(data)
    source = next((a for a in data["artifacts"] if artifact_ref(a) == _plain(source_ref) and a["kind"] == "SourceBundle"), None)
    if source is None:
        reject("MISSING_REFERENCE", "exact archived source is absent")
    manifest = source["payload"]["scope_manifest"]
    graphs = [a for a in data["artifacts"] if a["kind"] == "QuestionGraph" and
              a["book_id"] == source["book_id"] and a["scope_id"] == source["scope_id"] and
              a["payload"]["source"] == artifact_ref(source)]
    state = "UNKNOWN_DENOMINATOR" if manifest is None else "NO_ACTIONS" if not manifest else "ARCHIVED_SCOPE_ONLY"
    diagnostic = {"format_version": "a03-quality-diagnostic-1", "origin": "SYNTHETIC", "authority": "ARCHIVE_ONLY",
                  "state": state, "scope_manifest": copy.deepcopy(manifest), "total_expected": None if manifest is None else len(manifest),
                  "source_ref": artifact_ref(source), "completion_ratio": None, "postcheck_ref": None, "batch_ref": None,
                  "content_check_status": "PENDING", "submission_status": "NOT_SUBMITTED",
                  "questions": _source_states(source, graphs[0] if len(graphs) == 1 else None, statuses, {}, {}),
                  "provided_statuses": copy.deepcopy(statuses or {}), "model_calls": 0, "platform_actions": 0}
    return diagnostic

