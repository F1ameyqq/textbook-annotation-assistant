  "schema_pins": [
    [
      "schemas/basis-v3.schema.json",
      "40db0538a512f65e2f8668c528f98643d372cdc195b9b868c446cce2b0743202"
    ],
    [
      "schemas/conversion-v3.schema.json",
      "ac28365f16d028af83e385108cb06cdb3a6f81e2a2e792051692952640c116e4"
