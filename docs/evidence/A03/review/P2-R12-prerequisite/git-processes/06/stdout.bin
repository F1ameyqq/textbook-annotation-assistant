        "run_id",
        "book_id",
        "scope_id",
        "input_refs",
        "producer",
        "content_hash",
        "created_at",
        "payload"
      ],
      "title": "ExecutionProgress",
      "type": "object"
    },
    "AmendedReconciliationResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.4.0-a03-native-proposal"
        },
        "artifact_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "kind": {
          "const": "ReconciliationResult",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "book_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Book Id",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Scope Id",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ReconciliationResultPayload"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "revision",
        "kind",
        "run_id",
        "book_id",
        "scope_id",
        "input_refs",
        "producer",
        "content_hash",
        "created_at",
        "payload"
      ],
      "title": "ReconciliationResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": "a03-exchange-4-proposal"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "policies": {
      "items": {
        "$ref": "#/$defs/PlatformPolicy"
      },
      "minItems": 1,
      "title": "Policies",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/AmendedSourceBundle"
          },
          {
            "$ref": "#/$defs/AmendedEvidenceBundle"
          },
          {
            "$ref": "#/$defs/AmendedQuestionGraph"
          },
          {
            "$ref": "#/$defs/AmendedPlatformSnapshot"
          },
          {
            "$ref": "#/$defs/AmendedCheckReport"
          },
          {
            "$ref": "#/$defs/AmendedApplyPlan"
          },
          {
            "$ref": "#/$defs/AmendedExecutionReceipt"
          },
          {
            "$ref": "#/$defs/AmendedReviewPatch"
          },
          {
            "$ref": "#/$defs/AmendedBatchReport"
          },
          {
            "$ref": "#/$defs/AmendedWriteIntent"
          },
          {
            "$ref": "#/$defs/AmendedExecutionProgress"
          },
          {
            "$ref": "#/$defs/AmendedReconciliationResult"
          }
        ]
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    }
  },
  "required": [
    "format_version",
    "evidence",
    "policies",
    "artifacts"
  ],
  "title": "A03 native synthetic proposal: structure is not runtime authority",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a03:native:exchange-4",
  "$comment": "Structure only. Legacy nodes are not upgraded or granted execution eligibility. Native authority is outside JSON."
}

