              "type": "string"
            },
            "revision": {
              "exclusiveMinimum": 0,
              "title": "Revision",
              "type": "integer"
            },
            "kind": {
              "const": "PlatformSnapshot",
              "type": "string"
            },
            "content_hash": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Content Hash",
              "type": "string"
            }
          },
          "required": [
            "artifact_id",
            "revision",
            "kind",
            "content_hash"
          ],
          "title": "ArtifactRef",
          "type": "object"
        },
        "execution_mode": {
          "const": "SIMULATED"
