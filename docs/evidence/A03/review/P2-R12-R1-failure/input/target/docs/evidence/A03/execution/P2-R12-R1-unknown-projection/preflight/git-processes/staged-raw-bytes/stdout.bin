    source = ROOT / 'tests/fixtures/a02/normal'
    raw = json.loads((source / 'input.json').read_bytes())
    # A new, unexecuted one-page inventory, retaining only the independent beta question.
    changed = {}
    def refs(value):
        if isinstance(value, list):
            return [refs(v) for v in value]
        if isinstance(value, dict):
            if set(value) == {'artifact_id', 'revision', 'kind', 'content_hash'}:
                return copy.deepcopy(changed.get((value['artifact_id'], value['revision']), value))
            return {k: refs(v) for k, v in value.items()}
        return value
    for i, original in enumerate(raw['artifacts']):
        item = refs(original)
        item.update(artifact_id='r12-r1-L1-' + original['artifact_id'], run_id='run-r12-r1-L1',
                    book_id='book-r12-r1-legacy', scope_id='scope-r12-r1-legacy')
        p = item['payload']
        if item['kind'] == 'SourceBundle':
            p['assets'] = [a for a in p['assets'] if a['asset_id'] == 'asset-page-b1']
            p['directories'] = [d for d in p['directories'] if d['directory_id'] == 'directory-b']
            p['pages_expected'] = p['pages_acquired'] = ['asset-page-b1']
            p['external_page_mappings'] = [m for m in p['external_page_mappings'] if m['asset_id'] == 'asset-page-b1']
            p['scope_manifest'] = ['question-beta']
            p['scope_manifest_basis'] = 'Fresh synthetic singleton Unit B inventory for legacy UNKNOWN compatibility.'
            p['metadata_page_count'] = 1
        elif item['kind'] == 'EvidenceBundle':
            p['regions'] = [r for r in p['regions'] if r['region_id'].startswith('region-beta-')]
            p['coverage_clues'] = [c for c in p['coverage_clues'] if c['clue_id'].startswith('clue-beta-')]
        elif item['kind'] == 'QuestionGraph':
            p['questions'] = [q for q in p['questions'] if q['question_id'] == 'question-beta']
            p['fragments'] = [f for f in p['fragments'] if f['fragment_id'].startswith('fragment-beta-')]
            p['answer_relations'] = [r for r in p['answer_relations'] if r['question_id'] == 'question-beta']
            p['identity_notes'] = 'Fresh singleton synthetic input; stable identity independent of printed number.'
        elif item['kind'] == 'PlatformSnapshot':
            p.update(target_id='target-r12-r1-legacy', authorized_scope_id=item['scope_id'], directories=['platform-unit-b'])
        elif item['kind'] == 'CheckReport':
            p['coverage'].update(scope_id=item['scope_id'], pages_expected=['asset-page-b1'], pages_checked=['asset-page-b1'],
                clue_ids=['clue-beta-stem', 'clue-beta-answer'])
        sealed = seal_artifact(item)
        raw['artifacts'][i] = sealed
        changed[(original['artifact_id'], original['revision'])] = artifact_ref(sealed)
    target = HERE / 'legacy-unexecuted'
    target.mkdir(exist_ok=False)
    def resources(value):
        if isinstance(value, dict):
            if {'path', 'sha256', 'media_type'} <= set(value):
                path = value['path']
                if not (target / path).exists():
                    write(target / path, (source / path).read_bytes())
            for v in value.values():
                resources(v)
        elif isinstance(value, list):
            for v in value:
                resources(v)
    resources(raw)
    validate_bundle(raw, asset_root=target)
    write(target / 'input.json', raw)
    conversion = convert_synthetic_fixture(target / 'input.json', HERE / 'legacy-recovery',
        conversion_id='r12-r1-L1-fresh', expected_input_sha256=sha((target / 'input.json').read_bytes()))
    load_recovery_bundle(HERE / 'legacy-recovery/bundle.json', asset_root=HERE / 'legacy-recovery')
    config = json.loads((source / 'config.json').read_bytes())
    config.update(book_id='book-r12-r1-legacy', scope_id='scope-r12-r1-legacy', target_id='target-r12-r1-legacy',
                  directory_map={'directory-b': 'platform-unit-b'})
    write(HERE / 'legacy-config.json', config)
    write(HERE / 'legacy-fixture-provenance.json', {'conversion': conversion, 'source_files': index(source.rglob('*')),
        'kind': 'fresh unexecuted singleton input; no executed artifact converted', 'functional_scenes_run': 0})


def pins():
    profile = ROOT / 'src/annotation/contracts/a03_native/data/profile.json'
    adoption = profile.with_name('adoption.json')
    data = json.loads(profile.read_bytes())
    selected = {'@annotation/runtime/storage/__init__.py', '@annotation/runtime/storage/native.py'}
    rows = []
    for pin in data['implementation_pins']:
        if pin[0] in selected:
            old = {'@annotation/runtime/storage/__init__.py': '93cb82da040346cfba95a312f3615b8bfc5c47edee01ba69584ac338882cfa3a',
                   '@annotation/runtime/storage/native.py': 'c3e2f01ccbfb7b64c49a5272eb51ffbe2f6af8c8abb5a51c4c9c6965166b902a'}[pin[0]]
            pin[1] = sha((ROOT / 'src' / pin[0][1:]).read_bytes())
            rows.append({'path': pin[0], 'before': old, 'after': pin[1]})
    assert len(rows) == 2
    raw = (json.dumps(data, ensure_ascii=False, indent=2) + '\n').encode('utf-8')
    profile.write_bytes(raw)
    adopted = json.loads(adoption.read_bytes())
    adopted['profile_sha256'] = sha(raw)
    adoption.write_bytes((json.dumps(adopted, ensure_ascii=False, indent=2) + '\n').encode('utf-8'))
    return rows


if __name__ == '__main__':
    if '--create-fixture' in sys.argv:
        fixture()
    pin_rows = pins()
    for path in [*HERE.glob('*.py'), TEST,
                 ROOT / 'src/annotation/runtime/storage/__init__.py', ROOT / 'src/annotation/runtime/storage/native.py']:
        compile(path.read_bytes().decode('utf-8', errors='strict'), str(path), 'exec')
    from annotation.contracts.a03_native import select_native_codec
    codec = select_native_codec()
    inputs = {'base': BASE, 'workflow': '05ba526cbd8575edc778016cf25cee13661a65c6',
        'task_sha256': 'ec269e977ed67276e5b4d1901c32c28acd75ba44870094fa0eb5fecf0cdc0076',
        'expected_branches': FAULTS, 'functional_order': list(FAULTS), 'functional_scenes_run_before_freeze': 0,
        'budgets_seconds': {'parent': 90, 'business_child': 45, 'observer': 2, 'barrier': 5, 'lease': 10},
        'max_reconcile_attempts': 1, 'retries': 0, 'pin_changes': pin_rows,
        'native_profile_sha256': codec.profile_sha256, 'native_adoption_sha256': codec.adoption_sha256,
        'files': index(p for p in frozen_files() if '__pycache__' not in p.parts and p.suffix != '.pyc' and p.name != 'inputs.json')}
    path = HERE / 'inputs.json'
    path.write_bytes((json.dumps(inputs, ensure_ascii=False, sort_keys=True, indent=2) + '\n').encode('utf-8'))
    print(json.dumps({'static_only': True, 'inputs_sha256': sha(path.read_bytes()), 'source_files': len(inputs['files']),
        'native_profile_sha256': codec.profile_sha256, 'pin_changes': pin_rows}))

51e36e5f6f12ad298a6e1062cbc4f15ad2ddd9c2 blob 1211
"""One ordered author run. Never retries or proceeds after a first failure."""
import argparse
import json
from pathlib import Path
import sys
import traceback
from support import ROOT, HERE, OUT, GROUPS, process, write, check_frozen


def run(root):
    assert root.is_relative_to(OUT)
    root.mkdir(parents=True, exist_ok=False)
    check_frozen()
    statuses = {name: 'NOT_RUN' for name in GROUPS}
    for name in GROUPS:
        try:
            process(root / 'watchdogs' / name, [sys.executable, '-X', 'utf8', '-B',
                str(HERE / 'support.py'), name, str(root)], 90)
        except BaseException:
            statuses[name] = 'FAILED'
            write(root / 'first-failure.txt', traceback.format_exc().encode('utf-8'))
            write(root / 'matrix.json', statuses)
            raise
        statuses[name] = 'PASS_AUTHOR_ONLY'
        print(json.dumps({'group': name, 'status': statuses[name]}), flush=True)
    write(root / 'matrix.json', statuses)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, default=OUT / 'validation/author-01')
    args = parser.parse_args()
    run(args.output.resolve())

8fc9f5b6a4ae1a3677e95843891688110f9068c2 blob 1049
"""Passive import provenance at normal Python exit; no business hooks."""
import atexit
import hashlib
import json
import os
from pathlib import Path
import sys


def record_imports():
    folder = os.environ.get('A03_R12_R1_IMPORT_AUDIT')
    if not folder:
        return
    result = {}
    for name, module in sorted(sys.modules.items()):
        source = getattr(module, '__file__', None)
        if source and (name.startswith('annotation') or name in ('__main__', 'support', 'sitecustomize', 'r8_fixed_helper')):
            path = Path(source).resolve()
            if path.is_file():
                result[name] = {'path': str(path), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}
    output = Path(folder)
    output.mkdir(parents=True, exist_ok=True)
    with (output / (str(os.getpid()) + '.json')).open('x', encoding='utf-8', newline='\n') as stream:
        json.dump({'pid': os.getpid(), 'imports': result}, stream, ensure_ascii=False, sort_keys=True, indent=2)
        stream.write('\n')


atexit.register(record_imports)

81fc199e27c6b972e91fdc79303203d3f1a49fc0 blob 7273
"""Create-only process and retained-copy evidence for the six bounded scenes."""
import hashlib
import json
import os
from pathlib import Path
import sqlite3
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[3]
HERE = Path(__file__).resolve().parent
OUT = ROOT / 'docs/evidence/A03/execution/P2-R12-R1-unknown-projection'
TEST = ROOT / 'tests/test_a03_p2_r12_r1_unknown_projection.py'
BASE = '394fe51f5ed14c5ed312073a20faac0f5cbb9990'
GROUPS = ('L1', 'U1', 'U2', 'U3', 'U4', 'U5')
FAULTS = {'L1': ('partial', None, None, 'CONFLICT'),
          'U1': ('partial', None, None, 'CONFLICT'),
          'U2': (None, 'unavailable', 'duplicate', 'CONFLICT'),
          'U3': (None, 'unavailable', 'contradictory', 'INDETERMINATE'),
          'U4': (None, 'unavailable', 'truncated', 'INDETERMINATE'),
          'U5': (None, 'unavailable', 'unavailable', 'INDETERMINATE')}


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def write(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    raw = value if isinstance(value, bytes) else (json.dumps(value, ensure_ascii=False, sort_keys=True,
        indent=2, allow_nan=False) + '\n').encode('utf-8')
    with path.open('xb') as stream:
        stream.write(raw)


def index(paths):
    return {p.relative_to(ROOT).as_posix(): sha(p.read_bytes()) for p in sorted(set(paths)) if p.is_file()}


def frozen_files():
    return [*ROOT.joinpath('src').rglob('*'), *HERE.rglob('*'), TEST,
        ROOT / 'tests/test_a03_r8_r3_post_hold.py',
        *ROOT.joinpath('tests/fixtures/a03/P2-R8-R3-post-hold').rglob('*')]


def check_frozen():
    frozen = json.loads((HERE / 'inputs.json').read_bytes())['files']
    for name, expected in frozen.items():
        assert sha((ROOT / name).read_bytes()) == expected, 'frozen bytes changed: ' + name
    return sha((HERE / 'inputs.json').read_bytes())


def sql_copy(path):
    before = sha(path.read_bytes())
    db = sqlite3.connect(path.resolve().as_uri() + '?mode=ro&immutable=1', uri=True)
    db.row_factory = sqlite3.Row
    try:
        assert db.execute('PRAGMA quick_check').fetchone()[0] == 'ok'
        tables = [r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")]
        rows = {name: [dict(r) for r in db.execute('SELECT * FROM "' + name.replace('"', '""') + '" ORDER BY rowid')]
                for name in tables}
        result = {'application_id': db.execute('PRAGMA application_id').fetchone()[0],
                  'user_version': db.execute('PRAGMA user_version').fetchone()[0], 'tables': rows}
    finally:
        db.close()
    assert sha(path.read_bytes()) == before, 'immutable copy changed'
    return result


def capture(case, stage, *, store=None, keeper=None):
    """Sequential raw copies, never a claim of cross-database atomicity."""
    folder = case / 'captures' / stage
    folder.mkdir(parents=True, exist_ok=False)
    records, values = [], {}
    for kind, source in (('runtime', case / 'runtime/runtime.sqlite3'), ('target', case / 'target/target.sqlite3')):
        record = {'kind': kind, 'source': str(source), 'writer_process_pid': os.getpid(),
            'writer_in_business_call': False, 'keeper_alive': bool(keeper and keeper.thread.is_alive()),
            'captured_at_ns': time.time_ns(), 'sequential_non_atomic': True}
        if not source.exists():
            record['missing'] = True
            records.append(record)
            continue
        sidecars = {suffix: sha(Path(str(source) + suffix).read_bytes())
            for suffix in ('-journal', '-wal', '-shm') if Path(str(source) + suffix).exists()}
        assert not sidecars, 'active SQLite sidecar at raw capture: ' + str(source)
        raw = source.read_bytes()
        destination = folder / (kind + '.sqlite3')
        write(destination, raw)
        record.update(sha256=sha(raw), size=len(raw), retained=destination.relative_to(ROOT).as_posix(),
            source_sha256_after_copy=sha(source.read_bytes()), sidecars=sidecars)
        assert record['sha256'] == record['source_sha256_after_copy'], 'source changed during copy'
        values[kind] = sql_copy(destination)
        assert sha(source.read_bytes()) == record['sha256'], 'source changed during immutable SQL audit'
        records.append(record)
    write(folder / 'capture.json', {'stage': stage, 'process_pid': os.getpid(), 'records': records,
        'SQL_reads_only_retained_immutable_copies': True, 'cross_database_atomic': False})
    write(folder / 'SQL.json', values)
    return values


def imports():
    result = {}
    for name, module in sorted(sys.modules.items()):
        source = getattr(module, '__file__', None)
        if source and (name.startswith('annotation') or 'r12' in name or name == 'r8_fixed_helper'):
            path = Path(source).resolve()
            assert path.is_relative_to(ROOT), 'foreign product/helper import: ' + name
            result[name] = {'path': str(path), 'sha256': sha(path.read_bytes())}
    return result


def process(folder, argv, timeout):
    folder.mkdir(parents=True, exist_ok=False)
    env = dict(os.environ, PYTHONPATH=os.pathsep.join((str(ROOT / 'src'), str(HERE))), PYTHONDONTWRITEBYTECODE='1',
        A03_R12_R1_IMPORT_AUDIT=str(folder.parents[1] / 'import-processes'))
    write(folder / 'preregistered.json', {'argv': argv, 'cwd': str(ROOT), 'timeout_seconds': timeout,
        'input_sha256': check_frozen(), 'source_index': str(HERE / 'inputs.json'), 'retries': 0,
        'script_sha256': {str(Path(arg)): sha(Path(arg).read_bytes()) for arg in argv if arg.endswith('.py')},
        'expected_exit': 0, 'PYTHONPATH': env['PYTHONPATH']})
    for arg in argv:
        if arg.endswith('.py'):
            write(folder / ('source-' + Path(arg).name), Path(arg).read_bytes())
    with (folder / 'stdout.txt').open('xb') as stdout, (folder / 'stderr.txt').open('xb') as stderr:
        child = subprocess.Popen(argv, cwd=ROOT, env=env, stdout=stdout, stderr=stderr)
        write(folder / 'started.json', {'pid': child.pid, 'parent_pid': os.getpid(), 'started_at_ns': time.time_ns()})
        timed_out = False
        try:
            code = child.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            timed_out = True
            child.kill()
            code = child.wait(timeout=5)
    write(folder / 'completed.json', {'pid': child.pid, 'exit_code': code, 'timeout': timed_out,
        'alive': child.poll() is None, 'ended_at_ns': time.time_ns(),
        'stdout_sha256': sha((folder / 'stdout.txt').read_bytes()), 'stderr_sha256': sha((folder / 'stderr.txt').read_bytes())})
    assert code == 0 and not timed_out, 'first process failure: ' + str(folder / 'stderr.txt')


def group(root, name):
    for phase in (('execute',) if name == 'L1' else ('execute', 'recover')):
        process(root / 'processes' / (name + '-' + phase),
            [sys.executable, '-X', 'utf8', '-B', str(TEST), name, phase, str(root)], 45)
    write(root / (name + '-result.json'), {'group': name, 'status': 'REVIEW', 'functional_assertions': 'PASS',
        'runs': 1, 'expected': FAULTS[name], 'case': str(root / 'cases' / name)})


if __name__ == '__main__':
    group(Path(sys.argv[2]).resolve(), sys.argv[1])

