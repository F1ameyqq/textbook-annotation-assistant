          ],
          "title": "Severity",
          "type": "string"
        },
        "blocks": {
          "items": {
            "enum": [
              "PLAN",
              "APPLY",
              "COMPLETE"
            ],
            "type": "string"
          },
          "title": "Blocks",
          "type": "array"
        },
        "suggested_strategy": {
          "$ref": "#/$defs/Strategy"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "code",
        "scope_type",
        "scope_id",
        "evidence_refs",
        "severity",
        "blocks",
        "suggested_strategy",
        "reason"
