              "$ref": "#/$defs/Resource"
            },
            {
              "type": "null"
            }
          ]
        },
        "comparator_version": {
          "const": "a02-facts-1"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "replay_allowed": {
          "const": false
        }
      },
      "required": [
        "plan_ref",
        "intent_ref",
        "obligation_id",
        "action_id",
        "action_digest",
        "original_receipt_ref",
        "previous_resolution_ref",
