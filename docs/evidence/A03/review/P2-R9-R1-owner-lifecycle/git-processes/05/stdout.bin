        },
        "code": {
          "enum": [
            "SOURCE_MISSING",
            "PAGE_MAPPING_UNCERTAIN",
            "UNASSIGNED_CONTENT",
            "CROSS_PAGE_OPEN",
            "OPTION_INCOMPLETE",
            "ANSWER_AMBIGUOUS",
            "POLICY_UNRESOLVED",
            "UNSUPPORTED_LAYOUT",
            "TARGET_CHANGED",
            "CONTENT_MISMATCH",
            "SAVE_UNKNOWN",
            "LOGIN_REQUIRED",
            "BUDGET_LIMIT"
          ],
          "title": "Code",
          "type": "string"
        },
        "scope_type": {
          "enum": [
            "book",
            "scope",
            "page",
            "question",
            "fragment",
            "region",
            "action"
          ],
          "title": "Scope Type",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Scope Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning",
