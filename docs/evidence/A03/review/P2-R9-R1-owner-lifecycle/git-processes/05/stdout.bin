              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
              "title": "Action Id",
              "type": "string"
            },
            "outcome": {
              "const": "NOT_APPLIED"
            },
            "platform_ids": {
              "items": {
                "type": "string"
              },
              "title": "Platform Ids",
              "type": "array"
            },
            "before_evidence_refs": {
              "items": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
                "type": "string"
              },
              "minItems": 1,
              "title": "Before Evidence Refs",
              "type": "array"
            },
            "after_evidence_refs": {
              "items": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
                "type": "string"
              },
              "title": "After Evidence Refs",
              "type": "array"
            },
            "readback": {
