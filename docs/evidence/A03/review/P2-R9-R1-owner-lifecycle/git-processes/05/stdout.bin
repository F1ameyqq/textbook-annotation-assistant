    "AmendedCheckReport": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.4.0-a03-native-proposal"
        },
        "artifact_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "kind": {
          "const": "CheckReport",
          "title": "Kind",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "book_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Book Id",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Scope Id",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "payload": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "stage": {
                  "const": "PRE_APPLY"
                },
                "subject": {
                  "$ref": "#/$defs/ArtifactRef"
                },
                "graph": {
                  "$ref": "#/$defs/ArtifactRef"
                },
                "policy": {
                  "$ref": "#/$defs/PolicyRef"
                },
                "snapshot": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ArtifactRef"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "receipt": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ArtifactRef"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "coverage": {
                  "$ref": "#/$defs/Coverage"
                },
                "checks": {
                  "items": {
                    "$ref": "#/$defs/CheckResult"
                  },
                  "minItems": 1,
                  "title": "Checks",
                  "type": "array"
                },
                "issues": {
                  "items": {
                    "$ref": "#/$defs/Issue"
                  },
                  "title": "Issues",
                  "type": "array"
                },
                "decision": {
                  "enum": [
                    "PASS",
                    "RETRY",
                    "EXCEPTION",
                    "HOLD"
                  ],
                  "title": "Decision",
                  "type": "string"
                },
                "reason": {
                  "minLength": 1,
                  "title": "Reason",
                  "type": "string"
                },
                "recovery_refs": {
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "artifact_id": {
                        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
                        "title": "Artifact Id",
                        "type": "string"
                      },
                      "revision": {
                        "exclusiveMinimum": 0,
                        "title": "Revision",
                        "type": "integer"
                      },
                      "kind": {
                        "const": "ReconciliationResult",
                        "type": "string"
                      },
                      "content_hash": {
                        "pattern": "^[0-9a-f]{64}$",
                        "title": "Content Hash",
                        "type": "string"
                      }
                    },
                    "required": [
                      "artifact_id",
                      "revision",
                      "kind",
                      "content_hash"
                    ],
                    "title": "ArtifactRef",
                    "type": "object"
                  },
                  "minItems": 0
                },
                "synthetic_run_ref": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "media_type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "origin": {
                      "const": "SYNTHETIC"
                    }
                  },
                  "required": [
                    "path",
                    "sha256",
                    "media_type",
                    "origin"
                  ],
                  "additionalProperties": false
                },
                "verification_context": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "INITIAL"
                        },
                        "hold_id": {
                          "type": "null"
                        },
                        "hold_head": {
                          "type": "null"
                        },
                        "hold_ref": {
                          "type": "null"
                        }
                      },
                      "required": [
                        "kind",
                        "hold_id",
                        "hold_head",
                        "hold_ref"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "POST_HOLD"
                        },
                        "hold_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "hold_head": {
                          "type": "object",
                          "properties": {
                            "sequence": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "hash": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            }
                          },
                          "required": [
                            "sequence",
                            "hash"
                          ],
                          "additionalProperties": false
                        },
                        "hold_ref": {
                          "type": "object",
                          "properties": {
                            "path": {
                              "type": "string",
                              "minLength": 1
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            },
                            "media_type": {
                              "type": "string",
                              "minLength": 1
                            },
                            "origin": {
                              "const": "SYNTHETIC"
                            }
                          },
                          "required": [
                            "path",
                            "sha256",
                            "media_type",
                            "origin"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "kind",
                        "hold_id",
                        "hold_head",
                        "hold_ref"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "stage",
                "subject",
                "graph",
                "policy",
                "snapshot",
                "receipt",
                "coverage",
                "checks",
                "issues",
                "decision",
                "reason",
                "recovery_refs",
                "synthetic_run_ref",
                "verification_context"
              ],
              "title": "CheckPayload",
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "stage": {
                  "const": "TARGET"
                },
                "subject": {
                  "$ref": "#/$defs/ArtifactRef"
