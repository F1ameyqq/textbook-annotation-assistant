            {
              "type": "null"
            }
          ]
        },
        "comparator_version": {
          "const": "a02-facts-1"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "replay_allowed": {
          "const": false
        }
      },
