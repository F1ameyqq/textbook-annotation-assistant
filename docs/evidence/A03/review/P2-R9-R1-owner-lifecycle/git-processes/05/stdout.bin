            "outcome",
            "platform_ids",
            "before_evidence_refs",
            "after_evidence_refs",
            "readback",
            "effect_match",
            "next_step",
            "replay_allowed",
            "reason",
            "attempt_fact",
            "attempt_evidence_refs",
            "intent_ref"
          ],
          "title": "ActionResult",
          "type": "object"
        },
        "journal_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "predecessor_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "design_only": {
          "type": "boolean"
        },
        "unattempted_basis": {
          "$ref": "#/$defs/Resource"
        }
      },
      "required": [
        "format_version",
        "plan_ref",
        "origin_phase",
        "resolution_ref",
        "intent_ref",
        "obligation_id",
        "action_id",
