  "title": "R2 STATIC PROPOSAL: shape + exact registry, not native eligibility",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a03:p2-r2:exchange-3",
  "$comment": "Structure only. Legacy nodes are not upgraded or granted execution eligibility. Native authority is outside JSON."
}

