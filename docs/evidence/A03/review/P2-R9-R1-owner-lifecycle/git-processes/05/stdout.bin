aa1e1a3a40c1ec7e4e9428a8d9ea1ca3cddd8e71 blob 75449
"""Approved A03 recovery contracts. No store authority or target effects live here.

The serialized contract proves shape, bytes and exact dependencies. Runtime must
independently prove current owner, original durable intent and the whole book.
Legacy C01 inputs keep their separate, unchanged validator and archive semantics.
"""
import copy
import hashlib
import json
from datetime import datetime
from pathlib import Path

from .integrity import artifact_ref, content_digest, file_digest, read_json
from .models import relative_path
from .recovery_schema import FrozenSchemas
from .validation import fail, image_size

RECOVERY_SCHEMA_VERSION = '1.1.0-a-recovery-proposal'
RECOVERY_EXCHANGE_VERSION = 'a03-exchange-1'
RECOVERY_PROFILE = 'A03-P1-R2'
REF_FIELDS = {'artifact_id', 'revision', 'kind', 'content_hash'}
RESOURCE_FIELDS = {'path', 'sha256', 'media_type', 'origin'}
EVIDENCE_FIELDS = {'evidence_refs', 'before_evidence_refs', 'after_evidence_refs', 'submission_evidence_refs'}
NEW_KINDS = {'WriteIntent', 'ExecutionProgress', 'ReconciliationResult'}


class Node(dict):
    """JSON value with the attribute/model_dump interface used by A02 helpers."""
    def __getattr__(self, key):
        try:
            return self[key]
        except KeyError as error:
            raise AttributeError(key) from error

    def model_dump(self, mode='json', **kwargs):
        return json.loads(json.dumps(self, ensure_ascii=False, allow_nan=False))


def _node(value):
    if isinstance(value, dict):
        return Node({k: _node(v) for k, v in value.items()})
    if isinstance(value, list):
        return [_node(v) for v in value]
    return value


class RecoveryExchangeBundle(Node):
    """Validated value plus explicit resource root; still no execution permission."""
    def __init__(self, value, asset_root):
        super().__init__(_node(value))
        self.asset_root = Path(asset_root).resolve()
        self.profile = RECOVERY_PROFILE


def canonical_hash(value):
    return hashlib.sha256(json.dumps(value, ensure_ascii=False, sort_keys=True,
                                    separators=(',', ':'), allow_nan=False).encode('utf-8')).hexdigest()


def target_state_digest(state):
    """Business state only; observation metadata, fencing and logs are excluded."""
    value = _data(state)
    target = value.get('target', value)
    result = {k: value[k] for k in ('target_key', 'source_ref', 'scope_id')}
    result.update({k: target[k] for k in ('platform_version', 'capabilities', 'directories', 'questions', 'frames')})
    result.update({k: value[k] for k in ('internal_bindings', 'frame_projections')})
    return canonical_hash(result)


def _data(value):
    return value.model_dump(mode='json') if hasattr(value, 'model_dump') else copy.deepcopy(value)


def _walk(value):
    yield value
    if isinstance(value, dict):
        for child in value.values():
            yield from _walk(child)
    elif isinstance(value, list):
        for child in value:
            yield from _walk(child)


def _is_ref(value):
    return isinstance(value, dict) and set(value) == REF_FIELDS


def _is_resource(value):
    return isinstance(value, dict) and {'path', 'sha256', 'media_type'} <= set(value)


def _identity(artifact):
    return artifact['book_id'], artifact['scope_id'], artifact['artifact_id'], artifact['revision']


def _artifact_node(artifact):
    return ('a',) + _identity(artifact)


def recovery_artifact_ref(artifact):
    return artifact_ref(_data(artifact))


def seal_recovery_artifact(data):
    value = _data(data)
    value['content_hash'] = '0' * 64
    FrozenSchemas().check(value, definition=value.get('kind'))
    value['content_hash'] = content_digest(value)
    return value


def recovery_schema():
    return copy.deepcopy(FrozenSchemas().documents['recovery-exchange.schema.json'])


class _Closure:
    def __init__(self, bundle, root, synthetic=True, *, schema_version=RECOVERY_SCHEMA_VERSION):
        self.bundle, self.root, self.synthetic = bundle, Path(root).resolve(), synthetic
        self.artifacts, self.evidence, self.graph, self.decoded = {}, {}, {}, {}
        self.schemas = FrozenSchemas()
        for artifact in bundle['artifacts']:
            key = _identity(artifact)
            if key in self.artifacts:
                fail('$.artifacts', 'ARTIFACT_IDENTITY_CONFLICT', 'immutable identity appears twice')
            if artifact['schema_version'] != schema_version:
                fail('$.artifacts', 'CROSS_VERSION_REFERENCE', 'mixed artifact namespace')
            if content_digest(artifact) != artifact['content_hash']:
                fail('$.artifacts', 'REFERENCE_HASH_MISMATCH', 'artifact canonical digest differs')
            self.artifacts[key] = artifact
        for record in bundle['evidence']:
            if record['evidence_id'] in self.evidence:
                fail('$.evidence', 'DUPLICATE_EVIDENCE_ID', 'evidence IDs must be unique')
            self.evidence[record['evidence_id']] = record
            if synthetic and record['mode'] != 'SYNTHETIC':
                fail('$.evidence', 'SYNTHETIC_ONLY', 'observed evidence is not simulated input')
        policies = set()
        for policy in bundle['policies']:
            key = (policy['policy_id'], policy['revision'])
            if key in policies or content_digest(policy) != policy['content_hash']:
                fail('$.policies', 'POLICY_CONFLICT', 'duplicate or incorrect policy binding')
            policies.add(key)

    def resolve(self, ref, consumer=None, kind=None):
        if not _is_ref(ref):
            fail('$.reference', 'SCHEMA', 'ordinary reference must be exact four-tuple')
        values = [a for a in self.artifacts.values() if (a['artifact_id'], a['revision']) == (ref['artifact_id'], ref['revision'])]
        if consumer:
            local = [a for a in values if (a['book_id'], a['scope_id']) == (consumer['book_id'], consumer['scope_id'])]
            if values and not local:
                fail('$.reference', 'REFERENCE_SCOPE_MISMATCH', 'ordinary dependency crosses book or scope')
            values = local
        if not values:
            fail('$.reference', 'MISSING_REFERENCE', 'exact artifact identity is absent')
        matches = [a for a in values if a['content_hash'] == ref['content_hash'] and a['kind'] == ref['kind']]
        if not matches:
            fail('$.reference', 'REFERENCE_HASH_MISMATCH', 'artifact kind/digest differs')
        if len(matches) != 1:
            fail('$.reference', 'REFERENCE_SCOPE_MISMATCH', 'reference requires an unambiguous owning scope')
        value = matches[0]
        if kind and value['kind'] != kind:
            fail('$.reference', 'RECOVERY_CHAIN_INVALID', 'unexpected dependency kind')
        if consumer and (value['book_id'], value['scope_id']) != (consumer['book_id'], consumer['scope_id']):
            fail('$.reference', 'REFERENCE_SCOPE_MISMATCH', 'ordinary dependency crosses book or scope')
        return value

    def resource(self, resource):
        if not RESOURCE_FIELDS <= set(resource):
            fail('$.resource', 'SCHEMA', 'recovery resource requires origin')
        if self.synthetic and resource['origin'] != 'SYNTHETIC':
            fail('$.resource', 'SYNTHETIC_ONLY', 'resource origin is not synthetic')
        try:
            relative_path(resource['path'])
        except ValueError as error:
            fail('$.resource.path', 'PATH_ESCAPE', str(error))
        target = (self.root / resource['path']).resolve()
        try:
            target.relative_to(self.root)
        except ValueError:
            fail('$.resource.path', 'PATH_ESCAPE', 'resource escapes asset root')
        if not target.is_file():
            fail('$.resource', 'RESOURCE_MISSING', resource['path'])
        raw = target.read_bytes()
        if hashlib.sha256(raw).hexdigest() != resource['sha256']:
            fail('$.resource', 'RESOURCE_HASH_MISMATCH', resource['path'])
        if 'asset_id' in resource:
            try:
                size = image_size(target, resource['media_type'])
            except (OSError, ValueError) as error:
                fail('$.resource', 'IMAGE_HEADER', str(error))
            if size != (resource['width'], resource['height']):
                fail('$.resource', 'IMAGE_DIMENSIONS', 'declared image size differs')
        key = ('r', resource['path'], resource['sha256'], resource['media_type'])
        if key not in self.decoded:
            try:
                self.decoded[key] = read_json(target) if resource['media_type'] == 'application/json' else None
            except (OSError, ValueError) as error:
                fail('$.resource', 'JSON_INPUT', str(error))
        return key, self.decoded[key]

    def check(self):
        # Every consumer has its own traversal and declaration test. Parsed-byte
        # caching never inherits another artifact's declarations or scope.
        for artifact in self.artifacts.values():
            parent = _artifact_node(artifact)
            declared = [canonical_hash(ref) for ref in artifact['input_refs']]
            if len(set(declared)) != len(declared):
                fail('$.input_refs', 'DUPLICATE_ID', 'duplicate ordinary declaration')
            self.graph.setdefault(parent, set())
            seen = set()

            def visit(value, node, active, envelope=False):
                if _is_ref(value):
                    dep = self.resolve(value, artifact)
                    if canonical_hash(value) not in declared:
                        fail('$.input_refs', 'UNDECLARED_RESOURCE_REFERENCE', 'consumer must declare exact nested ordinary ref')
                    self.graph.setdefault(node, set()).add(_artifact_node(dep))
                    return
                # Malformed would-be ordinary refs may not hide as arbitrary JSON.
                if isinstance(value, dict) and REF_FIELDS <= set(value) and not envelope:
                    fail('$.reference', 'SCHEMA', 'ordinary reference has extra fields')
                if _is_resource(value):
                    resource_node, body = self.resource(value)
                    self.graph.setdefault(node, set()).add(resource_node)
                    self.graph.setdefault(resource_node, set())
                    if resource_node in active:
                        fail('$.resource', 'RESOURCE_REFERENCE_CYCLE', 'recursive resource cycle')
                    if resource_node not in seen:
                        seen.add(resource_node)
                        visit(body, resource_node, active | {resource_node})
                    return
                if isinstance(value, dict):
                    if self.synthetic:
                        if value.get('origin', 'SYNTHETIC') != 'SYNTHETIC' or value.get('provenance', 'SYNTHETIC') != 'SYNTHETIC':
                            fail('$.origin', 'SYNTHETIC_ONLY', 'nested real origin cannot be relabeled')
                        if value.get('evidence_mode', 'SYNTHETIC') != 'SYNTHETIC':
                            fail('$.producer', 'SYNTHETIC_ONLY', 'observed producer')
                        if 'region_id' in value and value.get('source', 'SYNTHETIC') != 'SYNTHETIC':
                            fail('$.source', 'SYNTHETIC_ONLY', 'region source is not synthetic')
                        if 'clue_id' in value and value.get('source', 'SYNTHETIC') != 'SYNTHETIC':
                            fail('$.source', 'SYNTHETIC_ONLY', 'coverage source is not synthetic')
                        if value.get('execution_mode', 'SIMULATED') not in ('SIMULATED', 'NOT_EXECUTED'):
                            fail('$.execution_mode', 'SYNTHETIC_ONLY', 'real execution mode')
                    for field, child in value.items():
                        if envelope and field == 'content_hash':
                            continue
                        if field in EVIDENCE_FIELDS and isinstance(child, list):
                            for evidence_id in child:
                                if isinstance(evidence_id, str):
                                    if evidence_id not in self.evidence:
                                        fail('$.evidence_refs', 'MISSING_REFERENCE', 'formal evidence ID is absent')
                                    visit(self.evidence[evidence_id]['resource'], node, active)
                        visit(child, node, active)
                elif isinstance(value, list):
                    for child in value:
                        visit(child, node, active)
            visit(artifact, parent, set(), envelope=True)
        # Unused evidence is still part of the all-synthetic input package.
        # Recurse for byte/origin/shape checks without inventing an Artifact
        # consumer or inheriting a different consumer's declaration closure.
        checked_evidence_resources = set()
        def audit_evidence(value, parent=None, active=frozenset()):
            if _is_resource(value):
                node, body = self.resource(value)
                if parent:
                    self.graph.setdefault(parent, set()).add(node)
                self.graph.setdefault(node, set())
                if node in active:
                    fail('$.evidence', 'RESOURCE_REFERENCE_CYCLE', 'nested evidence resource cycle')
                if node not in checked_evidence_resources:
                    checked_evidence_resources.add(node)
                    audit_evidence(body, node, active | {node})
                return
            if _is_ref(value):
                dependency = self.resolve(value)
                if parent:
                    self.graph.setdefault(parent, set()).add(_artifact_node(dependency))
                return
            if isinstance(value, dict):
                if REF_FIELDS <= set(value):
                    fail('$.evidence', 'SCHEMA', 'nested ordinary ref must have exactly four fields')
                if self.synthetic and (value.get('origin', 'SYNTHETIC') != 'SYNTHETIC' or
                        value.get('provenance', 'SYNTHETIC') != 'SYNTHETIC' or
                        value.get('evidence_mode', 'SYNTHETIC') != 'SYNTHETIC' or
                        ('region_id' in value and value.get('source', 'SYNTHETIC') != 'SYNTHETIC') or
                        ('clue_id' in value and value.get('source', 'SYNTHETIC') != 'SYNTHETIC') or
                        value.get('execution_mode', 'SIMULATED') not in ('SIMULATED', 'NOT_EXECUTED')):
                    fail('$.evidence', 'SYNTHETIC_ONLY', 'unused nested evidence has real provenance')
                for child in value.values():
                    audit_evidence(child, parent, active)
            elif isinstance(value, list):
                for child in value:
                    audit_evidence(child, parent, active)
        for record in self.evidence.values():
            audit_evidence(record['resource'])
        active, done = [], set()

        def dag(node):
            if node in active:
                cycle = active[active.index(node):]
                code = 'RESOURCE_REFERENCE_CYCLE' if any(n[0] == 'r' for n in cycle) else 'REFERENCE_CYCLE'
                fail('$.dependencies', code, 'dependency cycle')
            if node not in done:
                active.append(node)
                for dependency in self.graph.get(node, set()):
                    dag(dependency)
                active.pop()
                done.add(node)
        for node in self.graph:
            dag(node)


def _timestamp(value):
    try:
        stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))
    except (ValueError, AttributeError):
        fail('$.time', 'SCHEMA', 'expected timezone timestamp')
    if stamp.tzinfo is None:
        fail('$.time', 'SCHEMA', 'timestamp requires timezone')
    return stamp


def _snapshot_business_equal(first, second):
    if not isinstance(first, dict) or not isinstance(second, dict):
        return False
    metadata = {'observed_at', 'observed_version', 'observed_hash'}
    return {k: v for k, v in first.items() if k not in metadata} == {k: v for k, v in second.items() if k not in metadata}


def _scope(ctx):
    for source in ctx.artifacts.values():
        if source['kind'] != 'SourceBundle':
            continue
        p = source['payload']
        integrity = p['scope_integrity']
        if integrity['status'] != 'SYNTHETIC_COMPLETE' or integrity['basis'] != 'FIXTURE' or integrity['proof'] is None:
            fail('$.scope_integrity', 'SYNTHETIC_COMPLETE_REQUIRED', 'A03 requires explicit complete synthetic fixture proof')
        _, proof = ctx.resource(integrity['proof'])
        if not isinstance(proof, dict):
            fail('$.scope_integrity', 'SYNTHETIC_COMPLETE_REQUIRED', 'proof must be JSON')
        required = {'book_id': source['book_id'], 'scope_id': source['scope_id'],
                    'pages_expected': p['pages_expected'], 'pages_acquired': p['pages_acquired'],
                    'scope_manifest': p['scope_manifest']}
        if proof.get('origin') != 'SYNTHETIC' or proof.get('basis') != 'FIXTURE' or proof.get('complete') is not True:
            fail('$.scope_integrity', 'SYNTHETIC_COMPLETE_REQUIRED', 'proof fixture binding absent')
        if any(proof.get(k) != v for k, v in required.items()) or p['scope_manifest'] is None:
            fail('$.scope_integrity', 'SYNTHETIC_COMPLETE_REQUIRED', 'proof book/scope/page/question manifest differs')
        assets = [{k: a[k] for k in ('asset_id', 'path', 'sha256', 'width', 'height')} for a in p['assets']]
        if proof.get('assets') != assets or set(p['pages_expected']) != set(p['pages_acquired']):
            fail('$.scope_integrity', 'SYNTHETIC_COMPLETE_REQUIRED', 'proof assets/pages differ')
        rows = proof.get('per_page_questions', [])
        if {r.get('asset_id') for r in rows} != set(p['pages_expected']) or len(rows) != len(p['pages_expected']):
            fail('$.scope_integrity', 'SYNTHETIC_COMPLETE_REQUIRED', 'one independent enumeration per fixture page required')
        questions = set()
        for row in rows:
            if row.get('enumeration_complete') is not True or not isinstance(row.get('question_ids'), list):
                fail('$.scope_integrity', 'SYNTHETIC_COMPLETE_REQUIRED', 'incomplete page enumeration')
            if len(row['question_ids']) != len(set(row['question_ids'])):
                fail('$.scope_integrity', 'SYNTHETIC_COMPLETE_REQUIRED', 'duplicate page question')
            questions.update(row['question_ids'])
        if questions != set(p['scope_manifest']) or len(set(p['scope_manifest'])) != len(p['scope_manifest']):
            fail('$.scope_integrity', 'SYNTHETIC_COMPLETE_REQUIRED', 'page enumeration differs from full scope')


def _plan_action(ctx, plan_ref, action_id, consumer):
    plan = ctx.resolve(plan_ref, consumer, 'ApplyPlan')
    actions = [a for a in plan['payload']['actions'] if a['action_id'] == action_id]
    if len(actions) != 1:
        fail('$.action_id', 'RECOVERY_CHAIN_INVALID', 'action absent or duplicate in exact plan')
    return plan, actions[0]


def obligation_id(intent):
    p = _data(intent)['payload']
    return 'obl-' + canonical_hash({'journal_id': p['journal_id'], 'target_key': p['target_key'],
                                    'intent_ref': recovery_artifact_ref(intent),
                                    'journal_sequence': p['journal_sequence'],
                                    'journal_head_hash': p['journal_head_hash']})


def plan_dependency_digest(plan, source_ref, target_session_id, prepared_before):
    p = _data(plan)['payload']
    dependencies = {k: p[k] for k in ('graph', 'precheck', 'targetcheck', 'snapshot', 'policy',
                                     'execution_mode', 'session_mode', 'required_capabilities')}
    return canonical_hash({'plan_dependencies_digest': canonical_hash(dependencies), 'source_ref': _data(source_ref),
                           'target_session_id': target_session_id, 'comparator_version': 'a02-facts-1',
                           'prepared_before_sha256': _data(prepared_before)['sha256']})


def _intents(ctx):
    seen = set()
    for intent in ctx.artifacts.values():
        if intent['kind'] != 'WriteIntent':
            continue
        p = intent['payload']
        plan, action = _plan_action(ctx, p['plan_ref'], p['action_id'], intent)
        if p['action_digest'] != canonical_hash(action):
            fail('$.action_digest', 'ACTION_DIGEST_MISMATCH', 'intent complete action digest differs')
        graph = ctx.resolve(plan['payload']['graph'], intent, 'QuestionGraph')
        if p['source_ref'] != graph['payload']['source'] or p['before_snapshot_ref'] != plan['payload']['snapshot']:
            fail('$.intent', 'RECOVERY_CHAIN_INVALID', 'intent source/initial snapshot differs')
        if p['question_id'] != action['target']['question_id'] or p['source_entity_ids'] != action['source_entity_ids']:
            fail('$.intent', 'ACTION_DIGEST_MISMATCH', 'intent question/entities differ')
        if p['target_key']['book_id'] != intent['book_id'] or p['target_key']['target_id'] != action['target']['target_id']:
            fail('$.target_key', 'TARGET_IDENTITY_MISMATCH', 'intent target differs')
        key = canonical_hash([p['target_key'], p['plan_ref'], p['action_id']])
        if key in seen:
            fail('$.intent', 'INTENT_CONFLICT', 'duplicate plan/action intent')
        seen.add(key)
        _, prepared = ctx.resource(p['prepared_before'])
        if not isinstance(prepared, dict) or prepared.get('action_id') != p['action_id']:
            fail('$.prepared_before', 'OBSERVATION_BINDING_MISMATCH', 'prepare does not bind action')
        if prepared.get('source_ref') != p['source_ref'] or prepared.get('target_session_id') != p['target_session_id']:
            fail('$.prepared_before', 'OBSERVATION_BINDING_MISMATCH', 'prepare source/session differs')
        if p['plan_dependency_digest'] != plan_dependency_digest(plan, p['source_ref'], p['target_session_id'], p['prepared_before']):
            fail('$.plan_dependency_digest', 'ACTION_DIGEST_MISMATCH', 'exact plan dependency digest differs')
        if _timestamp(prepared.get('observed_at')) > _timestamp(p['intent_committed_at']):
            fail('$.intent', 'OBSERVATION_NOT_FRESH', 'prepare occurs after intent')


def _observation_binding(ctx, resolution, intent):
    p, ip = resolution['payload'], intent['payload']
    fields = ('observed_snapshot_ref', 'readback', 'read_sequence', 'target_state_version', 'target_state_hash')
    if p['observation'] in ('MATCH', 'ABSENT') and any(p[k] is None for k in fields):
        fail('$.resolution', 'OBSERVATION_BINDING_MISMATCH', 'decisive observation requires complete actual read bindings')
    if _timestamp(p['observed_at']) <= _timestamp(ip['intent_committed_at']):
        fail('$.resolution', 'OBSERVATION_NOT_FRESH', 'observation must follow original intent')
    _, prepared = ctx.resource(ip['prepared_before'])
    if p['read_sequence'] is not None:
        if type(prepared.get('read_sequence')) is not int or prepared['read_sequence'] >= p['read_sequence']:
            fail('$.resolution', 'OBSERVATION_NOT_FRESH', 'read sequence must follow the original actual prepare read')
    if p['readback'] is None:
        if p['observation'] != 'INDETERMINATE' or p['resolution'] != 'STILL_UNKNOWN':
            fail('$.resolution', 'OBSERVATION_BINDING_MISMATCH', 'failed read cannot decide outcome')
        return
    _, readback = ctx.resource(p['readback'])
    if not isinstance(readback, dict):
        fail('$.readback', 'OBSERVATION_BINDING_MISMATCH', 'readback must be complete JSON observation')
    required = {'observation_id': p['observation_id'], 'observed_at': p['observed_at'],
                'read_sequence': p['read_sequence'], 'target_state_version': p['target_state_version'],
                'target_state_hash': p['target_state_hash'], 'target_key': ip['target_key'],
                'source_ref': ip['source_ref'], 'scope_id': intent['scope_id'],
                'target_session_id': ip['target_session_id']}
    if any(readback.get(k) != v for k, v in required.items()):
        fail('$.readback', 'OBSERVATION_BINDING_MISMATCH', 'observation identity/state differs')
    if p['observed_snapshot_ref'] is not None:
        snapshot = ctx.resolve(p['observed_snapshot_ref'], resolution, 'PlatformSnapshot')['payload']
        if (snapshot['observed_at'], snapshot['observed_version'], snapshot['observed_hash']) != (p['observed_at'], p['target_state_version'], p['target_state_hash']):
            fail('$.snapshot', 'OBSERVATION_BINDING_MISMATCH', 'snapshot observation differs')
        view = readback.get('view')
        if not isinstance(view, dict) or not _snapshot_business_equal(view.get('target'), snapshot):
            fail('$.readback', 'OBSERVATION_BINDING_MISMATCH', 'readback view differs from exact snapshot')
        digest_input = dict(view, target_key=ip['target_key'], source_ref=ip['source_ref'], scope_id=intent['scope_id'])
        if target_state_digest(digest_input) != p['target_state_hash']:
            fail('$.readback', 'OBSERVATION_BINDING_MISMATCH', 'business state digest differs')
    if p['observation'] in ('MATCH', 'ABSENT'):
        if readback.get('scope_complete') is not True or not p['evidence_refs']:
            fail('$.readback', 'OBSERVATION_BINDING_MISMATCH', 'decisive read needs complete scope and evidence')
        ids = readback.get('action_ids')
        if ids is not None and p['action_id'] not in ids:
            fail('$.readback', 'OBSERVATION_BINDING_MISMATCH', 'action is outside observed relevant scope')


def _resolutions(ctx):
    successors, heads, observations, attempts = {}, {}, set(), set()
    resolutions = [a for a in ctx.artifacts.values() if a['kind'] == 'ReconciliationResult']
    for resolution in resolutions:
        p = resolution['payload']
        intent = ctx.resolve(p['intent_ref'], resolution, 'WriteIntent')
        ip = intent['payload']
        if (p['plan_ref'], p['action_id'], p['action_digest']) != (ip['plan_ref'], ip['action_id'], ip['action_digest']):
            fail('$.resolution', 'RECOVERY_CHAIN_INVALID', 'resolution plan/action differs from intent')
        if p['obligation_id'] != obligation_id(intent):
            fail('$.obligation_id', 'RECOVERY_CHAIN_INVALID', 'obligation must derive from exact original intent')
        expected = {'MATCH': 'RESOLVED_APPLIED', 'ABSENT': 'RESOLVED_NOT_APPLIED',
                    'CONFLICT': 'STILL_UNKNOWN', 'INDETERMINATE': 'STILL_UNKNOWN'}[p['observation']]
        if p['resolution'] != expected or (p['observation'] == 'MATCH' and not p['platform_ids']):
            fail('$.resolution', 'RECOVERY_CHAIN_INVALID', 'observation/outcome/IDs inconsistent')
        if p['observation'] == 'ABSENT' and p['platform_ids']:
            fail('$.resolution', 'RECOVERY_CHAIN_INVALID', 'ABSENT cannot claim applied platform IDs')
        if p['observation_id'] in observations:
            fail('$.observation_id', 'OBSERVATION_NOT_FRESH', 'observation identity reused')
        observations.add(p['observation_id'])
        attempt = (p['recovery_call_id'], canonical_hash(p['intent_ref']), p['attempt_index'])
        if attempt in attempts:
            fail('$.attempt_index', 'RECOVERY_CHAIN_INVALID', 'recovery attempt reused')
        attempts.add(attempt)
        previous = p['previous_resolution_ref']
        chain_key = canonical_hash(p['intent_ref'])
        previous_key = canonical_hash(previous) if previous else ('ROOT:' + chain_key)
        if previous_key in successors:
            fail('$.previous_resolution_ref', 'RESOLUTION_FORK', 'one unique successor required')
        successors[previous_key] = resolution
        if previous:
            prior = ctx.resolve(previous, resolution, 'ReconciliationResult')['payload']
            if prior['resolution'] != 'STILL_UNKNOWN':
                fail('$.previous_resolution_ref', 'RESOLUTION_TERMINAL', 'terminal resolution has no successor')
            for field in ('intent_ref', 'plan_ref', 'action_id', 'action_digest', 'obligation_id', 'original_receipt_ref'):
                if prior[field] != p[field]:
                    fail('$.previous_resolution_ref', 'RECOVERY_CHAIN_INVALID', 'resolution chain changes binding')
            if (_timestamp(p['observed_at']) <= _timestamp(prior['observed_at']) or
                    (p['read_sequence'] is not None and prior['read_sequence'] is not None and p['read_sequence'] <= prior['read_sequence'])):
                fail('$.resolution', 'OBSERVATION_NOT_FRESH', 'chain must use a new increasing actual observation')
            if p['recovery_call_id'] == prior['recovery_call_id'] and p['attempt_index'] != prior['attempt_index'] + 1:
                fail('$.attempt_index', 'RECOVERY_CHAIN_INVALID', 'same invocation attempt index must increase once')
        elif p['attempt_index'] != 1:
            fail('$.attempt_index', 'RECOVERY_CHAIN_INVALID', 'new chain starts at first attempt')
        if p['original_receipt_ref'] is not None:
            receipt = ctx.resolve(p['original_receipt_ref'], resolution, 'ExecutionReceipt')
            results = [r for r in receipt['payload']['results'] if r['action_id'] == p['action_id']]
            if receipt['payload']['plan'] != p['plan_ref'] or len(results) != 1 or results[0]['outcome'] != 'UNKNOWN' or results[0]['intent_ref'] != p['intent_ref']:
                fail('$.original_receipt_ref', 'RECOVERY_CHAIN_INVALID', 'resolution requires exact original UNKNOWN intent result')
        _observation_binding(ctx, resolution, intent)
    for resolution in resolutions:
        if canonical_hash(recovery_artifact_ref(resolution)) not in successors:
            heads[canonical_hash(resolution['payload']['intent_ref'])] = resolution
    return heads


def _unattempted(ctx, fact, consumer, plan, action):
    from .prefix_validation import validate_prefix
    basis_ref = fact['unattempted_basis']
    if basis_ref is None:
        fail('$.fact', 'NOT_ATTEMPTED_WITHOUT_ABSENT', 'never-called result requires its dedicated basis')
    _, basis = ctx.resource(basis_ref)
    ctx.schemas.check(basis, 'unattempted-basis.schema.json')
    required = {'plan_ref': fact['plan_ref'], 'action_id': fact['action_id'],
                'action_digest': fact['action_digest'], 'scope_id': consumer['scope_id']}
    if any(basis.get(k) != v for k, v in required.items()) or basis['comparison'] != 'ABSENT':
        fail('$.unattempted_basis', 'NOT_ATTEMPTED_WITHOUT_ABSENT', 'basis does not prove this exact tail action absent')
    if fact['intent_ref'] is not None or fact['obligation_id'] is not None or fact['resolution_ref'] is not None or fact['result']['intent_ref'] is not None:
        fail('$.fact', 'RECOVERY_CHAIN_INVALID', 'unattempted fact cannot fabricate an intent or obligation')
    _, prefix = ctx.resource(basis['complete_uncalled_prefix'])
    errors = validate_prefix(prefix, plan, basis['expected_event_head'], fact['action_id'])
    if errors:
        fail('$.unattempted_basis', errors[0], 'invalid complete accepted-plan-to-head prefix')
    if (fact['journal_sequence'], fact['predecessor_hash']) != (basis['expected_event_head']['sequence'] + 1, basis['expected_event_head']['hash']):
        fail('$.fact', 'RECOVERY_CHAIN_INVALID', 'tail result does not bind exact CAS predecessor')
    if fact['prepared_before'] != basis['readonly_prepared_ref'] or fact['readback'] != basis['second_observation_ref']:
        fail('$.fact', 'OBSERVATION_BINDING_MISMATCH', 'fact must consume both dedicated actual reads')
    _, first = ctx.resource(basis['first_observation_ref'])
    _, second = ctx.resource(basis['second_observation_ref'])
    _, prepared = ctx.resource(basis['readonly_prepared_ref'])
    if not all(isinstance(item, dict) for item in (first, second, prepared)):
        fail('$.fact', 'OBSERVATION_BINDING_MISMATCH', 'readonly observations must be JSON')
    for item in (first, second):
        expected = {'target_key': basis['target_key'], 'target_session_id': basis['target_session_id'],
                    'source_ref': basis['source_ref'], 'scope_id': basis['scope_id']}
        if any(item.get(k) != v for k, v in expected.items()) or item.get('scope_complete') is not True:
            fail('$.fact', 'OBSERVATION_BINDING_MISMATCH', 'tail reads require exact full relevant scope')
    if (first.get('observation_id') == second.get('observation_id') or
            type(first.get('read_sequence')) is not int or type(second.get('read_sequence')) is not int or
            first['read_sequence'] >= second['read_sequence'] or
            _timestamp(first.get('observed_at')) >= _timestamp(second.get('observed_at'))):
        fail('$.fact', 'OBSERVATION_NOT_FRESH', 'two distinct increasing reads are required')
    if prepared.get('observation_id') != first.get('observation_id') or prepared.get('read_sequence') != first.get('read_sequence'):
        fail('$.prepared_before', 'OBSERVATION_BINDING_MISMATCH', 'readonly prepare must derive from first actual read')
    if fact['result']['outcome'] != 'NOT_APPLIED' or fact['result']['effect_match'] != 'ABSENT':
        fail('$.fact', 'NOT_ATTEMPTED_WITHOUT_ABSENT', 'tail evidence cannot imply execution')
    # A prior result resource and its intent must agree with their exact events.
    for event in prefix['events']:
        p = event['payload']
        if event['event'] == 'WRITE_INTENT_COMMITTED':
            intent = ctx.resolve(p['intent_ref'], consumer, 'WriteIntent')
            ip = intent['payload']
            if (ip['journal_sequence'], ip['journal_head_hash'], ip['action_digest']) != (event['sequence'], event['previous_hash'], p['action_digest']):
                fail('$.prefix', 'RECOVERY_CHAIN_INVALID', 'intent event and immutable intent disagree')
        if event['event'] in ('ACTION_RESULT_COMMITTED', 'UNATTEMPTED_ABSENCE_COMMITTED'):
            _, prior = ctx.resource(p['fact'])
            if (prior['journal_sequence'], prior['predecessor_hash'], prior['action_id'], prior['action_digest']) != (event['sequence'], event['previous_hash'], p['action_id'], p['action_digest']):
                fail('$.prefix', 'RECOVERY_CHAIN_INVALID', 'prior immutable result and event disagree')


def _fact(ctx, resource, consumer):
    _, fact = ctx.resource(resource)
    ctx.schemas.check(fact, 'action-fact.schema.json')
    plan, action = _plan_action(ctx, fact['plan_ref'], fact['action_id'], consumer)
    if fact['action_digest'] != canonical_hash(action) or fact['result']['action_id'] != fact['action_id']:
        fail('$.fact', 'ACTION_DIGEST_MISMATCH', 'fact action differs')
    result = fact['result']
    # C01 result constraints are retained without weakening new required fields.
    from .models import ActionResult
    from pydantic import ValidationError
    try:
        ActionResult.model_validate({k: v for k, v in result.items() if k not in ('attempt_fact', 'attempt_evidence_refs', 'intent_ref') and k != 'readback'} |
                                    {'readback': {k: v for k, v in result['readback'].items() if k != 'origin'} if result['readback'] else None})
    except ValidationError as error:
        fail('$.fact.result', 'SCHEMA', str(error))
    if result['readback'] != fact['readback'] or result['intent_ref'] != fact['intent_ref']:
        fail('$.fact', 'RECOVERY_CHAIN_INVALID', 'embedded result must exactly bind fact readback and intent')
    if not result['attempt_evidence_refs']:
        fail('$.fact', 'RECOVERY_CHAIN_INVALID', 'every result requires explicit attempt evidence')
    if fact['origin_phase'] == 'UNATTEMPTED_ABSENCE':
        if result['attempt_fact'] != 'NOT_ATTEMPTED':
            fail('$.fact', 'NOT_ATTEMPTED_WITHOUT_ABSENT', 'tail fact must retain never-called classification')
        _unattempted(ctx, fact, consumer, plan, action)
    else:
        if fact['intent_ref'] is None or result['attempt_fact'] in ('NOT_ATTEMPTED', 'LEGACY_UNRECORDED') or fact['unattempted_basis'] is not None:
            fail('$.fact', 'LEGACY_UNRECORDED', 'attempted fact needs original intent, no tail basis')
        intent = ctx.resolve(fact['intent_ref'], consumer, 'WriteIntent')
        if fact['obligation_id'] != obligation_id(intent) or intent['payload']['plan_ref'] != fact['plan_ref'] or intent['payload']['action_id'] != fact['action_id']:
            fail('$.fact', 'RECOVERY_CHAIN_INVALID', 'fact obligation or original action differs')
        if fact['prepared_before'] != intent['payload']['prepared_before']:
            fail('$.fact', 'OBSERVATION_BINDING_MISMATCH', 'fact cannot replace original dispatch prepare')
        if fact['origin_phase'] == 'RECOVERY':
            if fact['resolution_ref'] is None:
                fail('$.fact', 'RECOVERY_CHAIN_INVALID', 'recovery fact requires resolution')
            resolution = ctx.resolve(fact['resolution_ref'], consumer, 'ReconciliationResult')['payload']
            if resolution['intent_ref'] != fact['intent_ref'] or resolution['readback'] != fact['readback']:
                fail('$.fact', 'RECOVERY_CHAIN_INVALID', 'recovery fact does not bind resolution')
            expected = {'RESOLVED_APPLIED': 'APPLIED', 'RESOLVED_NOT_APPLIED': 'NOT_APPLIED', 'STILL_UNKNOWN': 'UNKNOWN'}[resolution['resolution']]
            if result['outcome'] != expected:
                fail('$.fact', 'RECOVERY_CHAIN_INVALID', 'recovery fact outcome differs from resolution')
        elif fact['resolution_ref'] is not None:
            fail('$.fact', 'RECOVERY_CHAIN_INVALID', 'execution fact cannot claim later resolution')
    if fact['observed_snapshot_ref'] is not None:
        snapshot = ctx.resolve(fact['observed_snapshot_ref'], consumer, 'PlatformSnapshot')
        if fact['readback'] is not None:
            _, readback = ctx.resource(fact['readback'])
            if isinstance(readback, dict) and not _snapshot_business_equal(readback.get('view', {}).get('target'), snapshot['payload']):
                fail('$.fact', 'OBSERVATION_BINDING_MISMATCH', 'result readback differs from exact snapshot')
    if fact['origin_phase'] != 'UNATTEMPTED_ABSENCE' and result['outcome'] != 'UNKNOWN':
        _, actual = ctx.resource(fact['readback'])
        if not isinstance(actual, dict):
            fail('$.fact', 'OBSERVATION_BINDING_MISMATCH', 'conclusive result requires a complete JSON observation')
        # Both normal and recovered facts preserve the same public observation
        # binding rules. A content-addressed but forged state hash is not enough.
        observation_payload = {k: actual.get(k) for k in ('observed_at', 'observation_id', 'read_sequence',
                                                         'target_state_version', 'target_state_hash')}
        observation_payload.update(observed_snapshot_ref=fact['observed_snapshot_ref'], readback=fact['readback'],
                                   observation=result['effect_match'], evidence_refs=[fact['readback']], action_id=fact['action_id'])
        _observation_binding(ctx, dict(consumer, payload=observation_payload), intent)
    return fact


def _receipts_progress(ctx, heads):
    for artifact in ctx.artifacts.values():
        p, kind = artifact['payload'], artifact['kind']
        if kind == 'ExecutionReceipt':
            plan = ctx.resolve(p['plan'], artifact, 'ApplyPlan')
            if p['execution_mode'] == 'NOT_EXECUTED':
                if p['results'] or p['action_fact_refs']:
                    fail('$.receipt', 'RECOVERY_CHAIN_INVALID', 'not executed has no result facts')
                continue
            if [r['action_id'] for r in p['results']] != [a['action_id'] for a in plan['payload']['actions']] or len(p['action_fact_refs']) != len(p['results']):
                fail('$.receipt', 'ACTION_COVERAGE', 'complete receipt requires one fact/result for every plan action in order')
            for result, resource in zip(p['results'], p['action_fact_refs']):
                fact = _fact(ctx, resource, artifact)
                if fact['plan_ref'] != p['plan'] or fact['result'] != result:
                    fail('$.receipt', 'RECOVERY_CHAIN_INVALID', 'receipt must aggregate exact immutable facts')
        if kind == 'ExecutionProgress':
            plan = ctx.resolve(p['plan_ref'], artifact, 'ApplyPlan')
            if [r['action_id'] for r in p['actions']] != [a['action_id'] for a in plan['payload']['actions']]:
                fail('$.progress', 'ACTION_COVERAGE', 'progress includes all actions exactly in original order')
            for item in p['actions']:
                outcome = 'UNDETERMINED'
                if item['attempt_fact'] == 'LEGACY_UNRECORDED':
                    outcome = 'UNKNOWN'
                    if item['intent_ref'] is not None or item['resolution_head_ref'] is not None:
                        fail('$.progress', 'LEGACY_UNRECORDED', 'legacy no-intent state cannot acquire a resolution')
                if item['result_fact'] is not None:
                    fact = _fact(ctx, item['result_fact'], artifact)
                    if fact['plan_ref'] != p['plan_ref'] or fact['action_id'] != item['action_id'] or fact['result']['attempt_fact'] != item['attempt_fact'] or fact['intent_ref'] != item['intent_ref']:
                        fail('$.progress', 'RECOVERY_CHAIN_INVALID', 'progress fact/action/attempt differs')
                    outcome = fact['result']['outcome']
                elif item['intent_ref'] is not None:
                    outcome = 'UNKNOWN'
                if item['resolution_head_ref'] is not None:
                    resolution = _consumer_resolution_head(ctx, artifact, item['resolution_head_ref'], heads,
                                                           intent_ref=item['intent_ref'], plan_ref=p['plan_ref'],
                                                           action_id=item['action_id'])
                    outcome = {'RESOLVED_APPLIED': 'APPLIED', 'RESOLVED_NOT_APPLIED': 'NOT_APPLIED', 'STILL_UNKNOWN': 'UNKNOWN'}[resolution['payload']['resolution']]
                if item['effective_outcome'] != outcome:
                    fail('$.progress', 'RECOVERY_CHAIN_INVALID', 'effective projection lacks exact supporting fact/chain')
                if item['attempt_fact'] == 'NOT_ATTEMPTED' and outcome not in ('UNDETERMINED', 'NOT_APPLIED'):
                    fail('$.progress', 'NOT_ATTEMPTED_WITHOUT_ABSENT', 'never-called action cannot receive invented outcome')


def _consumer_resolution_head(ctx, consumer, ref, heads, *, intent_ref, plan_ref, action_id):
    """Validate a head in this immutable consumer's declared chain prefix.

    A later append does not rewrite an older progress/report. The complete
    global chain remains fork/terminal checked by _resolutions; only current
    eligibility projects that global head. Ordinary Artifact payloads are not
    inherited into this consumer's declarations while inspecting its prefix.
    """
    selected = ctx.resolve(ref, consumer, 'ReconciliationResult')
    p = selected['payload']
    if intent_ref is None or (p['intent_ref'], p['plan_ref'], p['action_id']) != (intent_ref, plan_ref, action_id):
        fail('$.recovery_refs', 'RECOVERY_CHAIN_INVALID', 'consumer resolution changes exact intent/plan/action binding')
    current = heads.get(canonical_hash(intent_ref))
    lineage = {}
    while current is not None:
        current_ref = recovery_artifact_ref(current)
        token = canonical_hash(current_ref)
        if token in lineage:
            fail('$.recovery_refs', 'RECOVERY_CHAIN_INVALID', 'resolution ancestry cycle')
        lineage[token] = len(lineage)
        previous = current['payload']['previous_resolution_ref']
        current = ctx.resolve(previous, consumer, 'ReconciliationResult') if previous else None
    token = canonical_hash(ref)
    if token not in lineage:
        fail('$.recovery_refs', 'RECOVERY_CHAIN_INVALID', 'selected head is not in the unique valid intent chain')
    selected_position = lineage[token]
    visited_resources = set()

    def declared(node):
        if node[0] == 'r':
            if node not in visited_resources:
                visited_resources.add(node)
                for child in ctx.graph.get(node, set()):
                    declared(child)
        elif node[0] == 'a':
            dependency = ctx.artifacts.get(tuple(node[1:]))
            if dependency and dependency['kind'] == 'ReconciliationResult' and dependency['payload']['intent_ref'] == intent_ref:
                position = lineage.get(canonical_hash(recovery_artifact_ref(dependency)))
                if position is None or position < selected_position:
                    fail('$.recovery_refs', 'RECOVERY_CHAIN_INVALID', 'consumer declares a successor beyond its selected historical head')
            # Do not traverse an ordinary referenced Artifact's payload.
    for dependency in ctx.graph.get(_artifact_node(consumer), set()):
        declared(dependency)
    return selected


def _legacy_projection(ctx):
    """Reuse C01 geometry/ownership/check/plan rules on a private value projection.

No projected value escapes as history or execution authority. New recovery
chains/Resources are separately validated above; original inputs stay unchanged.
"""
    from .validation import validate_bundle
    data = copy.deepcopy(ctx.bundle)
    keep = [a for a in data['artifacts'] if a['kind'] not in NEW_KINDS and a['kind'] != 'BatchReport']
    if getattr(ctx, 'native', False):
        # Native POST has its own stricter typed action/head/report-read grammar.
        # The full original history has already passed the mixed closure. This
        # private C01 business view is never returned as an admission package.
        keep = [a for a in keep if not (a['kind'] == 'CheckReport' and a['payload']['stage'] == 'POST_APPLY')]
    # Keep CheckReport issue declarations and their unchanged C01 invariants.
    # Additional effective recovery semantics are validated separately below.
    if any(a['kind'] == 'SourceBundle' and not a['payload']['scope_manifest'] for a in keep):
        if any(a['kind'] in ('ApplyPlan', 'QuestionGraph', 'ExecutionReceipt') for a in keep):
            fail('$.scope_manifest', 'NO_ACTIONS', 'unknown/zero scope cannot create a plan or complete batch')
        return None, {}
    scopes = {(a['book_id'], a['scope_id']) for a in keep}
    if len(scopes) > 1:
        for book, scope in scopes:
            local = dict(ctx.bundle, artifacts=[a for a in ctx.bundle['artifacts'] if (a['book_id'], a['scope_id']) == (book, scope)])
            _legacy_projection(_Closure(local, ctx.root, synthetic=ctx.synthetic))
        # Eligibility invokes this function with only the requested scope.
        return None, {}
    known = {(a['artifact_id'], a['revision']): a for a in keep}

    def strip(value):
        if isinstance(value, list):
            return [strip(v) for v in value]
        if isinstance(value, dict):
            return {k: strip(v) for k, v in value.items() if k not in ('origin', 'scope_integrity', 'recovery_refs', 'progress_refs',
                    'action_fact_refs', 'attempt_fact', 'attempt_evidence_refs', 'intent_ref') and
                    (not getattr(ctx, 'native', False) or k not in ('synthetic_run_ref', 'verification_context'))}
        return value
    data = strip(data)
    data['format_version'] = 'c01-exchange-1'
    data['artifacts'] = []
    mapped = {}

    def convert(artifact):
        key = (artifact['artifact_id'], artifact['revision'])
        if key in mapped:
            return mapped[key]
        value = strip(artifact)
        value['schema_version'] = '1.0.0-a-proposal'
        value['input_refs'] = [r for r in value['input_refs'] if (r['artifact_id'], r['revision']) in known]

        def remap(item, envelope=False):
            if _is_ref(item):
                k = (item['artifact_id'], item['revision'])
                if k not in known:
                    fail('$.projection', 'MISSING_REFERENCE', 'legacy semantic projection lacks dependency')
                return recovery_artifact_ref(convert(known[k]))
            if isinstance(item, dict):
                return {k: remap(v) for k, v in item.items()}
            if isinstance(item, list):
                return [remap(v) for v in item]
            return item
        value = remap(value, True)
        if getattr(ctx, 'native', False):
            # C01 hashes its typed JSON representation (e.g. float boxes).
            # Normalize this private semantic view before computing its digest;
            # native input bytes, identities and authority remain untouched.
            from .models import ExchangeBundle
            typed = ExchangeBundle.model_validate({'format_version': 'c01-exchange-1',
                'evidence': data['evidence'], 'policies': data['policies'], 'artifacts': [value]})
            value = typed.artifacts[0].model_dump(mode='json')
        value['content_hash'] = content_digest(value)
        mapped[key] = value
        return value
    data['artifacts'] = [convert(a) for a in keep]
    # Byte checking has already used the original exact resource declarations;
    # C01 here only supplies the unchanged semantic/geometry rules.
    return validate_bundle(data), mapped


def _outcomes(ctx, heads, target_key, scope_id):
    outcomes, unresolved, by_plan = {}, [], {}
    relevant = [a for a in ctx.artifacts.values() if a['book_id'] == target_key['book_id'] and a['scope_id'] == scope_id]
    for artifact in sorted(relevant, key=lambda a: {'WriteIntent': 0, 'ExecutionReceipt': 1, 'ExecutionProgress': 2}.get(a['kind'], 3)):
        if artifact['book_id'] != target_key['book_id'] or artifact['scope_id'] != scope_id:
            continue
        if artifact['kind'] == 'WriteIntent':
            ip = artifact['payload']
            if ip['target_key'] != target_key:
                continue
            outcomes[ip['action_id']] = 'UNKNOWN'
            by_plan[(canonical_hash(ip['plan_ref']), ip['action_id'])] = ('UNKNOWN', recovery_artifact_ref(artifact))
        if artifact['kind'] == 'ExecutionReceipt':
            plan = ctx.resolve(artifact['payload']['plan'], artifact, 'ApplyPlan')
            snapshot = ctx.resolve(plan['payload']['snapshot'], artifact, 'PlatformSnapshot')
            if snapshot['payload']['target_id'] != target_key['target_id']:
                continue
            for result in artifact['payload']['results']:
                outcomes[result['action_id']] = result['outcome']
                by_plan[(canonical_hash(artifact['payload']['plan']), result['action_id'])] = (result['outcome'], result['intent_ref'])
        if artifact['kind'] == 'ExecutionProgress':
            p = artifact['payload']
            plan = ctx.resolve(p['plan_ref'], artifact, 'ApplyPlan')
            snapshot = ctx.resolve(plan['payload']['snapshot'], artifact, 'PlatformSnapshot')
            if snapshot['payload']['target_id'] != target_key['target_id']:
                continue
            for item in p['actions']:
                if item['result_fact'] is not None:
                    _, fact = ctx.resource(item['result_fact'])
                    outcome = fact['result']['outcome']
                    outcomes[item['action_id']] = outcome
                    by_plan[(canonical_hash(p['plan_ref']), item['action_id'])] = (outcome, item['intent_ref'])
    for head in heads.values():
        p = head['payload']
        intent = ctx.resolve(p['intent_ref'], head, 'WriteIntent')
        if intent['payload']['target_key'] != target_key or head['scope_id'] != scope_id:
            continue
        result = {'RESOLVED_APPLIED': 'APPLIED', 'RESOLVED_NOT_APPLIED': 'NOT_APPLIED', 'STILL_UNKNOWN': 'UNKNOWN'}[p['resolution']]
        outcomes[p['action_id']] = result
        by_plan[(canonical_hash(p['plan_ref']), p['action_id'])] = (result, p['intent_ref'])
    for (plan_hash, action_id), (outcome, intent_ref) in by_plan.items():
        if outcome == 'UNKNOWN':
            unresolved.append({'action_id': action_id, 'intent_ref': intent_ref,
                               'reason': 'LEGACY_UNRECORDED' if intent_ref is None else 'NEEDS_RECONCILIATION',
                               'plan_digest': plan_hash})
    return _node({'target_key': target_key, 'scope_id': scope_id, 'outcomes': outcomes,
                  'unresolved': unresolved, 'paused': bool(unresolved), 'authority': 'SAME_SCOPE_CONTRACT_ONLY'})


def _reports(ctx, heads):
    for artifact in ctx.artifacts.values():
        p = artifact['payload']
        if artifact['kind'] == 'CheckReport':
            if p['stage'] != 'POST_APPLY':
                if p['recovery_refs']:
                    fail('$.recovery_refs', 'RECOVERY_CHAIN_INVALID', 'only POST_APPLY may consume recovery results')
                continue
            receipt = ctx.resolve(p['receipt'], artifact, 'ExecutionReceipt')
            plan = ctx.resolve(receipt['payload']['plan'], artifact, 'ApplyPlan')
            if p['graph'] != plan['payload']['graph'] or p['policy'] != plan['payload']['policy'] or p['subject'] != p['receipt']:
                fail('$.postcheck', 'RECOVERY_CHAIN_INVALID', 'postcheck graph/policy/subject differs')
            effective = {r['action_id']: r['outcome'] for r in receipt['payload']['results']}
            for ref in p['recovery_refs']:
                resolution = ctx.resolve(ref, artifact, 'ReconciliationResult')
                rp = resolution['payload']
                _consumer_resolution_head(ctx, artifact, ref, heads, intent_ref=rp['intent_ref'],
                                          plan_ref=receipt['payload']['plan'], action_id=rp['action_id'])
                if rp['original_receipt_ref'] != p['receipt']:
                    fail('$.postcheck', 'RECOVERY_CHAIN_INVALID', 'postcheck must bind its exact original receipt')
                effective[rp['action_id']] = {'RESOLVED_APPLIED': 'APPLIED', 'RESOLVED_NOT_APPLIED': 'NOT_APPLIED', 'STILL_UNKNOWN': 'UNKNOWN'}[rp['resolution']]
                if p['snapshot'] != rp['observed_snapshot_ref']:
                    fail('$.postcheck', 'OBSERVATION_BINDING_MISMATCH', 'postcheck needs the exact observation of its consumed historical head')
            if p['decision'] == 'PASS' and any(v != 'APPLIED' for v in effective.values()):
                fail('$.postcheck', 'UNPROVEN_APPLY', 'PASS requires every effective action applied')
        if artifact['kind'] == 'BatchReport':
            from .models import BatchPayload
            from pydantic import ValidationError
            # Shape alone cannot enforce denominator/status/cost invariants.
            try:
                BatchPayload.model_validate({k: v for k, v in p.items() if k not in ('recovery_refs', 'progress_refs')})
            except ValidationError as error:
                fail('$.batch', 'SCHEMA', str(error))
            receipt = ctx.resolve(p['receipt'], artifact, 'ExecutionReceipt')
            source = ctx.resolve(p['source'], artifact, 'SourceBundle')
            post = ctx.resolve(p['postcheck'], artifact, 'CheckReport')
            plan = ctx.resolve(receipt['payload']['plan'], artifact, 'ApplyPlan')
            if p['scope_manifest'] != source['payload']['scope_manifest'] or p['total_expected'] != len(p['scope_manifest']):
                fail('$.batch', 'DENOMINATOR_CHANGED', 'batch denominator must retain complete fixture scope')
            if post['payload']['receipt'] != p['receipt'] or post['payload']['graph'] != p['graph'] or p['graph'] != plan['payload']['graph']:
                fail('$.batch', 'BATCH_BINDING', 'batch graph/receipt/postcheck differs')
            if p['recovery_refs'] != post['payload']['recovery_refs']:
                fail('$.batch', 'RECOVERY_CHAIN_INVALID', 'batch and postcheck must consume exact same recovery heads')
            if p['state'] == 'COMPLETED' or p['submission_status'] != 'NOT_SUBMITTED' or p['content_check_status'] != 'PENDING':
                fail('$.batch', 'COMPLETION_GUARD', 'synthetic frame recovery does not prove content or human submission')
            effective = {r['action_id']: r['outcome'] for r in receipt['payload']['results']}
            for ref in p['recovery_refs']:
                rp = ctx.resolve(ref, artifact, 'ReconciliationResult')['payload']
                _consumer_resolution_head(ctx, artifact, ref, heads, intent_ref=rp['intent_ref'],
                                          plan_ref=receipt['payload']['plan'], action_id=rp['action_id'])
                effective[rp['action_id']] = {'RESOLVED_APPLIED': 'APPLIED', 'RESOLVED_NOT_APPLIED': 'NOT_APPLIED', 'STILL_UNKNOWN': 'UNKNOWN'}[rp['resolution']]
            if 'UNKNOWN' in effective.values() and p['state'] != 'NEEDS_RECONCILIATION':
                fail('$.batch', 'BOOK_WRITE_PAUSED', 'unknown effective outcome keeps batch paused')
            statuses = {q['question_id']: q['state'] for q in p['questions']}
            action_questions = {a['action_id']: a['target']['question_id'] for a in plan['payload']['actions']}
            for action_id, outcome in effective.items():
                state = statuses.get(action_questions[action_id])
                if outcome == 'UNKNOWN' and (state != 'UNKNOWN' or not p['unresolved_issue_ids']):
                    fail('$.batch.questions', 'UNKNOWN_GUARD', 'each unknown effective action remains counted and paused')
                if outcome == 'NOT_APPLIED' and state == 'VERIFIED':
                    fail('$.batch.questions', 'UNAPPLIED_QUESTION', 'absent action target cannot be verified')


def validate_recovery_bundle(bundle, *, asset_root=None, _archive=False, bridge_context=None):
    version = bundle.get('format_version') if isinstance(bundle, dict) else getattr(bundle, 'format_version', None)
    if version == 'a03-exchange-4-proposal':
        from .a03_native import validate_native_bundle
        return validate_native_bundle(bundle, bridge_context=bridge_context, asset_root=asset_root)
    root = asset_root if asset_root is not None else getattr(bundle, 'asset_root', None)
    data = _data(bundle)
    if not isinstance(data, dict) or data.get('format_version') != RECOVERY_EXCHANGE_VERSION:
        fail('$', 'RECOVERY_VERSION_UNSUPPORTED', 'expected approved recovery exchange namespace')
    if any(a.get('schema_version') != RECOVERY_SCHEMA_VERSION for a in data.get('artifacts', [])):
        fail('$', 'CROSS_VERSION_REFERENCE', 'one recovery namespace required')
    FrozenSchemas().check(data)
    if root is None:
        fail('$', 'RESOURCE_ROOT_REQUIRED', 'recovery validation never skips actual resource bytes')
    ctx = _Closure(data, root, synthetic=not _archive)
    ctx.check()
    for a in data['artifacts']:
        _timestamp(a['created_at'])
    if not _archive:
        _scope(ctx)
    _intents(ctx)
    heads = _resolutions(ctx)
    _receipts_progress(ctx, heads)
    _legacy_projection(ctx)
    _reports(ctx, heads)
    return RecoveryExchangeBundle(data, root)


def load_recovery_bundle(path, *, asset_root=None):
    path = Path(path)
    try:
        data = read_json(path)
    except (OSError, ValueError) as error:
        fail('$', 'JSON_INPUT', str(error))
    return validate_recovery_bundle(data, asset_root=asset_root if asset_root is not None else path.parent)


def load_archive_bundle(path, verify_assets=True):
    from .validation import load_bundle
    path = Path(path)
    try:
        data = read_json(path)
    except (OSError, ValueError) as error:
        fail('$', 'JSON_INPUT', str(error))
    if data.get('format_version') == 'c01-exchange-1':
        value = load_bundle(path, verify_assets=verify_assets)
    elif data.get('format_version') == RECOVERY_EXCHANGE_VERSION:
        # Recovery archives still check bytes and chain identity. Archive-only
        # reading never grants synthetic admission or a runtime intent.
        value = validate_recovery_bundle(data, asset_root=path.parent, _archive=True)
    else:
        fail('$', 'RECOVERY_VERSION_UNSUPPORTED', 'unsupported archive namespace')
    return _node({'eligibility': 'ARCHIVE_ONLY', 'bundle': _data(value),
                  'path': str(path.resolve()), 'sha256': file_digest(path)})


def effective_recovery_outcomes(bundle, *, target_key, scope_id, bridge_context=None):
    data = _data(bundle)
    if data.get('format_version') == 'a03-exchange-4-proposal':
        from .a03_native import effective_native_outcomes
        return effective_native_outcomes(bundle, target_key=target_key, scope_id=scope_id, bridge_context=bridge_context)
    if data.get('format_version') == 'c01-exchange-1':
        from .validation import validate_bundle
        legacy = validate_bundle(bundle)
        unresolved = [{'action_id': r.action_id, 'intent_ref': None, 'reason': 'LEGACY_UNRECORDED'}
                      for a in legacy.artifacts if a.kind == 'ExecutionReceipt' and a.book_id == target_key['book_id']
                      and a.scope_id == scope_id for r in a.payload.results if r.outcome == 'UNKNOWN']
        return _node({'outcomes': {}, 'unresolved': unresolved, 'paused': bool(unresolved), 'authority': 'ARCHIVE_ONLY'})
    validated = validate_recovery_bundle(bundle)
    ctx = _Closure(_data(validated), validated.asset_root)
    return _outcomes(ctx, _resolutions(ctx), _data(target_key), scope_id)


def assert_recovery_plan_ready(bundle, plan_ref, current_snapshot_ref, *, bridge_context=None):
    version = bundle.get('format_version') if isinstance(bundle, dict) else getattr(bundle, 'format_version', None)
    if version == 'a03-exchange-4-proposal':
        from .a03_native import assert_native_plan_ready
        return assert_native_plan_ready(bundle, plan_ref, current_snapshot_ref, bridge_context=bridge_context)
    from .validation import _Context, _plan
    validated = validate_recovery_bundle(bundle)
    ctx = _Closure(_data(validated), validated.asset_root)
    plan = ctx.resolve(_data(plan_ref), kind='ApplyPlan')
    snapshot = ctx.resolve(_data(current_snapshot_ref), plan, 'PlatformSnapshot')
    if plan['payload']['readiness'] != 'READY':
        fail('$.plan', 'PLAN_BLOCKED', 'diagnostic plan has no action authority')
    if _data(current_snapshot_ref) != plan['payload']['snapshot']:
        fail('$.plan', 'TARGET_CHANGED', 'current snapshot differs from exact plan observation')
    local = dict(ctx.bundle, artifacts=[a for a in ctx.bundle['artifacts'] if (a['book_id'], a['scope_id']) == (plan['book_id'], plan['scope_id'])])
    projected, mapped = _legacy_projection(_Closure(local, ctx.root))
    if projected is None:
        fail('$.plan', 'NO_ACTIONS', 'zero scope has no executable plan')
    p = mapped[(plan['artifact_id'], plan['revision'])]
    s = mapped[(snapshot['artifact_id'], snapshot['revision'])]
    c = _Context(projected)
    _plan(c, c.artifacts[(p['artifact_id'], p['revision'])], '$.plan.payload', _node(recovery_artifact_ref(s)))
    # The ordinary contract may only inspect its same-scope closure. Runtime
    # separately scans every historical scope/run in the canonical book store.
    target_bindings = {canonical_hash(a['payload']['target_key']): a['payload']['target_key']
                       for a in ctx.artifacts.values() if a['kind'] == 'WriteIntent' and
                       (a['book_id'], a['scope_id']) == (plan['book_id'], plan['scope_id']) and
                       a['payload']['target_key']['target_id'] == snapshot['payload']['target_id']}
    if len(target_bindings) > 1:
        fail('$.plan', 'TARGET_IDENTITY_MISMATCH', 'plan cannot choose between multiple canonical platform namespaces')
    target_key = next(iter(target_bindings.values()),
                      {'platform_namespace': 'a02-mock', 'target_id': snapshot['payload']['target_id'], 'book_id': plan['book_id']})
    view = _outcomes(ctx, _resolutions(ctx), target_key, plan['scope_id'])
    if view.paused:
        code = 'LEGACY_UNRECORDED' if any(r.reason == 'LEGACY_UNRECORDED' for r in view.unresolved) else 'BOOK_WRITE_PAUSED'
        fail('$.plan', code, 'same-scope unresolved history blocks new actions')
    # Loading an immutable old plan remains legal. Claiming current eligibility
    # after a terminal reconciliation requires a genuinely newer observation,
    # its exact new TARGET report and a plan created after those inputs.
    terminal_times = []
    for head in _resolutions(ctx).values():
        hp = head['payload']
        intent = ctx.resolve(hp['intent_ref'], head, 'WriteIntent')
        if (intent['payload']['target_key'] == target_key and head['scope_id'] == plan['scope_id'] and
                hp['resolution'] != 'STILL_UNKNOWN'):
            terminal_times.append(_timestamp(hp['observed_at']))
    if terminal_times:
        observed_at = _timestamp(snapshot['payload']['observed_at'])
        target = ctx.resolve(plan['payload']['targetcheck'], plan, 'CheckReport')
        if observed_at <= max(terminal_times):
            fail('$.plan.snapshot', 'OBSERVATION_NOT_FRESH', 'new eligibility requires an observation after terminal reconciliation')
        if target['payload']['snapshot'] != _data(current_snapshot_ref) or target['payload']['subject'] != _data(current_snapshot_ref):
            fail('$.plan.targetcheck', 'TARGET_CHANGED', 'new TARGET must bind the exact new current observation')
        if (_timestamp(target['created_at']) < observed_at or _timestamp(plan['created_at']) < observed_at or
                _timestamp(plan['created_at']) < _timestamp(target['created_at'])):
            fail('$.plan', 'OBSERVATION_NOT_FRESH', 'new TARGET and plan must be created after their current observation')
    return _node(plan)


def convert_synthetic_fixture(source_path, output_dir, *, conversion_id, expected_input_sha256):
    """Create a new initial simulation fixture; never import execution history."""
    from .validation import load_bundle
    from .models import Identifier
    from pydantic import TypeAdapter
    TypeAdapter(Identifier).validate_python(conversion_id)
    source_path, output_dir = Path(source_path).resolve(), Path(output_dir).resolve()
    if file_digest(source_path) != expected_input_sha256:
        fail('$', 'CONVERSION_INPUT_HASH_MISMATCH', 'exact original file SHA256 differs')
    if output_dir.exists():
        fail('$', 'CONVERSION_TARGET_EXISTS', 'conversion requires a new output directory')
    original = load_bundle(source_path, verify_assets=True).model_dump(mode='json')
    if any(a['kind'] in ('ExecutionReceipt', 'BatchReport') for a in original['artifacts']):
        fail('$', 'LEGACY_UNRECORDED', 'execution results cannot become new simulated history')
    for value in _walk(original):
        if not isinstance(value, dict):
            continue
        if ('evidence_mode' in value and value['evidence_mode'] != 'SYNTHETIC' or
                'provenance' in value and value['provenance'] != 'SYNTHETIC' or
                'mode' in value and value['mode'] == 'OBSERVED' or
                'region_id' in value and value.get('source', 'SYNTHETIC') != 'SYNTHETIC' or
                'clue_id' in value and value.get('source', 'SYNTHETIC') != 'SYNTHETIC' or
                'execution_mode' in value and value['execution_mode'] not in ('SIMULATED', 'NOT_EXECUTED')):
            fail('$', 'SYNTHETIC_ONLY', 'conversion cannot relabel real provenance')
    output_dir.mkdir(parents=True)
    incomplete = output_dir / 'conversion-incomplete.json'
    incomplete.write_text(json.dumps({'conversion_id': conversion_id, 'status': 'INCOMPLETE',
                                      'source_sha256': expected_input_sha256}, indent=2) + '\n', encoding='utf-8')
    artifacts = {(a['artifact_id'], a['revision']): a for a in original['artifacts']}
    mapped, active, resource_cache = {}, set(), {}
    resource_records = []

    def save_json(value):
        raw = (json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(',', ':'), allow_nan=False) + '\n').encode('utf-8')
        digest = hashlib.sha256(raw).hexdigest()
        relative = 'assets/' + digest + '.json'
        target = output_dir / relative
        target.parent.mkdir(exist_ok=True)
        if not target.exists():
            with target.open('xb') as handle:
                handle.write(raw)
        return {'path': relative, 'sha256': digest, 'media_type': 'application/json', 'origin': 'SYNTHETIC'}

    def resource(value):
        key = (value['path'], value['sha256'], value['media_type'])
        if key in resource_cache:
            return copy.deepcopy(resource_cache[key])
        source_file = (source_path.parent / value['path']).resolve()
        source_file.relative_to(source_path.parent)
        if file_digest(source_file) != value['sha256']:
            fail('$', 'RESOURCE_HASH_MISMATCH', 'source changed during conversion')
        if value['media_type'] == 'application/json':
            body = read_json(source_file)
            for node in _walk(body):
                if isinstance(node, dict) and node.get('origin', 'SYNTHETIC') != 'SYNTHETIC':
                    fail('$', 'SYNTHETIC_ONLY', 'nested source resource has real origin')
            converted = save_json(rewrite(body))
        else:
            target = output_dir / value['path']
            target.parent.mkdir(parents=True, exist_ok=True)
            with target.open('xb') as handle:
                handle.write(source_file.read_bytes())
            converted = {k: value[k] for k in ('path', 'sha256', 'media_type')}
            converted['origin'] = 'SYNTHETIC'
        converted.update({k: v for k, v in value.items() if k not in ('path', 'sha256', 'media_type')})
        resource_cache[key] = converted
        resource_records.append({'old': value, 'new': converted})
        return copy.deepcopy(converted)

    def rewrite(value, envelope=False):
        if _is_ref(value):
            return recovery_artifact_ref(convert(artifacts[(value['artifact_id'], value['revision'])]))
        if _is_resource(value):
            return resource(value)
        if isinstance(value, dict):
            return {k: rewrite(v) for k, v in value.items()}
        if isinstance(value, list):
            return [rewrite(v) for v in value]
        return value

    def convert(old):
        key = (old['artifact_id'], old['revision'])
        if key in mapped:
            return mapped[key]
        if key in active:
            fail('$', 'REFERENCE_CYCLE', 'conversion graph cycles')
        active.add(key)
        new = rewrite(copy.deepcopy(old), envelope=True)
        new['schema_version'] = RECOVERY_SCHEMA_VERSION
        if old['kind'] == 'SourceBundle':
            p = new['payload']
            # The explicit fixture conversion enumerates the known fixture
            # graph by original-image membership, retaining every scope item.
            graphs = [g for g in original['artifacts'] if g['kind'] == 'QuestionGraph' and g['payload']['source'] == artifact_ref(old)]
            per_page = {page: set() for page in p['pages_expected']}
            for graph in graphs:
                evidence = artifacts[(graph['payload']['evidence']['artifact_id'], graph['payload']['evidence']['revision'])]
                regions = {r['region_id']: r['box']['image']['asset_id'] for r in evidence['payload']['regions']}
                fragments = {f['fragment_id']: f['region_ids'] for f in graph['payload']['fragments']}
                for q in graph['payload']['questions']:
                    for fid in q['fragment_ids'] + q['shared_fragment_ids']:
                        for rid in fragments[fid]:
                            per_page[regions[rid]].add(q['question_id'])
            assigned = set().union(*per_page.values()) if per_page else set()
            if assigned != set(p['scope_manifest']):
                fail('$', 'CONVERSION_INPUT_UNSUPPORTED', 'fixture scope contains items without explicit page enumeration')
            proof = {'origin': 'SYNTHETIC', 'basis': 'FIXTURE', 'complete': True,
                     'book_id': new['book_id'], 'scope_id': new['scope_id'],
                     'pages_expected': p['pages_expected'], 'pages_acquired': p['pages_acquired'],
                     'scope_manifest': p['scope_manifest'],
                     'assets': [{k: a[k] for k in ('asset_id', 'path', 'sha256', 'width', 'height')} for a in p['assets']],
                     'per_page_questions': [{'asset_id': page, 'question_ids': sorted(ids), 'enumeration_complete': True}
                                            for page, ids in per_page.items()],
                     'conversion_id': conversion_id}
            p['scope_integrity'] = {'status': 'SYNTHETIC_COMPLETE', 'basis': 'FIXTURE', 'proof': save_json(proof)}
        if old['kind'] == 'CheckReport':
            new['payload']['recovery_refs'] = []
        new['content_hash'] = content_digest(new)
        mapped[key] = new
        active.remove(key)
        return new
    result = {'format_version': RECOVERY_EXCHANGE_VERSION,
              'evidence': rewrite(original['evidence']), 'policies': copy.deepcopy(original['policies']),
              'artifacts': [convert(a) for a in original['artifacts']]}
    # Explicit declaration closure is computed per new consumer, never copied
    # from an unrelated artifact or inferred from matching strings.
    for artifact in result['artifacts']:
        if artifact['kind'] == 'SourceBundle':
            continue
        # Converted initial fixtures currently have no nested ordinary refs
        # beyond those already declared in their C01 input graph. Validation
        # below rejects an unsupported graph rather than guessing new authority.
    validated = validate_recovery_bundle(result, asset_root=output_dir)
    bundle_path = output_dir / 'bundle.json'
    with bundle_path.open('x', encoding='utf-8', newline='\n') as handle:
        handle.write(json.dumps(validated.model_dump(), ensure_ascii=False, indent=2, allow_nan=False) + '\n')
    mappings = [{'old_namespace': {'schema_version': '1.0.0-a-proposal', 'exchange_version': 'c01-exchange-1'},
                 'new_namespace': {'schema_version': RECOVERY_SCHEMA_VERSION, 'exchange_version': RECOVERY_EXCHANGE_VERSION},
                 'book_id': old['book_id'], 'scope_id': old['scope_id'], 'old_ref': artifact_ref(old),
                 'new_ref': artifact_ref(mapped[key])} for key, old in artifacts.items()]
    manifest = {'conversion_id': conversion_id, 'source_path': str(source_path),
                'source_sha256': expected_input_sha256, 'bundle_path': str(bundle_path),
                'bundle_sha256': file_digest(bundle_path), 'mapping_path': str(output_dir / 'conversion-manifest.json'),
                'status': 'INITIAL_SIMULATED_INPUT_ONLY', 'artifact_mappings': mappings,
                'resource_mappings': resource_records, 'history_migrated': False}
    with (output_dir / 'conversion-manifest.json').open('x', encoding='utf-8', newline='\n') as handle:
        handle.write(json.dumps(manifest, ensure_ascii=False, indent=2) + '\n')
    # Keep the initial marker as diagnostic history, now explicitly completed.
    incomplete.write_text(json.dumps({'conversion_id': conversion_id, 'status': 'COMPLETED_NEW_FIXTURE',
                                      'source_sha256': expected_input_sha256}, indent=2) + '\n', encoding='utf-8')
    return _node(manifest)

1ad128e29c42d6ca86411c000ed3227c210c9d6e blob 45661
"""Referential and safety invariants; no planner, executor or recognition code."""
import copy
import struct
from pathlib import Path

from pydantic import BaseModel, ValidationError

from .integrity import artifact_ref, as_data, content_digest, file_digest, policy_ref, read_json
from .models import (ArtifactRef, ExchangeBundle, ImageBinding, PolicyRef, Resource)


class ContractError(ValueError):
    def __init__(self, issues):
        self.issues = issues
        super().__init__("\n".join("{path}: [{code}] {message}".format(**item) for item in issues))


def fail(path, code, message):
    raise ContractError([{"path": path, "code": code, "message": message}])


def walk(value, path):
    yield path, value
    if isinstance(value, BaseModel):
        for name in type(value).model_fields:
            yield from walk(getattr(value, name), path + "." + name)
    elif isinstance(value, list):
        for i, item in enumerate(value):
            yield from walk(item, path + "[" + str(i) + "]")
    elif isinstance(value, dict):
        for name, item in value.items():
            yield from walk(item, path + "." + name)


def distinct(items, path):
    if len(items) != len(set(items)):
        fail(path, "DUPLICATE_ID", "identifiers must be unique in this collection")


def subset(items, allowed, path):
    for i, item in enumerate(items):
        if item not in allowed:
            fail(path + "[" + str(i) + "]", "MISSING_REFERENCE", "unknown reference " + str(item))


def image_size(path, media_type):
    """Read only image headers; support PNG, JPEG and portable graymap fixtures."""
    with path.open("rb") as handle:
        if media_type == "image/png":
            head = handle.read(24)
            if head[:8] != b"\x89PNG\r\n\x1a\n" or head[12:16] != b"IHDR" or len(head) < 24:
                raise ValueError("invalid PNG header")
            return struct.unpack(">II", head[16:24])
        if media_type == "image/x-portable-graymap":
            tokens = []
            while len(tokens) < 4:
                line = handle.readline(4096)
                if not line:
                    raise ValueError("incomplete PGM header")
                tokens.extend(line.split(b"#", 1)[0].split())
            if tokens[0] not in (b"P2", b"P5"):
                raise ValueError("invalid PGM header")
            return int(tokens[1]), int(tokens[2])
        if media_type == "image/jpeg":
            if handle.read(2) != b"\xff\xd8":
                raise ValueError("invalid JPEG header")
            while True:
                prefix = handle.read(1)
                if not prefix:
                    raise ValueError("JPEG size not found")
                if prefix != b"\xff":
                    continue
                marker = handle.read(1)
                while marker == b"\xff":
                    marker = handle.read(1)
                if not marker or marker[0] in (0xD9, 0xDA):
                    raise ValueError("JPEG size not found")
                if marker[0] in (0x00, 0x01, *range(0xD0, 0xD9)):
                    continue
                raw_length = handle.read(2)
                if len(raw_length) != 2:
                    raise ValueError("truncated JPEG")
                length = struct.unpack(">H", raw_length)[0]
                if length < 2:
                    raise ValueError("invalid JPEG segment")
                if marker[0] in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF):
                    size = handle.read(5)
                    if len(size) != 5:
                        raise ValueError("truncated JPEG size")
                    height, width = struct.unpack(">HH", size[1:5])
                    return width, height
                handle.seek(length - 2, 1)
    raise ValueError("asset media_type must be an image")


class _Context:
    def __init__(self, bundle):
        self.bundle = bundle
        self.artifacts = {}
        self.paths = {}
        self.policies = {}
        self.evidence = {e.evidence_id: e for e in bundle.evidence}
        distinct([e.evidence_id for e in bundle.evidence], "$.evidence")
        for i, policy in enumerate(bundle.policies):
            key = (policy.policy_id, policy.revision)
            if key in self.policies:
                fail("$.policies[{}]".format(i), "DUPLICATE_ID", "duplicate policy revision")
            if policy.content_hash != content_digest(policy):
                fail("$.policies[{}].content_hash".format(i), "HASH_MISMATCH", "policy digest differs")
            if set(policy.role_mapping) != {"stem", "option", "answer", "explanation", "shared_material"}:
                fail("$.policies[{}].role_mapping".format(i), "POLICY_MAPPING", "all generic roles require mapping")
            if policy.applicability == "SYNTHETIC_ONLY" and policy.confirmation_status != "SYNTHETIC_ASSUMPTION":
                fail("$.policies[{}]".format(i), "POLICY_STATUS", "synthetic policy must be an explicit assumption")
            if policy.applicability == "JOINT_CONFIRMED" and policy.confirmation_status != "JOINT_CONFIRMED":
                fail("$.policies[{}]".format(i), "POLICY_STATUS", "joint applicability requires joint confirmation")
            self.policies[key] = policy
        identities = {}
        for i, artifact in enumerate(bundle.artifacts):
            path = "$.artifacts[{}]".format(i)
            key = (artifact.artifact_id, artifact.revision)
            if key in self.artifacts:
                fail(path, "DUPLICATE_ID", "duplicate immutable artifact revision")
            identity = (artifact.kind, artifact.book_id, artifact.scope_id)
            if artifact.artifact_id in identities and identities[artifact.artifact_id] != identity:
                fail(path, "IDENTITY_CONFLICT", "artifact identity changed kind/book/scope")
            identities[artifact.artifact_id] = identity
            if artifact.content_hash != content_digest(artifact):
                fail(path + ".content_hash", "HASH_MISMATCH", "artifact digest differs from normalized content")
            self.artifacts[key], self.paths[key] = artifact, path

    def resolve(self, ref, path, kind=None):
        artifact = self.artifacts.get((ref.artifact_id, ref.revision))
        if artifact is None:
            fail(path, "MISSING_REFERENCE", "missing artifact revision")
        if artifact_ref(artifact) != as_data(ref):
            fail(path, "REFERENCE_CONFLICT", "kind/revision/hash does not match referenced artifact")
        if kind and artifact.kind != kind:
            fail(path, "KIND_CONFLICT", "expected " + kind)
        return artifact

    def policy(self, ref, path):
        policy = self.policies.get((ref.policy_id, ref.revision))
        if policy is None or policy_ref(policy) != as_data(ref):
            fail(path, "POLICY_CONFLICT", "missing policy or revision/hash mismatch")
        return policy

    def source(self, artifact, path):
        if artifact.kind == "SourceBundle":
            return artifact
        if hasattr(artifact.payload, "source"):
            return self.resolve(artifact.payload.source, path + ".source", "SourceBundle")
        if hasattr(artifact.payload, "graph"):
            graph = self.resolve(artifact.payload.graph, path + ".graph", "QuestionGraph")
            return self.source(graph, path)
        if artifact.kind == "ExecutionReceipt":
            return self.source(self.resolve(artifact.payload.plan, path + ".plan", "ApplyPlan"), path)
        if artifact.kind == "ReviewPatch":
            return self.source(self.resolve(artifact.payload.baseline, path + ".baseline", "QuestionGraph"), path)
        # Snapshots may list frames; their exact image source must be an explicit input.
        sources = [self.resolve(r, path + ".input_refs") for r in artifact.input_refs if r.kind == "SourceBundle"]
        if len(sources) != 1:
            fail(path, "SOURCE_BINDING", "exactly one source dependency required for image bindings")
        return sources[0]

    def evrefs(self, refs, path, extra=()):
        subset(refs, set(self.evidence) | set(extra), path)


def _relationships(ctx):
    for key, artifact in ctx.artifacts.items():
        path = ctx.paths[key]
        declared = [tuple(as_data(r).values()) for r in artifact.input_refs]
        distinct(declared, path + ".input_refs")
        for location, value in walk(artifact, path):
            if isinstance(value, ArtifactRef):
                dependency = ctx.resolve(value, location)
                if (dependency.book_id, dependency.scope_id) != (artifact.book_id, artifact.scope_id):
                    fail(location, "SCOPE_CONFLICT", "dependency belongs to a different book or scope")
                if artifact.producer.evidence_mode == "OBSERVED" and dependency.producer.evidence_mode == "SYNTHETIC":
                    fail(location, "SYNTHETIC_EVIDENCE", "observed artifact cannot depend on a synthetic artifact")
                if ".input_refs[" not in location and tuple(as_data(value).values()) not in declared:
                    fail(location, "UNDECLARED_INPUT", "payload dependency must also appear in input_refs")
            elif isinstance(value, PolicyRef):
                ctx.policy(value, location)
                if ".producer.policy_versions[" not in location and value not in artifact.producer.policy_versions:
                    fail(location, "UNDECLARED_POLICY", "policy must also appear in producer.policy_versions")
        if artifact.kind == "SourceBundle" and artifact.input_refs:
            fail(path + ".input_refs", "SOURCE_MUTATION", "source imports are immutable roots in C01")
    visited, active = set(), set()

    def visit(key):
        if key in active:
            fail(ctx.paths[key] + ".input_refs", "DEPENDENCY_CYCLE", "artifact dependency cycle")
        if key not in visited:
            active.add(key)
            for ref in ctx.artifacts[key].input_refs:
                visit((ref.artifact_id, ref.revision))
            active.remove(key)
            visited.add(key)
    for key in ctx.artifacts:
        visit(key)


def _resources(ctx, asset_root):
    for path, value in walk(ctx.bundle, "$"):
        if isinstance(value, Resource) and asset_root is not None:
            root = Path(asset_root).resolve()
            resolved = (root / value.path).resolve()
            try:
                resolved.relative_to(root)
            except ValueError:
                fail(path + ".path", "PATH_ESCAPE", "resolved resource leaves bundle directory")
            if not resolved.is_file():
                fail(path + ".path", "RESOURCE_MISSING", "resource does not exist")
            if file_digest(resolved) != value.sha256:
                fail(path + ".sha256", "RESOURCE_HASH", "resource bytes differ")
            if hasattr(value, "asset_id"):
                try:
                    size = image_size(resolved, value.media_type)
                except (ValueError, OSError) as error:
                    fail(path, "IMAGE_HEADER", str(error))
                if size != (value.width, value.height):
                    fail(path, "IMAGE_DIMENSIONS", "image header differs from declared width/height")
    for key, artifact in ctx.artifacts.items():
        for path, value in walk(artifact.payload, ctx.paths[key] + ".payload"):
            if isinstance(value, ImageBinding):
                source = ctx.source(artifact, path)
                assets = {asset.asset_id: asset for asset in source.payload.assets}
                asset = assets.get(value.asset_id)
                if asset is None:
                    fail(path + ".asset_id", "MISSING_ASSET", "asset absent from bound SourceBundle")
                if (value.width, value.height, value.sha256) != (asset.width, asset.height, asset.sha256):
                    fail(path, "IMAGE_BINDING", "original dimensions/digest conflict with asset")


def _source(ctx, a, path):
    p = a.payload
    assets = {x.asset_id for x in p.assets}
    dirs = {x.directory_id for x in p.directories}
    distinct([x.asset_id for x in p.assets], path + ".assets")
    distinct([x.directory_id for x in p.directories], path + ".directories")
    for name in ("pages_expected", "pages_acquired", "scope_manifest"):
        distinct(getattr(p, name), path + "." + name)
    if set(p.pages_acquired) != assets:
        fail(path + ".pages_acquired", "SOURCE_PAGES", "acquired pages must equal actual asset inventory")
    subset(p.pages_acquired, p.pages_expected, path + ".pages_acquired")
    parents = {d.directory_id: d.parent_id for d in p.directories}
    for i, directory in enumerate(p.directories):
        if directory.parent_id is not None:
            subset([directory.parent_id], dirs, path + ".directories[{}].parent_id".format(i))
        seen, current = set(), directory.directory_id
        while current is not None:
            if current in seen:
                fail(path + ".directories", "DIRECTORY_CYCLE", "directory tree contains a cycle")
            seen.add(current)
            current = parents[current]
    mappings = []
    for i, mapping in enumerate(p.external_page_mappings):
        loc = path + ".external_page_mappings[{}]".format(i)
        subset([mapping.asset_id], assets, loc + ".asset_id")
        subset([mapping.directory_id], dirs, loc + ".directory_id")
        ctx.evrefs(mapping.evidence_refs, loc + ".evidence_refs")
        mappings.append(mapping.asset_id)
    distinct(mappings, path + ".external_page_mappings")
    if set(mappings) != assets:
        fail(path + ".external_page_mappings", "PAGE_MAPPING", "every acquired original needs an external-page mapping")


def _evidence(ctx, a, path):
    p = a.payload
    regions = {r.region_id for r in p.regions}
    distinct([r.region_id for r in p.regions], path + ".regions")
    distinct([c.clue_id for c in p.coverage_clues], path + ".coverage_clues")
    for i, region in enumerate(p.regions):
        ctx.evrefs(region.evidence_refs, path + ".regions[{}].evidence_refs".format(i))
    for i, clue in enumerate(p.coverage_clues):
        loc = path + ".coverage_clues[{}]".format(i)
        subset(clue.region_ids, regions, loc + ".region_ids")
        ctx.evrefs(clue.evidence_refs, loc + ".evidence_refs")
        if clue.disposition == "ASSIGNED" and not clue.region_ids:
            fail(loc, "COVERAGE_ASSIGNMENT", "assigned clue must identify regions")
        if clue.disposition in ("EXCLUDED", "UNASSIGNED") and clue.region_ids:
            fail(loc, "COVERAGE_ASSIGNMENT", "excluded/unassigned clue cannot claim assigned regions")


def _graph(ctx, a, path):
    p = a.payload
    source = ctx.resolve(p.source, path + ".source", "SourceBundle")
    evidence = ctx.resolve(p.evidence, path + ".evidence", "EvidenceBundle")
    if evidence.payload.source != p.source:
        fail(path + ".source", "VERSION_CONFLICT", "graph/evidence source versions differ")
    regions = {r.region_id: r for r in evidence.payload.regions}
    fragments = {f.fragment_id: f for f in p.fragments}
    questions = {q.question_id: q for q in p.questions}
    for name, ids in (("questions", [q.question_id for q in p.questions]),
                      ("fragments", [f.fragment_id for f in p.fragments]),
                      ("answer_relations", [r.relation_id for r in p.answer_relations])):
        distinct(ids, path + "." + name)
    # IDs identify distinct entity namespaces; numbers can repeat in external_refs.
    all_ids = list(regions) + list(fragments) + list(questions)
    distinct(all_ids, path)
    subset(list(questions), source.payload.scope_manifest, path + ".questions")
    dirs = {d.directory_id for d in source.payload.directories}
    for i, fragment in enumerate(p.fragments):
        loc = path + ".fragments[{}]".format(i)
        subset(fragment.region_ids, regions, loc + ".region_ids")
        distinct(fragment.region_ids, loc + ".region_ids")
        if any(regions[r].content_type != fragment.content_type for r in fragment.region_ids):
            fail(loc + ".content_type", "CONTENT_TYPE", "fragment and region content types differ")
    for i, question in enumerate(p.questions):
        loc = path + ".questions[{}]".format(i)
        subset([question.directory_id], dirs, loc + ".directory_id")
        subset(question.fragment_ids + question.shared_fragment_ids, fragments, loc + ".fragment_ids")
        distinct(question.fragment_ids, loc + ".fragment_ids")
        if question.parent_question_id is not None:
            subset([question.parent_question_id], questions, loc + ".parent_question_id")
        seen, current = set(), question.question_id
        while current is not None:
            if current in seen:
                fail(loc, "QUESTION_CYCLE", "question parent cycle")
            seen.add(current)
            current = questions[current].parent_question_id
        if any(fragments[f].role != "shared_material" for f in question.shared_fragment_ids):
            fail(loc + ".shared_fragment_ids", "SHARED_ROLE", "shared material requires generic shared_material role")
        pages = {regions[r].box.image.asset_id for f in question.fragment_ids + question.shared_fragment_ids
                 for r in fragments[f].region_ids if fragments[f].role not in ("answer", "explanation")}
        if question.cross_page != (len(pages) > 1):
            fail(loc + ".cross_page", "CROSS_PAGE", "cross_page must match question content original pages")
        orders = [fragments[f].reading_order for f in question.fragment_ids]
        distinct(orders, loc + ".fragment_ids")
    for i, relation in enumerate(p.answer_relations):
        loc = path + ".answer_relations[{}]".format(i)
        subset([relation.question_id], questions, loc + ".question_id")
        subset(relation.candidate_fragment_ids, fragments, loc + ".candidate_fragment_ids")
        subset(relation.selected_fragment_ids, relation.candidate_fragment_ids, loc + ".selected_fragment_ids")
        if any(fragments[f].role not in ("answer", "explanation") for f in relation.candidate_fragment_ids):
            fail(loc, "ANSWER_ROLE", "answer candidates must have answer/explanation roles")
        if (relation.status == "SELECTED") != bool(relation.selected_fragment_ids):
            fail(loc, "ANSWER_SELECTION", "selected status must have selected candidates; unresolved cannot select")
        ctx.evrefs(relation.evidence_refs, loc + ".evidence_refs", regions)
    # A graph that claims a patch derivation must actually be that patch result.
    patches = [ctx.resolve(ref, path + ".input_refs", "ReviewPatch")
               for ref in a.input_refs if ref.kind == "ReviewPatch"]
    if patches:
        if len(patches) != 1:
            fail(path, "PATCH_DERIVATION", "one explicit patch per derived graph revision is required")
        patch = patches[0].payload
        baseline = ctx.resolve(patch.baseline, path + ".patch.baseline", "QuestionGraph")
        if baseline.artifact_id != a.artifact_id or patch.result_revision != a.revision:
            fail(path, "PATCH_DERIVATION", "patch result identity/revision differs from derived graph")
        if patch.baseline not in a.input_refs:
            fail(path, "PATCH_DERIVATION", "derived graph must declare the immutable baseline input")
        expected = copy.deepcopy(baseline.payload.model_dump(mode="json"))
        for change in patch.changes:
            if change.field == "role":
                collection, id_field = expected["fragments"], "fragment_id"
            elif change.field == "printed_number":
                collection, id_field = expected["questions"], "question_id"
            else:
                collection, id_field = expected["answer_relations"], "relation_id"
            entity = next((e for e in collection if e[id_field] == change.entity_id), None)
            if entity is None:
                fail(path, "PATCH_DERIVATION", "patch entity missing from baseline")
            if change.field == "printed_number":
                entity["external_refs"]["printed_number"] = change.after
            else:
                entity[change.field] = change.after
        if expected != p.model_dump(mode="json"):
            fail(path, "PATCH_DERIVATION", "derived graph differs from exact baseline plus declared patch; re-recognition needs explicit conflict handling")


def _coverage(ctx, coverage, graph, path, passing=False):
    source = ctx.source(graph, path)
    evidence = ctx.resolve(graph.payload.evidence, path + ".evidence", "EvidenceBundle")
    if coverage.scope_id != graph.scope_id or set(coverage.pages_expected) != set(source.payload.pages_expected):
        fail(path, "COVERAGE_SCOPE", "coverage must bind complete original source scope")
    for name in ("pages_expected", "pages_checked", "clue_ids", "unassigned_region_ids"):
        distinct(getattr(coverage, name), path + "." + name)
    subset(coverage.pages_checked, source.payload.pages_acquired, path + ".pages_checked")
    clues = {c.clue_id: c for c in evidence.payload.coverage_clues}
    subset(coverage.clue_ids, clues, path + ".clue_ids")
    subset(coverage.unassigned_region_ids, {r.region_id for r in evidence.payload.regions}, path + ".unassigned_region_ids")
    # Every independently observed clue on a checked page must be accounted for.
    required = {c.clue_id for c in clues.values() if c.box.image.asset_id in coverage.pages_checked}
    if not required.issubset(coverage.clue_ids):
        fail(path + ".clue_ids", "COVERAGE_OMISSION", "checked page omitted whole-page coverage clues")
    if passing:
        if {q.question_id for q in graph.payload.questions} != set(source.payload.scope_manifest):
            fail(path, "SCOPE_QUESTION_MISSING", "PASS cannot omit an independently scoped question")
        owned = {f for q in graph.payload.questions for f in q.fragment_ids + q.shared_fragment_ids}
        owned.update(f for relation in graph.payload.answer_relations for f in relation.selected_fragment_ids)
        assigned = {r for f in graph.payload.fragments if f.fragment_id in owned for r in f.region_ids}
        if set(coverage.pages_checked) != set(coverage.pages_expected) or coverage.unassigned_region_ids:
            fail(path, "COVERAGE_INCOMPLETE", "PASS requires complete pages and no unassigned regions")
        for clue_id in coverage.clue_ids:
            clue = clues[clue_id]
            if clue.disposition == "UNASSIGNED" or (clue.disposition == "ASSIGNED" and not set(clue.region_ids).issubset(assigned)):
                fail(path + ".clue_ids", "UNASSIGNED_CONTENT", "whole-page clue lacks graph ownership")


def _check(ctx, a, path):
    p = a.payload
    graph = ctx.resolve(p.graph, path + ".graph", "QuestionGraph")
    policy = ctx.policy(p.policy, path + ".policy")
    if p.snapshot is not None:
        ctx.resolve(p.snapshot, path + ".snapshot", "PlatformSnapshot")
    if p.stage != "POST_APPLY" and p.receipt is not None:
        fail(path + ".receipt", "CHECK_STAGE", "receipt binding is reserved for POST_APPLY")
    expected_subject = {"PRE_APPLY": p.graph, "TARGET": p.snapshot, "POST_APPLY": p.receipt}[p.stage]
    if p.subject != expected_subject:
        fail(path + ".subject", "CHECK_SUBJECT", "stage subject must match graph/snapshot/receipt respectively")
    if p.decision == "PASS" and p.stage in ("PRE_APPLY", "TARGET"):
        if any(q.question_type in ("ordinary_choice", "seven_choice") for q in graph.payload.questions):
            if policy.option_grouping == "UNRESOLVED" or policy.confirmation_status == "UNRESOLVED":
                fail(path + ".policy", "POLICY_UNRESOLVED", "affected option rule must be resolved before PASS")
    _coverage(ctx, p.coverage, graph, path + ".coverage", p.decision == "PASS")
    source = ctx.source(graph, path)
    evidence = ctx.resolve(graph.payload.evidence, path + ".evidence", "EvidenceBundle")
    entities = {q.question_id for q in graph.payload.questions} | set(source.payload.scope_manifest)
    fragments = {f.fragment_id for f in graph.payload.fragments}
    regions = {r.region_id for r in evidence.payload.regions}
    extra = entities | fragments | regions | {c.clue_id for c in evidence.payload.coverage_clues}
    distinct([i.issue_id for i in p.issues], path + ".issues")
    for i, check in enumerate(p.checks):
        ctx.evrefs(check.evidence_refs, path + ".checks[{}].evidence_refs".format(i), extra)
    for i, issue in enumerate(p.issues):
        loc = path + ".issues[{}]".format(i)
        ctx.evrefs(issue.evidence_refs, loc + ".evidence_refs", extra)
        allowed = {"book": {a.book_id}, "scope": {a.scope_id}, "page": set(source.payload.pages_expected),
                   "question": entities, "fragment": fragments, "region": regions,
                   "action": {x.action_id for item in ctx.bundle.artifacts if item.kind == "ApplyPlan"
                              for x in item.payload.actions}}[issue.scope_type]
        subset([issue.scope_id], allowed, loc + ".scope_id")
    if p.stage == "POST_APPLY":
        receipt = ctx.resolve(p.receipt, path + ".receipt", "ExecutionReceipt")
        plan = ctx.resolve(receipt.payload.plan, path + ".receipt.plan", "ApplyPlan")
        if plan.payload.graph != p.graph or plan.payload.policy != p.policy:
            fail(path, "POSTCHECK_BINDING", "postcheck graph/policy must match executed plan")
        if p.decision == "PASS" and (not receipt.payload.results or any(r.outcome != "APPLIED" for r in receipt.payload.results)):
            fail(path + ".decision", "UNPROVEN_APPLY", "POST_APPLY PASS requires all actions APPLIED")


def _plan(ctx, a, path, current_snapshot=None):
    p = a.payload
    graph = ctx.resolve(p.graph, path + ".graph", "QuestionGraph")
    pre = ctx.resolve(p.precheck, path + ".precheck", "CheckReport").payload
    target = ctx.resolve(p.targetcheck, path + ".targetcheck", "CheckReport").payload
    snapshot = ctx.resolve(p.snapshot, path + ".snapshot", "PlatformSnapshot")
    policy = ctx.policy(p.policy, path + ".policy")
    previous = None
    if p.previous_receipt is not None:
        previous = ctx.resolve(p.previous_receipt, path + ".previous_receipt", "ExecutionReceipt")
        previous_plan = ctx.resolve(previous.payload.plan, path + ".previous_receipt.plan", "ApplyPlan")
        if (previous_plan.payload.graph.artifact_id != p.graph.artifact_id
                or previous_plan.payload.graph.revision >= p.graph.revision):
            fail(path + ".previous_receipt", "DELTA_BASELINE", "old receipt must belong to a prior revision of this graph")
    if pre.stage != "PRE_APPLY" or target.stage != "TARGET":
        fail(path, "TWO_CHECK_STAGES", "plan needs distinct PRE_APPLY and TARGET reports")
    for name, report in (("precheck", pre), ("targetcheck", target)):
        if report.graph != p.graph or report.policy != p.policy:
            fail(path + "." + name, "VERSION_CONFLICT", "check graph/policy version differs from plan")
        if report.snapshot is not None and report.snapshot != p.snapshot:
            fail(path + "." + name + ".snapshot", "TARGET_CHANGED", "check snapshot version differs from plan")
    if current_snapshot is not None and artifact_ref(snapshot) != as_data(current_snapshot):
        fail(path + ".snapshot", "TARGET_CHANGED", "current snapshot differs; recheck and replan")
    if snapshot.payload.authorized_scope_id != a.scope_id:
        fail(path + ".snapshot", "AUTHORIZED_SCOPE", "snapshot authorization scope differs")
    if p.readiness == "BLOCKED":
        issue_ids = {i.issue_id for report in (pre, target) for i in report.issues}
        subset(p.blocked_issue_ids, issue_ids, path + ".blocked_issue_ids")
        if pre.decision == target.decision == "PASS":
            fail(path, "BLOCKED_BASIS", "blocked plan needs a failed/held check")
        return
    if pre.decision != "PASS" or target.decision != "PASS":
        fail(path, "TWO_PASS_REQUIRED", "READY plan requires both content and target PASS")
    if any(q.question_type in ("ordinary_choice", "seven_choice") for q in graph.payload.questions):
        if policy.option_grouping == "UNRESOLVED" or policy.confirmation_status == "UNRESOLVED":
            fail(path + ".policy", "POLICY_UNRESOLVED", "affected option grouping cannot silently pass")
    if policy.applicability == "SYNTHETIC_ONLY" and (p.execution_mode != "SIMULATED" or a.producer.evidence_mode != "SYNTHETIC"):
        fail(path + ".policy", "SYNTHETIC_ONLY", "demo assumption cannot authorize platform execution")
    if p.execution_mode == "PLATFORM" and (policy.applicability != "JOINT_CONFIRMED" or a.producer.evidence_mode != "OBSERVED"):
        fail(path, "POLICY_UNCONFIRMED", "platform eligibility requires confirmed policy and observed evidence")
    caps = {c.name: c for c in snapshot.payload.capabilities}
    required = set(p.required_capabilities) | {"frame_readback"}
    required.add("persistent_draft" if p.session_mode == "PERSISTENT" else "same_session_handoff")
    if any(action.operation == "UPDATE_FRAMES" for action in p.actions):
        required.add("frame_update")
    for cap in required:
        if cap not in caps or caps[cap].status != "VERIFIED":
            fail(path + ".required_capabilities", "CAPABILITY_UNVERIFIED", "required capability not verified: " + cap)
        if caps[cap].platform_version != snapshot.payload.platform_version:
            fail(path + ".required_capabilities", "CAPABILITY_VERSION", "capability was tested against a different platform version: " + cap)
    distinct([x.action_id for x in p.actions], path + ".actions")
    questions = {q.question_id: q for q in graph.payload.questions}
    platform_questions = {q.platform_question_id: q for q in snapshot.payload.questions}
    graph_path = ctx.paths[(graph.artifact_id, graph.revision)] + ".payload"
    for i, question in enumerate(graph.payload.questions):
        external = question.external_refs
        if external.platform_question_id is None:
            continue
        loc = graph_path + ".questions[{}].external_refs".format(i)
        if external.platform_question_id not in platform_questions:
            fail(loc + ".platform_question_id", "MISSING_REFERENCE", "existing question mapping is absent from the plan snapshot")
        existing = platform_questions[external.platform_question_id]
        if external.platform_order is not None and external.platform_order != existing.platform_order:
            fail(loc + ".platform_order", "PLATFORM_MAPPING_CONFLICT", "mapped question order differs from the plan snapshot")
    entities = set(questions) | {f.fragment_id for f in graph.payload.fragments}
    seen = set()
    for i, action in enumerate(p.actions):
        loc = path + ".actions[{}]".format(i)
        subset(action.depends_on, seen, loc + ".depends_on")
        subset([action.target.question_id], questions, loc + ".target.question_id")
        subset(action.source_entity_ids, entities, loc + ".source_entity_ids")
        question = questions[action.target.question_id]
        owned = {question.question_id} | set(question.fragment_ids) | set(question.shared_fragment_ids)
        owned.update(f for relation in graph.payload.answer_relations if relation.question_id == question.question_id
                     for f in relation.selected_fragment_ids)
        if not set(action.source_entity_ids).issubset(owned):
            fail(loc + ".source_entity_ids", "ACTION_OWNERSHIP", "action sources must belong to its target question")
        if action.target.target_id != snapshot.payload.target_id:
            fail(loc + ".target.target_id", "TARGET_CONFLICT", "action target differs from snapshot")
        platform_id = action.target.platform_question_id
        mapped_id = question.external_refs.platform_question_id
        target_path = loc + ".target.platform_question_id"
        if platform_id is not None:
            if platform_id not in platform_questions:
                fail(target_path, "MISSING_REFERENCE", "action platform question is absent from the plan snapshot")
            if mapped_id is None:
                fail(target_path, "PLATFORM_MAPPING_REQUIRED", "existing action target requires an explicit mapping on its internal question")
            if platform_id != mapped_id:
                fail(target_path, "PLATFORM_MAPPING_CONFLICT", "action target differs from its internal question's existing platform mapping")
        elif mapped_id is not None:
            fail(target_path, "PLATFORM_MAPPING_CONFLICT", "null target cannot replace an existing platform question mapping")
        if action.operation == "UPDATE_FRAMES" and p.previous_receipt is None:
            fail(loc, "DELTA_BASELINE", "updates must reference old receipt; actual delta support is out of C01")
        if action.operation == "UPDATE_FRAMES":
            previous_targets = {old.action_id: old.target.question_id for old in previous_plan.payload.actions}
            applied_questions = {previous_targets[r.action_id] for r in previous.payload.results if r.outcome == "APPLIED"}
            if action.target.question_id not in applied_questions:
                fail(loc, "DELTA_BASELINE", "update target has no APPLIED baseline action")
        seen.add(action.action_id)


def _receipt(ctx, a, path):
    p = a.payload
    plan = ctx.resolve(p.plan, path + ".plan", "ApplyPlan").payload
    distinct([r.action_id for r in p.results], path + ".results")
    if plan.readiness == "BLOCKED":
        if p.results or p.execution_mode != "NOT_EXECUTED" or p.write_disposition != "NOT_EXECUTED":
            fail(path, "BLOCKED_EXECUTION", "blocked plan must not have executed actions")
    else:
        if {r.action_id for r in p.results} != {a.action_id for a in plan.actions}:
            fail(path + ".results", "ACTION_COVERAGE", "every planned action requires exactly one result")
        if p.execution_mode != {"SIMULATED": "SIMULATED", "PLATFORM": "PLATFORM_OBSERVED"}[plan.execution_mode]:
            fail(path + ".execution_mode", "EVIDENCE_MODE", "receipt execution mode differs from plan")
        outcomes = {r.outcome for r in p.results}
        expected = "PAUSE_RECONCILE" if "UNKNOWN" in outcomes else "RECHECK_TARGET" if "NOT_APPLIED" in outcomes else "POSTCHECK"
        if p.write_disposition != expected:
            fail(path + ".write_disposition", "UNKNOWN_GUARD", "receipt disposition must follow worst unresolved action")
        if "UNKNOWN" in outcomes and not p.unresolved_issue_ids:
            fail(path + ".unresolved_issue_ids", "UNKNOWN_GUARD", "UNKNOWN requires unresolved issue")
    for i, result in enumerate(p.results):
        ctx.evrefs(result.before_evidence_refs, path + ".results[{}].before_evidence_refs".format(i))
        ctx.evrefs(result.after_evidence_refs, path + ".results[{}].after_evidence_refs".format(i))


def _patch(ctx, a, path):
    p = a.payload
    graph = ctx.resolve(p.baseline, path + ".baseline", "QuestionGraph")
    if p.result_revision != graph.revision + 1:
        fail(path + ".result_revision", "PATCH_REVISION", "patch must propose next immutable revision")
    fragments = {f.fragment_id: f for f in graph.payload.fragments}
    questions = {q.question_id: q for q in graph.payload.questions}
    relations = {r.relation_id: r for r in graph.payload.answer_relations}
    distinct([(c.entity_id, c.field) for c in p.changes], path + ".changes")
    for i, change in enumerate(p.changes):
        loc = path + ".changes[{}]".format(i)
        if change.field == "role":
            entity = fragments.get(change.entity_id)
            if change.after not in ("stem", "option", "answer", "explanation", "shared_material"):
                fail(loc + ".after", "PATCH_VALUE", "invalid generic role")
            before = entity.role if entity else None
        elif change.field == "printed_number":
            entity = questions.get(change.entity_id)
            if change.after is not None and not isinstance(change.after, str):
                fail(loc + ".after", "PATCH_VALUE", "printed number must be string or null")
            before = entity.external_refs.printed_number if entity else None
        else:
            entity = relations.get(change.entity_id)
            if not isinstance(change.after, list):
                fail(loc + ".after", "PATCH_VALUE", "answer selection must be a list")
            subset(change.after, entity.candidate_fragment_ids if entity else (), loc + ".after")
            before = entity.selected_fragment_ids if entity else None
        if entity is None:
            fail(loc + ".entity_id", "MISSING_ENTITY", "patch entity absent from exact baseline")
        if change.before != before:
            fail(loc + ".before", "PATCH_BASELINE", "expected old field does not match baseline")


def _batch(ctx, a, path):
    p = a.payload
    source = ctx.resolve(p.source, path + ".source", "SourceBundle")
    graph = ctx.resolve(p.graph, path + ".graph", "QuestionGraph")
    receipt = ctx.resolve(p.receipt, path + ".receipt", "ExecutionReceipt")
    post = ctx.resolve(p.postcheck, path + ".postcheck", "CheckReport").payload
    if p.scope_manifest != source.payload.scope_manifest:
        fail(path + ".scope_manifest", "DENOMINATOR_CHANGED", "batch must retain independent source scope manifest")
    if graph.payload.source != p.source or post.graph != p.graph or post.receipt != p.receipt or post.stage != "POST_APPLY":
        fail(path, "BATCH_BINDING", "batch source/graph/postcheck/receipt versions differ")
    _coverage(ctx, p.coverage, graph, path + ".coverage", p.state in ("COMPLETED", "READY_FOR_SUBMISSION"))
    checks = {c.check_id: c.outcome for c in post.checks}
    expected_frames = {"PASS": "PASS", "FAIL": "FAIL", "UNAVAILABLE": "UNAVAILABLE"}[checks["frame_structure"]]
    if p.frame_check_status != expected_frames:
        fail(path + ".frame_check_status", "FRAME_EVIDENCE", "frame result differs from postcheck")
    if p.content_check_status == "VERIFIED" and checks["final_content"] != "PASS":
        fail(path + ".content_check_status", "CONTENT_EVIDENCE", "verified content requires final-content PASS")
    if p.content_check_status == "MISMATCH" and checks["final_content"] != "FAIL":
        fail(path + ".content_check_status", "CONTENT_EVIDENCE", "mismatch requires final-content failure")
    if p.state in ("COMPLETED", "READY_FOR_SUBMISSION") and post.decision != "PASS":
        fail(path + ".state", "COMPLETION_GUARD", "completion/readiness requires POST_APPLY PASS")
    if any(r.outcome == "UNKNOWN" for r in receipt.payload.results):
        if p.state != "NEEDS_RECONCILIATION" or not p.unresolved_issue_ids or not any(q.state == "UNKNOWN" for q in p.questions):
            fail(path + ".state", "UNKNOWN_GUARD", "unknown write must pause batch for reconciliation")
        if p.content_check_status == "VERIFIED":
            fail(path + ".content_check_status", "UNKNOWN_GUARD", "unresolved write cannot have verified final content")
    plan = ctx.resolve(receipt.payload.plan, path + ".receipt.plan", "ApplyPlan")
    targets = {action.action_id: action.target.question_id for action in plan.payload.actions}
    statuses = {q.question_id: q.state for q in p.questions}
    for result in receipt.payload.results:
        if result.outcome == "UNKNOWN" and statuses.get(targets[result.action_id]) != "UNKNOWN":
            fail(path + ".questions", "UNKNOWN_QUESTION", "each unresolved action target must remain UNKNOWN")
        if result.outcome == "NOT_APPLIED" and statuses.get(targets[result.action_id]) == "VERIFIED":
            fail(path + ".questions", "UNAPPLIED_QUESTION", "unapplied action target cannot be VERIFIED")
    for i, question in enumerate(p.questions):
        if question.question_id not in {q.question_id for q in graph.payload.questions} and question.state == "VERIFIED":
            fail(path + ".questions[{}]".format(i), "UNRECOGNIZED_QUESTION", "missing graph question cannot be verified")
    ctx.evrefs(p.submission_evidence_refs, path + ".submission_evidence_refs")


def validate_bundle(bundle, asset_root=None, *, bridge_context=None):
    """Validate schema, exact dependencies, geometry, policy and state invariants.

    asset_root=None deliberately skips file-byte validation; load_bundle defaults to it on.
    Re-parse even model instances to catch mutations of nested Python lists/dicts.
    """
    version = bundle.get('format_version') if isinstance(bundle, dict) else getattr(bundle, 'format_version', None)
    if version == 'a03-exchange-4-proposal':
        from .a03_native import validate_native_bundle
        return validate_native_bundle(bundle, bridge_context=bridge_context, asset_root=asset_root)
    try:
        bundle = ExchangeBundle.model_validate(as_data(bundle))
    except ValidationError as error:
        raise ContractError([{"path": "$" + "".join("[{}]".format(x) if isinstance(x, int) else "." + x for x in e["loc"]),
                              "code": "SCHEMA", "message": e["msg"]} for e in error.errors(include_url=False)]) from error
    ctx = _Context(bundle)
    _relationships(ctx)
    _resources(ctx, asset_root)
    handlers = {"SourceBundle": _source, "EvidenceBundle": _evidence, "QuestionGraph": _graph,
                "CheckReport": _check, "ApplyPlan": _plan, "ExecutionReceipt": _receipt,
                "ReviewPatch": _patch, "BatchReport": _batch}
    all_issues = {issue.issue_id for a in bundle.artifacts if a.kind == "CheckReport" for issue in a.payload.issues}
    for key, artifact in ctx.artifacts.items():
        path = ctx.paths[key] + ".payload"
        if artifact.kind in handlers:
            handlers[artifact.kind](ctx, artifact, path)
        if artifact.kind == "PlatformSnapshot":
            p = artifact.payload
            distinct(p.directories, path + ".directories")
            distinct([c.name for c in p.capabilities], path + ".capabilities")
            distinct([q.platform_question_id for q in p.questions], path + ".questions")
            distinct([f.platform_frame_id for f in p.frames], path + ".frames")
            for i, question in enumerate(p.questions):
                if question.directory_id not in p.directories:
                    fail(path + ".questions[{}].directory_id".format(i), "MISSING_REFERENCE", "platform question directory is absent from this snapshot")
            for i, cap in enumerate(p.capabilities):
                ctx.evrefs(cap.evidence_refs, path + ".capabilities[{}].evidence_refs".format(i))
            ctx.evrefs(p.evidence_refs, path + ".evidence_refs")
            for i, frame in enumerate(p.frames):
                subset([frame.platform_question_id], {q.platform_question_id for q in p.questions}, path + ".frames[{}]".format(i))
        for name in ("unresolved_issue_ids", "related_issue_ids"):
            if hasattr(artifact.payload, name):
                subset(getattr(artifact.payload, name), all_issues, path + "." + name)
        if artifact.producer.evidence_mode == "OBSERVED":
            # A synthetic evidence file cannot be relabeled into an observation chain.
            for location, value in walk(artifact, ctx.paths[key]):
                if isinstance(value, list) and location.endswith("evidence_refs"):
                    for evidence_id in value:
                        if evidence_id in ctx.evidence and ctx.evidence[evidence_id].mode == "SYNTHETIC":
                            fail(location, "SYNTHETIC_EVIDENCE", "observed artifact references synthetic evidence")
    return bundle


def load_bundle(path, verify_assets=True):
    path = Path(path)
    try:
        data = read_json(path)
    except (OSError, ValueError) as error:
        fail("$", "JSON_INPUT", str(error))
    return validate_bundle(data, path.parent if verify_assets else None)


def assert_plan_ready(bundle, plan_ref, current_snapshot_ref):
    """Check eligibility against an explicit current snapshot; performs no I/O or action."""
    bundle = validate_bundle(bundle)
    ctx = _Context(bundle)
    try:
        plan_ref = ArtifactRef.model_validate(as_data(plan_ref))
        current_snapshot_ref = ArtifactRef.model_validate(as_data(current_snapshot_ref))
    except ValidationError as error:
        fail("$.eligibility", "SCHEMA", str(error))
    plan = ctx.resolve(plan_ref, "$.plan", "ApplyPlan")
    ctx.resolve(current_snapshot_ref, "$.current_snapshot", "PlatformSnapshot")
    if plan.payload.readiness != "READY":
        fail("$.plan.readiness", "PLAN_BLOCKED", "diagnostic plan is not eligible")
    _plan(ctx, plan, "$.plan.payload", current_snapshot_ref)
    # A fresh plan ID cannot bypass an unresolved write elsewhere in this book.
    for artifact in bundle.artifacts:
        if artifact.kind == "ExecutionReceipt" and artifact.book_id == plan.book_id:
            if any(r.outcome == "UNKNOWN" for r in artifact.payload.results):
                fail("$.plan", "BOOK_WRITE_PAUSED", "UNKNOWN receipt requires reconciliation before any book write")
    return plan


def assert_patch_base(bundle, patch_ref, baseline_ref):
    bundle = validate_bundle(bundle)
    ctx = _Context(bundle)
    try:
        patch_ref = ArtifactRef.model_validate(as_data(patch_ref))
        baseline_ref = ArtifactRef.model_validate(as_data(baseline_ref))
    except ValidationError as error:
        fail("$.patch", "SCHEMA", str(error))
    patch = ctx.resolve(patch_ref, "$.patch", "ReviewPatch")
    ctx.resolve(baseline_ref, "$.baseline", "QuestionGraph")
    if patch.payload.baseline != baseline_ref:
        fail("$.patch.payload.baseline", "PATCH_BASELINE", "patch may only apply to its exact baseline version")
    return patch

903fc17703ced5e0f9129786afc7dc323e25332b blob 44562
"""Independent all-synthetic SQLite target, with controlled runtime fencing.

This database never shares a connection or transaction with runtime.sqlite3.
Public observations are evidence values; only runtime-issued opaque handles grant
effects, under the common book gate and the target's persisted fence.
"""
import copy
import hashlib
import json
import os
from pathlib import Path
import sqlite3
import threading
import time
import uuid
from datetime import datetime, timezone
from types import MappingProxyType

from annotation.contracts import artifact_ref, assert_plan_ready, content_digest, seal_artifact, validate_bundle
from annotation.delivery.planner import (PublicRecord, action_facts, bind_plan_observation,
                                         compare_action_effect, encoded)
from annotation.quality.targetcheck import reject, resolve_artifact

FORMAT = "a03-mock-state-1"
APPLICATION_ID = 0x41303354
EFFECT_FAULTS = {None, "applied", "not_applied", "partial", "lost_response",
                 "response_lost_readable", "after_effect_exit"}
READ_FAULTS = {None, "unavailable", "contradictory", "truncated", "duplicate", "timeout"}
_locks = {}
_locks_guard = threading.Lock()


class _ClosingConnection(sqlite3.Connection):
    def __exit__(self, *args):
        try:
            return super().__exit__(*args)
        finally:
            self.close()


def _plain(value):
    if hasattr(value, "model_dump"):
        return value.model_dump(mode="json")
    return dict(value) if isinstance(value, dict) else value


def _utc():
    return datetime.now(timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")


def _get(value, name, default=None):
    return value.get(name, default) if isinstance(value, dict) else getattr(value, name, default)


def _write_resource(root, value):
    root = Path(root).resolve()
    raw = (json.dumps(value, sort_keys=True, ensure_ascii=False, indent=2, allow_nan=False) + "\n").encode("utf-8")
    digest = hashlib.sha256(raw).hexdigest()
    relative = "assets/a03-target/" + digest + ".json"
    path = root / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    if not path.resolve().is_relative_to(root):
        reject("EVIDENCE_PATH", "target evidence path escapes asset root")
    try:
        with path.open("xb") as handle:
            handle.write(raw)
            handle.flush()
            os.fsync(handle.fileno())
    except FileExistsError:
        if path.read_bytes() != raw:
            reject("RESOURCE_HASH_MISMATCH", "immutable target evidence conflicts")
    return {"path": relative, "sha256": digest, "media_type": "application/json", "origin": "SYNTHETIC"}


def _copy_resources(value, source_root, destination_root):
    """Preserve exact evidence bytes when preparation uses a runtime package."""
    source_root, destination_root = Path(source_root).resolve(), Path(destination_root).resolve()
    if isinstance(value, list):
        for member in value:
            _copy_resources(member, source_root, destination_root)
    elif isinstance(value, dict):
        if {"path", "sha256", "media_type"}.issubset(value):
            source = (source_root / value["path"]).resolve()
            destination = (destination_root / value["path"]).resolve()
            if not source.is_relative_to(source_root) or not destination.is_relative_to(destination_root) or not source.is_file() or source.is_symlink():
                reject("RESOURCE_MISSING", "preparation evidence path is unsafe or missing")
            raw = source.read_bytes()
            if hashlib.sha256(raw).hexdigest() != value["sha256"]:
                reject("RESOURCE_HASH_MISMATCH", "preparation evidence bytes changed")
            if source != destination:
                destination.parent.mkdir(parents=True, exist_ok=True)
                try:
                    with destination.open("xb") as handle:
                        handle.write(raw)
                        handle.flush()
                        os.fsync(handle.fileno())
                except FileExistsError:
                    if destination.read_bytes() != raw:
                        reject("RESOURCE_HASH_MISMATCH", "package evidence cannot overwrite existing bytes")
            if value["media_type"] == "application/json":
                _copy_resources(json.loads(raw), source_root, destination_root)
        else:
            for member in value.values():
                _copy_resources(member, source_root, destination_root)


class BookEffectGate:
    """Bounded host-local per-book cross-process byte lock.

    Every controlled takeover and dispatch uses the same fixed runtime path.
    Reentry in the same thread preserves the original OS lock and lease.
    """
    def __init__(self, path, target_key, timeout=5.0):
        self.path = str(Path(path).resolve())
        self.target_key = copy.deepcopy(_plain(target_key))
        self.timeout = min(float(timeout), 5.0)
        with _locks_guard:
            self._local = _locks.setdefault(self.path, {"lock": threading.RLock(), "depth": 0, "thread": None})
        self.held = False
        self.pid = os.getpid()

    def acquire(self, timeout=None):
        if timeout is not None:
            self.timeout = min(float(timeout), 5.0)
        return self

    def __enter__(self):
        deadline = time.monotonic() + max(0.0, self.timeout)
        if not self._local["lock"].acquire(timeout=max(0.0, self.timeout)):
            reject("EFFECT_GATE_TIMEOUT", "book gate deadline exhausted")
        if self._local["depth"]:
            self._local["depth"] += 1
            self.held = True
            return self
        path = Path(self.path)
        path.parent.mkdir(parents=True, exist_ok=True)
        self._file = path.open("a+b")
        self._file.seek(0, 2)
        if self._file.tell() == 0:
            self._file.write(b"0")
            self._file.flush()
        try:
            while True:
                try:
                    self._file.seek(0)
                    if os.name == "nt":
                        import msvcrt
                        msvcrt.locking(self._file.fileno(), msvcrt.LK_NBLCK, 1)
                    else:
                        import fcntl
                        fcntl.flock(self._file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except (OSError, BlockingIOError):
                    if time.monotonic() >= deadline:
                        reject("EFFECT_GATE_TIMEOUT", "book gate acquisition exceeded absolute deadline")
                    time.sleep(min(0.01, max(0, deadline - time.monotonic())))
            self._local.update(depth=1, thread=threading.get_ident(), file=self._file)
            self.held = True
            return self
        except BaseException:
            self._file.close()
            self._local["lock"].release()
            raise

    def __exit__(self, *_):
        self._local["depth"] -= 1
        if not self._local["depth"]:
            handle = self._local.pop("file")
            try:
                handle.seek(0)
                if os.name == "nt":
                    import msvcrt
                    msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
                else:
                    import fcntl
                    fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
            finally:
                handle.close()
            self._local["thread"] = None
        self.held = self._local["depth"] > 0
        self._local["lock"].release()


def compare_action(action, before_observation, after_observation, *, comparator_version="a02-facts-1"):
    return compare_action_effect(action, before_observation, after_observation,
                                 comparator_version=comparator_version)


class PreparedAction(PublicRecord):
    """A value whose exact issued object must pass its observer's registry.

    A serialized/copy value is useful diagnostic evidence, not first-dispatch
    authority. Mutations are detected against the privately retained digest.
    """


class VerifiedPreparedAction:
    """Direct callback result, deliberately not a JSON dictionary or boolean."""
    def __init__(self, **data):
        self._data = MappingProxyType(copy.deepcopy(data))

    def __getitem__(self, key):
        return self._data[key]

    def get(self, key, default=None):
        return self._data.get(key, default)

    def __getattr__(self, key):
        try:
            return self._data[key]
        except KeyError as exc:
            raise AttributeError(key) from exc


def _prepared_digest(prepared):
    return content_digest({key: _plain(value) for key, value in prepared.items()})


def apply_synthetic_action(state, action, partial=False):
    payload = state["target"]
    pid = action["target"]["platform_question_id"]
    if pid is None:
        number = len(payload["questions"]) + 1
        existing = {q["platform_question_id"] for q in payload["questions"]}
        while "mock-question-" + str(number) in existing:
            number += 1
        pid = "mock-question-" + str(number)
        directory = action["expected_before"]["directory_id"]
        order = max([q["platform_order"] for q in payload["questions"] if q["directory_id"] == directory] + [0]) + 1
        payload["questions"].append({"platform_question_id": pid, "directory_id": directory, "platform_order": order})
    state["internal_bindings"][action["target"]["question_id"]] = pid
    projected = json.loads(action["expected_after"]["frames"])
    if partial:
        projected = projected[:-1]
    for frame in projected:
        number = len(payload["frames"]) + 1
        existing = {f["platform_frame_id"] for f in payload["frames"]}
        while "mock-frame-" + str(number) in existing:
            number += 1
        fid = "mock-frame-" + str(number)
        payload["frames"].append({"platform_frame_id": fid, "platform_question_id": pid,
                                  "box": frame["box"], "platform_role": frame["platform_role"]})
        state["frame_projections"][fid] = copy.deepcopy(frame)
    state["epoch"] += 1
    return pid


class PersistentMockSession:
    _format = FORMAT
    _application_id = APPLICATION_ID
    _user_version = 1
    _native = False
    def __init__(self, directory, descriptor):
        self.directory = Path(directory).resolve()
        self.path = self.directory / "target.sqlite3"
        self.descriptor = PublicRecord(descriptor)
        self.asset_root = Path(descriptor["asset_root"]).resolve()
        self.target_session_id = descriptor["target_session_id"]
        self.store_id = descriptor["store_id"]
        self.target_key = copy.deepcopy(descriptor["target_key"])
        self.source_ref = copy.deepcopy(descriptor["fixed_source_ref"])
        self.scope_id = descriptor["fixed_scope_id"]
        self._prepared_actions = {}

    @classmethod
    def create(cls, target_dir, bundle, snapshot_ref, *, platform_namespace, source_ref,
               asset_root, expected_store_id, target_session_id, bridge_context=None):
        if bridge_context is not None and cls is PersistentMockSession:
            from annotation.runtime.storage.native_target import NativeTargetSession
            return NativeTargetSession.create(target_dir, bundle, snapshot_ref, platform_namespace=platform_namespace, source_ref=source_ref, asset_root=asset_root, expected_store_id=expected_store_id, target_session_id=target_session_id, bridge_context=bridge_context)
        bundle = validate_bundle(bundle, asset_root=asset_root, bridge_context=bridge_context)
        snapshot = resolve_artifact(bundle, snapshot_ref, "PlatformSnapshot")
        source = resolve_artifact(bundle, source_ref, "SourceBundle")
        if snapshot.schema_version != ("1.4.0-a03-native-proposal" if cls._native else "1.1.0-a-recovery-proposal"):
            reject("RECOVERY_VERSION_UNSUPPORTED", "persistent target requires explicitly converted recovery input")
        if (snapshot.producer.evidence_mode != "SYNTHETIC" or source.producer.evidence_mode != "SYNTHETIC"):
            reject("SYNTHETIC_ONLY", "persistent target accepts all-synthetic inputs only")
        if (source.book_id, source.scope_id) != (snapshot.book_id, snapshot.scope_id):
            reject("SOURCE_BINDING", "target source book/scope differs")
        directory = Path(target_dir).resolve()
        path = directory / "target.sqlite3"
        directory.mkdir(parents=True, exist_ok=True)
        try:
            with path.open("xb"):
                pass
        except FileExistsError:
            reject("TARGET_STORE_EXISTS", "explicit create cannot reset an existing target")
        key = {"platform_namespace": platform_namespace, "target_id": snapshot.payload.target_id,
               "book_id": snapshot.book_id}
        descriptor = {"format": cls._format, "user_version": cls._user_version, "application_id": cls._application_id,
                      "store_id": expected_store_id, "target_session_id": target_session_id,
                      "target_key": key, "book_id": snapshot.book_id,
                      "fixed_scope_id": snapshot.scope_id, "fixed_source_ref": artifact_ref(source),
                      "base_snapshot_ref": artifact_ref(snapshot), "directory": str(directory),
                      "asset_root": str(Path(asset_root).resolve())}
        if cls._native:
            descriptor["native_adoption"] = cls.native_metadata()
        state = {"base": _plain(snapshot), "target": _plain(snapshot.payload),
                 "internal_bindings": {}, "frame_projections": {}, "epoch": 0,
                 "read_sequence": 0, "fence_generation": 0, "fence_owner_id": None,
                 "context": None}
        from annotation.contracts import target_state_digest
        descriptor["initial_state_digest"] = target_state_digest({"target_key": key,
            "source_ref": artifact_ref(source), "scope_id": snapshot.scope_id,
            "target": state["target"], "internal_bindings": {}, "frame_projections": {}})
        try:
            with sqlite3.connect(str(path), timeout=1.0, factory=_ClosingConnection) as db:
                db.execute("PRAGMA application_id=" + str(cls._application_id))
                db.execute("PRAGMA user_version=" + str(cls._user_version))
                db.execute("PRAGMA synchronous=FULL")
                db.execute("CREATE TABLE meta(key TEXT PRIMARY KEY,value TEXT NOT NULL)")
                db.execute("CREATE TABLE effects(sequence INTEGER PRIMARY KEY AUTOINCREMENT,body TEXT NOT NULL)")
                db.execute("CREATE TABLE observations(observation_id TEXT PRIMARY KEY,body TEXT NOT NULL)")
                db.execute("INSERT INTO meta VALUES('descriptor',?)", (encoded(descriptor),))
                db.execute("INSERT INTO meta VALUES('state',?)", (encoded(state),))
            session = cls(directory, descriptor)
            session._bridge_context = bridge_context
            return session
        except sqlite3.Error as exc:
            reject("TARGET_STORE_IO", str(exc))

    @classmethod
    def open(cls, target_dir, *, expected_store_id, expected_target_session_id,
             expected_target_key, expected_scope_id, expected_source_ref, bridge_context=None):
        if bridge_context is not None and cls is PersistentMockSession:
            from annotation.runtime.storage.native_target import NativeTargetSession
            return NativeTargetSession.open(target_dir, expected_store_id=expected_store_id, expected_target_session_id=expected_target_session_id, expected_target_key=expected_target_key, expected_scope_id=expected_scope_id, expected_source_ref=expected_source_ref, bridge_context=bridge_context)
        directory = Path(target_dir).resolve()
        path = directory / "target.sqlite3"
        if not path.is_file():
            reject("TARGET_STORE_MISSING", "reopen never initializes a missing target store")
        try:
            with sqlite3.connect(path.as_uri() + "?mode=rw", uri=True, timeout=1.0, factory=_ClosingConnection) as db:
                if db.execute("PRAGMA application_id").fetchone()[0] != cls._application_id or db.execute("PRAGMA user_version").fetchone()[0] != cls._user_version:
                    reject("TARGET_STORE_VERSION_UNSUPPORTED", "target application or user version differs")
                if db.execute("PRAGMA quick_check").fetchone()[0] != "ok":
                    reject("TARGET_STORE_CORRUPT", "target integrity check failed")
                row = db.execute("SELECT value FROM meta WHERE key='descriptor'").fetchone()
                descriptor = json.loads(row[0])
                json.loads(db.execute("SELECT value FROM meta WHERE key='state'").fetchone()[0])
        except (sqlite3.Error, ValueError, TypeError, KeyError) as exc:
            reject("TARGET_STORE_CORRUPT", str(exc))
        if descriptor.get("directory") != str(directory):
            reject("STATE_DIRECTORY_IDENTITY_MISMATCH", "target directory differs from established identity")
        if descriptor.get("format") != cls._format:
            reject("TARGET_STORE_VERSION_UNSUPPORTED", "target format differs")
        if descriptor.get("store_id") != expected_store_id or descriptor.get("target_key") != _plain(expected_target_key):
            reject("TARGET_IDENTITY_MISMATCH", "target store/key differs")
        if descriptor.get("target_session_id") != expected_target_session_id:
            reject("TARGET_SESSION_BINDING_MISMATCH", "target session differs")
        if descriptor.get("fixed_scope_id") != expected_scope_id:
            reject("TARGET_SCOPE_SWITCH_UNSUPPORTED", "fixed session scope cannot change")
        if descriptor.get("fixed_source_ref") != _plain(expected_source_ref):
            reject("SOURCE_BINDING", "fixed session source revision/hash cannot change")
        if cls._native and descriptor.get("native_adoption") != cls.native_metadata():
            reject("NATIVE_TARGET_ADOPTION_MISMATCH", "target native metadata is incomplete or foreign")
        session = cls(directory, descriptor)
        session._bridge_context = bridge_context
        return session

    def _connect(self):
        if not self.path.is_file():
            reject("TARGET_STORE_MISSING", "target file is missing")
        try:
            db = sqlite3.connect(self.path.as_uri() + "?mode=rw", uri=True, timeout=1.0, factory=_ClosingConnection)
            db.execute("PRAGMA synchronous=FULL")
            if db.execute("PRAGMA application_id").fetchone()[0] != self._application_id or db.execute("PRAGMA user_version").fetchone()[0] != self._user_version:
                db.close()
                reject("TARGET_STORE_VERSION_UNSUPPORTED", "target version changed")
            descriptor = json.loads(db.execute("SELECT value FROM meta WHERE key='descriptor'").fetchone()[0])
            if self._native and descriptor.get("native_adoption") != self.native_metadata():
                db.close()
                reject("NATIVE_TARGET_ADOPTION_MISMATCH", "target native adoption changed")
            for name in ("store_id", "target_session_id", "target_key", "directory", "fixed_source_ref", "fixed_scope_id"):
                if descriptor.get(name) != self.descriptor.get(name):
                    db.close()
                    reject("TARGET_IDENTITY_MISMATCH", "opened target was replaced")
            return db
        except sqlite3.Error as exc:
            reject("TARGET_STORE_CORRUPT", str(exc))

    @staticmethod
    def _load(db):
        return json.loads(db.execute("SELECT value FROM meta WHERE key='state'").fetchone()[0])

    @staticmethod
    def _save(db, state):
        db.execute("UPDATE meta SET value=? WHERE key='state'", (encoded(state),))

    def _view(self, state):
        return {"provenance": "SYNTHETIC", "execution_mode": "SIMULATED",
                "target_key": copy.deepcopy(self.descriptor.target_key),
                "target_session_id": self.descriptor.target_session_id,
                "source_ref": copy.deepcopy(self.descriptor.fixed_source_ref),
                "scope_id": self.descriptor.fixed_scope_id,
                "book_id": self.descriptor.book_id, "epoch": state["epoch"],
                "target": copy.deepcopy(state["target"]),
                "internal_bindings": copy.deepcopy(state["internal_bindings"]),
                "frame_projections": copy.deepcopy(state["frame_projections"])}

    def _hash(self, state):
        from annotation.contracts import target_state_digest
        return target_state_digest(self._view(state))

    def _key(self, target_key):
        if _plain(target_key) != self.descriptor.target_key:
            reject("TARGET_IDENTITY_MISMATCH", "requested canonical book key differs")

    def read_target(self, book_id=None):
        if book_id is not None and book_id != self.descriptor.book_id:
            reject("TARGET_NOT_REGISTERED", "book differs from persistent target")
        with self._connect() as db:
            return self._view(self._load(db))

    def activate_fence(self, target_key, *, target_session_id, owner_id, generation, authority):
        self._key(target_key)
        if target_session_id != self.descriptor.target_session_id:
            reject("TARGET_IDENTITY_MISMATCH", "fence target session differs")
        with authority.effect_gate(target_key) as gate:
            reservation = getattr(authority, "current_claim", None)
            if reservation is None:
                reject("CLAIM_NOT_RESERVED", "runtime opaque claim reservation is required")
            claim = authority.verify_claim(reservation, effect_gate=gate)
            if any(_get(claim, k) != value for k, value in (("owner_id", owner_id), ("generation", generation), ("target_key", target_key))):
                reject("OWNER_GENERATION_STALE", "runtime claim differs from fence request")
            with self._connect() as db:
                db.execute("BEGIN IMMEDIATE")
                state = self._load(db)
                if generation <= state["fence_generation"]:
                    reject("OWNER_GENERATION_STALE", "target fence generation must increase")
                state.update(fence_generation=generation, fence_owner_id=owner_id)
                self._save(db, state)
            return PublicRecord(store_id=self.descriptor.store_id, target_store_id=self.descriptor.store_id,
                                target_session_id=target_session_id, target_key=target_key, owner_id=owner_id,
                                generation=generation, commit_ref="target-fence-" + str(generation))

    def observe_target(self, target_key, *, observation_id, read_fault=None):
        self._key(target_key)
        if read_fault not in READ_FAULTS:
            reject("INVALID_FAULT", "unknown target read fault")
        timed_out = read_fault == "timeout"
        if timed_out:
            time.sleep(2.0)
        with self._connect() as db:
            db.execute("BEGIN IMMEDIATE")
            if db.execute("SELECT 1 FROM observations WHERE observation_id=?", (observation_id,)).fetchone():
                reject("OBSERVATION_ID_CONFLICT", "observation identity is permanently used")
            value = PublicRecord(format_version="a03-target-observation-1", origin="SYNTHETIC",
                                 provenance="SYNTHETIC", execution_mode="SIMULATED", observation_id=observation_id,
                                 store_id=self.descriptor.store_id, target_store_id=self.descriptor.store_id,
                                 target_session_id=self.descriptor.target_session_id, target_key=copy.deepcopy(target_key),
                                 scope_id=self.descriptor.fixed_scope_id, source_ref=copy.deepcopy(self.descriptor.fixed_source_ref),
                                 observed_at=_utc(), read_sequence=None, target_state_version=None,
                                 target_state_hash=None, read_status="UNAVAILABLE", relevant_scope_completeness=False,
                                 scope_complete=False, view=None, state=None, effect_log=[])
            if read_fault not in ("unavailable", "timeout"):
                state = self._load(db)
                state["read_sequence"] += 1
                self._save(db, state)
                view = self._view(state)
                effects = [json.loads(row[0]) for row in db.execute("SELECT body FROM effects ORDER BY sequence")]
                value.update(read_sequence=state["read_sequence"], target_state_version="a03-target-epoch-" + str(state["epoch"]),
                             target_state_hash=self._hash(state), read_status="OK", relevant_scope_completeness=True,
                             scope_complete=True, view=view, state=copy.deepcopy(view), effect_log=effects)
                if read_fault == "contradictory":
                    value["read_status"] = "CONTRADICTORY"
                elif read_fault == "truncated":
                    value.update(read_status="TRUNCATED", relevant_scope_completeness=False, scope_complete=False)
                elif read_fault == "duplicate":
                    if value["view"]["target"]["questions"]:
                        value["view"]["target"]["questions"].append(copy.deepcopy(value["view"]["target"]["questions"][0]))
                    else:
                        value.update(read_status="TRUNCATED", relevant_scope_completeness=False, scope_complete=False)
            if timed_out:
                value["failure_code"] = "TARGET_READ_TIMEOUT"
            db.execute("INSERT INTO observations VALUES(?,?)", (observation_id, encoded(value)))
        resource = _write_resource(self.asset_root, value)
        value.update(resource=resource, readback=resource, asset_root=str(self.asset_root))
        value["effect_log_resource"] = _write_resource(self.asset_root, {"origin": "SYNTHETIC", "effect_log": value["effect_log"]})
        return value

    def _verify_observation(self, observation, *, bridge_context=None):
        value = _plain(observation)
        with self._connect() as db:
            row = db.execute("SELECT body FROM observations WHERE observation_id=?", (value.get("observation_id"),)).fetchone()
        if row is None:
            reject("OBSERVATION_MISSING", "actual persisted observation does not exist")
        original = json.loads(row[0])
        resource = value.get("resource", value.get("readback"))
        if resource is None:
            reject("RESOURCE_MISSING", "observation resource is missing")
        path = (self.asset_root / resource["path"]).resolve()
        if not path.is_relative_to(self.asset_root) or not path.is_file() or path.is_symlink():
            reject("RESOURCE_MISSING", "observation resource path is missing or outside its root")
        raw = path.read_bytes()
        if hashlib.sha256(raw).hexdigest() != resource["sha256"]:
            reject("RESOURCE_HASH_MISMATCH", "observation bytes differ from their resource digest")
        if json.loads(raw) != original:
            reject("OBSERVATION_BINDING_MISMATCH", "observation resource differs from independent persisted read")
        for name, member in original.items():
            if value.get(name) != member:
                reject("OBSERVATION_BINDING_MISMATCH", "observation differs from actual persisted target read")
        if original["read_status"] != "OK" or not original["relevant_scope_completeness"]:
            reject("READBACK_INCOMPLETE", "snapshot requires complete actual target read")
        return original

    def snapshot_from_observation(self, observation, *, bridge_context=None):
        value = self._verify_observation(observation, bridge_context=bridge_context)
        with self._connect() as db:
            state = self._load(db)
        snapshot = copy.deepcopy(state["base"])
        snapshot.pop("content_hash", None)
        snapshot.update(artifact_id="snapshot-a03-" + content_digest({"store_id": value["store_id"], "observation_id": value["observation_id"]})[:24],
                        revision=1, created_at=value["observed_at"])
        snapshot["payload"] = copy.deepcopy(value["view"]["target"])
        snapshot["payload"].update(observed_at=value["observed_at"], observed_hash=value["target_state_hash"],
                                   observed_version=value["target_state_version"])
        snapshot["producer"].update(module="a03-persistent-mock", implementation_version="a03-1")
        snapshot["input_refs"] = [copy.deepcopy(self.descriptor.fixed_source_ref)]
        return seal_artifact(snapshot, bridge_context=bridge_context)

    def prepare_action(self, bundle, plan_ref, action_id, config, *, current_snapshot_ref, asset_root, bridge_context=None):
        bundle = validate_bundle(bundle, asset_root=asset_root, bridge_context=bridge_context)
        plan = resolve_artifact(bundle, plan_ref, "ApplyPlan")
        if _plain(current_snapshot_ref) != _plain(plan.payload.snapshot):
            reject("TARGET_CHANGED", "preparation plan-initial snapshot reference differs")
        assert_plan_ready(bundle, plan_ref, current_snapshot_ref, bridge_context=bridge_context)
        action = next((a for a in plan.payload.actions if a.action_id == action_id), None)
        if action is None:
            reject("ACTION_DIGEST_MISMATCH", "action is absent from exact plan")
        if (plan.book_id != self.descriptor.book_id or plan.scope_id != self.descriptor.fixed_scope_id or
                action.target.target_id != self.descriptor.target_key["target_id"]):
            reject("TARGET_IDENTITY_MISMATCH", "plan is outside fixed target/session")
        graph = resolve_artifact(bundle, plan.payload.graph, "QuestionGraph")
        if _plain(graph.payload.source) != self.descriptor.fixed_source_ref:
            reject("SOURCE_BINDING", "plan graph source differs from fixed target session source")
        observation = self.observe_target(self.descriptor.target_key, observation_id="prepare-" + uuid.uuid4().hex)
        snapshot = self.snapshot_from_observation(observation, bridge_context=bridge_context)
        observation["snapshot_ref"] = artifact_ref(snapshot)
        before = dict(observation)
        before.update(format_version="a03-prepared-before-1", action_id=action_id,
                      action_digest=content_digest(_plain(action)), facts=action_facts(action, observation["view"]))
        _copy_resources(before, self.asset_root, asset_root)
        prepared_resource = _write_resource(asset_root, before)
        with self._connect() as db:
            context = self._load(db).get("context") or {}
        proposed_prefix = context.get("progress_refs", context.get("applied_prefix_refs", []))
        prefix = []
        for ref in proposed_prefix:
            progress = next((a for a in bundle.artifacts if artifact_ref(a) == ref and a.kind == "ExecutionProgress"), None)
            if progress is not None and _plain(progress.payload.plan_ref) == artifact_ref(plan):
                prefix.append(ref)
        initial = resolve_artifact(bundle, plan.payload.snapshot, "PlatformSnapshot")
        try:
            observation["plan_baseline_epoch"] = int(initial.payload.observed_version.rsplit("-", 1)[1])
        except (ValueError, AttributeError):
            reject("OBSERVATION_BINDING_MISMATCH", "plan snapshot has no genuine target state version")
        if plan.schema_version == '1.4.0-a03-native-proposal':
            from annotation.quality.targetcheck import append_artifacts
            bundle = append_artifacts(bundle, snapshot, asset_root=asset_root, bridge_context=bridge_context)
            bridge_context = bundle.bridge_context
        binding = bind_plan_observation(bundle, plan_ref, action_id, observation, config,
                                        prepared_before=prepared_resource, progress_refs=prefix, bridge_context=bridge_context)
        prepared = PreparedAction(bundle=bundle, plan=plan, action=action, plan_ref=artifact_ref(plan), action_id=action_id,
                            action_digest=content_digest(_plain(action)), expected_effect_digest=content_digest(_plain(action.expected_after)),
                            target_key=copy.deepcopy(self.descriptor.target_key), target_store_id=self.descriptor.store_id,
                            target_session_id=self.descriptor.target_session_id, source_ref=copy.deepcopy(self.descriptor.fixed_source_ref),
                            scope_id=self.descriptor.fixed_scope_id, comparator_version="a02-facts-1",
                            before_snapshot_ref=_plain(plan.payload.snapshot), prepared_before=prepared_resource,
                            observation=observation, snapshot=snapshot, observation_binding=binding,
                            asset_root=str(Path(asset_root).resolve()))
        self._prepared_actions[id(prepared)] = {"object": prepared, "digest": _prepared_digest(prepared),
            "config": copy.deepcopy(config), "config_version": config.version,
            "plan_ref": artifact_ref(plan), "observation_id": observation["observation_id"]}
        return prepared

    def verify_prepared_action(self, prepared, *, observation_binding=None,
                               expected_config_version=None, expected_plan_ref=None, bridge_context=None):
        """Verify the exact native object through the current controlled observer.

        Runtime calls this instance method on its currently registered observer;
        neither a caller dictionary nor a self-reported completeness flag can
        manufacture the registry entry. This method performs no target effect or
        new observation. Persisted intent copies never recreate the capability.
        """
        issued = self._prepared_actions.get(id(prepared))
        if not isinstance(prepared, PreparedAction) or issued is None or issued["object"] is not prepared:
            reject("PREPARED_ACTION_UNVERIFIED", "exact current-observer-issued PreparedAction is required")
        if _prepared_digest(prepared) != issued["digest"]:
            reject("OBSERVATION_BINDING_MISMATCH", "issued prepared action or observation binding was modified")
        if expected_config_version is not None and expected_config_version != issued["config_version"]:
            reject("AUTHORIZATION_CHANGED", "current runtime configuration differs from the actual preparation")
        if expected_plan_ref is not None and _plain(expected_plan_ref) != issued["plan_ref"]:
            reject("PLAN_CHANGED", "current accepted plan differs from the actual preparation")
        if observation_binding is not None and _plain(observation_binding) != _plain(prepared["observation_binding"]):
            reject("OBSERVATION_BINDING_MISMATCH", "dispatch binding differs from the native preparation")
        self._key(prepared["target_key"])
        if (prepared["target_store_id"] != self.store_id or prepared["target_session_id"] != self.target_session_id or
                prepared["source_ref"] != self.source_ref or prepared["scope_id"] != self.scope_id):
            reject("TARGET_IDENTITY_MISMATCH", "prepared target/source/session differs from the controlled observer")
        bundle = validate_bundle(prepared["bundle"], asset_root=prepared["asset_root"], bridge_context=bridge_context)
        observation = prepared["observation"]
        original = self._verify_observation(observation, bridge_context=bridge_context)
        if original["observation_id"] != issued["observation_id"]:
            reject("OBSERVATION_BINDING_MISMATCH", "prepared observation identity differs from its registry")
        snapshot = self.snapshot_from_observation(observation, bridge_context=bridge_context)
        if snapshot != prepared["snapshot"] or artifact_ref(snapshot) != prepared["observation_binding"]["observed_snapshot_ref"]:
            reject("OBSERVATION_BINDING_MISMATCH", "prepared snapshot is not from the exact persisted target observation")
        resource = prepared["prepared_before"]
        root = Path(prepared["asset_root"]).resolve()
        path = (root / resource["path"]).resolve()
        if not path.is_relative_to(root) or not path.is_file() or path.is_symlink():
            reject("RESOURCE_MISSING", "prepared-before immutable resource is missing or unsafe")
        raw = path.read_bytes()
        if hashlib.sha256(raw).hexdigest() != resource["sha256"]:
            reject("RESOURCE_HASH_MISMATCH", "prepared-before evidence bytes changed")
        before = json.loads(raw)
        if (before.get("format_version") != "a03-prepared-before-1" or
                any(before.get(name) != value for name, value in original.items() if name != "format_version")):
            reject("OBSERVATION_BINDING_MISMATCH", "prepared-before evidence differs from actual persisted target read")
        if (before.get("action_id") != prepared["action_id"] or before.get("action_digest") != prepared["action_digest"] or
                before.get("facts") != action_facts(prepared["action"], original["view"])):
            reject("PREPARED_BEFORE_MISMATCH", "prepared-before does not bind the exact action and actual relevant facts")
        binding = bind_plan_observation(bundle, prepared["plan_ref"], prepared["action_id"], observation,
            issued["config"], prepared_before=resource, progress_refs=prepared["observation_binding"]["applied_prefix"], bridge_context=bridge_context)
        if binding != prepared["observation_binding"]:
            reject("OBSERVATION_BINDING_MISMATCH", "public observation bridge no longer matches native preparation")
        return VerifiedPreparedAction(attestation_digest=issued["digest"], config_version=issued["config_version"],
            plan_ref=copy.deepcopy(issued["plan_ref"]), action_id=prepared["action_id"],
            action_digest=prepared["action_digest"], target_key=copy.deepcopy(self.target_key),
            target_store_id=self.store_id, target_session_id=self.target_session_id,
            source_ref=copy.deepcopy(self.source_ref), scope_id=self.scope_id,
            prepared_before=copy.deepcopy(resource), observation_id=original["observation_id"],
            read_sequence=original["read_sequence"], target_state_version=original["target_state_version"],
            target_state_hash=original["target_state_hash"])

    def dispatch_action(self, prepared_action, *, committed_intent, dispatch_permit, authority, effect_fault=None):
        if effect_fault not in EFFECT_FAULTS:
            reject("INVALID_FAULT", "unsupported synthetic target effect fault")
        prepared = prepared_action
        self._key(prepared["target_key"])
        if committed_intent is None:
            reject("LOCAL_INTENT_COMMIT_REQUIRED", "target requires genuinely committed runtime intent")
        with authority.effect_gate(prepared["target_key"]) as gate:
            checked = self.verify_prepared_action(prepared)
            authorization = authority.consume_first_dispatch(dispatch_permit, effect_gate=gate,
                                  prepared_action=prepared, target_store_id=self.descriptor.store_id,
                                  target_session_id=self.descriptor.target_session_id)
            generation = _get(authorization, "generation")
            owner = _get(authorization, "owner_id")
            authority.verify_target_authorization(authorization, effect_gate=gate,
                target_key=prepared["target_key"], target_store_id=self.descriptor.store_id,
                target_session_id=self.descriptor.target_session_id, generation=generation,
                action_digest=prepared["action_digest"])
            with self._connect() as db:
                db.execute("BEGIN IMMEDIATE")
                state = self._load(db)
                if state["fence_generation"] != generation or state["fence_owner_id"] != owner:
                    reject("OWNER_GENERATION_STALE", "independent target fence differs")
                if (self._hash(state) != checked.target_state_hash or
                        "a03-target-epoch-" + str(state["epoch"]) != checked.target_state_version):
                    reject("TARGET_CHANGED", "complete business state changed after actual preparation")
                if action_facts(prepared["action"], self._view(state)) != _plain(prepared["action"])["expected_before"]:
                    reject("TARGET_CHANGED", "target relevant precondition changed before effect")
                action = _plain(prepared["action"])
                if content_digest(action) != prepared["action_digest"]:
                    reject("ACTION_DIGEST_MISMATCH", "prepared action digest changed")
                pid = None
                if effect_fault != "not_applied":
                    pid = apply_synthetic_action(state, action, effect_fault == "partial")
                log = {"origin": "SYNTHETIC", "execution_mode": "SIMULATED", "action_id": prepared["action_id"],
                       "action_digest": prepared["action_digest"], "plan_ref": prepared["plan_ref"],
                       "target_key": prepared["target_key"], "target_session_id": self.descriptor.target_session_id,
                       "owner_id": owner, "generation": generation, "epoch": state["epoch"],
                       "effect_fault": effect_fault or "applied", "mutated": effect_fault != "not_applied",
                       "recorded_at": _utc(), "target_state_hash": self._hash(state)}
                cursor = db.execute("INSERT INTO effects(body) VALUES(?)", (encoded(log),))
                self._save(db, state)
                log["sequence"] = cursor.lastrowid
            if hasattr(authority, "fault"):
                authority.fault("after_effect")
            if effect_fault == "after_effect_exit":
                os._exit(87)
            response = "TIMEOUT" if effect_fault in ("lost_response", "response_lost_readable") else "REJECTED" if effect_fault == "not_applied" else "OK"
            return PublicRecord(status=response, transport_response={"status": response, "platform_question_id": pid},
                                effect_log_ref=log, target_effect_committed=True,
                                outcome="UNKNOWN", reason="transport response requires independent readback")

    def import_book_context(self, verified_context, *, authority):
        key = self.descriptor.target_key
        with authority.effect_gate(key) as gate:
            ledger = _get(verified_context, "ledger_id", _get(verified_context, "journal_id"))
            checked = authority.verify_context(verified_context, target_key=key,
                                                expected_ledger_id=ledger, effect_gate=gate)
            context = copy.deepcopy(dict(checked))
            with self._connect() as db:
                db.execute("BEGIN IMMEDIATE")
                state = self._load(db)
                old = state.get("context")
                if old and context.get("event_head", {}).get("sequence", 0) < old.get("event_head", {}).get("sequence", 0):
                    reject("HISTORY_INCOMPLETE", "cannot replace restored context with older history")
                state["context"] = context
                self._save(db, state)
        return PublicRecord(imported=True, pending_count=len(context.get("pending", [])),
                            pause_reasons=context.get("pause_reasons", []), target_key=key,
                            target_store_id=self.descriptor.store_id, target_session_id=self.descriptor.target_session_id)

    def export_book_context(self, target_key):
        self._key(target_key)
        with self._connect() as db:
            state = self._load(db)
            effects = [json.loads(row[0]) for row in db.execute("SELECT body FROM effects ORDER BY sequence")]
        result = PublicRecord(copy.deepcopy(state.get("context") or {}))
        result.update(target_key=copy.deepcopy(target_key), store_id=self.descriptor.store_id,
                      target_store_id=self.descriptor.store_id, target_session_id=self.descriptor.target_session_id,
                      source_ref=copy.deepcopy(self.descriptor.fixed_source_ref), scope_id=self.descriptor.fixed_scope_id,
                      effect_log=effects, effect_count=sum(e["mutated"] for e in effects), dispatch_count=len(effects),
                      read_sequence=state["read_sequence"], fence_generation=state["fence_generation"],
                      fence_owner_id=state["fence_owner_id"], internal_bindings=state["internal_bindings"],
                      frame_projections=state["frame_projections"], target_state_hash=self._hash(state))
        return result

9a9edabf10be45ff38a4f4b2ebdee961e8cac294 blob 26611
"""A02 pure planner. No filesystem, session mutation, browser or model access."""
import json

from annotation.contracts import (
    artifact_ref, assert_plan_ready, content_digest, policy_ref, validate_bundle,
)
from annotation.quality.targetcheck import (
    analyze_target, append_artifacts, make_artifact, projection_frames, reject,
    resolve_artifact, resolve_policy,
)


def encoded(value):
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)


def frame_facts(frames):
    return content_digest({"frames": frames})


def _plain(value):
    return value.model_dump(mode="json") if hasattr(value, "model_dump") else value


def action_facts(action, observed_target_view):
    """The accepted A02 relevant-state rule, shared by all target adapters."""
    action = _plain(action)
    view = _plain(observed_target_view)
    before = action["expected_before"]
    directory = before["directory_id"]
    pid = action["target"]["platform_question_id"]
    if pid is None:
        pid = view["internal_bindings"].get(action["target"]["question_id"])
    question = next((q for q in view["target"]["questions"] if q["platform_question_id"] == pid), None)
    frames = [f for f in view["target"]["frames"] if f["platform_question_id"] == pid] if question else []
    facts = {"question_exists": question is not None, "platform_question_id": pid,
             "directory_id": question["directory_id"] if question else directory,
             "frame_count": len(frames), "frames_hash": frame_facts(frames)}
    if "platform_order" in before:
        facts["platform_order"] = question["platform_order"] if question else None
    if "next_order" in before:
        facts["next_order"] = max([q["platform_order"] for q in view["target"]["questions"]
                                   if q["directory_id"] == directory] + [0]) + 1
    return facts


class PublicRecord(dict):
    """Public value record. It is evidence, never a runtime permission."""
    def __getattr__(self, name):
        try:
            return self[name]
        except KeyError as exc:
            raise AttributeError(name) from exc


def _view(observation):
    value = _plain(observation)
    return value.get("view", value.get("state", value))


def compare_action_effect(action, before_observation, after_observation, *, comparator_version="a02-facts-1"):
    """Pure A02 comparison; transport responses never determine an outcome.

    Recovery observations additionally require full scope and unique platform IDs.
    Legacy observations retain their original representation and outcome rules.
    """
    if comparator_version != "a02-facts-1":
        reject("COMPARATOR_VERSION_UNSUPPORTED", "unsupported shared action comparator")
    action = _plain(action)
    before, after = _plain(before_observation), _plain(after_observation)
    digest = content_digest(action)
    recovery = "observation_id" in after
    result = PublicRecord(comparator_version=comparator_version, action_id=action["action_id"],
                          action_digest=digest, platform_ids=[], effect_match="INDETERMINATE",
                          outcome="UNKNOWN", identity_checks={}, reasons=[],
                          expected_effect_digest=content_digest(action["expected_after"]),
                          actual_digest=None, relevant_scope_completeness=False,
                          before_observation_ref=before.get("resource"),
                          after_observation_ref=after.get("resource"),
                          before_read_sequence=before.get("read_sequence"),
                          after_read_sequence=after.get("read_sequence"))
    def finish(match, ids, reason):
        result.update(effect_match=match, platform_ids=ids, reasons=[reason], reason=reason,
                      outcome={"MATCH": "APPLIED", "ABSENT": "NOT_APPLIED"}.get(match, "UNKNOWN"))
        return result
    if after.get("read_status", "OK") != "OK":
        return finish("INDETERMINATE", [], "readback unavailable, contradictory or truncated")
    if recovery:
        fields = ("store_id", "target_session_id", "target_key", "scope_id", "source_ref")
        checks = {name: before.get(name) == after.get(name) and name in before for name in fields}
        checks["action_target"] = after.get("target_key", {}).get("target_id") == action["target"]["target_id"]
        result["identity_checks"] = checks
        if not all(checks.values()):
            reject("OBSERVATION_BINDING_MISMATCH", "before/after observation identity differs")
        if (not isinstance(after.get("read_sequence"), int) or
                not isinstance(before.get("read_sequence"), int) or
                after["read_sequence"] <= before["read_sequence"]):
            reject("OBSERVATION_NOT_FRESH", "comparison needs a new actual monotonic target read")
        if not before.get("relevant_scope_completeness", before.get("scope_complete", False)) or not after.get("relevant_scope_completeness", after.get("scope_complete", False)):
            return finish("INDETERMINATE", [], "independent relevant scope is incomplete")
    result["relevant_scope_completeness"] = True
    oldview, view = _view(before), _view(after)
    if not isinstance(view, dict) or not all(k in view for k in ("target", "internal_bindings", "frame_projections")):
        return finish("INDETERMINATE", [], "target view is missing")
    questions, allframes = view["target"]["questions"], view["target"]["frames"]
    if recovery and (len({q["platform_question_id"] for q in questions}) != len(questions) or
                     len({f["platform_frame_id"] for f in allframes}) != len(allframes)):
        return finish("CONFLICT", [], "duplicate platform identity")
    if recovery:
        from annotation.contracts import target_state_digest
        if (target_state_digest(oldview) != before.get("target_state_hash") or
                target_state_digest(view) != after.get("target_state_hash")):
            reject("OBSERVATION_BINDING_MISMATCH", "independent business-state digest differs from observation")
    pid = action["target"]["platform_question_id"] or view["internal_bindings"].get(action["target"]["question_id"])
    question = next((q for q in questions if q["platform_question_id"] == pid), None)
    frames = [f for f in allframes if f["platform_question_id"] == pid] if question else []
    projected = [view["frame_projections"].get(f["platform_frame_id"]) for f in frames]
    expected = action["expected_after"]
    result["actual_digest"] = content_digest({"question": question, "frames": frames, "projections": projected})
    if (question and question["directory_id"] == expected["directory_id"] and
            question["platform_order"] == expected["platform_order"] and
            encoded(projected) == expected["frames"] and frames and
            all(p is not None and f["box"] == p["box"] and f["platform_role"] == p["platform_role"]
                for f, p in zip(frames, projected))):
        return finish("MATCH", [pid] + [f["platform_frame_id"] for f in frames],
                      "independent target readback matches all projected frames")
    facts_before, facts_after = action_facts(action, oldview), action_facts(action, view)
    if facts_after == facts_before and facts_after["frame_count"] == 0:
        return finish("ABSENT", [], "explicit readback proves projected frames ABSENT and relevant target unchanged")
    return finish("CONFLICT", [], "effect is partial, changed, or lacks a provable ABSENT baseline")


def snapshot_state_equivalent(planned_snapshot, observed_snapshot, *, planned_target_state, observed_target_state, bridge_context=None):
    from annotation.contracts import target_state_digest
    planned, observed = _plain(planned_snapshot), _plain(observed_snapshot)
    old, new = _plain(planned_target_state), _plain(observed_target_state)
    if planned["schema_version"] not in ("1.1.0-a-recovery-proposal", "1.4.0-a03-native-proposal") or observed["schema_version"] != planned["schema_version"]:
        reject("RECOVERY_VERSION_UNSUPPORTED", "state bridge is limited to recovery contracts")
    if planned['schema_version'] == '1.4.0-a03-native-proposal':
        from annotation.contracts.a03_native import require_context
        require_context(bridge_context)
    for name in ("target_key", "source_ref", "scope_id", "target_session_id"):
        if old.get(name) != new.get(name) or name not in old:
            reject("OBSERVATION_BINDING_MISMATCH", "state bridge fixed identity differs: " + name)
    hashes = (target_state_digest(old), target_state_digest(new))
    if hashes != (planned["payload"]["observed_hash"], observed["payload"]["observed_hash"]):
        reject("OBSERVATION_BINDING_MISMATCH", "snapshot digest does not bind the actual compared business state")
    versions = (planned["payload"]["observed_version"], observed["payload"]["observed_version"])
    equivalent = hashes[0] == hashes[1] and versions[0] == versions[1]
    return PublicRecord(equivalent=equivalent, planned_snapshot_ref=artifact_ref(planned),
                        observed_snapshot_ref=artifact_ref(observed), planned_state_hash=hashes[0],
                        observed_state_hash=hashes[1], planned_state_version=versions[0], observed_state_version=versions[1],
                        reasons=["business state matches" if equivalent else "business state changed"])


def bind_plan_observation(bundle, plan_ref, action_id, fresh_observation, config, *, prepared_before, progress_refs=(), bridge_context=None):
    """Bridge fresh observations using exact generated actions and target effect delta.

    Runtime separately supplies and verifies the committed prefix refs. This pure
    bridge checks their action results against the independently read target.
    """
    bundle = validate_bundle(bundle, bridge_context=bridge_context)
    plan = resolve_artifact(bundle, plan_ref, "ApplyPlan")
    if plan.schema_version not in ("1.1.0-a-recovery-proposal", "1.4.0-a03-native-proposal"):
        reject("RECOVERY_VERSION_UNSUPPORTED", "fresh observation bridge requires recovery version")
    observation = _plain(fresh_observation)
    actions = [_plain(a) for a in plan.payload.actions]
    index = next((i for i, a in enumerate(actions) if a["action_id"] == action_id), None)
    if index is None:
        reject("ACTION_DIGEST_MISMATCH", "action is absent from plan")
    action = actions[index]
    if observation.get("read_status") != "OK" or not observation.get("relevant_scope_completeness"):
        reject("CONCLUSIVE_READBACK_REQUIRED", "preparation needs complete actual target read")
    if observation.get("scope_id") != plan.scope_id or observation.get("target_key", {}).get("book_id") != plan.book_id:
        reject("TARGET_IDENTITY_MISMATCH", "observation book/scope differs from plan")
    verify_generated_plan(bundle, plan, plan.payload.snapshot, config, bridge_context=bridge_context)
    if action_facts(action, _view(observation)) != action["expected_before"]:
        reject("TARGET_CHANGED", "current relevant action facts differ from planned precondition")
    snapshot = resolve_artifact(bundle, plan.payload.snapshot, "PlatformSnapshot")
    effects = observation.get("effect_log", [])
    baseline_epoch = observation.get("plan_baseline_epoch", 0)
    delta = [e for e in effects if e.get("epoch", 0) > baseline_epoch]
    if len(delta) != index:
        reject("TARGET_CHANGED", "independent target effect-log delta is not the exact applied prefix")
    if index and not progress_refs:
        reject("DEPENDENCY_UNRESOLVED", "later action needs complete committed APPLIED prefix refs")
    if index:
        progress = [resolve_artifact(bundle, ref, "ExecutionProgress") for ref in progress_refs]
        if any(_plain(p.payload.plan_ref) != artifact_ref(plan) or p.scope_id != plan.scope_id for p in progress):
            reject("RECOVERY_CHAIN_INVALID", "applied prefix refs bind a different plan/scope")
        latest = max(progress, key=lambda p: p.payload.journal_head_sequence)
        prefix_items = [_plain(item) for item in latest.payload.actions]
        if [item["action_id"] for item in prefix_items] != [a["action_id"] for a in actions]:
            reject("RECOVERY_CHAIN_INVALID", "progress does not enumerate exact complete plan")
        for item in prefix_items[:index]:
            if (item["effective_outcome"] != "APPLIED" or item["attempt_fact"] != "ATTEMPTED" or
                    item["intent_ref"] is None or item["result_fact"] is None):
                reject("DEPENDENCY_UNRESOLVED", "predecessor lacks a committed sufficient APPLIED fact")
        if any(item["attempt_fact"] != "NOT_ATTEMPTED" for item in prefix_items[index:]):
            reject("PLAN_INTERRUPTED", "old attempted/interrupted plan tail cannot resume")
    for expected_action, effect in zip(actions[:index], delta):
        if (effect.get("action_id") != expected_action["action_id"] or
                effect.get("action_digest") != content_digest(expected_action) or
                effect.get("plan_ref") != artifact_ref(plan) or effect.get("effect_fault") not in ("applied", "response_lost_readable", "lost_response", "after_effect_exit")):
            reject("TARGET_CHANGED", "independent effect log contains unexplained change")
        check = compare_action_effect(expected_action, _view(observation), {"read_status": "OK", "view": _view(observation)})
        if check.effect_match != "MATCH":
            reject("DEPENDENCY_UNRESOLVED", "predecessor is not fully APPLIED in actual target")
    if index and delta[-1].get("target_state_hash") != observation.get("target_state_hash"):
        reject("TARGET_CHANGED", "target state changed after the committed applied prefix")
    if not index and (snapshot.payload.observed_hash != observation.get("target_state_hash") or
                      snapshot.payload.observed_version != observation.get("target_state_version")):
        reject("TARGET_CHANGED", "first dispatch actual business state differs from planned snapshot")
    return PublicRecord(plan_ref=artifact_ref(plan), action_id=action_id,
                        action_digest=content_digest(action), before_snapshot_ref=_plain(plan.payload.snapshot),
                        observed_snapshot_ref=observation.get("snapshot_ref"),
                        observation_id=observation["observation_id"], read_sequence=observation["read_sequence"],
                        target_key=observation["target_key"], source_ref=observation["source_ref"],
                        target_session_id=observation["target_session_id"], scope_id=plan.scope_id,
                        baseline_state_hash=snapshot.payload.observed_hash, current_state_hash=observation["target_state_hash"],
                        baseline_state_version=snapshot.payload.observed_version, current_state_version=observation["target_state_version"],
                        prepared_before=prepared_before, applied_prefix=list(progress_refs),
                        effect_log_delta=observation.get("effect_log_resource"), comparator_version="a02-facts-1")


def create_plan(bundle, graph_ref, precheck_ref, targetcheck_ref, snapshot_ref,
                current_snapshot_ref, policy_reference, config, *, artifact_id,
                created_at, run_id=None, operation="CREATE_FRAMES", previous_receipt=None, bridge_context=None):
    """Return a new validated bundle. Invalid/missing bindings raise ContractError.

    A valid failed-check chain yields a BLOCKED diagnostic plan with no actions.
    UPDATE is explicitly unsupported, including when a C01 baseline is provided.
    """
    bundle = validate_bundle(bundle, bridge_context=bridge_context)
    graph = resolve_artifact(bundle, graph_ref, "QuestionGraph")
    pre = resolve_artifact(bundle, precheck_ref, "CheckReport")
    target = resolve_artifact(bundle, targetcheck_ref, "CheckReport")
    snapshot = resolve_artifact(bundle, snapshot_ref, "PlatformSnapshot")
    current = resolve_artifact(bundle, current_snapshot_ref, "PlatformSnapshot")
    policy = resolve_policy(bundle, policy_reference)
    if operation != "CREATE_FRAMES" or previous_receipt is not None:
        reject("UPDATE_UNSUPPORTED", "A02 supports no delta shape; need old APPLIED receipt, frame_update and future implementation")
    if pre.payload.stage != "PRE_APPLY" or target.payload.stage != "TARGET":
        reject("TWO_CHECK_STAGES", "distinct PRE_APPLY and TARGET required")
    for report in (pre, target):
        if artifact_ref(graph) != report.payload.graph.model_dump(mode="json") or policy_ref(policy) != report.payload.policy.model_dump(mode="json"):
            reject("VERSION_CONFLICT", "report graph/policy differs from requested plan")
        if report.payload.snapshot is not None and report.payload.snapshot.model_dump(mode="json") != artifact_ref(snapshot):
            reject("TARGET_CHANGED", "report binds a different snapshot")
    if artifact_ref(snapshot) != artifact_ref(current):
        reject("TARGET_CHANGED", "explicit current snapshot changed; recheck target")
    if snapshot.payload.authorized_scope_id != graph.scope_id:
        reject("AUTHORIZED_SCOPE", "snapshot authorization differs; diagnostic plan not representable in C01")
    computed = analyze_target(bundle, graph_ref, snapshot_ref, current_snapshot_ref, policy_reference, config, bridge_context=bridge_context)
    if (target.producer.module != "a02-targetcheck" or target.producer.config_version != config.version or
            target.payload.model_dump(mode="json") != computed):
        reject("TARGET_CHECK_STALE", "target report does not equal recomputed conditions/current authorization")
    ready = pre.payload.decision == target.payload.decision == "PASS"
    actions = []
    required = ["frame_readback", "persistent_draft" if config.session_mode == "PERSISTENT" else "same_session_handoff"]
    if ready:
        platform = {q.platform_question_id: q for q in snapshot.payload.questions}
        next_orders = {d: max([q.platform_order for q in snapshot.payload.questions if q.directory_id == d] + [0]) + 1
                       for d in snapshot.payload.directories}
        for question in graph.payload.questions:
            qid = question.question_id
            pid = question.external_refs.platform_question_id
            directory = config.directory_map[question.directory_id]
            existing = platform.get(pid)
            order = existing.platform_order if existing else next_orders[directory]
            frames = [f.model_dump(mode="json") for f in snapshot.payload.frames if f.platform_question_id == pid] if existing else []
            before = {"question_exists": existing is not None, "platform_question_id": pid,
                      "directory_id": directory, "frame_count": len(frames), "frames_hash": frame_facts(frames)}
            if existing:
                before["platform_order"] = order
            else:
                before["next_order"] = order
                next_orders[directory] += 1
            projected = projection_frames(bundle, graph, question, policy)
            if not projected:
                reject("EMPTY_PROJECTION", "question has no frame projection: " + qid)
            action_id = "action-a02-" + content_digest({"plan_id": artifact_id, "question_id": qid,
                                                        "graph": artifact_ref(graph), "snapshot": artifact_ref(snapshot)})[:32]
            actions.append({"action_id": action_id,
                            "target": {"target_id": snapshot.payload.target_id, "question_id": qid, "platform_question_id": pid},
                            "source_entity_ids": [qid] + list(dict.fromkeys(f["fragment_id"] for f in projected)),
                            "expected_before": before, "operation": "CREATE_FRAMES",
                            "expected_after": {"question_exists": True, "directory_id": directory,
                                               "platform_order": order, "frames": encoded(projected)},
                            "depends_on": [actions[-1]["action_id"]] if actions else []})
    issues = [i.issue_id for report in (pre, target) for i in report.payload.issues if i.blocks]
    payload = {"graph": artifact_ref(graph), "precheck": artifact_ref(pre), "targetcheck": artifact_ref(target),
               "snapshot": artifact_ref(snapshot), "policy": policy_ref(policy),
               "readiness": "READY" if ready else "BLOCKED", "execution_mode": "SIMULATED",
               "session_mode": config.session_mode, "required_capabilities": required, "actions": actions,
               "blocked_issue_ids": list(dict.fromkeys(issues)), "previous_receipt": None, "final_submission": "HUMAN_ONLY"}
    if graph.schema_version == '1.4.0-a03-native-proposal':
        from annotation.contracts.a03_native import require_context
        require_context(bridge_context, bundle)('creation_anchor', bridge_context, bundle=bundle, config=config,
            artifact_id=artifact_id, created_at=created_at, run_id=run_id or graph.run_id)
    plan = make_artifact("ApplyPlan", artifact_id, graph, payload, [graph, pre, target, snapshot],
                         config.version, "a02-planner", created_at, run_id, bridge_context=bridge_context)
    output = append_artifacts(bundle, plan, bridge_context=bridge_context)
    if ready:
        assert_plan_ready(output, artifact_ref(plan), artifact_ref(current), bridge_context=getattr(output, "bridge_context", bridge_context))
    return output


def verify_generated_plan(bundle, plan, current_ref, config, *, observation_binding=None, bridge_context=None):
    """Recompute supported projection/facts before mock dispatch; refuse edited actions."""
    bundle = validate_bundle(bundle, bridge_context=bridge_context)
    if plan.schema_version == '1.4.0-a03-native-proposal':
        from annotation.contracts.a03_native import require_context
        return require_context(bridge_context, bundle)('verify_creation_anchor', bridge_context, bundle=bundle,
            plan=plan, current_ref=current_ref, config=config, observation_binding=observation_binding)
    payload = plan.payload
    if observation_binding is not None:
        binding = _plain(observation_binding)
        if plan.schema_version not in ("1.1.0-a-recovery-proposal", "1.4.0-a03-native-proposal"):
            reject("RECOVERY_VERSION_UNSUPPORTED", "observation bridge is recovery-version only")
        if (binding.get("plan_ref") != artifact_ref(plan) or
                binding.get("before_snapshot_ref") != _plain(payload.snapshot) or
                binding.get("observed_snapshot_ref") != _plain(current_ref)):
            reject("OBSERVATION_BINDING_MISMATCH", "fresh observation bridge does not bind exact plan/current refs")
        current_ref = payload.snapshot
    if plan.producer.config_version != config.version:
        reject("AUTHORIZATION_CHANGED", "current authorization/config differs from planned version")
    # Rebuild without this plan or its descendants; retain upstream history so UNKNOWN stays visible.
    data = bundle.model_dump(mode="json")
    remove = {(plan.artifact_id, plan.revision)}
    while True:
        previous_count = len(remove)
        for item in data["artifacts"]:
            if any((r["artifact_id"], r["revision"]) in remove for r in item["input_refs"]):
                remove.add((item["artifact_id"], item["revision"]))
        if len(remove) == previous_count:
            break
    data["artifacts"] = [a for a in data["artifacts"] if (a["artifact_id"], a["revision"]) not in remove]
    if plan.schema_version == "1.1.0-a-recovery-proposal":
        # This is an internal historical derivation, after validating the full
        # package above. Runtime result evidence that is not consumed by any
        # retained upstream Artifact must not refer back into the intentionally
        # removed plan/descendants. Retain the complete formal evidence closure
        # of every retained Artifact; never filter history in the admitted
        # bundle, return this view, or use it as current write eligibility.
        from pathlib import Path
        records = {record["evidence_id"]: record for record in data["evidence"]}
        needed, seen_resources = set(), set()
        root = Path(bundle.asset_root)
        evidence_fields = {"evidence_refs", "before_evidence_refs", "after_evidence_refs", "submission_evidence_refs"}

        def consume_evidence(evidence_id):
            if evidence_id in needed:
                return
            if evidence_id not in records:
                reject("MISSING_REFERENCE", "upstream formal evidence ID is absent")
            needed.add(evidence_id)
            consume(records[evidence_id]["resource"])

        def consume(value):
            if isinstance(value, list):
                for member in value:
                    consume(member)
            elif isinstance(value, dict):
                if {"path", "sha256", "media_type"}.issubset(value):
                    key = (value["path"], value["sha256"], value["media_type"])
                    if key not in seen_resources and value["media_type"] == "application/json":
                        seen_resources.add(key)
                        # Full validation already checked safe paths, bytes,
                        # all ordinary refs and mixed-resource cycle freedom.
                        consume(json.loads((root / value["path"]).read_text(encoding="utf-8")))
                else:
                    for name, child in value.items():
                        if name in evidence_fields and isinstance(child, list):
                            for member in child:
                                if isinstance(member, str):
                                    consume_evidence(member)
                        consume(child)

        for upstream_artifact in data["artifacts"]:
            consume(upstream_artifact)
        data["evidence"] = [record for record in data["evidence"] if record["evidence_id"] in needed]
    upstream = validate_bundle(data, asset_root=getattr(bundle, "asset_root", None))
    generated = create_plan(upstream, payload.graph, payload.precheck, payload.targetcheck,
                            payload.snapshot, current_ref, payload.policy, config,
                            artifact_id=plan.artifact_id, created_at=plan.created_at, run_id=plan.run_id)
    rebuilt = generated.artifacts[-1]
    if rebuilt != plan:
        reject("PLAN_CHANGED", "plan does not equal generated supported projection")

