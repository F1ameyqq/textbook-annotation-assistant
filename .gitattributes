* text=auto
/.gitattributes text eol=lf
/.gitignore text eol=lf
*.md text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.jpg binary
*.jpeg binary
*.png binary
*.mp4 binary
*.docx binary

# Preserve the exact bytes and recorded hashes of archived source evidence.
/原始资料/** -text
/技术证据/** -text
/只读核查工具/** -text
/项目交接说明.md -text
/项目交接说明.docx -text
/文件清单与校验.json -text

# Acceptance manifests bind exact bytes, including original line endings.
/docs/evidence/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
/docs/tasks/*-report.md -text whitespace=trailing-space,space-before-tab,cr-at-eol
/tools/a05_verify_evidence.py -text whitespace=trailing-space,space-before-tab,cr-at-eol

# Keep the independently archived review script's hash-bound blank EOF.
/docs/evidence/C01/review-R1/scripts/agent-r1-probes.py whitespace=trailing-space,space-before-tab,cr-at-eol,-blank-at-eof

# Stage 2 handoff manifests bind exact source and archived record bytes.
/docs/handoff/a-stage2/** -text

docs/evidence/A25-independent/created-zone-reconciliation-review/** -text
docs/evidence/A25-independent/remaining-two-actual-review/** -text
docs/evidence/A25-independent/final-recovery-preparation-review/** -text
docs/evidence/A25-independent/final-recovery-actual-review/** -text
