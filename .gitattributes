* text=auto
/.gitattributes text eol=lf
/.gitignore text eol=lf
*.md text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.jpg binary
*.jpeg binary
*.png binary
*.mp4 binary
*.docx binary

