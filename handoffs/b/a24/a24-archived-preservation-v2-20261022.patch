+import copy
+import hashlib
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+from annotation.quality.live_pilot import PilotError
+from annotation.runtime.live_pilot.archived_target_preservation import (
+    build_preservation,
+    run,
+    validate_preservation,
+)
+
+
+def sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+class ArchivedTargetPreservationTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix="a24-archived-target-")
+        self.root = Path(self.temp.name)
+
+    def tearDown(self):
+        self.temp.cleanup()
+
+    def fixtures(self, data_key="1792064001811"):
+        target = {
+            "book_id": "46007447",
+            "directories": [{
+                "id": "directory-1",
+                "label": "section",
+                "parent": None,
+                "raw_node_fields": {"id": "directory-1", "label": "section",
+                                    "directory_raw_extra": {"kept": True}},
+                "directory_extra": [None, ""],
+            }],
+            "questions": [{
+                "id": "1792064001811",
+                "directory_id": "directory-1",
+                "frames": [{
+                    "belong_to_level": 1,
+                    "content_type": "image",
+                    "directory_id": "directory-1",
+                    "file_id": "file-1",
+                    "image_order_in_annotation_zone": 0,
+                    "image_path_sha256": "a" * 64,
+                    "is_pre_annotation": False,
+                    "order_in_level": 1,
+                    "page_index": 0,
+                    "parent_rect_id": None,
+                    "pre_annotations_id": None,
+                    "rect_bbox": [1, 2, 3, 4],
+                    "rect_id": "rect-1",
+                    "type": "Q",
+                    "frame_extra": {"zero": 0},
+                }],
+                "frontend_derivation": None,
+                "frontend_derived_frame_candidates": [],
+                "frontend_derived_global_order": 1,
+                "frontend_derived_label": "1",
+                "order": 1,
+                "raw_label": "1",
+                "raw_node_fields": {"id": "1792064001811", "isQuestion": True,
+                                    "label": "1", "order_in_level": 1,
+                                    "question_raw_extra": False},
+                "raw_order_field_present": True,
+                "raw_order_in_level": 1,
+                "raw_order_status": "PRESENT",
+                "content": {"status": "UNKNOWN", "reason": "NOT_FETCHED", "text": None,
+                            "content_extra": "retain"},
+                "question_extra": {"nested": [0, None]},
+            }],
+            "inventory_coverage": "PARTIAL",
+            "content_coverage": "UNKNOWN",
+            "raw_directory_tree_is_full_response_body": False,
+            "target_extra": {"first": 1, "second": 2},
+        }
+        state = {
+            "authentication": {"token": "DO-NOT-EXPORT-SECRET"},
+            "account_identity_fields_available": ["username"],
+            "target": target,
+        }
+        historical_records = [
+            {"question": "old-1", "option": ["B", "A"], "answer": "A"},
+            {"question": "old-2", "option": [], "answer": "D"},
+        ]
+        historical_raw = b"\n".join(
+            json.dumps(item, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
+            for item in historical_records
+        )
+        dom = {"matches": [{"dataKey": data_key, "label": "1"}]}
+        state_raw = (json.dumps(state, ensure_ascii=False) + "\n").encode("utf-8")
+        dom_raw = (json.dumps(dom, ensure_ascii=False) + "\n").encode("utf-8")
+        state_path = self.root / "current-state.json"
+        historical_path = self.root / "historical.jsonl"
+        dom_path = self.root / "current-dom.json"
+        state_path.write_bytes(state_raw)
+        historical_path.write_bytes(historical_raw)
+        dom_path.write_bytes(dom_raw)
+        return target, (state_path, state_raw), (historical_path, historical_raw), (dom_path, dom_raw)
+
+    def invoke(self, data_key="1792064001811", output_name="out"):
+        target, state, historical, dom = self.fixtures(data_key)
+        public, receipt = run(
+            state[0], self.root / output_name, sha(state[1]), len(state[1]),
+            historical[0], sha(historical[1]), len(historical[1]),
+            dom[0], sha(dom[1]), len(dom[1]),
+        )
+        return target, state, historical, dom, public, receipt
+
+    def test_unknown_fields_roundtrip_and_credentials_are_not_exported(self):
+        target, _, historical, _, public, receipt = self.invoke()
+        output = self.root / "out"
+        exported = (output / "private" / "archived-target.full.json").read_text("utf-8")
+        preservation = json.loads(
+            (output / "private" / "archived-target.preservation.json").read_text("utf-8"))
+        self.assertEqual(json.loads(exported), target)
