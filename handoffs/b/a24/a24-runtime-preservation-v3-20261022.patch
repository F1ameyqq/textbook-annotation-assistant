+def build_business_preservation(observation, traces=(), *, direct_view=False):
+    """Identity-addressable copy of every projected old/new business object.
+
+    This sidecar is runtime evidence, not a public contract object.  It lets the
+    preservation gate compare unknown fields, JSON number types and key order
+    without changing the established normalized target schema.
+    """
+    view = observation["view"]
+    target = view["target"]
+    content = view["question_content"]
+    expected = {
+        "question": {item["platform_question_id"]: item for item in target["questions"]},
+        "frame": {item["platform_frame_id"]: item for item in target["frames"]},
+        "directory": {item["directory_id"]: item for item in observation["directory_details"]},
+        "content": content,
+    }
+    require(all(len(values) == len(set(values)) for values in expected.values()),
+            "RAW_ENTITY_IDENTITY_DUPLICATE")
+    candidates = {kind: {} for kind in expected}
+    for trace in traces:
+        if trace.get("trace_type") != "array_item" or not isinstance(trace.get("projected"), dict):
+            require(trace.get("trace_type") != "array_item", "RAW_ENTITY_PRESERVATION_UNBOUND")
+            continue
+        projected = trace["projected"]
+        if canonical_id(projected.get("platform_frame_id")):
+            kind, identity = "frame", projected["platform_frame_id"]
+        elif canonical_id(projected.get("platform_question_id")):
+            kind, identity = "question", projected["platform_question_id"]
+        elif canonical_id(projected.get("directory_id")):
