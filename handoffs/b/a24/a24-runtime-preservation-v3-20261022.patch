+def projection_response_paths(projection, response_names):
+    """Prove which external response subtrees are consumed by a projection."""
+    require(isinstance(projection, dict) and isinstance(response_names, set) and response_names,
+            "RAW_RESPONSE_RESIDUAL_UNBOUND")
+    covered = {name: [] for name in response_names}
+
+    def walk(rule):
+        require(isinstance(rule, dict) and len(rule) == 1, "RAW_RESPONSE_RESIDUAL_UNBOUND")
+        kind, spec = next(iter(rule.items()))
+        if kind == "from":
+            require(isinstance(spec, dict) and set(spec) == {"response", "path"},
+                    "RAW_RESPONSE_RESIDUAL_UNBOUND")
+            if spec["response"] != "$":
+                require(spec["response"] in covered, "RAW_RESPONSE_RESIDUAL_UNBOUND")
+                covered[spec["response"]].append(copy.deepcopy(spec["path"]))
+            return
+        if kind == "object":
+            require(isinstance(spec, dict), "RAW_RESPONSE_RESIDUAL_UNBOUND")
+            for child in spec.values():
+                walk(child)
+            return
+        if kind == "array":
+            require(isinstance(spec, dict) and "source" in spec and "item" in spec and
+                    "where" not in spec, "RAW_RESPONSE_RESIDUAL_UNBOUND")
+            walk(spec["source"])
+            walk(spec["item"])
+            return
+        if kind == "lookup":
+            require(isinstance(spec, dict) and "key" in spec, "RAW_RESPONSE_RESIDUAL_UNBOUND")
+            walk(spec["key"])
+            return
+        if kind == "csv_bbox":
+            walk(spec)
+            return
+        require(kind == "literal", "RAW_RESPONSE_RESIDUAL_UNBOUND")
+
+    for rule in projection.values():
+        walk(rule)
+    require(all(paths for paths in covered.values()), "RAW_RESPONSE_RESIDUAL_UNBOUND")
+    return covered
 
 
