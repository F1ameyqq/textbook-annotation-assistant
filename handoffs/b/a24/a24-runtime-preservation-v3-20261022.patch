+    def test_typed_wrapper_mask_preserves_keys_order_types_and_unknown_structure(self):
+        declared = [["snapshot", "view"]]
+        baseline = {"snapshot": {"view": {"business": "changes legally"}},
+                    "opaque": {"first": 0, "second": [None, ""]}}
+        same_wrapper_new_business = copy.deepcopy(baseline)
+        same_wrapper_new_business["snapshot"]["view"] = {"new_question": True}
+        before = wire.response_residual(baseline, declared)
+        after = wire.response_residual(same_wrapper_new_business, declared)
+        self.assertTrue(json_same(before, after))
+        snapshot_entry = before["entries"][0]
+        self.assertEqual(snapshot_entry["key"], "snapshot")
+        self.assertEqual(snapshot_entry["value"]["entries"][0]["value"],
+                         {"node_type": "DECLARED_SUBTREE_MASK"})
+
+        variants = []
+        added = copy.deepcopy(baseline); added["new_unknown"] = 1; variants.append(added)
+        deleted = copy.deepcopy(baseline); del deleted["opaque"]["second"]; variants.append(deleted)
+        type_changed = copy.deepcopy(baseline); type_changed["opaque"]["first"] = False; variants.append(type_changed)
+        reordered = {"opaque": {"first": 0, "second": [None, ""]},
+                     "snapshot": copy.deepcopy(baseline["snapshot"])}; variants.append(reordered)
+        for variant in variants:
+            with self.subTest(variant=variant):
+                self.assertFalse(json_same(before, wire.response_residual(variant, declared)))
