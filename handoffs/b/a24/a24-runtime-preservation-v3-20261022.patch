+from annotation.quality.live_pilot import PilotError, check_preservation, json_same, state_facts
+from annotation.runtime.storage.common import digest
+
+
+def observation(extra=None):
+    content = {
+        "status": "AVAILABLE",
+        "question_type": "ordinary_choice",
+        "parts": [{"text": "old"}],
+        "wire_zones": {zone: None for zone in wire.ZONES},
+        "question_info": {},
+        "rect_ids": ["r-old"],
+    }
+    if extra is not None:
+        content["opaque"] = copy.deepcopy(extra)
+    value = {
+        "book_id": "46007447",
+        "platform_version": "observed-v1",
+        "complete": True,
+        "read_status": "OK",
+        "submission_status": "NOT_SUBMITTED",
+        "source_bindings": {},
+        "directory_details": [{"directory_id": "leaf", "parent_id": None}],
+        "view": {
+            "target": {
+                "directories": ["leaf"],
+                "questions": [{"platform_question_id": "q-old", "platform_order": 1,
+                               "directory_id": "leaf"}],
+                "frames": [{"platform_frame_id": "r-old", "platform_question_id": "q-old"}],
+            },
+            "internal_bindings": {},
+            "frame_projections": {"r-old": {}},
+            "question_content": {"q-old": content},
+        },
+    }
+    value["raw_business_projection"] = wire.build_business_preservation(value, direct_view=True)
+    return value
+
+
+def content_record(pid, text):
+    raw = {
+        "platform_question_id": pid,
+        "question_type": "ordinary_choice",
+        "parts": [{"text": text}],
+        "wire_zones": {zone: None for zone in wire.ZONES},
+        "question_info": {},
+        "rect_ids": ["r-old"] if pid == "q-old" else ["r-new-" + str(i) for i in range(6)],
+    }
+    value = copy.deepcopy(raw)
+    value.update({"status": "AVAILABLE", "raw_record": copy.deepcopy(raw),
+                  "raw_record_json": json.dumps(raw, ensure_ascii=False, separators=(",", ":"))})
+    return value
+
+
+def projected_observation(*, old_extra, append=False):
+    """Build normalized state while retaining the original lossy-projection rows."""
+    value = observation()
+    value.pop("raw_business_projection")
+    question_rows = [{"qid": "q-old", "order": 1, "directory": "leaf",
+                      "unknown_extra": copy.deepcopy(old_extra)}]
+    frame_rows = [{"rid": "r-old", "owner": "q-old", "unknown_frame": {"zero": 0}}]
+    directory_rows = [{"did": "leaf", "parent": None, "unknown_directory": [1, None]}]
+    if append:
+        question_rows.append({"qid": "q-new", "order": 2, "directory": "leaf",
+                              "unknown_extra": {"new": True}})
+        frame_rows.extend({"rid": "r-new-" + str(i), "owner": "q-new",
+                           "unknown_frame": {"index": i}} for i in range(6))
+    traces = []
+    def array_rule(response, fields):
+        return {"array": {"source": {"from": {"response": response, "path": []}},
+                          "item": {"object": fields}}}
+    value["view"]["target"]["questions"] = wire.project(array_rule("questions", {
+        "platform_question_id": {"from": {"response": "$", "path": ["qid"]}},
+        "platform_order": {"from": {"response": "$", "path": ["order"]}},
+        "directory_id": {"from": {"response": "$", "path": ["directory"]}},
+    }), {"questions": question_rows}, collector=traces, path=("view", "target", "questions"))
+    value["view"]["target"]["frames"] = wire.project(array_rule("frames", {
+        "platform_frame_id": {"from": {"response": "$", "path": ["rid"]}},
+        "platform_question_id": {"from": {"response": "$", "path": ["owner"]}},
+    }), {"frames": frame_rows}, collector=traces, path=("view", "target", "frames"))
+    value["directory_details"] = wire.project(array_rule("directories", {
+        "directory_id": {"from": {"response": "$", "path": ["did"]}},
+        "parent_id": {"from": {"response": "$", "path": ["parent"]}},
+    }), {"directories": directory_rows}, collector=traces, path=("directory_details",))
+    value["view"]["question_content"] = {"q-old": content_record("q-old", "old")}
+    if append:
+        value["view"]["internal_bindings"]["local-new"] = "q-new"
+        value["view"]["question_content"]["q-new"] = content_record("q-new", "new")
+        for index in range(6):
+            value["view"]["frame_projections"]["r-new-" + str(index)] = {"index": index}
+    value["raw_business_projection"] = wire.build_business_preservation(
+        value, traces=traces, direct_view=False)
+    return value
+
+
+class FakeRawSession:
+    offline = True
+    evidence_mode = "SYNTHETIC"
+    actor = "author"
+    session_id = "raw-session"
+
+    def __init__(self, state, *, reorder_prewrite=True):
+        self.state = copy.deepcopy(state)
+        self.serial = 0
+        self.reorder_prewrite = reorder_prewrite
+
+    def request_once(self, method, path, *, params, payload, phase):
+        self.serial += 1
+        if phase == "upload":
+            body = {"credentials": {"accessid": "SENTINEL_ACCESS_ID",
+                                     "policy": "SENTINEL_POLICY",
+                                     "signature": "SENTINEL_SIGNATURE",
+                                     "securityToken": "SENTINEL_SECURITY_TOKEN"}}
+        else:
+            body = {"snapshot": copy.deepcopy(self.state),
+                    "unprojected_extra": {"first": 1, "second": 2}}
+        if phase == "prewrite" and self.reorder_prewrite:
+            body["unprojected_extra"] = {"second": 2, "first": 1}
+        return {
+            "http_status": 200,
+            "body": json.dumps(body, ensure_ascii=False, separators=(",", ":")),
+            "request_id": "raw-session:" + str(self.serial),
+            "session_id": self.session_id,
+            "fresh": True,
+            "cache": False,
+            "platform_version": "observed-v1",
+        }
+
+
+class RuntimeRawPreservationTests(unittest.TestCase):
