+                "response_fields": {key: ["snapshot", key] for key in wire.SNAPSHOT_FIELDS}}
+        profile = {"mode": "SYNTHETIC", "platform_version": "observed-v1",
+                   "reads": {"baseline": spec, "prewrite": copy.deepcopy(spec)}}
+        profile_hash = digest(profile)
+        transport.profile = profile
+        transport._profile_hash = profile_hash
+        transport._request = {"approval": {"wire_profile_hash": profile_hash,
+            "starts_at": "2026-01-01T00:00:00Z", "ends_at": "2099-01-01T00:00:00Z"}}
+        transport.session_id = session.session_id
+        baseline = transport.observe("baseline")
+        pid = "q-new"
+        session.state["view"]["target"]["questions"].append(
+            {"platform_question_id": pid, "platform_order": 2, "directory_id": "leaf"})
+        for index in range(6):
+            rid = "r-new-" + str(index)
+            session.state["view"]["target"]["frames"].append(
+                {"platform_frame_id": rid, "platform_question_id": pid})
+            session.state["view"]["frame_projections"][rid] = {"index": index}
+        session.state["view"]["internal_bindings"]["local-new"] = pid
+        session.state["view"]["question_content"][pid] = {
+            "status": "AVAILABLE", "question_type": "ordinary_choice",
+            "parts": [{"text": "new"}], "wire_zones": {zone: None for zone in wire.ZONES},
+            "question_info": {}, "rect_ids": ["r-new-" + str(i) for i in range(6)],
+        }
+        return baseline, transport.observe("prewrite"), pid
