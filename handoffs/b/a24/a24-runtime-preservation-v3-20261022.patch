+def response_residual(value, declared_paths):
+    """Typed wrapper tree with declared response_fields values replaced by masks."""
+    require(isinstance(declared_paths, list) and declared_paths, "RAW_RESPONSE_RESIDUAL_UNBOUND")
+    paths = []
+    for path in declared_paths:
+        require(isinstance(path, list) and path and all(isinstance(key, str) for key in path),
+                "RAW_RESPONSE_RESIDUAL_UNBOUND")
+        paths.append(tuple(path))
+    require(len(paths) == len(set(paths)) and
+            not any(a != b and len(a) < len(b) and b[:len(a)] == a for a in paths for b in paths),
+            "RAW_RESPONSE_RESIDUAL_UNBOUND")
+    mask = object()
+    residual = copy.deepcopy(value)
+    for path in paths:
+        node = residual
+        for key in path[:-1]:
+            require(isinstance(node, dict) and key in node, "RAW_RESPONSE_RESIDUAL_UNBOUND")
+            node = node[key]
+        require(isinstance(node, dict) and path[-1] in node, "RAW_RESPONSE_RESIDUAL_UNBOUND")
+        node[path[-1]] = mask
+
+    def encode(node):
+        if node is mask:
+            return {"node_type": "DECLARED_SUBTREE_MASK"}
+        if isinstance(node, dict):
+            return {"node_type": "OBJECT", "entries": [
+                {"key": key, "value": encode(item)} for key, item in node.items()
+            ]}
+        if isinstance(node, list):
+            return {"node_type": "ARRAY", "items": [encode(item) for item in node]}
+        json_type = ("NULL" if node is None else "BOOLEAN" if type(node) is bool else
+                     "INTEGER" if type(node) is int else "NUMBER" if type(node) is float else
+                     "STRING" if isinstance(node, str) else None)
+        require(json_type is not None, "RAW_RESPONSE_RESIDUAL_UNBOUND")
+        return {"node_type": "JSON_SCALAR", "json_type": json_type, "value": node}
+    return encode(residual)
+
