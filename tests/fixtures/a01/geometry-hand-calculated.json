    {"name":"combined90","config":{"crop":[10,5,50,25],"scale":[2,3],"padding":[3,7,11,13],"rotation_degrees":90},"point":[12,8],"expected_point":[64,7],"box":[12,8,22,12],"expected_box":[52,7,64,27],"output_size":[80,94]},
